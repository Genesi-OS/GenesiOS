# Genesi OS GRUB theme lifecycle.
#
# This only changes presentation settings. grub-mkconfig still discovers all
# normal kernels and the grub-btrfs recovery submenu through the standard
# scripts under /etc/grub.d.

_genesi_grub_set() {
    local file="$1" key="$2" value="$3"

    if grep -q "^[#[:space:]]*${key}=" "$file" 2>/dev/null; then
        sed -i "s|^[#[:space:]]*${key}=.*|${key}=${value}|" "$file"
    else
        printf '%s=%s\n' "$key" "$value" >> "$file"
    fi
}

_genesi_grub_regenerate() {
    if command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
        if ! grub-mkconfig -o /boot/grub/grub.cfg; then
            printf 'warning: Genesi theme installed, but grub.cfg regeneration failed\n' >&2
            printf 'warning: run sudo grub-mkconfig -o /boot/grub/grub.cfg manually\n' >&2
        fi
    fi
}

_genesi_grub_apply() {
    local defaults=/etc/default/grub
    [ -e "$defaults" ] || : > "$defaults"

    _genesi_grub_set "$defaults" GRUB_DISTRIBUTOR '"Genesi OS"'
    _genesi_grub_set "$defaults" GRUB_THEME '"/usr/share/grub/themes/genesi/theme.txt"'
    _genesi_grub_set "$defaults" GRUB_BACKGROUND '"/usr/share/grub/themes/genesi/background.png"'
    _genesi_grub_set "$defaults" GRUB_GFXMODE '"1920x1080,auto"'
    _genesi_grub_set "$defaults" GRUB_TERMINAL_OUTPUT '"gfxterm"'

    # Readable fallbacks if firmware cannot load the graphical theme.
    _genesi_grub_set "$defaults" GRUB_COLOR_NORMAL '"light-gray/black"'
    _genesi_grub_set "$defaults" GRUB_COLOR_HIGHLIGHT '"white/dark-gray"'

    _genesi_grub_regenerate
}

_genesi_grub_remove() {
    local defaults=/etc/default/grub
    [ -f "$defaults" ] || return 0

    sed -i '/^[#[:space:]]*GRUB_THEME=.*genesi\/theme\.txt/d' "$defaults"
    sed -i '/^[#[:space:]]*GRUB_BACKGROUND=.*genesi\/background\.png/d' "$defaults"
    _genesi_grub_regenerate
}

post_install() { _genesi_grub_apply; }
post_upgrade() { _genesi_grub_apply; }
post_remove() { _genesi_grub_remove; }
