# Maintainer: Genesi OS Team
#
# genesi-store — where a Genesi desktop gets its looks.
#
# The measure was RyoStore: shelves (lockscreens, rices, themes, bar styles,
# fastfetch, plugins, bundles, decor), a card per item, one click to wear it.
# What Genesi does differently is the part underneath.
#
# ── An item is DATA ─────────────────────────────────────────────────────────
#
# Every item in the catalogue is a name, a picture and a list of ACTIONS out
# of a vocabulary genesi-store implements: set a scheme, set a wallpaper,
# write this config file, switch the bar, ask pacman for a locker, point the
# login screen at a theme. There is no field an item can put a command in, and
# ci/store-test.py fails the build if one appears. A store that runs scripts
# from its catalogue is a root shell with a nice card around it -- and the day
# that catalogue comes down from the network rather than out of this package,
# it is a REMOTE root shell.
#
# ── Everything is reversible ────────────────────────────────────────────────
#
# Each action returns its own inverse, and `apply` records it. Revert is
# therefore not "apply the previous thing", it is the undo of what was done --
# including the case that catches people out, where a config file did not
# exist before and putting it "back" means deleting it again. The old file is
# kept under ~/.local/share/genesi/store/backups either way.
#
# ── What it may touch ───────────────────────────────────────────────────────
#
# Downloads land in ~/.local/share/genesi/store. Writes go to ~/.config,
# through genesi-center-set where there is a key for it (it validates), or as
# a whole file with a backup where there is not. Two things need root and both
# say so before they happen, through genesi-store-helper under pkexec: the
# login screen (SDDM lives in /etc and /usr/share) and installing a locker.
# The helper takes a NAME from a fixed list, never a path and never a command.
#
# ── The wallpapers ──────────────────────────────────────────────────────────
#
# One MIT-licensed collection (D3Ext/aesthetic-wallpapers), so there is a
# single licence to honour, and every file is recorded with the size and
# SHA-256 it served at build time: build-catalog.py downloads each one to get
# them, and the store refuses a file that no longer matches. A dead link is a
# failed build here rather than a broken card on somebody's desktop.
#
# ── Why source=() is empty ──────────────────────────────────────────────────
#
# Everything is installed from ${startdir}, the way genesi-center does it.
# makepkg's source=() takes FILENAMES, not paths: given "catalog/catalog.json"
# it looks for a file called catalog.json in the build directory, does not
# find one, and stops with "catalog.json was not found in the build directory
# and is not a URL" -- which is exactly how this package failed its first
# build. ci/pkgbuild-syntax-test.py now refuses a source entry with a slash in
# it, so the next person meets the rule instead of the error.
pkgname=genesi-store
pkgver=0.1.0
# 2: the first version shipped looked wrong on a real machine, in four ways.
#
# No icon, because none was installed -- the launcher drew the "no icon"
# circle. There is one now, and it is the Genesi mark itself (the same outline
# and five veins as genesi-plymouth's logo and the hicolor icon), on a tile,
# with a small download badge so a menu full of Genesi apps is not six
# identical leaves. The leaf the app drew in its own rail was a shape I made
# up; it is the real mark now as well.
#
# The rail's hover labels were drawn UNDER the cards: the rail is an earlier
# sibling of the shelf, and no z on a child lifts it out of its parent's turn.
# The window draws that label itself now.
#
# The icons were Material Symbols, on the reasoning that every Genesi desktop
# has that font. A real machine did not find it, so the fallback -- a leaf --
# was drawn nine times down the rail, one per shelf. They are SVGs shipped in
# the package now, recoloured at draw time.
#
# And the cards were a thumbnail with three rows of form under it. A card is
# the picture now: the wallpaper's own thumbnail (480px, shipped, so a shelf
# is a shelf of pictures before anything is downloaded), with a small desktop
# drawn ON it in the item's real colours. The shelf is a mosaic -- a whole
# desktop takes four cells, a wallpaper two -- rather than a row of equal
# rectangles.
#
# New with it: a detail sheet that lists what applying something will change,
# read off the item's own actions, and the Genesi login screen (a real SDDM
# theme, in sddm/, installed but never switched on by itself).
pkgrel=2
pkgdesc='Genesi Store — themes, wallpapers, bars, lock screens and whole desktops, one click each'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL-3.0-or-later')
# python-pyside6 for the window; the rest are what the ACTIONS reach for, and
# every one of them is already on a Genesi Hyprland install.
# qt6-svg because every icon in the window is an SVG (see Glyph.qml: a font
# that turned out not to be installed is why they are files), and sddm because
# the login screen this ships a theme for is the one it themes.
depends=('python' 'pyside6' 'polkit' 'qt6-svg')
optdepends=(
    'genesi-caelestia-cli: colour schemes and wallpapers'
    'genesi-caelestia-settings: the fifteen bar arrangements'
    'genesi-center: the settings writer the store applies keys through'
    'hyprlock: session lock screens (the store offers to install it)'
    'fastfetch: the terminal greeting the Fastfetch shelf configures'
    'sddm: the login screen the Genesi greeter replaces'
)
source=()
sha256sums=()

check() {
    # The two halves that run as scripts. A syntax error in either is a store
    # that opens and can do nothing, or a helper that fails under pkexec after
    # the password has been typed.
    python -c "import ast,io;ast.parse(io.open('${startdir}/genesi-store',encoding='utf-8').read())"
    python -c "import ast,io;ast.parse(io.open('${startdir}/genesi-store-helper',encoding='utf-8').read())"
    python -c "import ast,io;ast.parse(io.open('${startdir}/app/genesi_store_app.py',encoding='utf-8').read())"

    # ...and the catalogue, which is the thing this package actually ships.
    # Parsing is not enough: an item whose action the CLI does not implement
    # is a card that fails when somebody presses it, so the shelves, the ids
    # and the vocabulary are checked here, at build time, against the CLI in
    # this same directory.
    python - "${startdir}" <<'CHECKCATALOG'
import io, json, os, re, sys
root = sys.argv[1]
catalog = json.load(io.open(root + "/catalog/catalog.json", encoding="utf-8"))
cli = io.open(root + "/genesi-store", encoding="utf-8").read()
vocab = set(re.findall(r'^\s+"(\w+)": act_\w+,', cli, re.M))
sections = {s["id"] for s in catalog["sections"]}
items = catalog["items"]
if len(items) < 40:
    raise SystemExit("the catalogue has only %d items" % len(items))
seen = set()
for item in items:
    if item["id"] in seen:
        raise SystemExit("repeated id: " + item["id"])
    seen.add(item["id"])
    if item["section"] not in sections:
        raise SystemExit("%s is on a shelf that does not exist" % item["id"])
    for action in item.get("actions", []):
        if action["action"] not in vocab:
            raise SystemExit("%s asks for %r, which genesi-store cannot do"
                             % (item["id"], action["action"]))
# A login item names a theme DIRECTORY. Genesi's own has to be in this
# package; anything else has to be one SDDM itself ships. A name that is
# neither is a login screen that does not come up, and that is not a thing to
# find out by rebooting.
for item in items:
    for action in item.get("actions", []):
        if action.get("action") != "login":
            continue
        theme = action.get("theme")
        if theme == "genesi":
            if not os.path.isdir(os.path.join(root, "sddm")):
                raise SystemExit("the catalogue offers the Genesi login "
                                 "screen and this package does not ship it")
        elif theme not in ("breeze", "elarun", "maldives", "maya"):
            raise SystemExit("unknown login theme: %r" % theme)

print("catalogue: %d items, %d shelves, every action implemented"
      % (len(items), len(sections)))
CHECKCATALOG
}

package() {
    # The one command. With arguments it is the data plane; with none it opens
    # the window, because that is what a person means when they type it.
    install -Dm755 "${startdir}/genesi-store" "${pkgdir}/usr/bin/genesi-store"

    # The privileged half, deliberately NOT on PATH: it is started by pkexec
    # from the store and by nothing else.
    install -Dm755 "${startdir}/genesi-store-helper" \
        "${pkgdir}/usr/lib/genesi-store/genesi-store-helper"
    install -Dm644 "${startdir}/org.genesi.store.policy" \
        "${pkgdir}/usr/share/polkit-1/actions/org.genesi.store.policy"

    # The catalogue, and the script that built it -- shipped so the provenance
    # of every link travels with the data.
    install -Dm644 "${startdir}/catalog/catalog.json" \
        "${pkgdir}/usr/share/genesi-store/catalog.json"
    install -Dm644 "${startdir}/build-catalog.py" \
        "${pkgdir}/usr/share/genesi-store/build-catalog.py"

    # The window.
    install -Dm755 "${startdir}/app/genesi_store_app.py" \
        "${pkgdir}/usr/share/genesi-store/app/genesi_store_app.py"
    install -Dm644 "${startdir}/app/Main.qml" \
        "${pkgdir}/usr/share/genesi-store/app/Main.qml"
    install -Dm644 "${startdir}/app/Tokens.qml" \
        "${pkgdir}/usr/share/genesi-store/app/Tokens.qml"
    install -Dm644 "${startdir}/app/qmldir" \
        "${pkgdir}/usr/share/genesi-store/app/qmldir"
    for f in "${startdir}"/app/components/*.qml; do
        install -Dm644 "$f" \
            "${pkgdir}/usr/share/genesi-store/app/components/$(basename "$f")"
    done
    for f in "${startdir}"/app/icons/*.svg; do
        install -Dm644 "$f" \
            "${pkgdir}/usr/share/genesi-store/app/icons/$(basename "$f")"
    done

    # The pictures the shelves are made of. Shipped, not downloaded: a store
    # whose cards are grey rectangles until you press something is a list.
    for f in "${startdir}"/catalog/thumbs/*.jpg; do
        install -Dm644 "$f" \
            "${pkgdir}/usr/share/genesi-store/thumbs/$(basename "$f")"
    done

    # ── The login screen ────────────────────────────────────────────────────
    #
    # A theme for SDDM, the greeter every Genesi Hyprland install gets.
    # Installing it changes NOTHING on its own: SDDM keeps using whatever
    # /etc/sddm.conf.d says until somebody picks this one in the store, which
    # is the only moment a password is asked for.
    install -Dm644 "${startdir}/sddm/Main.qml" \
        "${pkgdir}/usr/share/sddm/themes/genesi/Main.qml"
    install -Dm644 "${startdir}/sddm/theme.conf" \
        "${pkgdir}/usr/share/sddm/themes/genesi/theme.conf"
    install -Dm644 "${startdir}/sddm/metadata.desktop" \
        "${pkgdir}/usr/share/sddm/themes/genesi/metadata.desktop"

    install -Dm644 "${startdir}/genesi-store.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/genesi-store.svg"

    install -Dm644 "${startdir}/org.genesi.store.desktop" \
        "${pkgdir}/usr/share/applications/org.genesi.store.desktop"
}
