# Maintainer: Genesi OS Team <dev@genesios.org>
pkgname=genesi-forge
pkgver=2.3.0
# pkgrel 8: the app did not start at all. SecretsPanel assigned danger: true on a
# GButton, but `danger` is derived read-only from `kind` in both the local and the
# kit button — QML rejected the assignment, SecretsPanel failed to build, and the
# failure cascaded up through ProjectView to Main, so the engine loaded nothing.
# pkgrel 9: with the panel finally on screen, its list was unreadable — every row
# collapsed to the width of its own buttons. The secrets ScrollView was the one
# in the app missing `contentWidth: availableWidth`, and sized its column with
# `width: parent.width`, which inside a ScrollView is the Flickable contentItem
# whose width comes from the content itself.
# 2026-08-26 (10): the design pass, built against devtools/preview.py.
# THE HEADER FOLLOWED NOTHING. Templates, Integrations and Settings each
# announced themselves as "Projects -- All your repositories in one place",
# with four PROJECT counters underneath counting something the page was not
# about, and then repeated their own name one line below that in a section
# heading beside a refresh button that did nothing there. Title and subtitle
# now come from the section; the counters and the section heading appear only
# on the project lists, where they say something the title does not.
# A LONE TILE TOOK THE WHOLE ROW. Project cards are drawn for a 268px grid
# cell, but a GridLayout column with nothing beside it takes the full width --
# so on a fresh install the dashed "Import Project" tile stretched to 1300px
# and its icon and its text ended up marooned at opposite ends of it. Capped at
# the pitch the column count is computed from, which fixes one and two project
# cards too.
# 11: Forge follows the scheme too, behind Genesi Center's switch.
#
# One setting for both apps rather than one each: two switches is two
# places to look when only one of them followed. Fixed graphite is still
# the default. `red` follows (it is the scheme's error colour) but turbo,
# purple and blue do not -- those carry meaning here, and a semantic colour
# that changes with the wallpaper is a legend that stops being true.
# 12: follows the desktop's colour scheme by DEFAULT. It was the other
# way round, on the reasoning that an identity should not leave in an
# update -- but that reasoning is about the identity, not about the
# desktop. "Every window follows the theme" cannot be true by default
# in an OS whose default is that its own six windows do not. The
# emerald is one switch away, on the same switch, and it is what you
# ask for now rather than what you get.
pkgrel=12
pkgdesc='Genesi Forge: the project hub — full git panel, GitHub pipelines, deployments and the Forge Canvas workflow builder'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL-3.0-or-later')
depends=('python' 'pyside6' 'kirigami' 'qqc2-desktop-style' 'qt6-svg' 'qt6-declarative' 'git' 'github-cli'
         # secret-tool: how the Secrets panel puts values in the OS keyring
         # (Secret Service). Without it the panel refuses to store anything
         # rather than silently falling back to a plaintext file.
         'libsecret')
optdepends=('genesi-code: open projects in the Genesi editor')
source=()
sha256sums=()

package() {
    install -Dm755 "${startdir}/genesi-forge" "$pkgdir/usr/bin/genesi-forge"

    # Python backend + every QML file that makes up the app.
    install -Dm644 "${startdir}/app/genesi_forge.py" "$pkgdir/usr/share/genesi-forge/app/genesi_forge.py"
    # Every QML file that makes up the app (GButton is Forge-local — it shadows
    # the kit button so bundled-SVG icons resolve + tint correctly).
    local qml
    for qml in Main Splash ForgeTheme FIcon FCard GButton HubView ProjectView \
               GitOverview GitGraph ConsolePanel CanvasView ConfigPanel TechLogo \
               NavItem StatTile ProjectCard ImportCard GToggle CanvasNode PaletteItem \
               SecretsPanel; do
        install -Dm644 "${startdir}/app/${qml}.qml" "$pkgdir/usr/share/genesi-forge/app/${qml}.qml"
    done

    # Bundled icon set (feather-style SVGs, tinted at runtime via FIcon).
    local svg
    for svg in "${startdir}"/app/icons/*.svg; do
        install -Dm644 "$svg" "$pkgdir/usr/share/genesi-forge/app/icons/$(basename "$svg")"
    done

    install -Dm644 "${startdir}/org.genesi.forge.desktop" "$pkgdir/usr/share/applications/org.genesi.forge.desktop"
    install -Dm644 "${startdir}/genesi-forge.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/genesi-forge.svg"
}
