# Maintainer: Genesi OS Team <dev@genesios.org>
pkgname=genesi-forge
pkgver=2.3.0
# pkgrel 8: the app did not start at all. SecretsPanel assigned danger: true on a
# GButton, but `danger` is derived read-only from `kind` in both the local and the
# kit button — QML rejected the assignment, SecretsPanel failed to build, and the
# failure cascaded up through ProjectView to Main, so the engine loaded nothing.
pkgrel=8
pkgdesc='Genesi Forge: the project hub — full git panel, GitHub pipelines, deployments and the Forge Canvas workflow builder'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL-3.0-or-later')
depends=('python' 'pyside6' 'kirigami' 'qqc2-desktop-style' 'qt6-svg' 'qt6-declarative' 'git' 'github-cli'
         # secret-tool: how the Secrets panel puts values in the OS keyring
         # (Secret Service). Without it the panel refuses to store anything
         # rather than silently falling back to a plaintext file.
         'libsecret')
optdepends=('genesi-code: open projects in the Genesi editor')
source=()
sha256sums=()

package() {
    install -Dm755 "${startdir}/genesi-forge" "$pkgdir/usr/bin/genesi-forge"

    # Python backend + every QML file that makes up the app.
    install -Dm644 "${startdir}/app/genesi_forge.py" "$pkgdir/usr/share/genesi-forge/app/genesi_forge.py"
    # Every QML file that makes up the app (GButton is Forge-local — it shadows
    # the kit button so bundled-SVG icons resolve + tint correctly).
    local qml
    for qml in Main Splash ForgeTheme FIcon FCard GButton HubView ProjectView \
               GitOverview GitGraph ConsolePanel CanvasView ConfigPanel TechLogo \
               NavItem StatTile ProjectCard ImportCard GToggle CanvasNode PaletteItem \
               SecretsPanel; do
        install -Dm644 "${startdir}/app/${qml}.qml" "$pkgdir/usr/share/genesi-forge/app/${qml}.qml"
    done

    # Bundled icon set (feather-style SVGs, tinted at runtime via FIcon).
    local svg
    for svg in "${startdir}"/app/icons/*.svg; do
        install -Dm644 "$svg" "$pkgdir/usr/share/genesi-forge/app/icons/$(basename "$svg")"
    done

    install -Dm644 "${startdir}/org.genesi.forge.desktop" "$pkgdir/usr/share/applications/org.genesi.forge.desktop"
    install -Dm644 "${startdir}/genesi-forge.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/genesi-forge.svg"
}
