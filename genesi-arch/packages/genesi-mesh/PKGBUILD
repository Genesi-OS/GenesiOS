# Maintainer: Genesi OS Team <dev@genesios.org>
#
# Genesi Mesh — pool GPU memory across machines on a LAN so a model that fits on
# no single box still runs accelerated.
#
# Built on llama.cpp's RPC backend: a worker machine runs `rpc-server`, the
# client runs `llama-server --rpc host:port` and treats the remote GPU as an
# extra device. This package supplies the part llama.cpp leaves out — signed
# LAN discovery, a machine-wide trust secret, worker supervision, and the
# fits/doesn't-fit planning that keeps Turbo from pooling when pooling would be
# slower than running locally.
#
# Deliberately NOT a hard dependency of genesi-ai-mode: the mesh is opt-in, and
# a machine with no second box loses nothing by having the daemon idle.
#
# 2026-08-15 (2): refuse to pool integrated GPUs. An iGPU's "VRAM" is a slice of
# system RAM, and llama.cpp splits layers by CAPACITY rather than speed, so an
# integrated peer takes a full share of the work and then makes every token wait
# for it -- including one usually makes the run slower than leaving it out. Such
# peers are now detected, advertised, and skipped by default (pool_integrated =
# on to override). The client side is the mirror image and matters just as much:
# a laptop whose only GPU is integrated now reports a local budget of ZERO, so
# "the model does not fit here" is true and the mesh engages -- which is the
# whole point of Mesh. Counting its shared memory as real VRAM would have
# refused the mesh in exactly the case it exists for.
# 2026-08-15 (1): initial release. Requires a llama.cpp built with GGML_RPC=ON
# (genesi-llama-cpp >= r0-4 or genesi-llama-cpp-cuda >= r0-2); `genesi-mesh
# doctor` says so plainly when it is missing rather than failing obscurely.
pkgname=genesi-mesh
pkgver=1.0.0
# 2026-08-15 (3): find the RPC server under its real name. Upstream installs it
# as `ggml-rpc-server`; we only probed `rpc-server`, so `genesi-mesh doctor` and
# `selftest` reported it MISSING on a machine where it was correctly installed,
# and worker mode refused to start. Both names are tried now. Also drops the
# ">= pkgrel 4" hint from the error text: pkgver() moved r0 -> r10443, which
# makes makepkg reset pkgrel to 1, so that advice pointed people away from a
# perfectly good package.
# 2026-08-15 (7): discovery that works over a VPN, and completions.
# (1) New `peers` config key / `genesi-mesh peer <addr>`: the daemon also
# beacons by UNICAST to listed addresses. Multicast cannot cross a VPN, a
# routed subnet or AP client isolation -- unicast can -- so naming the far
# machine makes discovery work wherever the two can reach each other.
# (2) Ship fish + bash completions: `genesi-mesh` is a prefix of
# `genesi-meshd`, so Tab rewrote the CLI into the daemon and it looked like
# a hang; a user had to type the full /usr/bin path to work around it.
# 2026-08-16 (8): `doctor` diagnoses the layers below the config. It only ever
# read mesh.conf and the daemon's own state -- what was REQUESTED and what was
# STARTED -- so it printed "Everything checks out" on a machine where firewalld
# dropped every mesh packet. A two-machine test lost an afternoon to exactly
# that. It now checks the listening socket, identifies the RUNNING firewall
# (and flags rules written to an inactive one, which report success and do
# nothing), reads the firewalld zone of each VPN interface, and probes
# registered peers -- separating "unreachable" from "reachable but silent".
# 2026-08-16 (9): `plan` accepts the name you actually run a model by. It took
# a path or a bare number, so `genesi-mesh plan llama3.2:3b` -- the obvious
# command, and the one the tool's own docs imply -- answered with a usage line.
# It now resolves ollama tags through ollama's manifests, gguf:<name> from the
# Genesi library, paths, and sizes, prints WHICH file it measured (an ollama
# blob name carries no hint of the model, so a wrong resolution would be
# invisible), and when nothing matches says the model was not found instead of
# implying the argument was malformed.
# 2026-08-16 (10): the mesh advertises FREE VRAM, not capacity. probe_gpu read
# nvidia-smi's memory.total, so a worker busy running its own 5.7 GB model still
# announced a full 8 GB card. The planner promised a client 6.8 GB of pooled
# VRAM that did not exist, and llama.cpp died mid-load with "failed to allocate
# RPC0[host:50052] buffer of size 2011539712" -- a real two-machine test failed
# exactly there. Beacons now carry free_mb (re-sampled every 5s; omitted, not
# zeroed, where it cannot be measured), plan_pool budgets against it, peers/
# status/doctor show free alongside total, and doctor flags a worker that is ON
# with no room to give.
# 2026-08-16 (11): `peers` only captions the VRAM column when a peer actually
# reported free memory. A CPU-only machine has none to report, so the list showed
# a lone "0 MiB" under a "(free / total VRAM)" caption -- explaining a column
# that was not there, and sending the reader hunting for a second number.
# 2026-08-16 (12): the mesh checks that two llama.cpp builds can actually talk.
# A worker on build 10438 and a client on 10454 handshake fine, transfer the
# weights (2002 MiB landed on the worker's GPU), and then the client hangs
# forever at "loading model" -- because the handshake compares RPC_PROTO_*,
# which matched, while what really diverged was the ggml OPERATION ENUM. Op
# codes travel as bare integers, so the two ends silently disagree about what
# each one means. Beacons now carry build/proto/ops, plan_pool refuses a peer
# whose op set differs, and doctor reports the pairing.
# 2026-08-16 (13): keep the worker's own output, and notice a crash loop.
# rpc-server was launched with stdout/stderr on /dev/null, which threw away the
# one line that says WHICH device it is serving -- it takes every non-CPU device
# it can find and falls back to the CPU silently, and a CPU-serving worker is
# network-attached CPU inference: slower than not meshing. The output now lands
# in /run/genesi-mesh/worker.log (line-buffered via stdbuf, or printf's block
# buffering would hold the banner until exit) and `doctor` reports the device.
# The same blindness hid a harder failure: on a real two-machine test the worker
# was SIGILL-ing on startup and being restarted every ~8s, while `doctor` said
# "running" -- true at every instant it was sampled. The daemon now tracks
# restart rate and reports a crash loop, naming the signal.
# 2026-08-19 (14): the firewall check had two holes, and a same-LAN mesh fell
# through both. (1) It only ever read the zone of VPN interfaces. Two machines
# on one LAN never use the overlay for bulk traffic -- the beacon advertises
# primary_address(), so the client dials the LAN IP and lands on the LAN NIC's
# zone, which on a stock install is `public`: ssh, dhcpv6-client, and nothing
# else. doctor inspected the (correctly opened) tailscale0 zone, said
# "Everything checks out", and every connection to rpc-server was dropped by a
# zone it never looked at. It now checks the interface holding
# primary_address() too, and prints open-port commands per BLOCKING ZONE rather
# than one block for the VPN. (2) firewalld answers --get-zone-of-interface to
# anyone but requires privilege for --list-all, so an unprivileged doctor knew
# each zone and NOTHING about its contents -- and printed a green "admits
# 50052/tcp, 47100/udp" built from that. A verdict of "unknown" was being
# rendered as "verified open": the exact false all-clear this section exists to
# prevent. Unverifiable now says so and points at `sudo genesi-mesh doctor`.
# 2026-08-19 (15): the mesh advertises Turbo, so borrowing a GPU needs no
# configuration. Pooling VRAM was the only discoverable way to use another
# machine's GPU, and it is the WRONG one whenever the model fits on that
# machine -- pooling ships layer activations per token, while Turbo-over-HTTP
# ships text. A beacon now carries `turbo_port` while a Turbo is reachable
# off-box (checked per beacon from /proc/net/tcp, so a loopback-only bind is
# never advertised and a stopped Turbo stops being advertised), turbo_url()
# resolves GENESI_TURBO_URL -> local Turbo -> best peer serving one -> loopback,
# and `peers` tags such a peer [turbo] and says when to prefer it. The env var
# survives as an override for hand-built setups; nothing should need it.
pkgrel=15
pkgdesc='Genesi Mesh — pool GPU memory across machines for local inference'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL3')
depends=('python')
# llama.cpp is what actually moves the tensors. Not a hard dep so the daemon can
# be installed and configured before the backend is chosen (Vulkan vs CUDA).
optdepends=('genesi-llama-cpp: Vulkan RPC backend (any GPU)'
            'genesi-llama-cpp-cuda: CUDA RPC backend (NVIDIA)'
            'genesi-ai-mode: automatic mesh use from Genesi Turbo')
backup=('etc/genesi-mesh/mesh.conf')
source=()
sha256sums=()

package() {
    # Shared module, imported by both the daemon and the CLI via an explicit
    # sys.path entry (not installed into site-packages: it is private to this
    # package and must not collide with anything else).
    install -Dm644 "${startdir}/genesi_mesh_common.py" \
        "$pkgdir/usr/lib/genesi-mesh/genesi_mesh_common.py"

    install -Dm755 "${startdir}/genesi-meshd" "$pkgdir/usr/bin/genesi-meshd"
    install -Dm755 "${startdir}/genesi-mesh"  "$pkgdir/usr/bin/genesi-mesh"

    install -Dm644 "${startdir}/genesi-meshd.service" \
        "$pkgdir/usr/lib/systemd/system/genesi-meshd.service"

    # 0644: the config is readable by anyone (so `genesi-mesh status` works
    # unprivileged). The SECRET is a separate file, created 0600 at runtime by
    # `genesi-mesh init` — never shipped in the package.
    install -Dm644 "${startdir}/mesh.conf" \
        "$pkgdir/etc/genesi-mesh/mesh.conf"

    # Shell completions. Not cosmetic: `genesi-mesh` is a PREFIX of the
    # daemon `genesi-meshd`, so without these Tab silently turns the CLI
    # into the daemon, which then sits in its main loop looking like a hang.
    install -Dm644 "${startdir}/genesi-mesh.fish" "$pkgdir/usr/share/fish/vendor_completions.d/genesi-mesh.fish"
    install -Dm644 "${startdir}/genesi-mesh.bash" "$pkgdir/usr/share/bash-completion/completions/genesi-mesh"

    install -Dm644 "${startdir}/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
