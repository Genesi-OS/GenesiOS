#!/usr/bin/env python3
"""genesi-mesh — control and inspect the Genesi Mesh.

    genesi-mesh status              what this node is and who it can see
    genesi-mesh peers               the live peer table
    genesi-mesh init                start a NEW mesh here (generates the secret)
    genesi-mesh show-secret         print this mesh's secret, to carry to a peer
    genesi-mesh join <secret>       join an EXISTING mesh
    genesi-mesh peer <addr>         add a peer reachable over a VPN
    genesi-mesh worker on|off       offer / stop offering this machine's VRAM
    genesi-mesh serve on|off        offer / stop offering this machine's Turbo
    genesi-mesh use auto|local|<peer>  which Turbo THIS machine's apps talk to
    genesi-mesh plan <model|GB>     would pooling help for this model?
    genesi-mesh selftest            prove the RPC path works on THIS machine
    genesi-mesh doctor              check prerequisites and explain what is missing

Typical first run, two machines:

    machine A:  sudo genesi-mesh init && sudo genesi-mesh worker on
    machine A:  genesi-mesh show-secret
    machine B:  sudo genesi-mesh join <that secret> && sudo genesi-mesh worker on
    either:     genesi-mesh peers

With ONE machine, `selftest` exercises the identical code path against your own
GPU over loopback, so the mesh is proven working before a second box exists.
"""

import json
import os
import shutil
import socket
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/genesi-mesh")
import genesi_mesh_common as mesh   # noqa: E402

RESET, BOLD, DIM = "\033[0m", "\033[1m", "\033[2m"
GREEN, YELLOW, RED, CYAN = "\033[32m", "\033[33m", "\033[31m", "\033[36m"


def color(txt, col):
    return txt if not sys.stdout.isatty() else col + txt + RESET


def need_root(action):
    if os.geteuid() != 0:
        print(color("This needs root: sudo genesi-mesh %s" % action, RED))
        return False
    return True


def reload_daemon():
    """Nudge the daemon to re-read the config. Falls back to a plain SIGHUP so
    this also works when the daemon was started by hand during development."""
    if subprocess.run(["systemctl", "reload-or-restart", "genesi-meshd"],
                      capture_output=True).returncode == 0:
        return
    subprocess.run(["pkill", "-HUP", "-f", "genesi-meshd"], capture_output=True)


def set_conf(key, value):
    """Rewrite one key in mesh.conf, preserving comments and unrelated keys."""
    os.makedirs(mesh.CONF_DIR, mode=0o755, exist_ok=True)
    try:
        with open(mesh.CONF_PATH, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []

    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in stripped:
            if stripped.split("=", 1)[0].strip() == key:
                out.append("%s = %s" % (key, value))
                replaced = True
                continue
        out.append(line)
    if not replaced:
        out.append("%s = %s" % (key, value))

    with open(mesh.CONF_PATH, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip() + "\n")


def read_state():
    try:
        with open(mesh.STATE_PATH, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


# ── firewall and reachability probes ─────────────────────────────────────────
#
# The single most common reason a correctly configured mesh does not work is
# that the ports are closed, and nothing else in this file can see that. The
# config says what the user ASKED for and the daemon's state says what it
# STARTED — both can be perfect while every packet is dropped one layer down.
# So doctor probes the live system instead of only reading intentions.

# Firewall managers a Genesi machine might be running. `nftables`/`iptables` are
# the raw ones: their rules are whatever the admin loaded, so we can report that
# they are in charge but never judge their contents.
FIREWALL_UNITS = ("firewalld", "ufw", "nftables", "iptables")


def _unit_active(unit):
    try:
        res = subprocess.run(["systemctl", "is-active", unit],
                             capture_output=True, text=True, timeout=5)
        return res.stdout.strip() == "active"
    except (OSError, subprocess.SubprocessError):
        return False


def _ufw_has_rules():
    """True when ufw has user rules on disk.

    Only interesting when ufw is NOT running, and then it is the most valuable
    signal doctor has. `sudo ufw allow ...` on a machine where firewalld is the
    active firewall writes the rule, prints "Rules updated", exits 0, and
    changes nothing. The user then has documented proof they opened the port and
    a mesh that still cannot connect, with no way to tell those apart."""
    try:
        with open("/etc/ufw/user.rules", "r", encoding="utf-8") as fh:
            return "### tuple ###" in fh.read()
    except OSError:
        return False


def _fw_cmd(*args):
    try:
        res = subprocess.run(["firewall-cmd"] + list(args),
                             capture_output=True, text=True, timeout=8)
        return res.returncode, (res.stdout or "").strip()
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def _firewalld_zone_for(iface):
    """(zone, is_default) that `iface` is filtered by.

    An interface in "no zone" is NOT unfiltered — it falls into the default
    zone, which on a stock install allows about two services. That is exactly
    how a VPN interface ends up silently dropping every mesh packet while the
    admin sees no rule anywhere that mentions it."""
    rc, out = _fw_cmd("--get-zone-of-interface=" + iface)
    if rc == 0 and out and out != "no zone":
        return out, False
    _, default = _fw_cmd("--get-default-zone")
    return (default or "public"), True


def _firewalld_allows(zone, port, proto):
    """Does `zone` admit `port/proto`? True / False / None when we cannot tell.

    The zone TARGET is checked first: a target of ACCEPT (the `trusted` zone)
    admits everything, and `--query-port` there answers "no" while the traffic
    sails straight through. Trusting that answer would make doctor report a
    problem that does not exist, which is worse than saying nothing."""
    rc, out = _fw_cmd("--zone=" + zone, "--list-all")
    if rc != 0:
        return None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("target:"):
            if line.split(":", 1)[1].strip() == "ACCEPT":
                return True
        elif line.startswith("ports:"):
            if ("%d/%s" % (port, proto)) in line:
                return True
    return False


def _probe_tcp(host, port, timeout=2.5):
    """Connect and classify the outcome. Returns one of:

        "open"        something is listening and accepted the connection
        "refused"     the packet ARRIVED and the kernel said no — the host is
                      reachable and nothing is filtering, there is simply no
                      listener on that port
        "blocked"     no answer at all, which is what a firewall DROP looks
                      like from the outside
        "unreachable" no route / name does not resolve

    The refused-versus-blocked split is the whole point. Both look like "it does
    not work", but one means "start the worker" and the other means "open the
    port", and guessing wrong costs an afternoon."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect((host, port))
        return "open"
    except socket.timeout:
        return "blocked"
    except ConnectionRefusedError:
        return "refused"
    except OSError:
        return "unreachable"
    finally:
        sock.close()


# ── naming a model ───────────────────────────────────────────────────────────
#
# `plan` answers "would pooling help for THIS model", and users name a model the
# way they RUN it — `llama3.2:3b` — not by the path into ollama's
# content-addressed blob store. Accepting only a filesystem path or a bare
# number meant the obvious command bounced off a usage line:
#
#     $ genesi-mesh plan llama3.2:3b
#     usage: genesi-mesh plan <model.gguf|SIZE_IN_GB>
#
# genesi-ai-turbo owns the complete resolver — sharded sets, quant metadata,
# the GGUF library index. Mesh needs exactly one number, the size on disk, so it
# carries the small read-only subset instead of depending on the AI Mode
# package, which is only an optdepend here and may not be installed.

def _ollama_roots():
    """Every plausible ollama model root, daemon's own first.

    More than one can exist at once (a stale ~/.ollama beside the real
    /var/lib/ollama), so callers probe them ALL for the specific model rather
    than locking onto the first that merely has a manifests/ dir."""
    daemon = None
    try:
        out = subprocess.run(["systemctl", "show", "ollama", "-p", "Environment"],
                             capture_output=True, text=True, timeout=5).stdout
        for tok in out.replace("Environment=", "", 1).split():
            if tok.startswith("OLLAMA_MODELS="):
                daemon = tok.split("=", 1)[1].strip() or None
    except (OSError, subprocess.SubprocessError):
        pass

    roots, seen = [], set()
    for d in (os.environ.get("OLLAMA_MODELS"), daemon, "/var/lib/ollama",
              "/usr/share/ollama/.ollama/models", "/usr/share/ollama",
              "/var/lib/ollama/.ollama/models", "/var/lib/ollama/models",
              os.path.expanduser("~/.ollama/models")):
        if d and d not in seen and os.path.isdir(os.path.join(d, "manifests")):
            seen.add(d)
            roots.append(d)
    return roots


def _ollama_gguf(tag):
    """The GGUF blob ollama stored for `tag` (e.g. 'llama3.2:3b'), or None."""
    name, _, ver = str(tag).partition(":")
    ver = ver or "latest"
    for root in _ollama_roots():
        man = os.path.join(root, "manifests", "registry.ollama.ai", "library",
                           name, ver)
        if not os.path.isfile(man):
            continue
        try:
            with open(man, "r", encoding="utf-8") as fh:
                layers = json.load(fh).get("layers", [])
        except (OSError, ValueError):
            continue
        for layer in layers:
            if str(layer.get("mediaType", "")).endswith("image.model"):
                # The digest is written as sha256:xxx or sha256-xxx; the file on
                # disk is always the dashed form.
                blob = os.path.join(
                    root, "blobs",
                    str(layer.get("digest", "")).replace(":", "-"))
                if os.path.isfile(blob) and os.access(blob, os.R_OK):
                    return blob
    return None


def _library_gguf(name):
    """A .gguf matched by file name in the Genesi library and the usual places a
    browser drops a Hugging Face download."""
    want = name.lower()
    if want.endswith(".gguf"):
        want = want[:-5]
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dirs = [d for d in (os.environ.get("GENESI_GGUF_DIR") or "").split(":") if d]
    dirs += [os.path.join(data, "genesi", "models"),
             os.path.expanduser("~/Downloads"),
             os.path.expanduser("~/Models"),
             "/var/lib/genesi/models"]
    for d in dirs:
        d = os.path.expanduser(d)
        try:
            entries = os.listdir(d)
        except OSError:
            continue
        for fn in entries:
            if not fn.lower().endswith(".gguf"):
                continue
            if want in (fn.lower(), fn.lower()[:-5]):
                path = os.path.join(d, fn)
                if os.path.isfile(path):
                    return path
    return None


def _free_note(gpu):
    """" (N MiB free)", coloured by whether that is enough to be worth pooling.

    Shown next to capacity everywhere, because capacity is the number that
    misleads: an 8 GB card busy with its own model is still an 8 GB card, and
    reading only that is how a client ends up planning a run against memory
    the worker cannot give it."""
    free = gpu.get("free_mb")
    if not isinstance(free, (int, float)):
        return ""
    usable = free / 1024.0 - mesh.GPU_OVERHEAD_GB > 0
    return color(" (%d MiB free)" % int(free), GREEN if usable else RED)


def _secret_state():
    """"present" / "absent" / "unreadable" for the mesh secret.

    read_secret() returns None for BOTH "no such file" and "permission denied",
    which is right for the daemon (it runs as root, so None can only mean
    missing) and wrong for every command a user runs unprivileged. The secret is
    0600 root, so a plain `genesi-mesh doctor` reported "absent" on a machine
    that had just been through `init` — and then helpfully suggested running
    `init` again, which refuses because the secret it could not read exists."""
    if os.geteuid() == 0:
        return "present" if mesh.read_secret() is not None else "absent"
    if mesh.read_secret() is not None:
        return "present"
    return "unreadable" if os.path.exists(mesh.SECRET_PATH) else "absent"


def _hex_ip(hexstr):
    """Decode /proc/net/tcp's address form. Each 4-byte word is little-endian,
    so the bytes come out reversed per word — IPv4 is one word, IPv6 is four."""
    try:
        if len(hexstr) == 8:
            return socket.inet_ntop(socket.AF_INET, bytes.fromhex(hexstr)[::-1])
        if len(hexstr) == 32:
            raw = b"".join(bytes.fromhex(hexstr[i:i + 8])[::-1]
                           for i in range(0, 32, 8))
            return socket.inet_ntop(socket.AF_INET6, raw)
    except (ValueError, OSError):
        pass
    return "?"


def _socket_state(port):
    """(listening, [connected peer ip, ...]) for `port`, from /proc/net/tcp{,6}.

    Read from the kernel rather than probed, because probing rpc-server has a
    real cost: it serves ONE client at a time behind a listen backlog of 1. A
    diagnostic connection opened while it is busy with a peer gets no accept, so
    it times out and looks exactly like a firewall DROP — doctor would report a
    healthy, actively-serving worker as broken. Worse, the probe occupies the
    single backlog slot while it hangs, so the check degrades the thing it is
    checking. Asking what the socket is doing costs nothing and cannot lie."""
    listening, connected = False, []
    for path in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(path, "r", encoding="utf-8") as fh:
                next(fh, None)                      # column header
                for line in fh:
                    parts = line.split()
                    if len(parts) < 4:
                        continue
                    local, remote, st = parts[1], parts[2], parts[3]
                    try:
                        if int(local.rsplit(":", 1)[1], 16) != port:
                            continue
                    except (ValueError, IndexError):
                        continue
                    if st == "0A":                  # TCP_LISTEN
                        listening = True
                    elif st == "01":                # TCP_ESTABLISHED
                        connected.append(_hex_ip(remote.rsplit(":", 1)[0]))
        except OSError:
            continue
    return listening, connected


def _source_address_for(host):
    """The address a peer at `host` sees us as, or None.

    The same routing trick primary_address() uses, but aimed at a specific
    destination. That distinction matters the moment a VPN is involved: the LAN
    address is not the one carrying mesh traffic, and telling the user to test
    against it sends them to check a path their peers never use."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect((host, 9))
        return sock.getsockname()[0]
    except OSError:
        return None
    finally:
        sock.close()


def _needed_ports(worker_on, rpc_port, discovery_on):
    """Every port this machine must be able to RECEIVE on, and why."""
    needed = []
    if worker_on:
        needed.append(("tcp", rpc_port, "peers connect here to use this GPU"))
    if discovery_on:
        needed.append(("udp", mesh.DISCOVERY_PORT,
                       "peer beacons arrive here (this is what fills "
                       "`genesi-mesh peers`)"))
    return needed


def _open_port_commands(manager, needed, vpn_iface, zone=None,
                        zone_is_default=True):
    """The commands that actually open `needed` under the RUNNING firewall.

    Keyed to the active manager on purpose rather than printing every variant.
    The failure this exists to prevent is a user applying perfectly correct
    syntax for a firewall that is not the one filtering their traffic.

    When the VPN interface already sits in a zone of its own, the advice adds
    ports to THAT zone. Suggesting the usual `--zone=trusted --change-interface`
    there would silently undo a deliberate, narrower setup — advice that breaks
    working configuration is worse than no advice."""
    if manager == "firewalld":
        if vpn_iface and zone and not zone_is_default:
            cmds = ["sudo firewall-cmd --permanent --zone=%s --add-port=%d/%s"
                    % (zone, p, proto) for proto, p, _ in needed]
            return cmds + ["sudo firewall-cmd --reload"], (
                "%s is already in zone `%s`, so the ports go there rather than "
                "moving the interface." % (vpn_iface, zone))
        if vpn_iface:
            return ([
                "sudo firewall-cmd --permanent --zone=trusted "
                "--change-interface=%s" % vpn_iface,
                "sudo firewall-cmd --reload",
            ], "Trusts the %s interface as a whole — what Tailscale and "
               "WireGuard recommend on firewalld, since the overlay is already "
               "an authenticated network. For something narrower, give %s its "
               "own zone and add only the ports listed above."
               % (vpn_iface, vpn_iface))
        # Name the zone explicitly whenever we know it. A bare --add-port lands
        # in the DEFAULT zone, which is only the right target by coincidence —
        # on a machine whose LAN NIC sits in a zone of its own it opens a zone
        # nothing arrives on, and the user has a correct command that fixed
        # nothing.
        where = ("--zone=%s " % zone) if zone else ""
        cmds = ["sudo firewall-cmd --permanent %s--add-port=%d/%s"
                % (where, p, proto) for proto, p, _ in needed]
        return cmds + ["sudo firewall-cmd --reload"], ""

    if manager == "ufw":
        if vpn_iface:
            cmds = ["sudo ufw allow in on %s to any port %d proto %s"
                    % (vpn_iface, p, proto) for proto, p, _ in needed]
        else:
            cmds = ["sudo ufw allow %d/%s" % (p, proto)
                    for proto, p, _ in needed]
        return cmds, ""

    # Raw nftables/iptables: we do not know the ruleset's shape, so telling the
    # user to append a rule could land it after a DROP and do nothing. Name the
    # ports and let them place the rule correctly.
    return [], ("%s is managing the ruleset directly. Make sure it accepts %s "
                "on the interface your peers arrive on."
                % (manager, ", ".join("%d/%s" % (p, proto)
                                      for proto, p, _ in needed)))


# ── commands ─────────────────────────────────────────────────────────────────

def cmd_status():
    state = read_state()
    conf = mesh.load_conf()
    caps = mesh.rpc_supported()
    gpu = mesh.probe_gpu()
    peers = mesh.read_peers()

    print(color("Genesi Mesh", BOLD))
    if not state:
        print(color("  daemon:  not running "
                    "(sudo systemctl enable --now genesi-meshd)", YELLOW))
    else:
        age = time.time() - (state.get("updated") or 0)
        fresh = age < 10
        print("  daemon:  %s" % color("running" if fresh else "stale",
                                      GREEN if fresh else YELLOW))

    print("  node:    %s  (%s)" % (mesh.node_id(),
                                   conf.get("name") or socket.gethostname()))
    print("  address: %s" % mesh.primary_address())
    kind = " (integrated — shared system RAM)" if gpu.get("integrated") else ""
    print("  gpu:     %s%s, %d MiB%s%s"
          % (gpu["backend"], (" " + gpu["name"]) if gpu.get("name") else "",
             gpu["vram_mb"], _free_note(gpu),
             color(kind, YELLOW) if kind else ""))

    print("  mesh:    %s" % {
        "present": color("configured", GREEN),
        "unreadable": color("configured", GREEN)
            + color(" (secret is 0600 root; not read as this user)", DIM),
        "absent": color("no secret — run `genesi-mesh init`", YELLOW),
    }[_secret_state()])

    worker_on = mesh.conf_flag(conf, "worker")
    running = state.get("worker_running")
    if worker_on:
        detail = "listening on %s:%s" % (conf.get("rpc_bind"),
                                         conf.get("rpc_port"))
        print("  worker:  %s (%s)" % (
            color("ON" if running else "ON but not listening",
                  GREEN if running else RED), detail))
    else:
        print("  worker:  %s %s" % (color("off", DIM),
                                    color("(this machine is not sharing its GPU)", DIM)))

    if not caps["rpc_server"] or not caps["rpc_flag"]:
        print(color("  ! llama.cpp lacks the RPC backend — run `genesi-mesh doctor`",
                    YELLOW))

    print()
    if peers:
        _print_peers(peers)
    else:
        print(color("  no peers online", DIM))
        _explain_empty_peers()
    return 0


def _explain_empty_peers():
    """Say WHY the list is empty when the answer is structural.

    Over a VPN this is the correct result, not a failure: discovery is UDP
    multicast and no overlay forwards it. Without this note the user does
    everything right, sees a blank list, and reasonably concludes it is broken --
    which is exactly what happened in testing."""
    vpns = mesh.vpn_interfaces()
    if not vpns:
        return
    print()
    print(color("  A VPN interface is up (%s)." % ", ".join(vpns), YELLOW))
    print(color("  Discovery is UDP multicast, which no VPN forwards, so peers on"
                " the other", DIM))
    print(color("  side will NEVER appear here. That is expected — and the shared"
                " secret", DIM))
    print(color("  (init/join) only ever authenticated discovery, so it is not"
                " needed either.", DIM))
    print()
    print("  Either register the peer so discovery works over the VPN:")
    print(color("    sudo genesi-mesh peer <their-vpn-ip>      (on BOTH machines)",
                CYAN))
    print()
    print("  ...or skip discovery and name the worker directly:")
    print(color("    GENESI_MESH_ENDPOINTS=<vpn-ip>:%d genesi-ai-turbo serve"
                % mesh.DEFAULT_RPC_PORT, CYAN))


def _print_peers(peers):
    print(color("Peers (%d)" % len(peers), BOLD))
    any_integrated, any_busy, any_free = False, False, False
    for p in peers:
        role = color("worker", GREEN) if p.get("worker") else color("idle", DIM)
        tag = ""
        # A peer serving Turbo over HTTP is usually the BETTER answer than
        # pooling its VRAM — it ships text instead of per-token activations —
        # so it has to be visible here, next to the worker role it competes
        # with, rather than only inside Turbo's own resolution logic.
        if p.get("turbo_port"):
            tag += color("  [turbo%s]"
                         % (": " + p["turbo_model"] if p.get("turbo_model")
                            else ""), CYAN)
        if p.get("integrated"):
            any_integrated = True
            tag = color("  [integrated]", YELLOW)
        # FREE memory, not capacity, is what decides whether a run can use this
        # peer — so it is what the column shows, with capacity beside it. A
        # worker busy with its own model reads as full-sized and unavailable at
        # the same time, which is the truth and used to be invisible.
        total = int(p.get("vram_mb") or 0)
        free = p.get("free_mb")
        if isinstance(free, (int, float)):
            any_free = True
            mem = "%5d / %5d MiB" % (int(free), total)
            if p.get("worker") and mesh.peer_budget_gb(p) <= 0:
                any_busy = True
                tag += color("  [no room]", RED)
        else:
            mem = "%13d MiB" % total
        print("  %-18s %-15s %-7s %s  %s%s"
              % (p.get("host", "?"), p.get("addr", "?"),
                 p.get("backend", "?"), mem, role, tag))
    # Only when a peer actually reported free memory. A CPU-only machine has
    # none to report, and captioning a lone "0 MiB" as "free / total" explains
    # a column that is not there — worse than no caption, because it makes the
    # reader hunt for a second number.
    if any_free:
        print(color("  (free / total VRAM)", DIM))
    if any_busy:
        print()
        print(color("  [no room] = the GPU is there but something else is using", DIM))
        print(color("  it. Pooling needs memory it can ALLOCATE, so this peer is", DIM))
        print(color("  skipped until it frees up — check `nvidia-smi` there.", DIM))
    if any_integrated:
        print()
        print(color("  [integrated] = shared system RAM, not dedicated VRAM. Not", DIM))
        print(color("  pooled by default: llama.cpp splits layers by capacity, not", DIM))
        print(color("  speed, so such a peer takes a full share and slows every", DIM))
        print(color("  token. Override with pool_integrated = on in mesh.conf.", DIM))


def _explain_turbo_peers(peers):
    """Say what [turbo] means, and that it usually beats pooling."""
    serving = [p for p in peers if p.get("turbo_port")]
    if not serving:
        return
    print()
    print(color("  [turbo] = this peer runs Genesi Turbo and will answer over "
                "HTTP.", DIM))
    print(color("  Genesi clients here find it automatically — no configuration "
                "needed.", DIM))
    print(color("  Prefer it over pooling whenever the model FITS on that "
                "machine: HTTP", DIM))
    print(color("  moves the text, pooling moves layer activations for every "
                "token and", DIM))
    print(color("  leaves the far GPU waiting on the network.", DIM))


def cmd_peers():
    peers = mesh.read_peers()
    if not peers:
        print(color("no peers online", DIM))
        if not os.path.exists(mesh.STATE_PATH):
            print("the daemon does not look like it is running: "
                  "sudo systemctl enable --now genesi-meshd")
        _explain_empty_peers()
        return 0
    _print_peers(peers)
    _explain_turbo_peers(peers)
    return 0


