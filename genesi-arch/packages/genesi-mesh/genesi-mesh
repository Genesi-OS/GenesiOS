#!/usr/bin/env python3
"""genesi-mesh — control and inspect the Genesi Mesh.

    genesi-mesh status              what this node is and who it can see
    genesi-mesh peers               the live peer table
    genesi-mesh init                start a NEW mesh here (generates the secret)
    genesi-mesh show-secret         print this mesh's secret, to carry to a peer
    genesi-mesh join <secret>       join an EXISTING mesh
    genesi-mesh worker on|off       offer / stop offering this machine's GPU
    genesi-mesh plan <model|GB>     would pooling help for this model?
    genesi-mesh selftest            prove the RPC path works on THIS machine
    genesi-mesh doctor              check prerequisites and explain what is missing

Typical first run, two machines:

    machine A:  sudo genesi-mesh init && sudo genesi-mesh worker on
    machine A:  genesi-mesh show-secret
    machine B:  sudo genesi-mesh join <that secret> && sudo genesi-mesh worker on
    either:     genesi-mesh peers

With ONE machine, `selftest` exercises the identical code path against your own
GPU over loopback, so the mesh is proven working before a second box exists.
"""

import os
import socket
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/genesi-mesh")
import genesi_mesh_common as mesh   # noqa: E402

RESET, BOLD, DIM = "\033[0m", "\033[1m", "\033[2m"
GREEN, YELLOW, RED, CYAN = "\033[32m", "\033[33m", "\033[31m", "\033[36m"


def color(txt, col):
    return txt if not sys.stdout.isatty() else col + txt + RESET


def need_root(action):
    if os.geteuid() != 0:
        print(color("This needs root: sudo genesi-mesh %s" % action, RED))
        return False
    return True


def reload_daemon():
    """Nudge the daemon to re-read the config. Falls back to a plain SIGHUP so
    this also works when the daemon was started by hand during development."""
    if subprocess.run(["systemctl", "reload-or-restart", "genesi-meshd"],
                      capture_output=True).returncode == 0:
        return
    subprocess.run(["pkill", "-HUP", "-f", "genesi-meshd"], capture_output=True)


def set_conf(key, value):
    """Rewrite one key in mesh.conf, preserving comments and unrelated keys."""
    os.makedirs(mesh.CONF_DIR, mode=0o755, exist_ok=True)
    try:
        with open(mesh.CONF_PATH, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []

    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in stripped:
            if stripped.split("=", 1)[0].strip() == key:
                out.append("%s = %s" % (key, value))
                replaced = True
                continue
        out.append(line)
    if not replaced:
        out.append("%s = %s" % (key, value))

    with open(mesh.CONF_PATH, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip() + "\n")


def read_state():
    try:
        import json
        with open(mesh.STATE_PATH, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


# ── commands ─────────────────────────────────────────────────────────────────

def cmd_status():
    state = read_state()
    conf = mesh.load_conf()
    caps = mesh.rpc_supported()
    gpu = mesh.probe_gpu()
    peers = mesh.read_peers()

    print(color("Genesi Mesh", BOLD))
    if not state:
        print(color("  daemon:  not running "
                    "(sudo systemctl enable --now genesi-meshd)", YELLOW))
    else:
        age = time.time() - (state.get("updated") or 0)
        fresh = age < 10
        print("  daemon:  %s" % color("running" if fresh else "stale",
                                      GREEN if fresh else YELLOW))

    print("  node:    %s  (%s)" % (mesh.node_id(),
                                   conf.get("name") or socket.gethostname()))
    print("  address: %s" % mesh.primary_address())
    kind = " (integrated — shared system RAM)" if gpu.get("integrated") else ""
    print("  gpu:     %s%s, %d MiB%s"
          % (gpu["backend"], (" " + gpu["name"]) if gpu.get("name") else "",
             gpu["vram_mb"], color(kind, YELLOW) if kind else ""))

    secret = mesh.read_secret()
    print("  mesh:    %s" % (color("configured", GREEN) if secret
                             else color("no secret — run `genesi-mesh init`", YELLOW)))

    worker_on = mesh.conf_flag(conf, "worker")
    running = state.get("worker_running")
    if worker_on:
        detail = "listening on %s:%s" % (conf.get("rpc_bind"),
                                         conf.get("rpc_port"))
        print("  worker:  %s (%s)" % (
            color("ON" if running else "ON but not listening",
                  GREEN if running else RED), detail))
    else:
        print("  worker:  %s %s" % (color("off", DIM),
                                    color("(this machine is not sharing its GPU)", DIM)))

    if not caps["rpc_server"] or not caps["rpc_flag"]:
        print(color("  ! llama.cpp lacks the RPC backend — run `genesi-mesh doctor`",
                    YELLOW))

    print()
    if peers:
        _print_peers(peers)
    else:
        print(color("  no peers online", DIM))
    return 0


def _print_peers(peers):
    print(color("Peers (%d)" % len(peers), BOLD))
    any_integrated = False
    for p in peers:
        role = color("worker", GREEN) if p.get("worker") else color("idle", DIM)
        tag = ""
        if p.get("integrated"):
            any_integrated = True
            tag = color("  [integrated]", YELLOW)
        print("  %-18s %-15s %-7s %6d MiB  %s%s"
              % (p.get("host", "?"), p.get("addr", "?"),
                 p.get("backend", "?"), int(p.get("vram_mb") or 0), role, tag))
    if any_integrated:
        print()
        print(color("  [integrated] = shared system RAM, not dedicated VRAM. Not", DIM))
        print(color("  pooled by default: llama.cpp splits layers by capacity, not", DIM))
        print(color("  speed, so such a peer takes a full share and slows every", DIM))
        print(color("  token. Override with pool_integrated = on in mesh.conf.", DIM))


def cmd_peers():
    peers = mesh.read_peers()
    if not peers:
        print(color("no peers online", DIM))
        if not os.path.exists(mesh.STATE_PATH):
            print("the daemon does not look like it is running: "
                  "sudo systemctl enable --now genesi-meshd")
        return 0
    _print_peers(peers)
    return 0


def cmd_init():
    if not need_root("init"):
        return 1
    if mesh.read_secret():
        print(color("This machine is already in a mesh.", YELLOW))
        print("Use `genesi-mesh show-secret` to add another machine to it, or "
              "delete %s first to start over." % mesh.SECRET_PATH)
        return 1
    secret = mesh.create_secret()
    print(color("New mesh created.", GREEN))
    print()
    print("  secret: %s" % secret.decode())
    print()
    print("Run this on every other machine that should join:")
    print(color("  sudo genesi-mesh join %s" % secret.decode(), CYAN))
    reload_daemon()
    return 0


def cmd_show_secret():
    if not need_root("show-secret"):
        return 1
    secret = mesh.read_secret()
    if not secret:
        print(color("No mesh here yet — run `sudo genesi-mesh init`.", YELLOW))
        return 1
    print(secret.decode())
    return 0


def cmd_join(value):
    if not need_root("join <secret>"):
        return 1
    if not value or len(value.strip()) < 32:
        print(color("That does not look like a mesh secret.", RED))
        print("Get it from a machine already in the mesh: "
              "sudo genesi-mesh show-secret")
        return 1
    mesh.install_secret(value)
    print(color("Joined. Peers should appear within a few seconds.", GREEN))
    print("Share this machine's GPU too with: sudo genesi-mesh worker on")
    reload_daemon()
    return 0


def cmd_worker(arg):
    if arg not in ("on", "off"):
        print("usage: genesi-mesh worker on|off")
        return 2
    if not need_root("worker %s" % arg):
        return 1
    if arg == "on":
        caps = mesh.rpc_supported()
        if not caps["rpc_server"]:
            print(color("Cannot enable: `rpc-server` is not installed.", RED))
            print("Run `genesi-mesh doctor` for how to fix it.")
            return 1
        conf = mesh.load_conf()
        if conf.get("rpc_bind", "127.0.0.1") in ("127.0.0.1", "localhost"):
            # Sharing a GPU only means something off-box, so flip the bind for
            # the user — but say so explicitly, because it is a real exposure.
            set_conf("rpc_bind", "0.0.0.0")
            print(color("Note: rpc_bind set to 0.0.0.0 so peers can reach this "
                        "GPU.", YELLOW))
            print(color("      rpc-server has NO authentication. Only do this "
                        "on a network you control.", YELLOW))
    set_conf("worker", arg)
    reload_daemon()
    print(color("worker %s" % arg, GREEN))
    return 0


def _model_size_gb(arg):
    """Accept either a path to a .gguf or a bare number of gigabytes, so this is
    useful both for a model you have and one you are only considering."""
    if arg is None:
        return 0.0
    if os.path.exists(arg):
        try:
            return os.path.getsize(arg) / (1024 ** 3)
        except OSError:
            return 0.0
    try:
        return float(str(arg).lower().rstrip("gb").strip())
    except ValueError:
        return 0.0


def cmd_plan(arg):
    size = _model_size_gb(arg)
    if size <= 0:
        print("usage: genesi-mesh plan <model.gguf|SIZE_IN_GB>")
        return 2
    conf = mesh.load_conf()
    gpu = mesh.probe_gpu()
    decision = mesh.plan_pool(gpu, mesh.read_peers(), size,
                              pool_integrated=mesh.conf_flag(conf, "pool_integrated"))

    print(color("Model %.1f GB" % size, BOLD))
    if gpu.get("integrated"):
        # Say it, or the 0.0 GB budget below looks like a detection failure.
        print(color("  this machine's GPU is integrated (%s) — its memory is "
                    "system RAM," % (gpu.get("name") or "?"), YELLOW))
        print(color("  so it counts as 0 dedicated VRAM. That is what lets the "
                    "mesh step in.", YELLOW))
    print("  local VRAM budget:  %.1f GB" % decision["local_gb"])
    print("  pooled across mesh: %.1f GB" % decision["pooled_gb"])
    for host in decision.get("skipped_integrated", []):
        print(color("  skipped %s (integrated graphics)" % host, DIM))
    print()
    if decision["use_mesh"]:
        print(color("  → use the mesh", GREEN))
        print("    %s" % decision["reason"])
        print("    endpoints: %s" % ", ".join(decision["endpoints"]))
    else:
        print(color("  → run locally", CYAN))
        print("    %s" % decision["reason"])
    return 0


def cmd_selftest():
    """Prove the whole RPC path on ONE machine.

    This is not a mock: it starts a real `rpc-server`, connects a real client
    socket to it, and reports what llama.cpp itself sees. The only thing a
    second machine adds is the network hop — so if this passes, a peer that
    shows up in `genesi-mesh peers` will work."""
    caps = mesh.rpc_supported()
    ok = True

    print(color("Genesi Mesh selftest", BOLD))

    print("  rpc-server binary  ... ", end="")
    if caps["rpc_server"]:
        print(color("ok", GREEN))
    else:
        print(color("MISSING", RED))
        ok = False

    print("  llama-server --rpc ... ", end="")
    if caps["rpc_flag"]:
        print(color("ok", GREEN))
    else:
        print(color("MISSING", RED))
        ok = False

    if not ok:
        print()
        print("The installed llama.cpp was built without the RPC backend.")
        print("Run `genesi-mesh doctor` for the fix.")
        return 1

    binp = mesh.rpc_server_bin()
    port = mesh.conf_int(mesh.load_conf(), "rpc_port", mesh.DEFAULT_RPC_PORT) + 1
    print("  starting rpc-server on 127.0.0.1:%d ... " % port, end="", flush=True)
    try:
        proc = subprocess.Popen([binp, "-H", "127.0.0.1", "-p", str(port)],
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True)
    except OSError as exc:
        print(color("failed (%s)" % exc, RED))
        return 1

    try:
        # Poll rather than sleep a fixed amount: loading the backend can take a
        # moment on a cold GPU, and a fixed sleep would either be flaky or slow.
        deadline = time.time() + 25
        connected = False
        while time.time() < deadline:
            if proc.poll() is not None:
                break
            try:
                with socket.create_connection(("127.0.0.1", port), timeout=1):
                    connected = True
                    break
            except OSError:
                time.sleep(0.4)

        if connected:
            print(color("ok", GREEN))
            print()
            print(color("  PASS — this machine can serve its GPU to the mesh.",
                        GREEN))
            print(color("  Add a second machine and `genesi-mesh peers` will "
                        "show it.", DIM))
            return 0

        print(color("failed", RED))
        if proc.poll() is not None:
            out = (proc.stdout.read() if proc.stdout else "") or ""
            for line in out.strip().splitlines()[-8:]:
                print("    %s" % line)
        return 1
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=8)
            except subprocess.TimeoutExpired:
                proc.kill()


def cmd_doctor():
    caps = mesh.rpc_supported()
    gpu = mesh.probe_gpu()
    conf = mesh.load_conf()
    problems = []

    print(color("Genesi Mesh doctor", BOLD))
    print()

    print("llama.cpp RPC backend")
    print("  rpc-server binary:     %s"
          % (color("found", GREEN) if caps["rpc_server"] else color("missing", RED)))
    print("  llama-server --rpc:    %s"
          % (color("supported", GREEN) if caps["rpc_flag"] else color("missing", RED)))
    if not (caps["rpc_server"] and caps["rpc_flag"]):
        problems.append(
            "Install a llama.cpp built with GGML_RPC=ON:\n"
            "    sudo pacman -Syu genesi-llama-cpp        # Vulkan, any GPU\n"
            "    sudo pacman -Syu genesi-llama-cpp-cuda   # NVIDIA + CUDA\n"
            "  (genesi-llama-cpp >= 4 / genesi-llama-cpp-cuda >= 2 enable it.)")

    print()
    print("This machine")
    print("  GPU:                   %s, %d MiB" % (gpu["backend"], gpu["vram_mb"]))
    if gpu["vram_mb"] == 0:
        problems.append(
            "No GPU detected. This machine can still USE a mesh, but it has "
            "nothing to contribute as a worker.")

    print()
    print("Mesh membership")
    has_secret = mesh.read_secret() is not None
    print("  secret:                %s"
          % (color("present", GREEN) if has_secret else color("absent", YELLOW)))
    if not has_secret:
        problems.append(
            "No mesh yet. On the first machine: sudo genesi-mesh init\n"
            "  On every other machine:  sudo genesi-mesh join <secret>")

    print("  worker mode:           %s"
          % ("on" if mesh.conf_flag(conf, "worker") else "off"))
    print("  rpc bind:              %s:%s"
          % (conf.get("rpc_bind"), conf.get("rpc_port")))

    print()
    print("Daemon")
    state = read_state()
    if state and (time.time() - (state.get("updated") or 0)) < 10:
        print("  genesi-meshd:          %s" % color("running", GREEN))
    else:
        print("  genesi-meshd:          %s" % color("not running", YELLOW))
        problems.append("Start it: sudo systemctl enable --now genesi-meshd")

    print()
    if problems:
        print(color("Issues found:", YELLOW))
        for i, p in enumerate(problems, 1):
            print("  %d. %s" % (i, p))
        return 1
    print(color("Everything checks out.", GREEN))
    return 0


USAGE = __doc__


def main(argv):
    # This output contains a few non-ASCII glyphs (→). Under a POSIX/C locale
    # stdout is ASCII and printing one raises UnicodeEncodeError, killing the
    # command over pure decoration — which is easy to hit from systemd, a
    # minimal shell, or a cron-ish context where LANG is unset. Degrade the
    # glyph instead of the command.
    try:
        sys.stdout.reconfigure(errors="replace")
    except (AttributeError, ValueError):
        pass

    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd, rest = argv[1], argv[2:]
    arg = rest[0] if rest else None

    handlers = {
        "status": lambda: cmd_status(),
        "peers": lambda: cmd_peers(),
        "init": lambda: cmd_init(),
        "show-secret": lambda: cmd_show_secret(),
        "join": lambda: cmd_join(arg),
        "worker": lambda: cmd_worker(arg),
        "plan": lambda: cmd_plan(arg),
        "selftest": lambda: cmd_selftest(),
        "doctor": lambda: cmd_doctor(),
    }
    handler = handlers.get(cmd)
    if not handler:
        print("unknown command: %s\n" % cmd)
        print(USAGE)
        return 2
    return handler()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
