def cmd_peer(addr):
    """Register a peer to beacon DIRECTLY, for networks multicast cannot cross.

    A VPN carries unicast perfectly well and drops multicast, so naming the far
    machine here is all discovery needs to start working across one."""
    if not addr:
        print("usage: genesi-mesh peer <address>    (e.g. the peer's Tailscale IP)")
        return 2
    if not need_root("peer %s" % addr):
        return 1
    conf = mesh.load_conf()
    have = [a for a in str(conf.get("peers", "") or "").replace(",", " ").split()]
    if addr in have:
        print(color("%s is already listed." % addr, DIM))
        return 0
    have.append(addr)
    set_conf("peers", ", ".join(have))
    reload_daemon()
    print(color("Added %s. It should appear in `genesi-mesh peers` within a few "
                "seconds," % addr, GREEN))
    print(color("once the same is done on the other machine.", GREEN))
    return 0


def cmd_worker(arg):
    if arg not in ("on", "off"):
        print("usage: genesi-mesh worker on|off")
        return 2
    if not need_root("worker %s" % arg):
        return 1
    if arg == "on":
        caps = mesh.rpc_supported()
        if not caps["rpc_server"]:
            print(color("Cannot enable: `rpc-server` is not installed.", RED))
            print("Run `genesi-mesh doctor` for how to fix it.")
            return 1
        conf = mesh.load_conf()
        if conf.get("rpc_bind", "127.0.0.1") in ("127.0.0.1", "localhost"):
            # Sharing a GPU only means something off-box, so flip the bind for
            # the user — but say so explicitly, because it is a real exposure.
            set_conf("rpc_bind", "0.0.0.0")
            print(color("Note: rpc_bind set to 0.0.0.0 so peers can reach this "
                        "GPU.", YELLOW))
            print(color("      rpc-server has NO authentication. Only do this "
                        "on a network you control.", YELLOW))
    set_conf("worker", arg)
    reload_daemon()
    print(color("worker %s" % arg, GREEN))
    return 0


def cmd_serve(arg):
    """Offer this machine's Turbo to the mesh — the other way to share a GPU.

    `worker` shares this machine's VRAM: peers run their OWN llama-server and
    stream layer activations here for every token, so the far GPU spends most of
    its time waiting on the network. That is the price of running a model that
    fits on no single machine, and it is worth paying only for that.

    `serve` shares the whole inference server instead. Peers send text and get
    text back, so a model that FITS here runs at full GPU speed no matter how
    slow the link is. It is the right default whenever the model fits, which is
    why doctor points at it.

    Turbo itself belongs to genesi-ai-mode, so the mechanics — its env file, its
    unit, its port — are delegated there. Mesh owns the DECISION to share
    compute with other machines, in one place, next to `worker`."""
    if arg not in ("on", "off"):
        print("usage: genesi-mesh serve on|off")
        return 2
    if not need_root("serve %s" % arg):
        return 1
    turbo = shutil.which("genesi-ai-turbo")
    if not turbo:
        # Same shape as `worker on` without rpc-server: refuse clearly rather
        # than half-configure something that cannot run.
        print(color("Cannot %s: Genesi Turbo is not installed." % arg, RED))
        print("      sudo pacman -S genesi-ai-mode")
        return 1
    return subprocess.run([turbo, "share", arg]).returncode


def cmd_use(arg):
    """Choose which Turbo this machine's Genesi apps talk to.

    The mirror of `serve`: that one decides what this machine OFFERS, this one
    decides what it USES. Both matter, and only the offering side existed --
    routing was automatic, which is right as a default and wrong as the only
    behaviour. Someone who wants the chat on the box in front of them, or pinned
    to one particular machine, is not misconfigured, and quietly sending them
    elsewhere is the kind of helpfulness they cannot even see to argue with."""
    opts = mesh.turbo_options()
    if not arg:
        print(color("Turbo source: %s" % opts["source"], BOLD))
        print(color("  (%s)" % opts["url"], DIM))
        print()
        for o in opts["options"]:
            mark = color("*", GREEN) if o["effective"] else " "
            model = o["model"] or color("no model reported", DIM)
            state = "" if o["available"] else color("  [not serving]", DIM)
            print("  %s %-18s %-24s %s%s"
                  % (mark, o["key"], model, color(o["url"], DIM), state))
        print()
        print("  genesi-mesh use auto      the local Turbo if there is one, "
              "else a peer's")
        print("  genesi-mesh use local     always this machine")
        print("  genesi-mesh use <peer>    always that machine")
        if opts["source"] != "auto" and not any(o["selected"] and o["effective"]
                                                for o in opts["options"]):
            print()
            print(color("  Note: `%s` is not serving Turbo right now, so this "
                        "machine is falling" % opts["source"], YELLOW))
            print(color("  back to its own. It will switch back on its own when "
                        "that peer returns.", YELLOW))
        return 0

    keys = {o["key"] for o in opts["options"]} | {"auto", "local"}
    if arg not in keys:
        print(color("Unknown Turbo source: %s" % arg, RED))
        print("Known: %s" % ", ".join(sorted(keys)))
        print("Run `genesi-mesh use` with no argument to see them.")
        return 2
    if not need_root("use %s" % arg):
        return 1
    set_conf("turbo_source", arg)
    reload_daemon()
    after = mesh.turbo_options()
    print(color("Turbo source: %s" % arg, GREEN))
    print(color("  -> %s" % after["url"], DIM))
    return 0


def _model_size_gb(arg):
    """(size_gb, how_we_found_it) for whatever the user typed.

    Accepts every form a model gets named in this OS, because `plan` is only
    useful if you can ask it about the model you actually run:

        a bare number       12  /  12GB      a model you are only considering
        a path              ./mistral.gguf   one you already have
        an ollama tag       llama3.2:3b      resolved through ollama's manifest
        gguf:<name>         gguf:qwen3       the Genesi GGUF library

    Returns (0.0, "") when nothing matches, so the caller can explain."""
    if arg is None:
        return 0.0, ""

    ref = str(arg).strip()

    # A number first: "3" is a size, not a model named 3.
    try:
        val = float(ref.lower().rstrip("b").rstrip("g").strip())
        if val > 0:
            return val, "as given"
    except ValueError:
        pass

    path = None
    if ref.startswith("gguf:"):
        path = _library_gguf(ref[5:].strip())
    elif os.path.exists(os.path.expanduser(ref)):
        path = os.path.expanduser(ref)
    elif ref.lower().endswith(".gguf"):
        path = _library_gguf(ref)
    else:
        path = _ollama_gguf(ref) or _library_gguf(ref)

    if not path:
        return 0.0, ""
    try:
        return os.path.getsize(path) / (1024 ** 3), path
    except OSError:
        return 0.0, ""


def cmd_plan(arg):
    size, found = _model_size_gb(arg)
    if size <= 0:
        if arg:
            # Say what was tried. "usage:" alone implies the argument was the
            # wrong SHAPE, when the usual truth is that the model is simply not
            # on this machine — a different problem with a different fix.
            print(color("Could not find a model called '%s'." % arg, YELLOW))
            print()
            print("Tried: a size in GB, a path, the ollama library, and the "
                  "Genesi GGUF library.")
            print("If it is an ollama model, check the exact tag with: "
                  "ollama list")
            print()
        print("usage: genesi-mesh plan <model>")
        print("  <model> is an ollama tag (llama3.2:3b), a path to a .gguf,")
        print("  gguf:<name> from the Genesi library, or a plain size in GB.")
        return 2
    conf = mesh.load_conf()
    gpu = mesh.probe_gpu()
    decision = mesh.plan_pool(gpu, mesh.read_peers(), size,
                              pool_integrated=mesh.conf_flag(conf, "pool_integrated"))

    print(color("Model %.1f GB" % size, BOLD))
    if found and found != "as given":
        # Which file was measured. With an ollama tag the answer is a blob whose
        # name carries no hint of the model, so a wrong resolution would
        # otherwise be invisible — and the verdict below is only as good as it.
        print(color("  %s" % found, DIM))
    if gpu.get("integrated"):
        # Say it, or the 0.0 GB budget below looks like a detection failure.
        print(color("  this machine's GPU is integrated (%s) — its memory is "
                    "system RAM," % (gpu.get("name") or "?"), YELLOW))
        print(color("  so it counts as 0 dedicated VRAM. That is what lets the "
                    "mesh step in.", YELLOW))
    print("  local VRAM budget:  %.1f GB" % decision["local_gb"])
    print("  pooled across mesh: %.1f GB" % decision["pooled_gb"])
    for host in decision.get("skipped_integrated", []):
        print(color("  skipped %s (integrated graphics)" % host, DIM))
    print()
    if decision["use_mesh"]:
        print(color("  → use the mesh", GREEN))
        print("    %s" % decision["reason"])
        print("    endpoints: %s" % ", ".join(decision["endpoints"]))
    else:
        print(color("  → run locally", CYAN))
        print("    %s" % decision["reason"])
    return 0


def cmd_selftest():
    """Prove the whole RPC path on ONE machine.

    This is not a mock: it starts a real `rpc-server`, connects a real client
    socket to it, and reports what llama.cpp itself sees. The only thing a
    second machine adds is the network hop — so if this passes, a peer that
    shows up in `genesi-mesh peers` will work."""
    caps = mesh.rpc_supported()
    ok = True

    print(color("Genesi Mesh selftest", BOLD))

    print("  rpc-server binary  ... ", end="")
    if caps["rpc_server"]:
        print(color("ok", GREEN))
    else:
        print(color("MISSING", RED))
        ok = False

    print("  llama-server --rpc ... ", end="")
    if caps["rpc_flag"]:
        print(color("ok", GREEN))
    else:
        print(color("MISSING", RED))
        ok = False

    if not ok:
        print()
        print("The installed llama.cpp was built without the RPC backend.")
        print("Run `genesi-mesh doctor` for the fix.")
        return 1

    binp = mesh.rpc_server_bin()
    port = mesh.conf_int(mesh.load_conf(), "rpc_port", mesh.DEFAULT_RPC_PORT) + 1
    print("  starting rpc-server on 127.0.0.1:%d ... " % port, end="", flush=True)
    try:
        proc = subprocess.Popen([binp, "-H", "127.0.0.1", "-p", str(port)],
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True)
    except OSError as exc:
        print(color("failed (%s)" % exc, RED))
        return 1

    try:
        # Poll rather than sleep a fixed amount: loading the backend can take a
        # moment on a cold GPU, and a fixed sleep would either be flaky or slow.
        deadline = time.time() + 25
        connected = False
        while time.time() < deadline:
            if proc.poll() is not None:
                break
            try:
                with socket.create_connection(("127.0.0.1", port), timeout=1):
                    connected = True
                    break
            except OSError:
                time.sleep(0.4)

        if connected:
            print(color("ok", GREEN))
            print()
            print(color("  PASS — this machine can serve its GPU to the mesh.",
                        GREEN))
            print(color("  Add a second machine and `genesi-mesh peers` will "
                        "show it.", DIM))
            return 0

        print(color("failed", RED))
        if proc.poll() is not None:
            out = (proc.stdout.read() if proc.stdout else "") or ""
            for line in out.strip().splitlines()[-8:]:
                print("    %s" % line)
        return 1
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=8)
            except subprocess.TimeoutExpired:
                proc.kill()


def cmd_doctor():
    """Check every layer between "the config looks right" and "a peer can
    actually use this GPU".

    Reading the config is not enough and never was: mesh.conf records what the
    user ASKED for, state.json records what the daemon STARTED, and a machine
    can be perfect on both while a firewall silently drops every packet. So this
    walks outward — binaries, GPU, membership, daemon, listener, firewall,
    reachability — and each section reports what is TRUE, not what was
    requested."""
    caps = mesh.rpc_supported()
    gpu = mesh.probe_gpu()
    conf = mesh.load_conf()
    state = read_state()
    problems = []

    worker_on = mesh.conf_flag(conf, "worker")
    discovery_on = mesh.conf_flag(conf, "discovery")
    bind = (conf.get("rpc_bind") or "127.0.0.1").strip()
    rpc_port = mesh.conf_int(conf, "rpc_port", mesh.DEFAULT_RPC_PORT)
    vpns = mesh.vpn_interfaces()
    vpn_iface = vpns[0] if vpns else None
    daemon_live = bool(state) and (time.time() - (state.get("updated") or 0)) < 10

    print(color("Genesi Mesh doctor", BOLD))
    print()

    print("llama.cpp RPC backend")
    print("  rpc-server binary:     %s"
          % (color("found", GREEN) if caps["rpc_server"] else color("missing", RED)))
    print("  llama-server --rpc:    %s"
          % (color("supported", GREEN) if caps["rpc_flag"] else color("missing", RED)))
    llama = mesh.llama_build()
    print("  build:                 %s"
          % (("%s (RPC protocol v%s, %s ops)"
              % (llama.get("build") or "?", llama.get("proto") or "?",
                 llama.get("ops") or "?"))
             if any(llama.values()) else color("unknown", YELLOW)))
    if not (caps["rpc_server"] and caps["rpc_flag"]):
        problems.append(
            "Install a llama.cpp built with GGML_RPC=ON:\n"
            "    sudo pacman -Syu genesi-llama-cpp        # Vulkan, any GPU\n"
            "    sudo pacman -Syu genesi-llama-cpp-cuda   # NVIDIA + CUDA\n"
            "  (genesi-llama-cpp >= 4 / genesi-llama-cpp-cuda >= 2 enable it.)")

    print()
    print("This machine")
    print("  GPU:                   %s, %d MiB%s"
          % (gpu["backend"], gpu["vram_mb"], _free_note(gpu)))
    if worker_on and isinstance(gpu.get("free_mb"), (int, float)) \
            and gpu["free_mb"] / 1024.0 - mesh.GPU_OVERHEAD_GB <= 0:
        problems.append(
            "worker is ON but only %d MiB of VRAM is free, so a peer has "
            "nothing to\n  allocate here — pooling will be skipped, or fail at "
            "load time if forced.\n  Something on THIS machine is using the "
            "GPU it is offering (check nvidia-smi);\n  a local llama-server or "
            "ollama model is the usual culprit." % int(gpu["free_mb"]))
    if gpu["vram_mb"] == 0:
        problems.append(
            "No GPU detected. This machine can still USE a mesh, but it has "
            "nothing to contribute as a worker.")

    # Turbo-over-HTTP versus pooling. A machine with a real GPU almost always
    # wants to be the one SERVING, and that is not discoverable from anywhere
    # else — a user who found `worker on` has no reason to suspect a better
    # option exists, and pooling a model that fits is the slower path.
    print("  serving Turbo:         %s"
          % (color("yes — peers use this GPU over HTTP", GREEN)
             if mesh.turbo_reachable()
             else color("no (loopback only)", DIM)))
    if not mesh.turbo_reachable() and gpu["vram_mb"] > 0 \
            and not gpu.get("integrated"):
        print(color("     Peers with no GPU could run models HERE instead of "
                    "pooling this card:", DIM))
        print(color("         sudo genesi-mesh serve on", CYAN))
        print(color("     Prefer that whenever the model FITS on this machine "
                    "— pooling ships", DIM))
        print(color("     layer activations per token, HTTP ships text.", DIM))

    print()
    print("Mesh membership")
    secret = _secret_state()
    print("  secret:                %s"
          % {"present": color("present", GREEN),
             "absent": color("absent", DIM),
             "unreadable": color("present", GREEN)
                + color(" (0600 root — run doctor with sudo to verify it)",
                        DIM)}[secret])
    if secret != "absent":
        pass
    elif not vpns:
        problems.append(
            "No mesh yet. On the first machine: sudo genesi-mesh init\n"
            "  On every other machine:  sudo genesi-mesh join <secret>")
    else:
        # Over a VPN the secret would authenticate a discovery that cannot
        # happen anyway. Calling it a problem sends the user to fix something
        # that is not broken, which buries the thing that is.
        print(color("     (not needed here: it only authenticates multicast "
                    "discovery, which a VPN cannot carry)", DIM))

    print("  worker mode:           %s" % ("on" if worker_on else "off"))
    print("  rpc bind:              %s:%d" % (bind, rpc_port))
    if worker_on and bind in ("127.0.0.1", "localhost", "::1"):
        problems.append(
            "worker is ON but rpc_bind is %s, so the GPU is offered to this\n"
            "  machine only — no peer can ever reach it. Fix:\n"
            "      sudo genesi-mesh worker on      (sets rpc_bind = 0.0.0.0)" % bind)

    print()
    print("Daemon")
    print("  genesi-meshd:          %s"
          % (color("running", GREEN) if daemon_live else color("not running", RED)))
    if not daemon_live:
        problems.append("Start it: sudo systemctl enable --now genesi-meshd")

    # ── is the GPU actually being served? ────────────────────────────────────
    #
    # "worker mode: on" is a config line. Whether rpc-server survived startup is
    # a different question, and a worker that dies on every launch looks
    # identical to a healthy one from the outside. Check the process, the
    # socket, AND which device it actually ended up serving.
    if worker_on:
        print()
        print("Worker service")
        if not daemon_live:
            print("  rpc-server process:    %s"
                  % color("unknown (daemon not running)", YELLOW))
        elif state.get("worker_crash_looping"):
            print("  rpc-server process:    %s"
                  % color("crash-looping (%d restarts in the last 2 min)"
                          % state.get("worker_restarts", 0), RED))
            problems.append(
                "rpc-server keeps dying and being restarted. A peer that "
                "connects gets the\n  connection dropped mid-load, which looks "
                "like a hang on its end. The reason\n  is in the daemon's log "
                "and in %s:\n"
                "      sudo journalctl -u genesi-meshd -n 50\n"
                "      sudo tail -n 20 %s\n"
                "  If it exited on signal 4 (SIGILL) the llama.cpp package was "
                "built for a\n  newer CPU than this one and must be rebuilt or "
                "reinstalled."
                % (mesh.WORKER_LOG, mesh.WORKER_LOG))
        elif state.get("worker_running"):
            print("  rpc-server process:    %s" % color("running", GREEN))
        else:
            print("  rpc-server process:    %s" % color("NOT running", RED))
            problems.append(
                "worker is ON but rpc-server is not running. Its own output is "
                "kept at\n  %s, and the daemon's reason is in the journal:\n"
                "      sudo journalctl -u genesi-meshd -n 50\n"
                "  A `genesi-mesh selftest` reproduces the launch on its own."
                % mesh.WORKER_LOG)

        listening, connected = _socket_state(rpc_port)
        if connected:
            # The best possible state, and the one a naive probe misreads as a
            # dead port. Report it and probe nothing.
            print("  port %-17s %s"
                  % ("%d:" % rpc_port,
                     color("serving %s" % ", ".join(sorted(set(connected))),
                           GREEN)))
            print(color("     A peer is using this GPU right now. rpc-server "
                        "takes one client at a", DIM))
            print(color("     time, so further connections wait — that is "
                        "normal, not a fault.", DIM))
        elif listening:
            print("  port %-17s %s"
                  % ("%s:%d:" % (bind, rpc_port), color("listening", GREEN)))
            # Say this out loud or the green line above becomes false comfort.
            # The socket being open locally says nothing about whether a packet
            # from another machine survives the firewall — and a connection from
            # this host to its OWN vpn/LAN address takes the loopback path, so
            # even that would not test it. Only the peer can answer this.
            print(color("     (local check — proves the listener exists, not "
                        "that a peer can reach it)", DIM))
        else:
            print("  port %-17s %s"
                  % ("%s:%d:" % (bind, rpc_port), color("NOT open", RED)))
            if daemon_live and state.get("worker_running"):
                problems.append(
                    "rpc-server is running but nothing is listening on %d. It "
                    "may still be\n  initialising the GPU — retry in a few "
                    "seconds — or it failed after start:\n"
                    "      sudo journalctl -u genesi-meshd -n 50" % rpc_port)

        # WHICH device is being served. rpc-server takes every non-CPU device it
        # can find and falls back to the CPU only when it finds none — and that
        # fallback is silent. A worker in that state accepts the connection,
        # loads the weights and computes every offloaded layer on its CPU, over
        # the network: strictly slower than the client not meshing at all. From
        # the outside it is indistinguishable from a healthy worker; the only
        # symptom is the far machine's CPU pinned while its GPU sits idle.
        devs = mesh.worker_devices()
        if not devs:
            print("  serving device:        %s"
                  % color("unknown (no banner yet)", DIM))
            print(color("     (rpc-server logs its device on startup; restart "
                        "the daemon to capture it)", DIM))
        elif all(d["is_cpu"] for d in devs):
            print("  serving device:        %s"
                  % color("CPU — %s" % devs[0]["desc"], RED))
            problems.append(
                "rpc-server is serving the CPU, not a GPU. It only does that "
                "when it can\n  find no accelerator, so the GPU backend failed "
                "to load. A peer using this\n  worker gets network-attached CPU "
                "inference — slower than no mesh at all.\n"
                "  Check what the backend sees (the last lines name each "
                "backend loaded):\n"
                "      %s -d __probe__\n"
                "  A CUDA build needs its runtime on the loader path "
                "(/opt/cuda/lib64 via\n  ld.so.conf.d); a Vulkan build needs a "
                "working ICD (`vulkaninfo --summary`)."
                % (mesh.rpc_server_bin() or "ggml-rpc-server"))
        else:
            for d in devs:
                print("  serving device:        %s"
                      % color("%s — %s (%d MiB free / %d MiB)"
                              % (d["name"], d["desc"], d["free_mb"],
                                 d["total_mb"]), GREEN))

    # ── the layer that reads correct and still drops everything ──────────────
    print()
    print("Firewall")
    active = [u for u in FIREWALL_UNITS if _unit_active(u)]
    needed = _needed_ports(worker_on, rpc_port, discovery_on)

    if not active:
        print("  active manager:        %s" % color("none", GREEN))
        print(color("     (nothing is filtering — no ports to open)", DIM))
    else:
        print("  active manager:        %s" % color(", ".join(active), CYAN))

    # The trap that costs the most time: rules applied to a firewall that is not
    # running. `ufw allow` succeeds, writes the rule, prints "Rules updated",
    # and filters nothing, because a different firewall owns the ruleset. The
    # user then has written proof the port is open and a mesh that cannot
    # connect, with no way to reconcile the two.
    ufw_trap = "ufw" not in active and _ufw_has_rules()
    if ufw_trap:
        print("  ufw:                   %s"
              % color("INACTIVE, but has rules on disk", YELLOW))

    if needed:
        print()
        for proto, p, why in needed:
            print("  needs %-16s %s" % ("%d/%s" % (p, proto), color(why, DIM)))
    elif active:
        print(color("     (worker and discovery are both off — this machine "
                    "receives nothing)", DIM))

    # firewalld can be interrogated precisely, so do: an interface in no zone is
    # not unfiltered, it inherits the default zone, and that is invisible to
    # anyone reading their own rules.
    #
    # `admitted` stays None for every firewall we cannot verify (ufw needs root
    # to read its status; raw nftables rulesets cannot be judged at all). None
    # means "unknown", never "fine" — the advice below is still offered, just
    # phrased as a maybe.
    admitted = None
    fw_zone, fw_zone_is_default = None, True
    # EVERY interface a peer can arrive on, not just the VPN. A mesh whose two
    # machines sit on one LAN never touches the overlay for the bulk traffic:
    # the beacon advertises primary_address(), so the client dials the LAN IP
    # and lands on the LAN interface's zone. Checking only the VPN passed that
    # machine as healthy while the stock `public` zone (ssh + dhcpv6-client and
    # nothing else) dropped every connection to rpc-server.
    lan_iface = mesh.primary_interface()
    advice_iface = vpn_iface
    fw_targets = []
    fw_ifaces = list(vpns) + ([lan_iface] if lan_iface and lan_iface not in vpns
                              else [])
    if "firewalld" in active and needed and fw_ifaces:
        print()
        admitted = True
        blocked_zones = {}
        unsure_zones = {}
        for iface in fw_ifaces:
            zone, is_default = _firewalld_zone_for(iface)
            if iface == (vpn_iface or lan_iface):
                fw_zone, fw_zone_is_default = zone, is_default
            note = " (default zone — %s is in no zone of its own)" % iface \
                if is_default else ""
            kind = "VPN" if iface in vpns else "LAN"
            print("  %-22s %s%s" % ("%s zone (%s):" % (iface, kind), zone,
                                    color(note, DIM)))
            verdicts = [(proto, p, _firewalld_allows(zone, p, proto))
                        for proto, p, _ in needed]
            blocked = [(proto, p) for proto, p, ok in verdicts if ok is False]
            unknown = [(proto, p) for proto, p, ok in verdicts if ok is None]
            if blocked:
                admitted = False
                blocked_zones.setdefault(zone, (iface, is_default))
                print("  %-22s %s" % ("", color(
                    "zone `%s` does not admit %s" % (zone, ", ".join(
                        "%d/%s" % (p, proto) for proto, p in blocked)), RED)))
                problems.append(
                    "%s carries your peers, but firewalld filters it with zone "
                    "`%s`,\n  which drops %s. Ping still works (the default "
                    "zone allows ICMP),\n  so the link looks fine while every "
                    "mesh packet is discarded."
                    % (iface, zone, ", ".join("%d/%s" % (p, proto)
                                              for proto, p in blocked)))
            elif unknown:
                # firewalld answers --get-zone-of-interface to anyone but needs
                # privilege for --list-all, so an unprivileged doctor knows the
                # zone and NOT its contents. Printing "admits" here is the exact
                # false all-clear this whole section exists to prevent.
                if admitted is not False:
                    admitted = None
                unsure_zones.setdefault(zone, (iface, is_default))
                print("  %-22s %s" % ("", color(
                    "contents not readable without root — re-run as "
                    "`sudo genesi-mesh doctor` to verify", YELLOW)))
            else:
                print("  %-22s %s" % ("", color(
                    "admits %s" % ", ".join("%d/%s" % (p, proto)
                                            for proto, p, _ in needed), GREEN)))
        # Point the advice at whichever zone is actually blocking. With both a
        # VPN and a LAN in play these are different zones, and opening the wrong
        # one is a change that appears to work and fixes nothing.
        # Blocked zones first: if one is proven shut, that is the fix. Only
        # when nothing is proven do the unverifiable ones become the advice.
        fw_targets = list((blocked_zones or unsure_zones).items())

    # The ufw verdict has to wait until the real firewall has been checked,
    # because the same fact means two different things. With the ports open, the
    # stale rules break nothing today — but the next `ufw allow` will still
    # report success and do nothing, so it is worth saying out loud either way.
    if ufw_trap:
        others = " and ".join(active)
        # `not needed` means this node receives nothing, so no port of ours is
        # closed and the stale rules cannot be the cause of anything. Still
        # worth naming — it is a landmine for the next time worker mode goes on.
        if admitted is True or not needed:
            print()
            print(color("  Note: ufw is not running, so its rules in "
                        "/etc/ufw/user.rules are inert.", DIM))
            print(color("  Nothing is broken — %s is what opened the ports "
                        "above — but any future" % others, DIM))
            print(color("  `sudo ufw allow ...` will report success and change "
                        "nothing. Use %s." % others, DIM))
        else:
            problems.append(
                "ufw has rules but is not running%s.\n"
                "  Every `sudo ufw allow ...` you ran reported success and "
                "changed NOTHING —\n  the rules sit in /etc/ufw/user.rules "
                "unenforced. Re-apply them to the\n  firewall that is actually "
                "running, or enable ufw instead:\n"
                "      sudo systemctl enable --now ufw"
                % ((", while %s is" % others) if active else ""))

    # Only walk the user through opening ports that are not already open.
    # Printing "To open them: ..." under a verified-correct firewall reads as an
    # instruction to change something that works — and here it would have talked
    # them out of a deliberately narrow zone and into a blanket one.
    if needed and active and admitted is not True:
        for manager in active:
            # One block per zone that needs opening. A machine with the mesh on
            # a VPN AND on the LAN has two different zones filtering it, and
            # opening only the first leaves half the paths shut — which reads as
            # "I already did that" the next time it fails.
            targets = fw_targets if manager == "firewalld" and fw_targets \
                else [(fw_zone, (advice_iface, fw_zone_is_default))]
            for zone, (iface, is_default) in targets:
                # _open_port_commands only offers the "trust the whole
                # interface" shortcut for an overlay: safe there, wrong on a LAN.
                cmds, note = _open_port_commands(
                    manager, needed, iface if iface in vpns else None,
                    zone, is_default)
                if not cmds and not note:
                    continue
                print()
                print("  %s under %s%s:"
                      % ("To open them" if admitted is False
                         else "If they are not open yet", color(manager, CYAN),
                         (" for %s" % iface) if iface else ""))
                for cmd in cmds:
                    print(color("      %s" % cmd, CYAN))
                if note:
                    print(color("      %s" % note, DIM))
        if discovery_on:
            print(color("  Run this on BOTH machines — %d/udp is needed on each "
                        "side for peers to\n  find each other."
                        % mesh.DISCOVERY_PORT, DIM))

    # ── discovery and peers ──────────────────────────────────────────────────
    print()
    print("Discovery")
    print("  multicast discovery:   %s" % ("on" if discovery_on else "off"))
    static = mesh.static_peers(conf)
    peers = mesh.read_peers()
    print("  peers seen:            %d" % len(peers))

    seen_addrs = {p.get("addr") for p in peers}
    missing = [host for host, _ in static if host not in seen_addrs]

    if vpns and static and not missing:
        # Everything registered is answering, so state the structural fact
        # without the call to action — telling a working setup to go configure
        # peers reads as "still broken" when it is not.
        print(color("     A VPN interface is up (%s). Multicast cannot cross "
                    "it; the peers" % ", ".join(vpns), DIM))
        print(color("     below work because they are registered explicitly, "
                    "which is the fix.", DIM))
    elif vpns:
        print(color("     A VPN interface is up (%s). Discovery is UDP "
                    "multicast and no VPN" % ", ".join(vpns), YELLOW))
        print(color("     forwards it, so peers there will NEVER appear on "
                    "their own. Register", DIM))
        print(color("     each one explicitly, on BOTH machines:", DIM))
        print(color("         sudo genesi-mesh peer <their-vpn-ip>", CYAN))

    if static:
        print()
        print("  registered peers:")
        for host, _port in static:
            # A TCP probe of their RPC port separates the two very different
            # reasons a registered peer never shows up. "refused" means the host
            # is reachable and nothing filters — so the silence is on their end
            # (no `genesi-mesh peer` back at us, or discovery off). "blocked"
            # means packets are being dropped and no amount of config will help.
            seen = host in seen_addrs
            result = "open" if seen else _probe_tcp(host, mesh.DEFAULT_RPC_PORT,
                                                    timeout=3.0)
            if seen:
                verdict = color("in the peer table", GREEN)
            elif result == "open":
                verdict = color("reachable, but no beacon received — run "
                                "`sudo genesi-mesh peer` on THAT machine too",
                                YELLOW)
            elif result == "refused":
                verdict = color("reachable (no worker there), but no beacon — "
                                "run `sudo genesi-mesh peer` on THAT machine "
                                "too", YELLOW)
            else:
                verdict = color("NOT reachable (%s) — firewall or VPN" % result,
                                RED)
            print("    %-18s %s" % (host, verdict))
            if not seen and result in ("blocked", "unreachable"):
                problems.append(
                    "peer %s is registered but unreachable. Check that machine's "
                    "firewall\n  (same commands as above) and that it is up on "
                    "the VPN." % host)
            elif not seen:
                problems.append(
                    "peer %s is reachable but has never beaconed. Registration is "
                    "per-machine:\n  run `sudo genesi-mesh peer %s` on THAT "
                    "machine as well, and confirm\n  UDP %d is open there."
                    % (host, mesh.primary_address(), mesh.DISCOVERY_PORT))
    elif not peers and not discovery_on:
        problems.append(
            "discovery is off and no peers are registered, so this node will "
            "never find\n  anyone. Either set `discovery = on` in %s,\n"
            "  or name peers directly: sudo genesi-mesh peer <address>"
            % mesh.CONF_PATH)

    # Version pairing, against every live peer. This failure is invisible until
    # it has cost someone an hour: the handshake succeeds, the weights transfer,
    # and THEN the load hangs with nothing printed on either end.
    for peer in peers:
        compatible, note = mesh.rpc_compatibility(llama, mesh.peer_llama(peer))
        if not note:
            continue
        name = peer.get("host", "?")
        if compatible:
            print()
            print(color("  note: %s — %s" % (name, note), YELLOW))
        else:
            problems.append(
                "cannot pool with %s: %s.\n  Install the same llama.cpp build on "
                "both machines." % (name, note))

    print()
    if problems:
        print(color("Issues found:", YELLOW))
        for i, p in enumerate(problems, 1):
            print("  %d. %s" % (i, p))
        return 1
    print(color("Everything checks out.", GREEN))
    if worker_on:
        # Address the peer would actually reach us on, not the LAN one — over a
        # VPN those differ, and only the peer's view of us is worth testing.
        known = [h for h, _ in static] or sorted(seen_addrs - {None})
        addr = (_source_address_for(known[0]) if known else None) \
            or mesh.primary_address()
        print(color("Note: everything above was checked from this machine, "
                    "which cannot see its", DIM))
        print(color("own firewall. To prove the path end to end, run this on "
                    "the peer:", DIM))
        print(color("    nc -vz %s %d" % (addr, rpc_port), CYAN))
    return 0


USAGE = __doc__


def main(argv):
    # This output contains a few non-ASCII glyphs (→). Under a POSIX/C locale
    # stdout is ASCII and printing one raises UnicodeEncodeError, killing the
    # command over pure decoration — which is easy to hit from systemd, a
    # minimal shell, or a cron-ish context where LANG is unset. Degrade the
    # glyph instead of the command.
    try:
        sys.stdout.reconfigure(errors="replace")
    except (AttributeError, ValueError):
        pass

    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd, rest = argv[1], argv[2:]
    arg = rest[0] if rest else None

    handlers = {
        "status": lambda: cmd_status(),
        "peers": lambda: cmd_peers(),
        "init": lambda: cmd_init(),
        "show-secret": lambda: cmd_show_secret(),
        "join": lambda: cmd_join(arg),
        "peer": lambda: cmd_peer(arg),
        "worker": lambda: cmd_worker(arg),
        "plan": lambda: cmd_plan(arg),
        "selftest": lambda: cmd_selftest(),
        "doctor": lambda: cmd_doctor(),
        "serve": lambda: cmd_serve(arg),
        "use": lambda: cmd_use(arg),
    }
    handler = handlers.get(cmd)
    if not handler:
        print("unknown command: %s\n" % cmd)
        print(USAGE)
        return 2
    return handler()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
