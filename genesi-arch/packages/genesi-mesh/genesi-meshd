#!/usr/bin/env python3
"""genesi-meshd — the Genesi Mesh node daemon.

Runs on every machine that participates in a mesh and does exactly three things:

  1. ANNOUNCE  — multicast a signed beacon describing this machine's GPU.
  2. DISCOVER  — collect peers' beacons into /run/genesi-mesh/peers.json, which
                 genesi-ai-turbo reads when deciding whether to pool.
  3. SERVE     — when worker mode is on, supervise a llama.cpp `rpc-server` so
                 this machine's GPU is usable by a peer running the model.

Deliberately NOT here: anything that touches inference itself. The daemon never
loads a model and never proxies tokens — llama.cpp's own RPC transport does
that, directly between the two machines. Keeping the daemon out of the data path
means a daemon restart cannot interrupt a running generation.

Config lives at /etc/genesi-mesh/mesh.conf and is re-read on SIGHUP, so
`genesi-mesh worker on` takes effect without dropping the peer table.
"""

import os
import shutil
import signal
import socket
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/genesi-mesh")
import genesi_mesh_common as mesh   # noqa: E402


# A worker exiting when its client disconnects is normal and expected. Several
# exits inside one short window is a crash loop -- the process is dying on its
# own, faster than any real session could end. Sized so a legitimate burst of
# short client runs does not trip it, while a worker that cannot survive its own
# startup (SIGILL from a package built for a newer CPU, a missing GPU backend)
# is caught within about a minute.
WORKER_CRASH_WINDOW = 120.0
WORKER_CRASH_RESTARTS = 5


class Daemon:
    def __init__(self):
        self.conf = mesh.load_conf()
        self.secret = mesh.read_secret()
        self.gpu = mesh.probe_gpu()
        self.caps = mesh.rpc_supported()
        # Static for the life of the process: a llama.cpp upgrade replaces the
        # binaries, and the daemon is restarted by the package hook anyway.
        self.llama = mesh.llama_build()
        self.peers = {}              # node id -> peer record
        self.worker_proc = None
        self.worker_restarts = []    # timestamps, trimmed to the crash window
        self.running = True
        self.reload_pending = False
        self.node = mesh.node_id()

    # ── lifecycle ────────────────────────────────────────────────────────────

    def handle_term(self, *_):
        self.running = False

    def handle_hup(self, *_):
        # Only set a flag: the handler runs on the main thread between socket
        # timeouts, and doing config/process work inside a signal handler risks
        # re-entering subprocess machinery mid-call.
        self.reload_pending = True

    def reload(self):
        self.reload_pending = False
        old_worker = mesh.conf_flag(self.conf, "worker")
        self.conf = mesh.load_conf()
        self.secret = mesh.read_secret()
        new_worker = mesh.conf_flag(self.conf, "worker")
        if old_worker != new_worker:
            self.log("worker mode -> %s" % ("on" if new_worker else "off"))
            if new_worker:
                self.start_worker()
            else:
                self.stop_worker()

    def log(self, msg):
        # journald captures stdout; keep it single-line and greppable.
        print("[genesi-meshd] %s" % msg, flush=True)

    # ── worker (rpc-server) supervision ──────────────────────────────────────

    def start_worker(self):
        if self.worker_proc and self.worker_proc.poll() is None:
            return
        binp = mesh.rpc_server_bin()
        if not binp:
            self.log("worker requested but no RPC server binary was found "
                     "(looked for %s) — install a llama.cpp built with "
                     "GGML_RPC=ON" % ", ".join(mesh.RPC_SERVER_NAMES))
            return

        bind = self.conf.get("rpc_bind", "127.0.0.1").strip() or "127.0.0.1"
        port = mesh.conf_int(self.conf, "rpc_port", mesh.DEFAULT_RPC_PORT)
        cmd = [binp, "-H", bind, "-p", str(port)]

        mem_mb = mesh.conf_int(self.conf, "rpc_mem_mb", 0)
        if mem_mb > 0:
            cmd += ["-m", str(mem_mb)]

        # rpc-server writes its banner with plain printf(3), which switches to
        # 4 KB block buffering the moment stdout is a file instead of a tty. The
        # banner is a few hundred bytes, so it would sit in the child's buffer
        # for the entire life of the process and the log would read as empty for
        # exactly as long as it was useful. stdbuf forces line buffering.
        stdbuf = shutil.which("stdbuf")
        if stdbuf:
            cmd = [stdbuf, "-oL", "-eL"] + cmd

        if bind not in ("127.0.0.1", "localhost", "::1"):
            # Say this loudly and every time. rpc-server does no authentication
            # and no input validation, so a LAN bind is a real exposure and the
            # operator should be reminded whenever it is in effect.
            self.log("WARNING: rpc-server is bound to %s (LAN-visible). It has "
                     "NO authentication — only do this on a network you control."
                     % bind)

        # Keep rpc-server's output. Its startup banner names the DEVICE it is
        # serving, and that is the one fact that separates a worker which
        # offloads to the GPU from one that quietly fell back to the CPU and is
        # now doing network-attached CPU inference -- slower than no mesh at
        # all. DEVNULL threw exactly that away, so a worker pegged at 100% CPU
        # with an idle GPU looked identical to a healthy one from every tool we
        # ship. Truncated per start: only the current run is ever of interest.
        try:
            os.makedirs(mesh.RUN_DIR, mode=0o755, exist_ok=True)
            logfh = open(mesh.WORKER_LOG, "w", encoding="utf-8")
        except OSError as exc:
            self.log("worker log unavailable (%s) — starting without it" % exc)
            logfh = None

        try:
            self.worker_proc = subprocess.Popen(
                cmd,
                stdout=logfh or subprocess.DEVNULL,
                stderr=subprocess.STDOUT if logfh else subprocess.DEVNULL)
            self.log("worker up: %s" % " ".join(cmd))
        except OSError as exc:
            self.worker_proc = None
            self.log("worker failed to start: %s" % exc)
        finally:
            # The child holds its own dup of the fd; ours would otherwise leak
            # one per restart, and a supervised worker restarts on every client
            # disconnect.
            if logfh is not None:
                logfh.close()

    def stop_worker(self):
        if not self.worker_proc:
            return
        if self.worker_proc.poll() is None:
            self.worker_proc.terminate()
            try:
                self.worker_proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.worker_proc.kill()
                self.worker_proc.wait(timeout=5)
        self.worker_proc = None
        self.log("worker stopped")

    def supervise_worker(self):
        """Restart a worker that died. rpc-server exits on some client
        disconnects, which is normal — it must come back for the next run
        rather than leaving the machine silently out of the mesh."""
        if not mesh.conf_flag(self.conf, "worker"):
            return
        if self.worker_proc is None or self.worker_proc.poll() is not None:
            if self.worker_proc is not None:
                rc = self.worker_proc.poll()
                # Negative = killed by a signal, and the signal is the whole
                # story: a SIGILL here means the llama.cpp build executes an
                # instruction this CPU lacks (a package compiled for a newer
                # ISA), which no amount of mesh configuration can fix.
                how = ("signal %d" % -rc) if rc is not None and rc < 0 \
                    else "exit %s" % rc
                self.worker_restarts.append(time.time())
                self.log("worker exited (%s) — restarting" % how)
            self.start_worker()

    def worker_crash_looping(self):
        """True when the worker keeps dying as fast as we restart it.

        A worker that exits when its client disconnects is NORMAL. One that
        exits seconds after every start is broken, and the difference is
        invisible from outside: at any single instant both look like "running".
        """
        now = time.time()
        self.worker_restarts = [t for t in self.worker_restarts
                                if now - t <= WORKER_CRASH_WINDOW]
        return len(self.worker_restarts) >= WORKER_CRASH_RESTARTS

    # ── discovery ────────────────────────────────────────────────────────────

    def refresh_free_vram(self):
        """Re-read free VRAM before beaconing.

        Capacity is fixed; free memory is not, and it is the number that decides
        whether a peer's allocation succeeds. Probing once at startup would
        advertise an idle card forever — including while this machine runs its
        own model on the very GPU it is offering, which is exactly when a client
        must NOT plan against it. probe_free_mb is the cheap nvidia-smi-only
        path; where it cannot measure, the field drops out of the beacon and
        peers fall back to capacity."""
        self.gpu["free_mb"] = mesh.probe_free_mb()

    def announce(self, sender):
        if not self.secret or not mesh.conf_flag(self.conf, "discovery"):
            return
        beacon = mesh.build_beacon(self.conf, self.gpu, self.llama)
        signed = mesh.sign_beacon(beacon, self.secret)
        try:
            sender.sendto(signed, (mesh.MULTICAST_GROUP, mesh.DISCOVERY_PORT))
        except OSError:
            # No route to the multicast group (NIC down, no network). Not fatal:
            # a node with no network is simply a mesh of one.
            pass
        # Unicast to any explicitly configured peers. This is what makes
        # discovery work over a VPN, where multicast is silently dropped: the
        # machines can reach each other perfectly well, just not via a group
        # address. Same signed beacon, same verification on the far side.
        for addr in mesh.static_peers(self.conf):
            try:
                sender.sendto(signed, addr)
            except OSError:
                pass

    def absorb(self, raw, addr):
        if not self.secret:
            return
        payload = mesh.verify_beacon(raw, self.secret)
        if payload is None:
            return
        if payload.get("node") == self.node:
            return                    # our own multicast loopback echo
        self.peers[payload["node"]] = {
            "node": payload["node"],
            "host": payload.get("host") or addr[0],
            "addr": addr[0],          # the source IP, never a self-reported one
            "worker": bool(payload.get("worker")),
            "rpc_port": int(payload.get("rpc_port") or mesh.DEFAULT_RPC_PORT),
            "backend": payload.get("backend") or "CPU",
            "vram_mb": int(payload.get("vram_mb") or 0),
            # Whatever llama.cpp identity the peer chose to advertise. Absent
            # keys stay absent so "unknown" never masquerades as a value.
            **{k: payload[k] for k in ("llama_build", "llama_proto", "llama_ops")
               if k in payload},
            # None, not 0, when the peer did not send it: an older node simply
            # cannot report free memory, and recording that as "0 MiB free"
            # would make every pre-upgrade peer look permanently full.
            "free_mb": (int(payload["free_mb"])
                        if isinstance(payload.get("free_mb"), (int, float))
                        else None),
            "integrated": bool(payload.get("integrated")),
            # Present only while that peer's Turbo is reachable off-box. Absent
            # means "not offering", never "offering on the default port" — a
            # guessed port is a client hanging on something that will not answer.
            **({"turbo_port": int(payload["turbo_port"])}
               if payload.get("turbo_port") else {}),
            "last_seen": time.time(),
        }

    def publish(self):
        now = time.time()
        live = {k: v for k, v in self.peers.items()
                if (now - v["last_seen"]) <= mesh.PEER_TTL}
        self.peers = live
        mesh.write_json_atomic(mesh.PEERS_PATH, {
            "updated": now,
            "peers": sorted(live.values(), key=lambda p: p["host"]),
        })
        mesh.write_json_atomic(mesh.STATE_PATH, {
            "updated": now,
            "node": self.node,
            "host": self.conf.get("name") or socket.gethostname(),
            "addr": mesh.primary_address(),
            "backend": self.gpu.get("backend"),
            "vram_mb": self.gpu.get("vram_mb"),
            # None when unmeasurable. The Monitor and the CLI both show this,
            # and it is what tells a user why a healthy-looking worker is not
            # being pooled.
            "free_mb": self.gpu.get("free_mb"),
            "gpu_name": self.gpu.get("name"),
            "integrated": bool(self.gpu.get("integrated")),
            "worker": mesh.conf_flag(self.conf, "worker"),
            "worker_running": bool(self.worker_proc
                                   and self.worker_proc.poll() is None),
            # "running" is a snapshot, and a crash loop passes that test at
            # every single instant while giving a peer nothing. Publish the
            # restart rate so the CLI can tell the two apart.
            "worker_restarts": len(self.worker_restarts),
            "worker_crash_looping": self.worker_crash_looping(),
            "rpc_bind": self.conf.get("rpc_bind"),
            "rpc_port": mesh.conf_int(self.conf, "rpc_port",
                                      mesh.DEFAULT_RPC_PORT),
            # Whether THIS machine is offering Turbo over HTTP, and where the
            # local clients should be sending inference. Published so the CLI
            # and the Monitor can show it without re-deriving the rule.
            "turbo_serving": mesh.turbo_reachable(),
            "turbo_url": mesh.turbo_url(list(live.values())),
            "capabilities": self.caps,
            "llama": self.llama,
            "peer_count": len(live),
            "protocol": mesh.PROTOCOL,
        })

    # ── main loop ────────────────────────────────────────────────────────────

    def run(self):
        signal.signal(signal.SIGTERM, self.handle_term)
        signal.signal(signal.SIGINT, self.handle_term)
        signal.signal(signal.SIGHUP, self.handle_hup)

        if not self.secret:
            # NOT an error. The secret authenticates LAN DISCOVERY and nothing
            # else: worker mode still serves this GPU, and a client pointed at an
            # explicit GENESI_MESH_ENDPOINTS never consults it. Over a VPN there
            # is no discovery at all, so this is the normal, correct state --
            # word it so it does not read as a failure on every start.
            self.log("LAN discovery is off (no secret at %s). This is fine for a "
                     "VPN/explicit-endpoint setup; worker mode and "
                     "GENESI_MESH_ENDPOINTS work without it. Run `genesi-mesh "
                     "init` (or `join`) only if you want peers on the same "
                     "network to find each other automatically."
                     % mesh.SECRET_PATH)

        self.log("node %s | %s %d MiB | rpc=%s" % (
            self.node, self.gpu.get("backend"), self.gpu.get("vram_mb"),
            "yes" if self.caps.get("rpc_server") else "MISSING"))

        listener = mesh.open_listen_socket()
        listener.settimeout(1.0)
        sender = mesh.open_send_socket()

        if mesh.conf_flag(self.conf, "worker"):
            self.start_worker()

        last_beacon = 0.0
        last_publish = 0.0
        try:
            while self.running:
                if self.reload_pending:
                    self.reload()

                try:
                    raw, addr = listener.recvfrom(8192)
                    self.absorb(raw, addr)
                except socket.timeout:
                    pass
                except OSError:
                    pass

                now = time.time()
                if now - last_beacon >= mesh.BEACON_INTERVAL:
                    last_beacon = now
                    # Before announcing AND before the next publish, so the
                    # local UI and remote peers read the same figure. Outside
                    # announce() because state.json must stay current even with
                    # discovery off or no secret — worker mode still works then.
                    self.refresh_free_vram()
                    self.announce(sender)
                    self.supervise_worker()
                # Publish on the same cadence as the TTL sweep so a peer that
                # goes away disappears from readers within one interval.
                if now - last_publish >= 2.0:
                    last_publish = now
                    self.publish()
        finally:
            self.stop_worker()
            listener.close()
            sender.close()
            self.log("stopped")


def main():
    # Reject arguments instead of silently ignoring them.
    #
    # `genesi-mesh` is a PREFIX of `genesi-meshd`, so tab completion happily
    # turns the CLI into the daemon. Typing `genesi-mesh init<TAB>` gets you
    # `genesi-meshd init`, which used to ignore argv, print two startup lines
    # and then sit in its main loop forever -- indistinguishable from a hang,
    # with no hint that the wrong binary is running. Say so instead.
    if len(sys.argv) > 1:
        if sys.argv[1] in ("-h", "--help", "help"):
            print((__doc__ or "").strip())
            return 0
        sys.stderr.write(
            "genesi-meshd is the background DAEMON and takes no arguments.\n\n"
            "Did you mean the command-line tool?\n"
            "    genesi-mesh " + " ".join(sys.argv[1:]) + "\n\n"
            "(`genesi-mesh` is a prefix of `genesi-meshd`, so tab completion\n"
            "often lands here by mistake.)\n\n"
            "To run the daemon: sudo systemctl enable --now genesi-meshd\n")
        return 2

    os.makedirs(mesh.RUN_DIR, mode=0o755, exist_ok=True)
    Daemon().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
