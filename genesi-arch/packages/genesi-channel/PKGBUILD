# Maintainer: Genesi OS Team
pkgname=genesi-channel
pkgver=1.0.0
# 2026-08-20: bumped 1 -> 2. The channel switch never worked on an installed
# system. It only UNCOMMENTED an existing [genesi-testing] block, and
# /etc/pacman-target.conf -- the config the installer writes to a real install
# -- never contained one, so `set testing` printed success and changed nothing.
# It now WRITES the block when it is missing, which fixes every machine
# installed before the channel existed without needing a migration scriptlet.
# It also verifies the result instead of announcing it, and rolls the change
# back if the testing repo does not answer -- an unreachable repo left enabled
# would break every later `pacman -Syu`. Covered by ci/channel-switch-test.sh.
pkgrel=2
pkgdesc="Switch between stable and testing update channels for Genesi OS"
arch=('any')
url="https://github.com/Genesi-OS/GenesiOS"
license=('AGPL-3.0-or-later')
depends=('bash' 'pacman' 'polkit')
optdepends=('kdialog: graphical channel switcher')
source=(
    'genesi-channel'
    'genesi-channel-gui'
    'org.genesi.channel.policy'
    'genesi-channel.desktop'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "${srcdir}/genesi-channel"     "${pkgdir}/usr/bin/genesi-channel"
    install -Dm755 "${srcdir}/genesi-channel-gui" "${pkgdir}/usr/bin/genesi-channel-gui"
    install -Dm644 "${srcdir}/org.genesi.channel.policy" \
        "${pkgdir}/usr/share/polkit-1/actions/org.genesi.channel.policy"
    install -Dm644 "${srcdir}/genesi-channel.desktop" \
        "${pkgdir}/usr/share/applications/genesi-channel.desktop"
}
