# Maintainer: Genesi OS Team
#
# caelestia-shell (caelestia-dots/shell) repackaged for the [genesi] repo. This
# is the Quickshell-based desktop shell (bar, launcher, notifications, OSDs) that
# powers Roadmap 5.1's "Hyprland + caelestia-shell" install option. AUR-only
# upstream; mirrored here so the Calamares netinstall (pacman, no AUR) installs
# it, pinned to a release tarball for reproducibility. provides=caelestia-shell.
#
# Deviation from the AUR PKGBUILD: the AUR build hard-depends on `quickshell-git`
# because, historically, Quickshell was AUR-only. It has since graduated to Arch
# [extra] as `quickshell`, so we depend on that instead — no need to compile
# Quickshell from git in CI, and the installed system pulls a real release. The
# remaining AUR-only deps are Genesi repackages providing the bare names:
# caelestia-cli -> genesi-caelestia-cli, app2unit -> genesi-app2unit,
# libcava -> genesi-libcava, ttf-rubik-vf -> genesi-ttf-rubik-vf.
pkgname=genesi-caelestia-shell
pkgver=2.0.3
# pkgrel 2: backport upstream commit 79a387e9 ("fix: wallpaper launcher crash",
# 2026-06-26, after the v2.0.3 tarball). The launcher's ContentList animated the
# `state` property via `Behavior on state`, so the state Transition's
# SequentialAnimation ran on targets destroyed when switching apps<->wallpapers /
# selecting a wallpaper -> Qt animation driver hit a freed object
# (QQuickPropertyChanges::actions via QSequentialAnimationGroupJob) -> SIGSEGV.
# Diagnosed from three identical coredumps on a Genesi RTX 3050 box. We ship the
# whole fixed ContentList.qml and overwrite the tarball's copy in prepare() (a
# full file, not a context patch, so the CI build can't fail on patch fuzz).
# pkgrel 3: fill in the Nexus "Updates" page. Upstream registers it in
# PageRegistry and points it at PlaceholderComp -- the "Page under construction"
# screen -- so the entry has always been in the settings menu leading nowhere.
# The update UI belongs where a user already looks for settings, not in a
# program of its own, which is the same reason Windows keeps it in Settings.
#
# Written entirely in caelestia's own design language (PageBase / ConnectedRect /
# SectionHeader / InfoRow, Tokens and Colours): the palette here retints live
# from the wallpaper, and Genesi's fixed emerald would fight it. The page is
# Genesi by what it does, not by how it looks.
#
# prepare() now asserts each override's precondition and fails the build when it
# stops holding -- including refusing to apply if upstream ever ships its own
# UpdatesPage.qml, which we would otherwise erase in silence on the next bump.
# pkgrel 4: two visual bugs in the Updates page, both found by looking at it
# on a real screen -- which no amount of static verification was going to do.
#
# The hero icon sat upside down. `RotationAnimator on rotation` takes ownership
# of the property and leaves it wherever the animation stopped, so the spinner
# from the initial check froze the check-circle mid-turn. A standalone
# RotationAnimator with target: can put it back, and does.
#
# And the System cards had a squared-off border over their rounded corners:
# InfoRow ALREADY IS a ConnectedRect, drawing its own background and taking
# first/last itself. Wrapping it in another one stacked two rectangles and the
# inner, nearly-square one won. Upstream uses InfoRow bare (AboutPage's System
# section); so does this now.
# 16: the Display page shows WHICH screen is the main one. It was a button
# with no state, so pressing it looked identical to it not working.
# 17: bar.width and bar.spacing. caelestia exposed what the bar contains
# and nothing about how it is drawn, so presets could only reorder modules.
# 22: a second body for the launcher, and the shape it takes.
# caelestia's launcher is a prompt with a list stacked over it, sized to its
# content. The Genesi one is a wide slab: the wallpaper behind the prompt, the
# clock and the weather in the corners, the selection named in a card of its
# own, and the results in numbered columns. `launcher.layout` picks.
#
# Ships as two WHOLE FILES Genesi owns (GenesiContent.qml, GenesiAppGrid.qml)
# rather than as a patch against upstream's Content.qml. A layout this different
# expressed as a diff would rewrite nearly every line of a file we do not own,
# and a fuzzy match on a version bump would give us a launcher that loads and is
# subtly wrong instead of a build that stops. Upstream's Content.qml is not
# touched at all; the only edit is the line in Wrapper.qml that chooses between
# the two, which the patcher asserts.
#
# Nothing compiles this QML -- CMake installs modules/ as plain files -- so a
# green build says nothing about whether the launcher loads. It was verified by
# standing up the Quickshell and caelestia types it needs as stubs and having Qt
# itself parse, instantiate and lay out the real file offscreen, failing on any
# warning. That is also how the band bug was found: the children said
# `parent.band`, a clipping container reparented them, the binding went
# undefined, and the wallpaper covered the whole panel.
# 23: the colour schemes, fanned out. `>scheme` in the Genesi launcher body is
# a PathView of cards, each PAINTED IN ITS OWN COLOURS -- surface as the ground,
# onSurface as the ink, a title bar in the container colour, and text/primary/
# tertiary/secondary/error as five swatches. Upstream lists names with a
# two-tone dot beside each, which tells catppuccin from gruvbox and cannot tell
# four catppuccins apart. A colour scheme is the one setting whose value IS a
# picture. Off to the sides the cards tilt, drop and fall behind; a click on one
# of those brings it to the middle first rather than repainting the desktop from
# a half-hidden card.
# 24: fourteen desktop widgets. caelestia draws two things on the
# wallpaper -- a clock and an audio visualiser -- and this is the rest of
# what a desktop is usually asked to show: weather and forecast, what is
# playing, cpu, memory, storage, network, battery, a calendar, an
# analogue clock, the workspaces, recent notifications, uptime and a
# greeting. Each is off by default, sits in one of nine named corners,
# and scales; everything that lands in the same corner stacks in a
# column instead of piling on top of itself.
#
# Verified by standing the services up as stubs and having Qt parse,
# instantiate and lay out all sixteen files offscreen with every widget
# on. That caught what reading them would not have: fourteen of them
# used `Tokens` without importing Caelestia.Config, which is not a
# warning but a ReferenceError at every size, radius and font in the
# widget.
# 25: a menu on the desktop, widgets you can drag, and a dock.
#
# Right-click the wallpaper: every widget with a tick, arrange mode, and
# the two things people go looking for straight after (Genesi Center, and
# another wallpaper). It writes through genesi-center-set rather than
# editing shell.json -- two programs writing one file by two sets of
# rules is how a config grows a key only one of them understands.
#
# Arrange mode has TWO gestures, not one. A widget in a corner lives in a
# Column, and a Column sets the x and y of everything in it -- a drag
# handler writing the same properties is two things assigning one value
# every frame, which does not look like dragging, it looks like
# vibrating. So an anchored widget offers UNPIN (it becomes free exactly
# where it stands) and a free one is dragged. Free positions are stored
# as FRACTIONS: the config outlives the monitor.
#
# And the dock: the open applications as icons along the bottom, grouped
# one per application with a count, on its own layer above windows, with
# an input mask that covers the bar and nothing else -- without that it
# is a strip that swallows clicks meant for the bottom edge of every
# maximised window. Between one icon and the next, lights run along a
# track, staggered per GAP: every gap pulsing in unison reads as one
# progress bar that never finishes.
#
# Its look is configurable down to the corners -- the bar on or off (not
# the same as an opacity of zero: no bar means no edge), how solid it is,
# its radius, the icons' radius, the spacing and the padding.
#
# The dock config lands in config.hpp AND config.cpp, where there are two
# constructors both listing every member. Patching only the header
# compiles and leaves m_dock null in whichever one was missed, which is a
# crash on the first read of Config.dock; the patcher asserts it finds
# exactly two.
# 26: the dock never appeared, and widgets could not be dragged.
#
# The dock's input mask was `Region { item: bar }`. Not one Region in
# caelestia names an item -- all of them are written as geometry -- and a
# property that does not exist does not fail quietly in QML: the whole
# file fails to load, so the dock was never built at all. Geometry now,
# the same shape upstream uses.
#
# Its slide also did nothing: the bar is anchored to its parent's bottom
# AND had a `y:` binding, which is two things assigning one property.
# The anchor wins. It rides the margin now, like the launcher's Wrapper.
#
# And arrange mode asked for two gestures -- UNPIN a corner widget, then
# drag it -- which is not what anybody means by "move it", and put the
# pill under the widget, which is off-screen for anything anchored at the
# bottom. Arrange mode moves every widget into the free layer instead,
# seeded from where it already was, so one drag works on all of them and
# nothing jumps.
# pkgrel 27: the dock STILL did not appear, and the reason was one level
# deeper. `Config` in QML is not the config object -- it is an attached
# type that mirrors it property by property, and the dock's section was
# added to the object and not to the mirror. That compiles, loads, runs,
# and `Config.dock` is undefined: every binding in the file throws and the
# dock is enabled and invisible. The patcher now writes the mirror too,
# and refuses to finish if any section of the config is missing from it.
#
# Also: the colour schemes get a surface of their own, edge to edge, over
# a dimmed desktop -- `launcher.schemePicker`. And a bug the offscreen
# render found in the fan that has been there since it shipped: it read
# `PathView.itemIndex`, which is Repeater's attached property and does not
# exist here, so clicking a card did nothing at all and only Enter ever
# applied a scheme.
# pkgrel 28: the bar across the top, and it does not take caelestia away.
#
# Genesi shipped one of these once, as its OWN Quickshell process, and
# switching to it ran `pkill -f caelestia` -- which does not disable a bar,
# it kills the shell: the launcher, every drawer, the notification daemon,
# the wallpaper, the theme bridge and the CLI go with it. It was withdrawn.
#
# This is a WINDOW inside caelestia, like the dock. Turning it on sets the
# `disabled` flag caelestia's own BarWrapper already had for excludedScreens,
# which collapses the rail's width AND its exclusive zone -- and every drawer
# reflows on its own, because Panels.qml anchors them to bar.implicitWidth.
# Nothing is killed and nothing is restarted, in either direction.
#
# The bar carries its own settings panel, because you change a bar while
# looking at it or you change it twice; Genesi Center keeps exactly one
# control for it, the switch that turns it on.
# pkgrel 29: the shell studio. The bar's settings card became a rail and
# seven pages -- bar, dock, launcher, widgets, desktop, shape, system --
# driven by a TABLE rather than hand-written rows, because forty
# hand-written controls out of the hundred and sixty-two the writer
# accepts was the shape of that answer. It is a hundred and seventy now,
# and a row names the config key it reads and writes exactly once.
#
# The bar wears the Genesi mark instead of a Material Symbols glyph of
# three dots, drawn as a Shape so it takes the scheme's colours -- an SVG
# carries its own green, and the one Genesi thing on the bar would be the
# one green thing on a violet desktop. It opens the side panel now; the
# launcher moved to the search glyph beside it.
#
# The bar also grew the flow between its islands, auto-hide, a border and
# a shadow; the dock grew an edge, auto-hide, magnification, hover labels
# and PINNED APPLICATIONS -- which are in the dock whether or not they
# are running, and launch rather than focus when they are not.
# 30: the bar was dead after every login, and no slider in the studio
# wrote anything. Two bugs, both of which loaded clean.
#
# caelestia's drawers window takes input on a frame around the screen:
# the border, plus a drag margin so a panel can be pulled in from its
# edge. That margin is the largest dragThreshold of the four panels --
# 80, the sidebar's -- and it applies whenever the active workspace has
# no windows on it. So on an empty desktop the drawers window owns the
# top and bottom ninety pixels. The top bar is 46 tall and the dock 76;
# both sit entirely inside it, the drawers window is above them, and
# neither took a click. An empty workspace is the state a session starts
# in, which is why this read as a startup bug -- log in and the bar is
# dead, open any window and it works. Regions.qml now drops that margin
# on an edge a Genesi surface owns and keeps its border strip, so every
# caelestia hover point stays where it was.
#
# And caelestia's StyledSlider never moves its own `value`: a MouseArea
# of its own drives a 0-to-1 `pos` and hands it back through
# `interaction`. The studio's rows watched `pressed` and read `value`,
# and a drag touches neither -- so the handle moved, snapped back on
# release and wrote nothing, silently, because a handler for a property
# that never changes is not an error. ci/qml-sanity-test.py fails on it
# now, reading the comment-stripped source, since the paragraph
# explaining it names both strings it looks for.
# 31: the bar has a shape, the dock has a style, and the studio has a
# front door.
#
# `topbar.islands` was a bool -- three pills or one inset slab -- and a
# switch labelled "islands rather than one bar" cannot grow a third
# answer without becoming a switch that lies. It is `topbar.form` now,
# with five: islands, full, fit, dock and notch. The dock has four the
# same way: bar, islands, rail and seal. Each of them also decides how
# tall the strip is, because a bar flush to the screen edge that still
# reserves a gap above itself leaves a stripe of desktop nothing can be
# dropped into.
#
# Both surfaces grew Frost, which is a Hyprland layerrule and not a Qt
# effect: a layer surface cannot read what is under it, so there is
# nothing for QML to blur. And the dock grew the media chip -- what is
# playing, at the end of the row, click to play or pause and
# right-click for the whole player.
#
# The studio: a viewfinder at the top of the Bar and Dock pages drawing
# the surface as it is set, because five named forms and four styles
# are nine words, and a word for a shape is something you have to try
# before you know whether you wanted it. Form and style are picked as
# CARDS next to it rather than as list rows. Every switch can carry a
# second line, so "Auto-hide" can also say that the pointer is what
# brings it back.
#
# And a front door: seven pages and a hundred and eighty rows is more
# than a rail can answer for, so the studio opens on a map of the pages
# with a search across every row in it. A result is the REAL row --
# same delegate, same key -- because a search that shows you a copy of
# a control is a search that can disagree with the page it came from.
# 32: the quick settings, down the left edge.
#
# The Genesi mark used to open caelestia's dashboard -- a clock, a
# calendar, a media player and four graphs. Useful, and not what a mark
# in the corner of a bar is for: that is where a desktop keeps the
# switches you reach for without thinking. It opens a panel of them now:
# Wi-Fi, Bluetooth, Airplane, Night light, Keep awake, Do not disturb and
# Gaming, the volume, the microphone and the screen, a calendar, and the
# power profile.
#
# Two ways in, and they mean different things. The mark opens it PINNED,
# because you asked for it by name and a panel that vanishes while you
# reach for a slider is a panel nobody uses twice. The left four pixels
# of the screen open it on hover and it closes when the pointer leaves --
# caelestia already teaches that edges are where panels come from, and
# with the Genesi bar on, the left edge is the one nothing is using: the
# side rail has collapsed to make room for the bar. Which is also why
# the panel exists exactly when the bar does.
#
# Every switch on it is a real service or it is not on it. Aeroplane mode
# is rfkill and night light is hyprsunset -- the two that were not
# already in the shell -- and both read their state back rather than
# remembering what they were told, because something else can block a
# radio and a toggle that only remembers is then showing the opposite of
# what is true. hyprsunset is a hard dependency for the same reason: a
# switch that turns on and does nothing is the failure this repository
# keeps writing guards for.
#
# The mark itself can be something else now. `topbar.markIcon` takes any
# Material Symbols name, and the Panel page in the studio offers six.
# 33: Depth. The subject of the wallpaper, cut out and drawn again on
# top of the clock and the widgets -- so they sit behind it while the
# rest of the picture stays in front of nothing. There is no depth map
# and nothing moves: one cut-out and a stacking order.
#
# genesi-depth does the cutting, and it is classical vision rather than
# a network on purpose. A segmentation model is 170MB of weights and an
# onnxruntime dependency for a feature that is off by default;
# spectral-residual saliency and GrabCut need numpy and the core half of
# OpenCV, and a wallpaper is the easy case for saliency because it was
# chosen by a person for having a subject. If python-rembg happens to be
# installed the Fine tier uses it, because on hair and foliage a network
# really is better -- an optdepend, never a requirement.
#
# Cut-outs are cached by the picture's path, size and mtime plus the
# settings, so changing the wallpaper and changing it back is instant
# and editing one in place is not. A picture with no subject to find --
# a texture, a gradient -- is left alone rather than cut down to a speck
# and drawn over the clock.
# 34: the side panel never appeared, and the bar came up in the wrong
# place and would not take a click.
#
# The panel declared `modelData` on the Scope and then asked for
# `win.modelData` -- a property the window does not have. So its "is
# this my screen?" test compared undefined to a monitor id, which is
# false, on every screen, always. Reading a property that is not there
# is not an error in QML, and the offscreen harness had been editing
# that very expression out of the file before rendering it.
#
# The bar: caelestia reserves each screen edge with a one-pixel window,
# and the bar reserves the same edge. Layer-shell hands out exclusive
# zones in map order, so on a cold start the border went first and the
# bar was placed ten pixels down, inside the border that is drawn over
# it. Exclusions.qml yields the edge the bar is on now. Everything
# caelestia opens -- the dashboard, the launcher, the notifications in
# the top right -- was laid out by Panels.qml inside `borderThickness`
# and nothing else, which is why a notification arrived underneath the
# bar; Panels insets by the bar as well now. Both read the one
# expression for the bar's height, in GenesiEdges.
#
# Auto-hide flickered and could not be used: a MouseArea reports the
# pointer has LEFT the moment it moves onto a child that takes hover,
# and every button on the bar does. Reaching for one hid the bar, which
# moved it away, which brought the bar back. HoverHandler does not
# behave that way.
#
# The dock respects exclusive zones now (and still reserves none), so a
# dock on the top edge sits below the bar; it grew headroom above it,
# because a layer surface clips its own contents and the hover label was
# drawn with its top half missing; and the media chip opens a player in
# that headroom.
#
# Depth moved to the side panel, where it was asked for, and shows what
# it FOUND -- the cut-out over a dimmed wallpaper, or a plain sentence
# when the picture has no subject to cut. A sky full of cloud has none,
# which is a correct answer and an invisible one: the desktop looks
# exactly as it did before, so the feature reads as broken. And
# genesi-depth takes the edge fade by name now, so no caller translates
# "soft" into a pixel count.
# 35: the side panel could not load at all, and the fix for it in 34
# is what made that true. `modelData` was declared `required` on both of
# its windows -- and Variants sets modelData on its DELEGATE, which is
# the Scope, not on anything inside it. A required property nobody
# initialises is a hard load error, so the whole file stopped
# instantiating. It reads scope.modelData now, the way upstream's own
# Drawers.qml does with the same shape.
#
# The offscreen harness had been substituting a plain property for EVERY
# required declaration in the file before rendering it, so the shape
# that cannot load rendered perfectly. It only supplies what Variants
# supplies now -- the delegate's screen -- and it fails on the rest.
#
# 34 also moved caelestia's panels below the bar and left their
# backgrounds where they were: three places convert a Panels-relative
# position into a window-relative one by adding the border thickness,
# and that was the whole offset until the bar was added to it. Every
# blob, the fullscreen region and every panel's input region were drawn
# one bar-height too high, which is the surface sticking out over the
# notifications.
#
# And the bar still came up underneath the drawers on a cold start,
# because the `layerrule` it asks for is applied to a surface as it MAPS
# and this one was already up -- and because the drawers window remaps
# itself during startup anyway, when Hyprland's IPC answers whether
# something is fullscreen. The bar's first map waits for the shell to
# settle now, which is the toggle that fixed it by hand, done once.
#
# genesi-shell-doctor prints what the surfaces are actually doing:
# stacking order per monitor, what each reserved, which files loaded and
# what the shell said while starting. Three bugs in a row were diagnosed
# from a screenshot and two of those guesses were wrong.
# 36: the dashboard's closed tab hung permanently below the bar, the
# music card was clipped, the bar had no margin setting, and Depth was
# picking embers out of a picture of a person.
#
# The tab: 35 insets caelestia's panel area by the bar so nothing opens
# underneath it, and a closed drawer hides by moving up its own height
# plus five -- measured from the top of that AREA. Upstream that put its
# edge inside the ten-pixel border, invisible. With the bar in the
# inset, five pixels above the panel area is forty-five pixels down the
# screen, so the dashboard's blob sat there in plain view. It tucks the
# bar's height further now, which puts it back where upstream had it.
#
# topbar.margin: how far the bar sits from the screen edge, which is a
# different question from `gap` -- that is the space around the islands
# INSIDE the strip. GenesiEdges counts both, so the exclusion zone,
# caelestia's panels and its input regions all move with it.
#
# The player card was 290 tall in 220 of headroom, so the window clipped
# its whole transport row away -- which is why none of it could be
# clicked. The headroom is measured from the card now instead of chosen,
# and the album art is capped so a wider card is not a taller one.
#
# Depth was only asking one question. Spectral-residual saliency finds
# unusual TEXTURE, so on a wallpaper of a dark hooded figure against an
# ember-filled sky it found the embers. Two more terms: frequency-tuned
# saliency, which finds unusual COLOUR and to which a large dark flat
# subject is obvious; and a centre prior, because a wallpaper is
# composed and its scattered bright detail is not in the middle. The
# test suite had a bright subject on a dark field and a flat gradient --
# not the case that broke. It has it now, and the old code refuses that
# picture outright while the new one cuts the figure.
pkgrel=36
pkgdesc='Quickshell desktop shell for the Caelestia design (Genesi repackage of caelestia-shell)'
arch=('x86_64')
url='https://github.com/caelestia-dots/shell'
license=('GPL-3.0-only')
depends=('caelestia-cli' 'quickshell' 'ddcutil' 'brightnessctl' 'app2unit' 'libcava' 'networkmanager'
         'lm_sensors' 'fish' 'aubio' 'libpipewire' 'glibc' 'gcc-libs' 'ttf-material-symbols-variable'
         'power-profiles-daemon' 'ttf-rubik-vf' 'ttf-cascadia-code-nerd' 'swappy' 'libqalculate' 'bash'
         'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'hyprsunset'
         'util-linux' 'bluez' 'python' 'python-opencv' 'python-numpy')
makedepends=('cmake' 'ninja' 'qt6-shadertools')
# python-rembg is Depth's Fine tier when it happens to be installed: a
# segmentation network is genuinely better on hair and foliage. Never a
# requirement -- without it Fine is the same classical method at a larger
# working size, which is what the other two tiers already are.
# No apostrophe in that description. This line read "Depth's Fine tier"
# and the apostrophe CLOSED the single-quoted string -- bash then read
# the rest of the file in the wrong quoting context and reported a
# syntax error a hundred and forty lines later, and makepkg failed to
# source the PKGBUILD at all. ci/pkgbuild-syntax-test.py runs `bash -n`
# over every one of them now.
optdepends=('python-rembg: a segmentation network for the Fine tier of Depth')
provides=('caelestia-shell')
conflicts=('caelestia-shell' 'caelestia-shell-git')
source=("$url/releases/download/v$pkgver/caelestia-shell-v$pkgver.tar.gz"
        "ContentList.qml"
