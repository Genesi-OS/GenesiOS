#!/usr/bin/env python3
"""
genesi-studio-helperd — the privileged half of Genesi Studio Mode.

Studio Mode's session daemon (genesi-studiod) runs as the user and handles
everything a user may do to their own processes: listing windows, freezing
background apps, restoring them. But the levers that actually buy latency —
negative nice, realtime I/O class, pinning to the fastest cores, cgroup
weights, the CPU governor — all need root. This tiny service is the only part
that runs privileged, and it is deliberately boring.

SECURITY MODEL (this is the whole reason it isn't a world-writable flag file)
    genesi-ai-mode's control surface is a world-writable file in /run, which is
    fine there: the only thing you can write is "on"/"off"/"auto" for the whole
    machine. Studio Mode's surface takes *PIDs*, so an unauthenticated file
    would let any local user ask root to renice or pin someone else's
    processes. Instead this listens on a unix socket and reads the peer's real
    uid from SO_PEERCRED — a kernel-supplied credential the caller cannot
    forge. Every request is then constrained:

      * a non-root caller may only name PIDs whose /proc entry it owns
      * PIDs are re-checked at apply time, not just at parse time
      * nice never goes below -10, so a runaway request cannot starve the
        kernel's own threads or lock the box out of its input stack
      * the request vocabulary is a fixed set of ops with no free-form paths

BASELINES AND RESTORE
    Every lever is captured before it is touched and written to
    /run/genesi-studio/baseline.json, so a helper that is killed and restarted
    (or a session that crashes) can still put the machine back. `restore` is
    idempotent and safe to call when nothing was ever applied.

COEXISTENCE WITH AI MODE
    genesi-aid owns the same global sysfs knobs (governor/EPP) and restores
    them from its own captured baseline. Two daemons writing the same file
    would fight, and whoever restored last would win with a stale value. So
    this helper refuses to touch the *global* knobs whenever AI Mode reports
    itself active, and says so in its reply; the per-process levers, which
    genesi-aid never touches, always apply.
"""

from __future__ import annotations

import glob
import json
import os
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import threading

RUN_DIR = "/run/genesi-studio"
SOCK_PATH = f"{RUN_DIR}/helper.sock"
BASELINE_PATH = f"{RUN_DIR}/baseline.json"
AID_STATE = "/run/genesi-ai-mode/state.json"

CPU_BASE = "/sys/devices/system/cpu"
# Gentle on purpose. -10 (the first cut) starved the compositor on a loaded
# machine — the focused app won the CPU over kwin/mutter, so its own window
# repainted less and it FELT laggier despite having more CPU — and it fought
# Genesi's ananicy-cpp, which manages nice per-app (the same clash genesi-game
# documents with GameMode). cgroup cpu.weight below is the real lever: a
# proportional share that never starves anyone absolutely. nice just nudges the
# ordering. Renicing the compositor's competition, not the compositor.
NICE_BOOST = -5
# cgroup weights are PROPORTIONAL, so a large number is safe in a way a large
# negative nice is not: everyone else still gets scheduled, the focused app just
# gets a much bigger slice when the machine is actually contended. Default is
# 100, so this is a 10x share.
CGROUP_BOOST_WEIGHT = 1000


def log(msg):
    print(f"genesi-studio-helperd: {msg}", flush=True)


# ── small fs helpers ─────────────────────────────────────────────────────────
def _read(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def _write(path, value):
    try:
        with open(path, "w") as fh:
            fh.write(str(value))
        return True
    except OSError:
        return False


def _atomic_json(path, data):
    tmp = f"{path}.tmp"
    try:
        with open(tmp, "w") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
    except OSError:
        pass


def _load_baseline():
    try:
        with open(BASELINE_PATH) as fh:
            return json.load(fh)
    except Exception:
        return {}


def _proc_uid(pid):
    try:
        return os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return None


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _ai_mode_active():
    """True when AI Mode is on at all (reported to callers, not used to gate)."""
    try:
        with open(AID_STATE) as fh:
            return bool(json.load(fh).get("ai_mode_active"))
    except Exception:
        return False


# genesi-aid names every lever it took in state.json's "applied" list. Matching
# those prefixes tells us which knobs it is actually holding right now.
_AID_LEVER_PREFIXES = (
    ("cpu governor", "governor"),
    ("epp", "epp"),
    ("swappiness", "swappiness"),
    ("amd gpu", "gpu"),
    ("intel gpu", "gpu"),
)


def _ai_mode_held_levers():
    """The global levers genesi-aid holds right now, as a set of lever names.

    Ownership is PER LEVER, not all-or-nothing. The first cut stood down from
    every global knob the moment AI Mode was on, which meant a warm ollama in
    the background silently disabled the GPU lever — the one lever that matters
    for a game, and one genesi-aid may not even be holding. So ask genesi-aid
    what it actually took and skip exactly that.

    NVIDIA is never in this set: genesi-aid drives nvidia-smi (persistence,
    power limit, locked clocks) while Studio Mode drives nvidia-settings
    (PowerMizer mode). Different knobs, no fight.
    """
    try:
        with open(AID_STATE) as fh:
            st = json.load(fh)
    except Exception:
        return set()
    if not st.get("ai_mode_active"):
        return set()
    applied = st.get("applied")
    if applied is None:
        # AI Mode is on but has not published its lever list (an older genesi-aid,
        # or a state file written mid-enable). Assume it holds everything rather
        # than racing it for a knob it may be about to take.
        return {"governor", "epp", "swappiness", "gpu"}
    held = set()
    for item in applied:
        low = str(item).lower()
        for prefix, lever in _AID_LEVER_PREFIXES:
            if low.startswith(prefix):
                held.add(lever)
    return held


def _performance_cpu_ids():
    """Logical CPUs on the fast cores of a HYBRID CPU only — else [].

    On an Intel P/E chip, pinning the focused app to the P-cores keeps it off
    the slow E-cores. But pinning only helps when there genuinely are two
    frequency tiers: on a uniform CPU (every Ryzen/older Intel) or in a VM,
    "fastest cores" is either every core or measurement noise, and pinning the
    app to a SUBSET just removes cores from it and makes it slower — the exact
    "the app feels laggier with Studio on" regression. So this returns a subset
    only when a clearly slower tier exists, and [] otherwise (no pinning).
    """
    freqs = {}
    try:
        for cpu in os.listdir(CPU_BASE):
            m = re.fullmatch(r"cpu(\d+)", cpu)
            if not m:
                continue
            raw = _read(f"{CPU_BASE}/{cpu}/cpufreq/cpuinfo_max_freq")
            if raw is None:
                return []                    # incomplete data → don't guess
            try:
                freqs[int(m.group(1))] = int(raw)
            except ValueError:
                return []
    except OSError:
        return []
    if len(freqs) < 4:                        # too few cores to carve up
        return []
    top, bottom = max(freqs.values()), min(freqs.values())
    # A real hybrid has the E-cores >12% slower. Uniform CPUs and VMs don't.
    if bottom >= top * 0.88:
        return []
    fast = sorted(i for i, mf in freqs.items() if mf >= top * 0.95)
    # Never strand the app on almost nothing, and never pin if "fast" is
    # everything (then it is not really a hybrid split).
    if len(fast) < 2 or len(fast) >= len(freqs):
        return []
    return fast


def _cgroup_path(pid):
    """Absolute cgroup-v2 dir for a pid, or None on a v1-only/odd system."""
    raw = _read(f"/proc/{pid}/cgroup")
    if not raw:
        return None
    for line in raw.splitlines():
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[0] == "0":       # v2 unified line
            path = os.path.join("/sys/fs/cgroup", parts[2].lstrip("/"))
            return path if os.path.isdir(path) else None
    return None


# Cgroups that hold the whole session rather than one app. Writing a share into
# any of these raises a group against itself, and their memory knobs cover
# everything the user is running.
_SHARED_CGROUP_NAMES = ("init.scope",)


def _cgroup_is_exclusive(cg, pid):
    """True when `cg` holds this app and nothing else the user is running.

    cpu.weight and io.weight are shares measured against SIBLINGS inside the
    same parent — so they only mean something when the target has a cgroup to
    itself. An app launched straight from the compositor lands in the shared
    `session-N.scope` alongside the compositor and everything else the session
    started (measured: 23 processes, Hyprland among them). Writing cpu.weight
    there raises the whole group against itself, which is no boost at all, and
    memory.swap.max / memory.low would quietly rewrite the memory policy of the
    entire session — a side effect nobody asked Studio Mode for.

    Two checks, because either alone is wrong:

    * by name — `session-N.scope`, `user@N.service`, `init.scope` and any
      `.slice` are session containers by construction, however few processes
      happen to be in them at the moment;
    * by shape — a launcher may still drop several unrelated apps into one
      scope, so the members must form a SINGLE process tree.

    The shape test is about the cgroup, not about the target's place in it: the
    boosted pid is usually a leaf, not the root. Minecraft's own scope is rooted
    at the launcher script with `java` several levels below it, so asking
    "does every member descend from the target" rejected the app's own scope.
    What matters is that nothing unrelated shares the group, so the test is on
    the roots — members whose parent is not itself a member. One root means one
    app. Extra roots are allowed only when they were orphaned to init: Firefox's
    crashhelper sits in Firefox's scope with ppid 1, and rejecting the scope
    over it would disable the levers for every app that outlives its launcher.
    """
    base = os.path.basename(cg.rstrip("/"))
    if (base.endswith(".slice") or base in _SHARED_CGROUP_NAMES
            or re.fullmatch(r"session-\d+\.scope", base)
            or re.fullmatch(r"user@\d+\.service", base)):
        return False
    try:
        with open(os.path.join(cg, "cgroup.procs")) as fh:
            members = [int(x) for x in fh.read().split()]
    except (OSError, ValueError):
        return False
    if not members:
        return False
    inside = set(members)
    roots = [m for m in members if _ppid(m) not in inside]
    if len(roots) <= 1:
        return True
    # More than one tree: fine only if the extras are the app's own processes
    # reparented to init, not separate apps still attached to a live launcher.
    return all(_ppid(r) <= 1 for r in roots)


def _ppid(pid):
    """Parent pid, or 0 when it cannot be read."""
    try:
        with open(f"/proc/{pid}/stat") as fh:
            raw = fh.read()
        return int(raw[raw.rindex(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


# ── the levers ───────────────────────────────────────────────────────────────
class Levers:
    """Applies and reverses every privileged tweak, remembering the originals."""

    def __init__(self):
        self.state = _load_baseline()

    def _save(self):
        _atomic_json(BASELINE_PATH, self.state)

    # -- per process -------------------------------------------------------
    def boost_pid(self, pid, perf_cpus):
        """Give one process the fast path. Returns a list of applied lever names."""
        applied = []
        procs = self.state.setdefault("procs", {})
        key = str(pid)
        if key in procs:
            return []                        # already boosted; don't re-capture

        saved = {}
        # Every thread, not just the tgid — see _threads(). The tid list is a
        # snapshot: threads the app spawns after this run at their inherited
        # priority, which is the honest ceiling without a scheduler hook.
        tids = _threads(pid)
        saved["threads"] = [str(t) for t in tids]

        # nice: a gentle ordering nudge (see NICE_BOOST — going harder starves
        # the compositor and fights ananicy-cpp).
        nice_saved = {}
        for tid in tids:
            try:
                nice_saved[str(tid)] = os.getpriority(os.PRIO_PROCESS, tid)
                os.setpriority(os.PRIO_PROCESS, tid, NICE_BOOST)
            except OSError:
                continue
        if nice_saved:
            saved["nice"] = nice_saved
            applied.append("nice")

        # ionice: best-effort priority 0. Deliberately NOT realtime class —
        # RT I/O can starve journald/systemd and wedge the desktop, which is
        # exactly the "my PC froze" outcome Studio Mode exists to prevent.
        # Capture the real class/priority first: restoring to a hardcoded
        # default would silently change the I/O behaviour of any process that
        # was not on the default to begin with.
        prev = _ionice_get(tids)
        if subprocess_ok(["ionice", "-c", "2", "-n", "0", "-p"]
                         + [str(t) for t in tids]):
            saved["ionice"] = {str(t): v for t, v in prev.items()}
            applied.append("ionice")

        # affinity: keep it on the fast cores.
        if perf_cpus:
            aff_saved = {}
            for tid in tids:
                try:
                    aff_saved[str(tid)] = sorted(os.sched_getaffinity(tid))
                    os.sched_setaffinity(tid, set(perf_cpus))
                except OSError:
                    continue
            if aff_saved:
                saved["affinity"] = aff_saved
                applied.append("affinity")

        # oom_score_adj: make the focused app the LAST thing the kernel kills.
        adj = f"/proc/{pid}/oom_score_adj"
        cur = _read(adj)
        if cur is not None and _write(adj, "-500"):
            saved["oom_score_adj"] = cur
            applied.append("oom_score_adj")

        # cgroup: the real levers. nice only orders the run queue; these size
        # the actual slice, and the memory ones remove the biggest source of
        # visible stutter — being paged out or reclaimed mid-use.
        cg = _cgroup_path(pid)
        if cg and not _cgroup_is_exclusive(cg, pid):
            # Shared with the rest of the session — see _cgroup_is_exclusive().
            # Say so rather than reporting a lever that would do nothing.
            log(f"pid {pid}: cgroup levers skipped, "
                f"{os.path.basename(cg.rstrip('/'))} is shared with the session")
            cg = None
        if cg:
            knobs = [
                ("cpu.weight", CGROUP_BOOST_WEIGHT),
                ("io.weight", CGROUP_BOOST_WEIGHT),
                # Never swap the focused app. A game or editor that gets paged
                # out stutters for seconds when it touches that memory again,
                # and no amount of CPU priority recovers it.
                ("memory.swap.max", "0"),
                # Protect its pages from reclaim: under pressure the kernel
                # takes memory from everyone else first. "max" means the whole
                # of what it is using is protected.
                ("memory.low", "max"),
            ]
            for knob, want in knobs:
                path = os.path.join(cg, knob)
                cur = _read(path)
                if cur is not None and _write(path, want):
                    saved.setdefault("cgroup", {})[knob] = [path, cur]
                    applied.append(knob)

        if saved:
            procs[key] = saved
            self._save()
        return applied

    def restore_pid(self, pid):
        procs = self.state.get("procs", {})
        saved = procs.pop(str(pid), None)
        if not saved:
            return
        # A dead process needs no restoring, but its cgroup knobs might still
        # exist (the scope outlives the leader briefly), so do those anyway.
        if _alive(pid):
            # A baseline written by the pre-thread helper (a package upgrade
            # restarts this daemon without a reboot, and /run outlives that)
            # holds one scalar per lever instead of one per tid. Read it as the
            # main thread's value so an in-place upgrade still restores cleanly.
            if saved.get("nice") is not None and not isinstance(saved["nice"], dict):
                saved["nice"] = {str(pid): saved["nice"]}
            if saved.get("affinity") is not None and not isinstance(saved["affinity"], dict):
                saved["affinity"] = {str(pid): saved["affinity"]}
            if "ionice" in saved and not isinstance(saved["ionice"], dict):
                saved["ionice"] = {str(pid): saved["ionice"]}

            # Restore per thread, skipping any that exited in the meantime.
            tids = [int(t) for t in saved.get("threads") or [pid]]
            live = [t for t in tids if os.path.exists(f"/proc/{pid}/task/{t}")]
            nice_saved = saved.get("nice") or {}
            for tid in live:
                if str(tid) in nice_saved:
                    try:
                        os.setpriority(os.PRIO_PROCESS, tid,
                                       int(nice_saved[str(tid)]))
                    except OSError:
                        pass
            if "ionice" in saved:
                _ionice_set_many(live, saved["ionice"])
            aff_saved = saved.get("affinity") or {}
            for tid in live:
                if str(tid) in aff_saved:
                    try:
                        os.sched_setaffinity(tid, set(aff_saved[str(tid)]))
                    except OSError:
                        pass
            if "oom_score_adj" in saved:
                _write(f"/proc/{pid}/oom_score_adj", saved["oom_score_adj"])
        for _knob, (path, cur) in (saved.get("cgroup") or {}).items():
            _write(path, cur)
        self._save()

    # -- global ------------------------------------------------------------
    def apply_global(self):
        """Governor, EPP, swappiness and GPU clocks to their performance state.

        Each lever stands down on its own if genesi-aid is holding that one —
        see _ai_mode_held_levers(). Anything AI Mode is NOT holding is still
        taken, so a warm ollama no longer costs the game its GPU lever.
        """
        if "global" in self.state:
            return [], "already"
        held = _ai_mode_held_levers()
        saved, applied, skipped = {}, [], []
        if "governor" in held:
            skipped.append("governor")
        else:
            govs = []
            for cpu in sorted(os.listdir(CPU_BASE)):
                if not re.fullmatch(r"cpu\d+", cpu):
                    continue
                p = f"{CPU_BASE}/{cpu}/cpufreq/scaling_governor"
                cur = _read(p)
                if cur is not None and _write(p, "performance"):
                    govs.append([p, cur])
            if govs:
                saved["governor"] = govs
                applied.append("governor")
        if "epp" in held:
            skipped.append("epp")
        else:
            epps = []
            for cpu in sorted(os.listdir(CPU_BASE)):
                if not re.fullmatch(r"cpu\d+", cpu):
                    continue
                p = f"{CPU_BASE}/{cpu}/cpufreq/energy_performance_preference"
                cur = _read(p)
                if cur is not None and _write(p, "performance"):
                    epps.append([p, cur])
            if epps:
                saved["epp"] = epps
                applied.append("epp")
        # Keep the machine out of swap while a session is running. Same reason
        # as memory.swap.max on the target: a page-out mid-frame is a visible
        # hitch that no scheduler priority can undo.
        if "swappiness" in held:
            skipped.append("swappiness")
        else:
            cur = _read("/proc/sys/vm/swappiness")
            if cur is not None and _write("/proc/sys/vm/swappiness", "10"):
                saved["swappiness"] = cur
                applied.append("swappiness")

        # GPU to its performance state. This is the lever that matters for a
        # game — everything above only reorders a CPU that a GPU-bound game was
        # never waiting on.
        if "gpu" in held:
            skipped.append("gpu-clocks")
        else:
            gpu = []
            for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
                # AMD: forcing the DPM level stops the clocks bouncing back down
                # between frames.
                p = os.path.join(card, "device/power_dpm_force_performance_level")
                cur = _read(p)
                if cur is not None and _write(p, "high"):
                    gpu.append([p, cur])
            if gpu:
                saved["gpu"] = gpu
                applied.append("gpu-clocks")
        # NVIDIA PowerMizer is never in `held`: genesi-aid drives nvidia-smi,
        # this drives nvidia-settings, and the two knobs do not overlap.
        if _nvidia_prefer_max_performance():
            saved["nvidia"] = True
            applied.append("nvidia-powermizer")

        if saved:
            self.state["global"] = saved
            self._save()
        return applied, ("ai-mode-owns:" + ",".join(skipped) if skipped else None)

    def restore_global(self):
        saved = self.state.pop("global", None)
        if not saved:
            return
        for group in ("governor", "epp", "gpu"):
            for path, cur in saved.get(group, []):
                _write(path, cur)
        if "swappiness" in saved:
            _write("/proc/sys/vm/swappiness", saved["swappiness"])
        if saved.get("nvidia"):
            # 0 = Adaptive, the driver default.
            _nvidia_powermizer(0)
        self._save()

    def restore_all(self):
        for pid in list(self.state.get("procs", {}).keys()):
            self.restore_pid(int(pid))
        self.restore_global()
        self.state = {}
        self._save()


def _nvidia_powermizer(mode):
    """Set the NVIDIA PowerMizer mode (1 = prefer maximum performance, 0 = adaptive).

    Only touches the setting when the proprietary driver's control tool is
    present; the open kernel module and nouveau simply have no equivalent, and
    the AMD path above already covers those cards.
    """
    if not subprocess_which("nvidia-settings"):
        return False
    return subprocess_ok([
        "nvidia-settings", "-a", f"GPUPowerMizerMode={int(mode)}"])


def _nvidia_prefer_max_performance():
    return _nvidia_powermizer(1)


_IONICE_CLASSES = {"none": 0, "realtime": 1, "best-effort": 2, "idle": 3}


def _ionice_parse(txt):
    """One line of `ionice -p` output as [class, prio], or None if unreadable."""
    txt = txt.strip().lower()
    cls = _IONICE_CLASSES.get(txt.split(":", 1)[0].strip())
    if cls is None:
        return None
    m = re.search(r"prio\s+(\d+)", txt)
    return [cls, int(m.group(1)) if m else None]


def _ionice_get(tids):
    """Current [class, prio] per tid, as {tid: [class, prio] or None}.

    `ionice -p A B C` prints one line per tid, in order — so the whole thread
    list costs one fork rather than one per thread. The line reads e.g.
    "best-effort: prio 4", or just "idle" for the classes with no priority.

    The environment is forced to LC_ALL=C: util-linux translates that line, and
    a localised "prioridade 4" does not match the priority pattern, so on a
    non-English desktop we would restore the class but silently drop the
    priority the process started with.
    """
    tids = list(tids)
    if not tids:
        return {}
    lines = _ionice_lines(tids)
    if len(lines) == len(tids):
        return {t: _ionice_parse(line) for t, line in zip(tids, lines)}
    if len(tids) == 1:
        return {}
    # A thread exited mid-read and the lines no longer line up with the tids.
    # Pairing them anyway would restore one thread's I/O class onto another, so
    # fall back to one read per thread — slower, but it cannot misalign, and
    # losing the whole app's baseline over one dead thread would put every
    # remaining thread back on the kernel default instead of its own class.
    out = {}
    for tid in tids:
        one = _ionice_lines([tid])
        if len(one) == 1:
            out[tid] = _ionice_parse(one[0])
    return out


def _ionice_lines(tids):
    """Raw `ionice -p` output lines for a tid list, or [] if the call failed."""
    try:
        env = dict(os.environ, LC_ALL="C", LANGUAGE="C")
        out = subprocess.run(["ionice", "-p"] + [str(t) for t in tids],
                             capture_output=True, text=True, timeout=5, env=env)
    except Exception:
        return []
    if out.returncode != 0:
        return []
    return out.stdout.strip().splitlines()


def _ionice_set_many(tids, saved):
    """Put threads back on the I/O class they had before we touched them.

    Threads that shared a class are set together, so a 60-thread process costs
    a handful of forks instead of 60.
    """
    groups = {}
    for tid in tids:
        prev = (saved or {}).get(str(tid), saved.get(tid) if saved else None)
        # We could not read the original; "none" restores the kernel default,
        # which is where an unreadable thread almost certainly was.
        key = (0, None) if not prev else \
            (prev[0], prev[1] if len(prev) > 1 else None)
        groups.setdefault(key, []).append(str(tid))
    for (cls, prio), members in groups.items():
        cmd = ["ionice", "-c", str(cls)]
        if prio is not None and cls in (1, 2):   # only these carry a priority
            cmd += ["-n", str(prio)]
        subprocess_ok(cmd + ["-p"] + members)


def _threads(pid):
    """Every live thread id of a process, the main thread first.

    nice, ionice and CPU affinity are PER THREAD on Linux: setting them on the
    tgid moves the main thread and nothing else. A game or a DAW does its real
    work on threads that are not the main one — Minecraft renders and builds
    chunks off it — so boosting only the tgid was very close to boosting
    nothing at all.
    """
    try:
        tids = sorted(int(t) for t in os.listdir(f"/proc/{pid}/task"))
    except OSError:
        return [pid]
    if pid in tids:
        tids.remove(pid)
        tids.insert(0, pid)
    return tids or [pid]


def subprocess_ok(cmd):
    try:
        return subprocess.run(cmd, capture_output=True,
                              timeout=5).returncode == 0
    except Exception:
        return False


def subprocess_which(name):
    return shutil.which(name)


# ── server ───────────────────────────────────────────────────────────────────
class Helper:
    def __init__(self):
        self.levers = Levers()
        self.lock = threading.Lock()
        self.perf_cpus = _performance_cpu_ids()

    def _authorized_pids(self, pids, peer_uid):
        """Drop anything the caller does not own. Root may name anything."""
        ok = []
        for p in pids:
            try:
                pid = int(p)
            except (TypeError, ValueError):
                continue
            if pid <= 1 or not _alive(pid):
                continue
            if peer_uid != 0 and _proc_uid(pid) != peer_uid:
                log(f"denied pid {pid} to uid {peer_uid} (not owner)")
                continue
            ok.append(pid)
        return ok

    def handle(self, req, peer_uid):
        op = req.get("op")
        if op == "ping":
            return {"ok": True, "perf_cpus": self.perf_cpus,
                    "ai_mode_active": _ai_mode_active()}

        if op == "boost":
            pids = self._authorized_pids(req.get("pids") or [], peer_uid)
            with self.lock:
                applied = {}
                for pid in pids:
                    applied[pid] = self.levers.boost_pid(pid, self.perf_cpus)
                gapplied, gskip = ([], None)
                if req.get("global", True):
                    gapplied, gskip = self.levers.apply_global()
            return {"ok": True, "boosted": applied, "global": gapplied,
                    "global_skipped": gskip}

        if op == "release":
            pids = self._authorized_pids(req.get("pids") or [], peer_uid)
            # A pid that already exited still needs its baseline dropped, so
            # release works off the recorded set rather than liveness.
            recorded = set(self.levers.state.get("procs", {}))
            with self.lock:
                for pid in pids:
                    self.levers.restore_pid(pid)
                for key in list(recorded):
                    if peer_uid != 0 and _proc_uid(int(key)) not in (peer_uid, None):
                        continue
                    if not _alive(int(key)):
                        self.levers.restore_pid(int(key))
                if req.get("global", True):
                    self.levers.restore_global()
            return {"ok": True}

        if op == "restore-all":
            if peer_uid != 0:
                # Scoped restore for a normal user: only their own processes,
                # plus the global knobs (which are machine-wide by nature and
                # were only ever set on a Studio Mode request).
                pids = [int(p) for p in self.levers.state.get("procs", {})
                        if _proc_uid(int(p)) in (peer_uid, None)]
                with self.lock:
                    for pid in pids:
                        self.levers.restore_pid(pid)
                    self.levers.restore_global()
            else:
                with self.lock:
                    self.levers.restore_all()
            return {"ok": True}

        if op == "status":
            return {"ok": True, "state": self.levers.state,
                    "perf_cpus": self.perf_cpus,
                    "ai_mode_active": _ai_mode_active()}

        return {"ok": False, "error": f"unknown op {op!r}"}

    def serve(self):
        os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK_PATH)
        # World-writable: any local user may ASK. What they may actually do is
        # decided per-request by SO_PEERCRED, not by file permissions.
        os.chmod(SOCK_PATH, 0o666)
        srv.listen(16)
        log(f"listening on {SOCK_PATH} (perf cpus: {self.perf_cpus or 'n/a'})")
        while True:
            try:
                conn, _ = srv.accept()
            except OSError:
                continue
            threading.Thread(target=self._client, args=(conn,),
                             daemon=True).start()

    def _client(self, conn):
        try:
            conn.settimeout(10)
            creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                    struct.calcsize("3i"))
            _pid, uid, _gid = struct.unpack("3i", creds)
            data = b""
            while b"\n" not in data:
                chunk = conn.recv(65536)
                if not chunk:
                    return
                data += chunk
                if len(data) > 1 << 20:      # 1MB of "request" is an attack
                    return
            req = json.loads(data.split(b"\n", 1)[0].decode())
            reply = self.handle(req, uid)
        except Exception as exc:
            reply = {"ok": False, "error": str(exc)}
        try:
            conn.sendall((json.dumps(reply) + "\n").encode())
        except OSError:
            pass
        finally:
            try:
                conn.close()
            except OSError:
                pass


def main():
    if os.geteuid() != 0:
        log("must run as root")
        return 1
    helper = Helper()

    def _bye(_sig, _frm):
        # Leaving a machine pinned to `performance` after the service stops
        # would be a silent battery/thermal regression, so unwind on the way out.
        log("shutting down — restoring baselines")
        try:
            helper.levers.restore_all()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, _bye)
    signal.signal(signal.SIGINT, _bye)
    # A previous run that was SIGKILLed leaves baselines on disk; unwind them
    # before taking new ones, or the originals are lost forever.
    if helper.levers.state:
        log("stale baselines from a previous run — restoring first")
        helper.levers.restore_all()
    helper.serve()
    return 0


if __name__ == "__main__":
    sys.exit(main())
