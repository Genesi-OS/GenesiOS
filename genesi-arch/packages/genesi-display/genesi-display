#!/usr/bin/env python3
"""
genesi-display — monitor scale and rotation for Hyprland, from anywhere.

── Why a CLI and not a panel ────────────────────────────────────────────────

Genesi offers nine desktops and, on Hyprland, more than one shell. A control
built into caelestia would not exist on a future genesi-hyprland, and one
built into a Quickshell widget would not exist for anyone using waybar. So the
logic lives here, once, and every front-end is a thin caller — exactly how
genesi-snapshots' GUI delegates to its CLI, with the CLI as the single source
of truth.

── The part that is easy to get wrong ───────────────────────────────────────

`hyprctl keyword monitor` takes the WHOLE monitor line. Setting a scale means
re-stating resolution, refresh rate, position and transform in the same
breath, so anything not read back correctly is silently reset — a user changes
the scale and their second screen jumps to the wrong place. Every value here
is read from `hyprctl monitors -j` first and passed through untouched.

And `hyprctl keyword` is runtime-only: it is gone on the next reload. Real
persistence means writing config, which is why this also maintains
~/.config/hypr/genesi-display.conf and makes sure the user's hyprland.conf
sources it. That file holds nothing but our overrides, so it can be deleted
whole without touching anything the user wrote.

Usage:
  genesi-display list                 what is connected, as JSON
  genesi-display show                 the same, readable
  genesi-display scale <name> <n>     1, 1.25, 1.5, 2 …, or "up"/"down"
  genesi-display rotate <name> <deg>  0, 90, 180, 270, or "cycle"
  genesi-display reset [name]         drop our override (all, or one)

A <name> of "-" means the monitor currently in use, which is what a keybind
or a launcher entry needs: those carry a fixed command and cannot know the
name of the screen you are looking at.
"""
import json
import os
import re
import shutil
import subprocess
import sys

CONF_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hypr")
MAIN_CONF = os.path.join(CONF_DIR, "hyprland.conf")
OUR_CONF = os.path.join(CONF_DIR, "genesi-display.conf")

# The line we add to the user's config, once, marked so it can be recognised
# and never duplicated.
SOURCE_MARKER = "# genesi-display: per-monitor overrides"
SOURCE_LINE = f"{SOURCE_MARKER}\nsource = ~/.config/hypr/genesi-display.conf\n"

# Hyprland's transform values. 4-7 are the flipped variants, which no UI here
# offers: someone who wants a mirrored display can write it by hand, and
# offering it in a menu mostly produces confused users.
DEG_TO_TRANSFORM = {0: 0, 90: 1, 180: 2, 270: 3}
TRANSFORM_TO_DEG = {v: k for k, v in DEG_TO_TRANSFORM.items()}

# The ladder `scale up` / `scale down` walks. Only values that divide common
# resolutions into whole pixels: Hyprland refuses the rest outright, and a
# keybind that errors every other press is worse than one that stops at the end.
SCALE_STEPS = [1.0, 1.25, 1.5, 1.75, 2.0]


def die(msg, code=1):
    sys.stderr.write(f"genesi-display: {msg}\n")
    sys.exit(code)


def hypr(*args, check=True):
    if not shutil.which("hyprctl"):
        die("hyprctl not found — is this a Hyprland session?", 2)
    p = subprocess.run(["hyprctl", *args], capture_output=True, text=True)
    if check and p.returncode != 0:
        die((p.stderr or p.stdout).strip() or "hyprctl failed")
    return p


def monitors():
    """Current state, straight from the compositor."""
    p = hypr("monitors", "-j")
    try:
        raw = json.loads(p.stdout)
    except json.JSONDecodeError:
        die("could not read hyprctl monitors -j")
    out = []
    for m in raw:
        out.append({
            "name": m.get("name", ""),
            "description": m.get("description", ""),
            "width": m.get("width", 0),
            "height": m.get("height", 0),
            "refresh": round(float(m.get("refreshRate", 0)), 2),
            "x": m.get("x", 0),
            "y": m.get("y", 0),
            "scale": round(float(m.get("scale", 1)), 6),
            "transform": int(m.get("transform", 0)),
            "rotation": TRANSFORM_TO_DEG.get(int(m.get("transform", 0))),
            "focused": bool(m.get("focused", False)),
            "disabled": bool(m.get("disabled", False)),
        })
    return out


def find(name):
    """
    Resolve a monitor name, where "-" means "the one being used right now".

    That alias exists for the launcher. A `>scale 150%` entry is a FIXED
    command -- caelestia's launcher actions cannot carry an argument typed by
    the user -- so there has to be a way to say "this screen" without knowing
    its name at the time the action was written.
    """
    mons = monitors()
    if name in ("-", "focused", ""):
        for m in mons:
            if m["focused"]:
                return m
        if mons:
            return mons[0]
        die("no monitors reported by Hyprland")
    for m in mons:
        if m["name"] == name:
            return m
    die(f"no monitor named {name!r}. Try: genesi-display show")


def monitor_line(m, scale=None, transform=None, x=None, y=None):
    """
    Rebuild the full monitor line, changing only what was asked for.

    Everything else is passed through from what the compositor reports. This
    is the whole reason the tool reads state first: a line that omits the
    position moves the display, and a user who changed the scale would find
    their second screen has jumped.
    """
    s = m["scale"] if scale is None else scale
    t = m["transform"] if transform is None else transform
    px = m["x"] if x is None else x
    py = m["y"] if y is None else y
    # Trailing zeros in the scale make Hyprland's parser unhappy in some
    # versions; normalise to the shortest exact form.
    s_str = f"{s:.6f}".rstrip("0").rstrip(".")
    return (f"{m['name']},{m['width']}x{m['height']}@{m['refresh']},"
            f"{px}x{py},{s_str},transform,{t}")


def logical_size(m, scale=None, transform=None):
    """
    The size a monitor occupies in the shared coordinate space.

    This is what neighbours are positioned against, and it is NOT the
    resolution: scaling 2560px by 1.25 makes the monitor 2048 wide as far as
    every other monitor is concerned. Rotating swaps the two.
    """
    s = m["scale"] if scale is None else scale
    t = m["transform"] if transform is None else transform
    w, h = m["width"], m["height"]
    if t in (1, 3, 5, 7):          # 90° / 270°, and their flipped forms
        w, h = h, w
    return int(round(w / s)), int(round(h / s))


def side_by_side(mons):
    """
    Were these monitors laid out in a plain row, touching, before we changed
    anything?

    Only then is it safe to move them. Someone who stacked a screen above
    another, or left a deliberate gap, arranged that by hand and would not
    thank us for straightening it out.
    """
    if len(mons) < 2:
        return False
    row = sorted(mons, key=lambda m: m["x"])
    if len({m["y"] for m in row}) != 1:
        return False
    x = row[0]["x"]
    for m in row:
        if m["x"] != x:
            return False
        x += logical_size(m)[0]
    return True


def apply_change(m, scale=None, transform=None):
    """
    Apply a change to one monitor, and leave the whole desktop consistent.

    Two things go wrong if only the changed monitor is touched, and both were
    reported from a real two-monitor desk:

      * The other screen keeps rendering its old contents until something
        happens on it. Hyprland reconfigures the output it is given a line
        for; the untouched one is never told anything happened.

      * Changing a scale changes the monitor's LOGICAL width, so a neighbour
        positioned right after it now overlaps it or floats away from it by
        the difference.

    So every monitor is re-applied, and when they were sitting in a plain
    touching row they are re-packed to stay touching. A deliberate arrangement
    (stacked, or spaced apart) is left exactly where the user put it.

    Returns the lines that need persisting: the changed monitor, plus anything
    we moved -- and nothing else, so a screen the user never touched does not
    silently acquire an override.
    """
    mons = monitors()
    repack = side_by_side(mons)

    lines = {}
    to_persist = {}
    x = None
    for mon in sorted(mons, key=lambda mm: mm["x"]):
        changed = mon["name"] == m["name"]
        sc = scale if changed else None
        tr = transform if changed else None
        new_x = mon["x"]
        if repack:
            if x is None:
                x = mon["x"]          # keep the leftmost where it is
            new_x = x
            x += logical_size(mon, sc, tr)[0]
        moved = new_x != mon["x"]
        line = monitor_line(mon, scale=sc, transform=tr, x=new_x)
        lines[mon["name"]] = line
        if changed or moved:
            to_persist[mon["name"]] = line

    # The changed monitor first: if Hyprland rejects the scale we want to fail
    # before having moved anybody.
    apply_live(lines[m["name"]])
    for name, line in lines.items():
        if name != m["name"]:
            apply_live(line)
    return to_persist


def apply_live(line):
    p = hypr("keyword", "monitor", line, check=False)
    out = (p.stdout + p.stderr).strip()
    if p.returncode != 0 or "invalid" in out.lower() or "error" in out.lower():
        # Hyprland refuses scales that do not divide into whole pixels. That is
        # a real answer, not a glitch, and the user needs to see it rather than
        # a silent no-op.
        die(f"Hyprland rejected the change:\n  {out}\n"
            f"  A scale must divide the resolution into whole pixels — try 1, 1.25, 1.5 or 2.")


def read_overrides():
    """Our persisted lines, as {monitor: line}."""
    result = {}
    if not os.path.exists(OUR_CONF):
        return result
    with open(OUR_CONF, "r", encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            m = re.match(r"monitor\s*=\s*(.+)$", line)
            if m:
                value = m.group(1).strip()
                result[value.split(",")[0].strip()] = value
    return result


def write_overrides(overrides):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(OUR_CONF, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("# Written by genesi-display. Safe to delete: it holds only\n"
                 "# per-monitor overrides, and nothing you wrote by hand.\n"
                 "#\n"
                 "# Hyprland applies later monitor= lines over earlier ones, so\n"
                 "# this is sourced at the END of hyprland.conf to win over the\n"
                 "# catch-all default.\n\n")
        for name in sorted(overrides):
            fh.write(f"monitor = {overrides[name]}\n")
    ensure_sourced()


def ensure_sourced():
    """
    Make the user's config pull ours in — once, and never twice.

    Appending is deliberate: Hyprland applies later monitor= lines over
    earlier ones, so our overrides have to come after the catch-all
    `monitor = , preferred, auto, 1` that Genesi ships.
    """
    if not os.path.exists(MAIN_CONF):
        # No config to edit. The live change already applied; say what will
        # not survive rather than failing after the fact.
        sys.stderr.write(
            f"genesi-display: {MAIN_CONF} does not exist, so the change is not\n"
            f"                persisted. It will be lost on the next reload.\n")
        return
    with open(MAIN_CONF, "r", encoding="utf-8", errors="replace") as fh:
        content = fh.read()
    if SOURCE_MARKER in content or "genesi-display.conf" in content:
        return
    with open(MAIN_CONF, "a", encoding="utf-8", newline="\n") as fh:
        fh.write(f"\n{SOURCE_LINE}")


def cmd_list():
    print(json.dumps(monitors(), indent=2))


def cmd_show():
    ov = read_overrides()
    for m in monitors():
        mark = " *" if m["focused"] else "  "
        rot = m["rotation"]
        rot_s = f"{rot}°" if rot is not None else f"transform {m['transform']}"
        pinned = " (pinned by genesi-display)" if m["name"] in ov else ""
        print(f"{mark} {m['name']}  {m['width']}x{m['height']}@{m['refresh']}Hz"
              f"  scale {m['scale']:g}  {rot_s}{pinned}")
        if m["description"]:
            print(f"     {m['description']}")


def cmd_scale(name, value):
    m = find(name)
    # A keybind cannot carry a number -- SUPER+= means "a bit bigger", not
    # "1.25". So up/down walk a ladder from wherever the screen currently is,
    # which also means the two keys stay correct after someone picks a value
    # from the launcher.
    if value in ("up", "down"):
        cur = m["scale"]
        nearest = min(range(len(SCALE_STEPS)),
                      key=lambda i: abs(SCALE_STEPS[i] - cur))
        idx = nearest + (1 if value == "up" else -1)
        if idx < 0 or idx >= len(SCALE_STEPS):
            # Already at an end. Say so instead of failing: a keybind that
            # prints an error when you press it once too often teaches people
            # the feature is broken.
            print(f"{m['name']}: already at {cur:g}x "
                  f"({'largest' if value == 'up' else 'smallest'})")
            return
        scale = SCALE_STEPS[idx]
        value = str(scale)
    else:
        try:
            scale = float(value)
        except ValueError:
            die(f"{value!r} is not a number, and not 'up' or 'down'")
    if not (0.1 <= scale <= 10):
        die(f"scale {scale} is out of range (0.1 – 10)")
    ov = read_overrides()
    # Keyed on the monitor's REAL name, never on the `-` the caller typed.
    # `ov["-"]` does not collide with the "DP-1" key a re-read produces, so a
    # second change wrote a SECOND line for the same monitor -- and Hyprland
    # applies the last matching line, which was the stale one. The change
    # reverted itself on the next reload, silently.
    ov.update(apply_change(m, scale=scale))
    write_overrides(ov)
    print(f"{m['name']}: scale {scale:g}")


def cmd_rotate(name, value):
    m = find(name)
    # "cycle" is what a keybind or a single launcher entry wants: one action
    # that keeps turning, instead of four entries the user has to choose
    # between while holding a laptop sideways.
    if value == "cycle":
        current = TRANSFORM_TO_DEG.get(m["transform"], 0)
        deg = (current + 90) % 360
    else:
        try:
            deg = int(value) % 360
        except ValueError:
            die(f"{value!r} is not a number of degrees, and not 'cycle'")
    if deg not in DEG_TO_TRANSFORM:
        die(f"rotation must be 0, 90, 180, 270 or 'cycle' (got {value})")
    ov = read_overrides()
    ov.update(apply_change(m, transform=DEG_TO_TRANSFORM[deg]))
    write_overrides(ov)
    print(f"{m['name']}: rotated {deg}°")


def cmd_reset(name=None):
    ov = read_overrides()
    if name:
        if name not in ov:
            print(f"{name}: no override to remove")
            return
        del ov[name]
    else:
        ov = {}
    write_overrides(ov)
    # Reload so the compositor forgets what we told it and falls back to the
    # config. Without this the live state keeps the value we just deleted, and
    # the user sees nothing happen.
    hypr("reload", check=False)
    print("reset" + (f" {name}" if name else " all monitors"))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "show":
        cmd_show()
    elif cmd == "scale":
        if len(rest) != 2:
            die("usage: genesi-display scale <monitor> <factor>")
        cmd_scale(*rest)
    elif cmd == "rotate":
        if len(rest) != 2:
            die("usage: genesi-display rotate <monitor> <degrees>")
        cmd_rotate(*rest)
    elif cmd == "reset":
        cmd_reset(rest[0] if rest else None)
    else:
        die(f"unknown command {cmd!r}. Try: genesi-display --help", 2)
    return 0


if __name__ == "__main__":
    sys.exit(main())
