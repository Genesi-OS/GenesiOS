SERVICES=("ananicy-cpp" "systemd-resolved" )

post_install() {
    echo "Enabling services..."
    for service in "${SERVICES[@]}"; do
        systemctl enable "$service"
    done
    if command -v iw >/dev/null 2>&1; then
        systemctl enable cachyos-iw-set-regdomain.path
    fi
    migrate_default_shell_fish
    migrate_fish_greeting_dedup
    fix_sddm_contrast
    fix_desktop_visual_defaults
}

post_upgrade() {
    echo "Enabling services..."

    for service in "${SERVICES[@]}"; do
        if systemctl is-active "$service" >/dev/null; then
            systemctl restart "$service"
        fi
    done

    fix_selection_contrast
    fix_titlebar_uniformity
    migrate_panel_widgets
    migrate_default_shell_fish
    migrate_fish_greeting_dedup
    fix_sddm_contrast
    fix_desktop_visual_defaults
}

# Apply the new visual defaults to existing users. Fresh and live users receive
# the same values from skel-override; this migration only touches the four keys
# owned by this release and leaves the rest of each user's theme intact.
fix_desktop_visual_defaults() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    local home u kf key
    for home in /home/*; do
        [ -d "$home/.config" ] || continue
        u=$(stat -c %U "$home" 2>/dev/null) || continue
        id "$u" >/dev/null 2>&1 || continue

        for kf in klassyrc klassy/klassyrc; do
            runuser -u "$u" -- kwriteconfig6 --file "$home/.config/$kf" --group Windeco \
                --key ColorizeWindowOutlineWithButton false 2>/dev/null || true
            runuser -u "$u" -- kwriteconfig6 --file "$home/.config/$kf" --group Windeco \
                --key ButtonShape ShapeFullHeightRectangle 2>/dev/null || true
        done
        runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kwinrc" --group org.kde.kdecoration2 \
            --key BorderSize NoSides 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kwinrc" --group org.kde.kdecoration2 \
            --key BorderSizeAuto false 2>/dev/null || true

        runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kdeglobals" --group "Colors:Selection" \
            --key BackgroundNormal "29,158,117" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kdeglobals" --group "Colors:Selection" \
            --key BackgroundAlternate "22,120,90" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kdeglobals" --group "Colors:Selection" \
            --key DecorationFocus "29,158,117" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kdeglobals" --group "Colors:Selection" \
            --key DecorationHover "29,158,117" 2>/dev/null || true
        for key in ForegroundActive ForegroundInactive ForegroundLink \
            ForegroundNegative ForegroundNeutral ForegroundNormal \
            ForegroundPositive ForegroundVisited; do
            runuser -u "$u" -- kwriteconfig6 --file "$home/.config/kdeglobals" \
                --group "Colors:Selection" --key "$key" "255,255,255" 2>/dev/null || true
        done
    done
}

fix_sddm_contrast() {
    /usr/lib/genesi/genesi-fix-sddm-contrast 2>/dev/null || true
}

# Stop the DOUBLE terminal greeting on systems seeded before the fix. The skel
# config.fish ran `fastfetch -l small` on every interactive fish, but the branded
# greeting is already shown once by genesi-fastfetch's vendor_conf.d — so older
# ~/.config/fish/config.fish files show the greeting twice (the distro-detected
# logo plus the branded Genesi one). New skel no longer runs fastfetch there;
# strip the leftover invocation from existing users' configs here. Only the plain
# `fastfetch -l small` line is removed (a user's own fastfetch lines are left
# alone); the branded vendor_conf.d greeting is untouched.
migrate_fish_greeting_dedup() {
    local home u cfg
    for home in /home/*; do
        cfg="$home/.config/fish/config.fish"
        [ -f "$cfg" ] || continue
        grep -q 'fastfetch -l small' "$cfg" 2>/dev/null || continue
        u=$(stat -c %U "$home" 2>/dev/null) || continue
        id "$u" >/dev/null 2>&1 || continue
        sed -i '/fastfetch -l small/d' "$cfg"
        chown "$u" "$cfg" 2>/dev/null || true
    done
}

# Switch existing regular users from the old default /bin/bash to fish — the new
# default interactive shell (autosuggestions + completions out of the box,
# CachyOS-style). NEW installs already get fish via the Calamares users module;
# this reaches systems installed BEFORE that change on `pacman -Syu`. Only users
# still on the DEFAULT /bin/bash are touched — anyone who picked another shell
# (zsh, etc.) is left alone — and only when fish is actually present (it's a hard
# dep, so it always is). fish is a LOGIN shell only: SDDM/the DE launches the
# desktop session, not the login shell, so this never affects DE startup; scripts
# keep using their #! interpreter. Takes effect in newly opened terminals (or
# after re-login). Fully reversible: `chsh -s /bin/bash`.
migrate_default_shell_fish() {
    local fish=/usr/bin/fish
    [ -x "$fish" ] || return 0
    command -v chsh >/dev/null 2>&1 || return 0
    local name pw uid gid gecos home sh
    while IFS=: read -r name pw uid gid gecos home sh; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 65000 ] 2>/dev/null || continue
        [ "$sh" = "/bin/bash" ] || continue
        chsh -s "$fish" "$name" 2>/dev/null || true
    done < <(getent passwd)
}

# Heal the selected-item text colour on systems installed before the
# readable-selection fix. The skel kdeglobals (white selected text) only seeds
# NEW users; an existing ~/.config/kdeglobals keeps its old
# [Colors:Selection] ForegroundNormal (dark -> near-black selected text, the
# "can't read selected items in the Package Installer" bug). genesi-apply-theme
# .sh can't fix it either: it self-deletes after the first login, and
# plasma-apply-colorscheme is a no-op once "Genesi" is already the active
# scheme. So force the selection foregrounds to white per existing user here,
# on every `pacman -Syu`. Only the selection foreground keys are touched; the
# rest of the user's palette is left alone. Takes effect on the next login (or
# immediately for apps reopened afterwards).
fix_selection_contrast() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    local home u
    for home in /home/*; do
        [ -f "$home/.config/kdeglobals" ] || continue
        u=$(stat -c %U "$home" 2>/dev/null) || continue
        id "$u" >/dev/null 2>&1 || continue
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals \
            --group "Colors:Selection" --key ForegroundNormal "255,255,255" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals \
            --group "Colors:Selection" --key ForegroundActive "255,255,255" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals \
            --group "Colors:Selection" --key ForegroundInactive "255,255,255" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals \
            --group "Colors:Selection" --key ForegroundLink "255,255,255" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals \
            --group "Colors:Selection" --key ForegroundVisited "255,255,255" 2>/dev/null || true
        # Heal the odd grey button background (44,44,42) left by older Genesi
        # color schemes — everything else in the scheme is the Genesi blue, so a
        # grey button stood out. Force it to the brand blue per existing user.
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals \
            --group "Colors:Button" --key BackgroundNormal "20,49,69" 2>/dev/null || true
    done
}

# Stop the titlebar floating lighter than the window body for users installed
# before this change. The old config forces a 70%-opaque Klassy titlebar over a
# ~78% window body; the new skel instead lets the titlebar inherit the system
# [WM] colour (alpha matched to the body) so the two read as one shade. Skel
# never touches an existing config, so flip Klassy's Override off and unify
# [WM]/outline per user here, on every `pacman -Syu`. The window body, its blur
# and the translucency effect are left UNTOUCHED — the glass is exactly as before;
# only the titlebar is corrected. Root has no session bus, so the values are
# written to the files and take effect on next login (like the selection heal).
fix_titlebar_uniformity() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    local home u kf key grp
    for home in /home/*; do
        [ -f "$home/.config/kdeglobals" ] || continue
        u=$(stat -c %U "$home" 2>/dev/null) || continue
        id "$u" >/dev/null 2>&1 || continue

        # Restore the window GLASS: put the alpha back on every window/view/
        # tooltip/complementary surface and the titlebar ([WM]). Darkly bakes a
        # window's translucency at creation from these alphas ([WM] activeBackground
        # + [Colors:Window] BackgroundNormal are the triggers), so this alpha is
        # exactly what makes windows see-through. The old code STRIPPED it for a
        # since-abandoned "opaque in AI Mode" feature; AI Mode now KEEPS the glass
        # (kwin-helper is a no-op), so we heal existing users back to translucent.
        for grp in "Colors:Window" "Colors:View" "Colors:Complementary"; do
            runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group "$grp" \
                --key BackgroundNormal "13,32,48,230" 2>/dev/null || true
            runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group "$grp" \
                --key BackgroundAlternate "18,45,64,230" 2>/dev/null || true
        done
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group "Colors:Tooltip" \
            --key BackgroundNormal "13,32,48,235" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group "Colors:Tooltip" \
            --key BackgroundAlternate "18,45,64,235" 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group "Colors:Button" \
            --key BackgroundAlternate "18,45,64,235" 2>/dev/null || true
        for key in activeBackground activeBlend inactiveBackground inactiveBlend; do
            runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group WM \
                --key "$key" "13,32,48,230" 2>/dev/null || true
        done
        # An older AI-Mode helper could have left the user on the now-removed
        # "Genesi-Solid" scheme; point them back at "Genesi" so the name resolves.
        if [ "$(runuser -u "$u" -- kreadconfig6 --file kdeglobals --group General \
                --key ColorScheme 2>/dev/null)" = "Genesi-Solid" ]; then
            runuser -u "$u" -- kwriteconfig6 --file kdeglobals --group General \
                --key ColorScheme "Genesi" 2>/dev/null || true
        fi

        # klassyrc: let the titlebar inherit the (now opaque) [WM] colour and
        # match the inactive window outline to the active one.
        for kf in klassyrc klassy/klassyrc; do
            runuser -u "$u" -- kwriteconfig6 --file "$kf" --group TitleBarOpacity \
                --key OverrideActiveTitleBarOpacity false 2>/dev/null || true
            runuser -u "$u" -- kwriteconfig6 --file "$kf" --group TitleBarOpacity \
                --key OverrideInactiveTitleBarOpacity false 2>/dev/null || true
            runuser -u "$u" -- kwriteconfig6 --file "$kf" --group WindowOutlineStyle \
                --key WindowOutlineCustomColorInactive "13,32,48" 2>/dev/null || true
        done

        # kwinrc: keep the translucency + blur effects enabled. They frost the
        # scheme-alpha glass and dim inactive/dialogs/menus; the active-window
        # transparency itself comes from the restored scheme alpha above (Darkly),
        # NOT from the effect (the effect doesn't dim a fully-active window).
        runuser -u "$u" -- kwriteconfig6 --file kwinrc --group Plugins \
            --key translucencyEnabled true 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kwinrc --group Plugins \
            --key kwin4_effect_translucencyEnabled true 2>/dev/null || true
        runuser -u "$u" -- kwriteconfig6 --file kwinrc --group Plugins \
            --key blurEnabled true 2>/dev/null || true
    done
}

# Heal the panel for users created before a default widget was added. New users
# get every default widget from the static skel appletsrc, but an EXISTING
# user's panel layout is whatever plasmashell built at their first login and is
# never touched by skel changes — so a widget added later (e.g.
# org.genesi.containers, shipped via the genesi-desktop meta) lands in
# /usr/share/plasma/plasmoids but never on the running panel. We can't edit the
# live appletsrc here (plasmashell clobbers it from memory on logout), and this
# scriptlet runs as root with no access to the user's session bus. So instead we
# drop a one-shot autostart into each existing user's ~/.config/autostart; on
# their next login genesi-panel-migrate.sh runs IN-session and adds any missing
# default widget to the live panel via the plasmashell scripting interface, then
# self-removes. It is idempotent (only adds a widget not already present) and
# guarded by a per-user marker, so it never duplicates a widget and never
# re-fires once it has succeeded.
migrate_panel_widgets() {
    local src=/usr/share/genesi/migrate/genesi-panel-migrate.desktop
    [ -f "$src" ] || return 0
    local home u uid gid
    for home in /home/*; do
        [ -d "$home" ] || continue
        # Already migrated for this user? leave it alone.
        [ -f "$home/.config/genesi/panel-migrate-containers.done" ] && continue
        u=$(stat -c %U "$home" 2>/dev/null) || continue
        id "$u" >/dev/null 2>&1 || continue
        uid=$(id -u "$u" 2>/dev/null) || continue
        gid=$(id -g "$u" 2>/dev/null) || continue
        install -d -o "$uid" -g "$gid" "$home/.config/autostart" 2>/dev/null || continue
        install -m 644 -o "$uid" -g "$gid" "$src" \
            "$home/.config/autostart/genesi-panel-migrate.desktop" 2>/dev/null || true
    done
}
