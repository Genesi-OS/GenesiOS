# Maintainer: Genesi OS Team <dev@genesios.org>
#
# Meta-package: pulls in the full set of Genesi OS desktop components. Its whole
# job is to make the Genesi experience a SINGLE dependency, so that:
#   * a fresh install only needs `genesi-desktop` (it drags in everything), and
#   * adding a new component later = add it here + bump pkgrel; every system that
#     has genesi-desktop then pulls the new component automatically on `pacman
#     -Syu` (a plain -Syu never installs brand-new packages on its own, which is
#     why older installs were missing AI Mode, the package installer, etc.).
#
# Build note: this is the one Genesi package that depends on OTHER Genesi
# packages, which aren't in any repo at CI build-deps time. publish-packages.yml
# therefore (a) filters genesi-* out of the pre-installed build deps and (b)
# builds this package with `makepkg -d` (skip the dep check). At INSTALL time the
# genesi repo has all of them, so the dependencies resolve normally.
pkgname=genesi-desktop
pkgver=1.0.0
# pkgrel 4: drop the KDE-only theming (genesi-kde-settings/klassy/darkly) from
# the meta. The meta is installed on EVERY desktop, so pulling genesi-kde-settings
# everywhere made it collide with the CachyOS WM settings on non-KDE installs
# (i3/niri/wayfire/… all provide+conflict cachyos-desktop-settings). Those three
# are KWin/Plasma-specific and are now installed by the KDE-Desktop netinstall
# group instead, so KDE still gets them and other desktops stay clean.
# pkgrel 5: add genesi-snapshots (the "indestructible OS" — automatic Btrfs
# restore points before every update + one-click rollback). In the meta so it
# reaches BOTH fresh installs and existing systems on `pacman -Syu`. It no-ops on
# a non-Btrfs root, so it's safe to ship to everyone.
# pkgrel 6: add Genesi PortScope (dashboard + Plasma widget + tray fallback).
# Gaming remains optional because its launcher/runtime stack is intentionally
# large; users install genesi-gaming from Welcome or Package Installer.
# pkgrel 7: add Genesi Forge, the local Git/GitHub and delivery dashboard.
# pkgrel 8: ship the branded Plymouth theme to fresh and existing systems.
# pkgrel 9: add Genesi Studio Mode (focus one app, freeze the rest, restore
# after). In the meta so it reaches fresh installs AND existing systems on
# `pacman -Syu`. It is inert until the user switches it on, and its widget
# follows whatever desktop is installed, so it is safe to ship to everyone.
# pkgrel 10: add Genesi Mesh. It shipped to the [genesi] repo in pkgrel 1 but
# was NOT listed here, so `pacman -Syu` had no reason to install it and it never
# reached any machine — the exact failure mode this file's header warns about.
pkgrel=10
pkgdesc='Genesi OS desktop meta-package (AI Mode, installer, theming, updater)'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL-3.0-or-later')
# The full default Genesi component set for an INSTALLED system. Installer-only
# packages (genesi-calamares, genesi-calamares-branding) are deliberately NOT
# here — they belong on the live ISO, not the target.
depends=(
    'genesi-settings'
    # genesi-kde-settings is KDE-only and now lives in the KDE-Desktop netinstall
    # group (see pkgrel 4 note) — NOT here, or it lands on every desktop.
    'genesi-ai-mode'
    # The Turbo backend is depended on by its VIRTUAL provide `llama.cpp`, NOT by
    # the concrete `genesi-llama-cpp` name. Both genesi-llama-cpp (Vulkan, the
    # shipped default) AND llama.cpp-cuda (AUR, the faster NVIDIA build) provide
    # `llama.cpp` and conflict with each other. A by-NAME dep here made switching
    # to CUDA impossible: removing genesi-llama-cpp to install llama.cpp-cuda
    # tripped "removing genesi-llama-cpp breaks dependency required by
    # genesi-desktop" and aborted the whole transaction. Depending on the provide
    # lets EITHER backend satisfy the meta-package, so the swap just works.
    'llama.cpp'
    'genesi-update'
    'genesi-channel'
    'genesi-welcome'
    'genesi-packageinstaller'
    # genesi-klassy (KWin decoration) + genesi-darkly (widget style) are
    # KDE-only too — installed by the KDE-Desktop netinstall group, not here.
    'genesi-grub-theme'
    'genesi-plymouth'
    'genesi-fastfetch'
    # Phase 4.3-4.6 developer tools (this OS targets programmers).
    'genesi-containers'    # Plasma widget for Docker/Podman
    'genesi-ports'         # port -> PID dashboard, Plasma widget + SNI tray
    'genesi-forge'         # local Git projects, pipelines + deploy integrations
    'genesi-sandboxes'     # Distrobox workspaces with stack templates
    'genesi-netinspect'    # mitmproxy HTTP/HTTPS debug proxy + toggle
    'genesi-db-explorer'   # DB client launcher + Dolphin integration
    # "Indestructible OS": snapper + snap-pac + grub-btrfs, wired ENXUTO, with a
    # branded manager app. No-op on non-Btrfs roots.
    'genesi-snapshots'
    # Studio Mode: hand the machine to one app (game, Genesi Code, DAW) and
    # freeze the rest. Inert until switched on; its widget follows the DE.
    'genesi-studio'
    # Genesi Mesh: pool GPU memory across machines on the LAN so a model that
    # fits on no single box still runs. The daemon idles at ~0 cost with one
    # machine, and worker mode is off by default, so shipping it by default
    # costs nothing — but NOT listing it here means `pacman -Syu` has no reason
    # to pull it, which is exactly why it never reached installed systems.
    'genesi-mesh'
)

package() {
    # Pure meta-package: no payload of its own.
    :
}
