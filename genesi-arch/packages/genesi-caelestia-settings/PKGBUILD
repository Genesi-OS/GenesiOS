# Maintainer: Genesi OS Team
#
# Genesi branding/config overlay for the "Hyprland + caelestia-shell" desktop
# option (Roadmap 5.1). It ships a ready-to-use Hyprland config into /etc/skel so
# every new user logs straight into a working caelestia desktop with the Genesi
# wallpaper and Material You scheme derived from it — the Hyprland equivalent of
# what genesi-kde-settings does for Plasma.
#
# Payload-only (no build). Installed by the Hyprland-Desktop netinstall group.
#
# NOTE: deliberately does NOT provide/conflict cachyos-desktop-settings. The
# always-on "Genesi OS" netinstall group installs genesi-kde-settings (which
# already provides cachyos-desktop-settings) on every system regardless of DE, so
# claiming that virtual here would make the two Genesi settings packages conflict.
pkgname=genesi-caelestia-settings
pkgver=1.0.0
# pkgrel 2: fix a malformed gradient color in hyprland.conf
# (col.active_border had `rgba(00 aaff ee)` with spaces in the hex). Hyprland
# 0.55 failed to parse it and the broken `general {}` block cascaded into bogus
# "dwindle:pseudotile does not exist" / "togglesplit dispatcher" errors on first
# Hyprland launch. Now `rgba(00aaffee)`.
# pkgrel 3: (1) render caelestia under the Qt Quick SOFTWARE backend inside VMs
# (systemd-detect-virt != none) — on VirtualBox the GPU/EGL path crashed
# Quickshell to a black screen; real hardware still gets GPU rendering/blur.
# (2) stop forcing the Genesi wallpaper — use caelestia's own default so its
# Material You palette comes from the shipped caelestia look.
# pkgrel 4: fix the magenta "missing icon" placeholders in the launcher/menus.
# The Hyprland session shipped no icon theme, so Qt/Quickshell (caelestia) and
# GTK apps had no app icons. Depend on papirus-icon-theme and set it as the
# default via /etc/skel qt6ct.conf + kdeglobals + gtk-3.0/settings.ini. Safe in
# /etc/skel: genesi-kde-settings strips its own skel, so nothing conflicts. Icons
# are CPU-rendered, so this is visible even under the VM software backend.
# pkgrel 5: default terminal kitty -> foot. kitty needs OpenGL and crashed to
# nothing inside VirtualBox (same GL gap that black-screened Quickshell); foot is
# a pure-software Wayland terminal that renders in VMs and is light on real
# hardware, so SUPER+Return works everywhere.
# pkgrel 6: fix the two on-screen Hyprland config errors for real. pkgrel 2 blamed
# a malformed gradient colour — that was WRONG (the errors persisted on bare metal
# after that fix). The real cause is Hyprland 0.54/0.55 breaking changes:
#   * `dwindle:pseudotile` was REMOVED in 0.55 (pseudotile is per-window only now)
#     -> dropped `pseudotile = true` from the dwindle {} block (line 88 error).
#       Pseudotiling still works via the `pseudo` dispatcher (SUPER+P) already bound.
#   * `togglesplit` stopped being a direct dispatcher in 0.54+ -> now sent via
#     `layoutmsg, togglesplit` (line 113 "dispatcher does not exist" error).
# Also: (a) tapping SUPER alone now opens the caelestia launcher (Windows-like;
# bindr SUPER,SUPER_L), and (b) start the Genesi update-notifier tray from
# hyprland.conf — Hyprland ignores /etc/xdg/autostart, so the shipped tray
# .desktop never fired under this session and no tray icon appeared. New dep:
# genesi-update (provides the `genesi-update --tray` SNI applet).
# pkgrel 7: migrate EXISTING users on upgrade. hyprland.conf ships via /etc/skel,
# which only seeds NEW accounts, so pkgrel 6's fixes + tray exec-once never
# reached an already-installed user (new binaries present, but nothing starts
# them and the old dwindle/togglesplit errors persist). New .install scriptlet
# edits each existing user's ~/.config/hypr/hyprland.conf in place: drops the
# removed pseudotile line, routes togglesplit via layoutmsg, and appends the tray
# exec-once + popup windowrule + SUPER-tap launcher if missing. Idempotent, backs
# the file up once (.genesi-bak), only touches Genesi's shipped config, preserves
# ownership. So now `pacman -Syu` (or the update notifier) + `hyprctl reload`
# brings a running install fully up to date — no reinstall.
# pkgrel 8: fix a regression I shipped in pkgrel 6/7 — the AI-tray `windowrule`
# lines used the OLD comma syntax (`windowrule = float, class:^(genesi-ai-tray)$`),
# which Hyprland 0.55 rejects ("invalid field float: missing a value"): 0.55 made
# the rule and its matchers SPACE-separated (`windowrule = float class:^(...)$`).
# Corrected the skel config AND the .install now heals the comma form an earlier
# upgrade already wrote to existing users (idempotent sed on windowrule lines).
# pkgrel 9: fix plain-Qt apps rendering WHITE on the dark desktop. The shipped
# qt6ct.conf had custom_palette=false + style=Breeze, so qt6ct gave non-KDE Qt
# apps the default LIGHT palette (and Breeze can be absent on a Hyprland-only
# install → silent fallback to light). Now ship a Genesi dark qt6ct colour scheme
# (genesi-dark.conf → /usr/share/qt6ct/colors/) and point qt6ct.conf at it
# (custom_palette=true, style=Fusion). The .install migration also flips an
# existing user's old custom_palette=false config. Does NOT touch kdeglobals, so
# a dual-DE user's KDE theme is left alone.
# pkgrel 10: the AI-tray windowrules STILL errored on screen — Hyprland 0.55
# rejects `noborder` ("invalid field type") and `rounding N` ("garbage input")
# even space-separated. They're cosmetic, so keep ONLY `float` (confirmed valid;
# the popup rounds itself via its stylesheet). The .install migration now also
# deletes the noborder/rounding/move windowrules an earlier upgrade wrote to
# existing users. (float + move parsed fine; dropped move too for minimalism.)
# pkgrel 11: DYNAMIC theme — Qt apps now follow caelestia's Material You scheme.
# caelestia 2.0.3 doesn't export its scheme to qt6ct (validated: colors/ dir
# never appears after a scheme change), so ship genesi-caelestia-theme-sync: it
# reads ~/.local/state/caelestia/scheme.json and regenerates a qt6ct colour
# scheme (colors/genesi-caelestia.conf) from the Material You roles, repointing
# qt6ct.conf at it; runs --watch from hyprland.conf and regenerates on every
# scheme change. The static genesi-dark.conf stays as the no-scheme fallback.
# (KF6/Dolphin reads kdeglobals, not qt6ct — a dual-DE-risky follow-up.) The
# .install migration adds the exec-once for existing users.
# pkgrel 12: the white/light theme toggle now works out of the box. caelestia
# ships "catppuccin mocha", a DARK-ONLY flavour, so toggling light failed with
# 'Scheme "catppuccin mocha" does not have a light mode.' (reported on a fresh
# install). "dynamic" (Material You from the wallpaper) is the only scheme that
# supports BOTH modes, so a marker-guarded first-login exec-once sets the scheme
# to dynamic once (retried, since dynamic needs the wallpaper set first). It never
# overrides a scheme the user later picks. The .install migrates existing users.
# pkgrel 13: stop the colour-sequence notification spam on wallpaper change. On a
# scheme change (which fires on EVERY wallpaper change under the dynamic scheme),
# caelestia-cli's apply_terms writes OSC terminal colour escapes to every /dev/pts
# (theme.enableTerm, default on). On this setup those escapes surface as a "system
# message" notification dumping the raw rgb sequences — annoying. Ship a caelestia
# cli.json with theme.enableTerm=false (terminals keep their own colours; foot's
# default is fine) via /etc/skel, and the .install merges it into existing users'
# cli.json without clobbering their other keys.
# pkgrel 14: start Genesi PortScope's SNI tray under Hyprland/Caelestia and
# migrate existing users (Hyprland does not process XDG autostart).
# pkgrel 15: start the Genesi AI Quick Chat background service so its native
# Ctrl+Alt+Space registration is available in Hyprland too.
# pkgrel 17: fix the session drawer's LOGOUT button leaving an infinite black
# screen. caelestia's default logout is `loginctl terminate-user ""` — it kills
# every user process at once (sddm-helper included, mid-teardown), and on real
# hardware the seat never returned to the SDDM greeter. Ship a shell.json with
# logout = `hyprctl dispatch exit` (the clean Hyprland session exit; SDDM then
# shows the greeter) via /etc/skel + .install merge for existing users (only
# sets session.commands.logout when the user hasn't customized it).
# pkgrel 16: float the Quick Chat under Hyprland. The frameless summon bar was
# being TILED into a workspace-high slab (reported 2026-07-18 with a photo of
# the screen). New windowrules float it at its own compact size, center it and
# pin it to every workspace; the .install appends them to existing users'
# configs (idempotent, same migration machinery as before). The window itself
# became drag-movable in genesi-ai-mode pkgrel 128.
# pkgrel 18: start genesi-studio-tray on this session too (exec-once). Hyprland
# ignores /etc/xdg/autostart, so without this the Studio Mode widget — whose
# tray is its ONLY form here, the KDE plasmoid needing plasmashell — simply
# never appeared on caelestia. Migrated into existing users' configs like the
# other trays.
# pkgrel 19: put display controls in the launcher, and fix a logout that was
# only half-fixed.
#
# caelestia reads its `>` actions from GlobalConfig.launcher.actions -- config,
# not code -- so Scale 100/125/150/200%, Rotate screen and Reset display are
# added with no new app, no new package and no QML override. They call
# genesi-display, which is Hyprland-level and works on any shell.
#
# The catch, and why ci/caelestia-actions-test.py now exists: that property is a
# single QVariantList, so setting it REPLACES upstream's thirteen defaults
# instead of merging. Our file has to carry all of them, and the day caelestia
# adds a fourteenth, Genesi users silently lose it. The check fails the build on
# that, on our own actions vanishing, and on the Logout regressing.
#
# And the Logout: pkgrel 17 fixed the SESSION DRAWER's `loginctl terminate-user`
# -- the infinite black screen -- but the launcher has its own copy of that
# command and was never covered. Two doors to the same room, one of them still
# open. Now both use `hyprctl dispatch exit`.
# pkgrel 20: the launcher actions never reached anyone who already had a
# home directory. shell.json ships through /etc/skel, which only ever seeds a
# NEW user -- so `>` showed no display controls even with the package installed,
# because the file it wanted to deliver was never delivered. This is the same
# lesson as the panel widget migration, learned again in a new place.
#
# The .install now merges launcher.actions for existing users, reading the list
# from the shipped /etc/skel copy rather than duplicating it in the scriptlet,
# so the two cannot drift. A user with their own actions keeps them untouched;
# the point is to reach people who never had the key.
#
# It also repairs the launcher's OWN Logout action if it still carries
# `loginctl terminate-user ""` -- the black screen fixed for the session drawer
# in pkgrel 17. Someone who already had an actions list would have kept the
# broken one forever otherwise.
pkgrel=22
pkgdesc='Genesi OS Hyprland + caelestia-shell default configuration and branding'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('GPL-3.0-or-later')
depends=(
    # The launcher actions and the keybinds shipped here CALL this. Without
    # the dependency the package installs, the entries appear, and clicking
    # them does nothing at all -- which is exactly what happened: genesi-display
    # was published and nothing pulled it in, so `Quickshell.execDetached` was
    # launching a binary that was not on the machine and failing silently.
    'genesi-display'
    # The volume keybinds shipped here run wpctl. It happens to be installed
    # today because the ISO package list carries wireplumber -- but this
    # package is what BINDS the keys, so this package is what should require
    # it. Found by the same check that found genesi-display missing.
    'wireplumber'
    'hyprland'
    'caelestia-shell'
    'genesi-settings'          # ships /usr/share/wallpapers/genesi/wallpaper.png
    'genesi-update'            # `genesi-update --tray` SNI applet, started from
                               # hyprland.conf (Hyprland ignores xdg/autostart)
    'genesi-ai-mode'           # `genesi-ai-tray` SNI applet (AI Mode widget)
    'genesi-containers'        # `genesi-containers-tray` SNI applet
    'genesi-ports'             # `genesi-ports-tray` SNI applet
    'polkit-kde-agent'
    'foot'                     # $terminal in hyprland.conf — no-GL Wayland term
                               # that renders in VMs (kitty needs OpenGL -> crash)
    'dolphin'                  # $fileManager
    'fuzzel'                   # launcher fallback + clipboard picker
    'cliphist'
    'wl-clipboard'
    'brightnessctl'
    'qt6ct'
    'papirus-icon-theme'       # app icons for the launcher/menus (no icon theme
                               # shipped before -> magenta "missing icon" squares)
)
install='genesi-caelestia-settings.install'
source=('hyprland.conf' 'qt6ct.conf' 'kdeglobals' 'gtk-settings.ini' 'genesi-dark.conf'
        'genesi-caelestia-theme-sync' 'cli.json' 'shell.json')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # Default Hyprland config for new users. Hyprland reads
    # ~/.config/hypr/hyprland.conf; shipping it via /etc/skel means the users
    # module (Calamares) copies it into /home/<user> at account creation.
    install -Dm644 "${srcdir}/hyprland.conf" \
        "${pkgdir}/etc/skel/.config/hypr/hyprland.conf"

    # Icon theme for new users (Papirus-Dark). Set it for Qt6 (qt6ct is the
    # platform theme via QT_QPA_PLATFORMTHEME in hyprland.conf), for Quickshell/
    # KDE-framework icon lookups (kdeglobals), and for GTK apps (dolphin, etc.).
    # Without this, caelestia's launcher shows magenta placeholders for app icons.
    # Safe in /etc/skel: genesi-kde-settings deliberately strips its own skel.
    install -Dm644 "${srcdir}/qt6ct.conf" \
        "${pkgdir}/etc/skel/.config/qt6ct/qt6ct.conf"
    install -Dm644 "${srcdir}/kdeglobals" \
        "${pkgdir}/etc/skel/.config/kdeglobals"
    install -Dm644 "${srcdir}/gtk-settings.ini" \
        "${pkgdir}/etc/skel/.config/gtk-3.0/settings.ini"

    # Genesi dark colour scheme for qt6ct (system-wide, referenced by qt6ct.conf
    # custom_palette=true). Makes plain-Qt apps dark under Hyprland instead of the
    # default light palette. KDE/KF6 apps are unaffected (they read kdeglobals).
    install -Dm644 "${srcdir}/genesi-dark.conf" \
        "${pkgdir}/usr/share/qt6ct/colors/genesi-dark.conf"

    # Dynamic-theme bridge: reads caelestia's active Material You scheme
    # (~/.local/state/caelestia/scheme.json) and regenerates a qt6ct colour
    # scheme from it so Qt apps follow the bar. Started with --watch from
    # hyprland.conf. Falls back to the static genesi-dark.conf when no scheme.
    install -Dm755 "${srcdir}/genesi-caelestia-theme-sync" \
        "${pkgdir}/usr/local/bin/genesi-caelestia-theme-sync"

    # caelestia-cli config: disable terminal colour-sequence application so a
    # scheme/wallpaper change doesn't spam the "system message" notification with
    # raw OSC rgb sequences (see the pkgrel 13 note). New users get it from skel;
    # existing users are migrated by the .install.
    install -Dm644 "${srcdir}/cli.json" \
        "${pkgdir}/etc/skel/.config/caelestia/cli.json"

    # caelestia-shell config: replace the session drawer's default LOGOUT
    # command. Upstream defaults to `loginctl terminate-user ""`, which nukes
    # every process of the user at once (including sddm-helper mid-teardown) —
    # on real hardware that left an infinite black screen instead of returning
    # to the SDDM greeter (reported 2026-07-18). `hyprctl dispatch exit` ends
    # the Hyprland session cleanly and SDDM comes back. Shutdown/reboot/
    # hibernate keep upstream defaults (systemctl — those are fine).
    install -Dm644 "${srcdir}/shell.json" \
        "${pkgdir}/etc/skel/.config/caelestia/shell.json"
}
