#!/usr/bin/env python3
# genesi-caelestia-theme-sync — make Qt apps follow caelestia's dynamic scheme.
#
# WHY THIS EXISTS
#   caelestia 2.0.3 generates a Material You palette for its own bar/shell but
#   does NOT export it to qt6ct on a Genesi install (validated: after a scheme
#   change ~/.config/qt6ct/colors/ doesn't even exist). So plain-Qt apps don't
#   follow the bar's colours. This bridge reads caelestia's ACTIVE scheme and
#   writes a qt6ct colour scheme from it, regenerating whenever the scheme
#   changes — the "dynamic theme" the static genesi-dark.conf couldn't give.
#
#   qt6ct apps read the palette at launch (qt6ct has no live reload), so a scheme
#   change recolours NEWLY launched apps.
#
#   KDE/KF6 APPS ARE THE OTHER HALF, and they were the follow-up this file's
#   header used to promise. They do not read qt6ct at all: Dolphin, Ark, Kate
#   and every app built on Kirigami — which is all six Genesi apps that use the
#   shared UI kit — take their colours from ~/.config/kdeglobals. That file
#   shipped with nothing in it but [Icons], so those apps fell back to Breeze
#   defaults and sat there in blue while the rest of the desktop followed the
#   wallpaper. That is what "the apps do not follow the theme" was.
#
#   kdeglobals is written by MERGE, never by replacement: [Icons] and anything
#   else in there is somebody's, and this only owns the colour groups. KF6 apps
#   watch the file (KConfigWatcher), so most of them recolour without a restart.
#
#   ── The dual-DE risk, and why it is acceptable ──────────────────────────────
#
#   kdeglobals is shared with a Plasma session on the same account. This runs
#   only under Hyprland (it is started from caelestia's hyprland.conf), so a
#   Plasma login inherits whatever scheme Hyprland last set. That is a
#   consistent desktop rather than a broken one, and Plasma's own scheme picker
#   overwrites it the moment somebody uses it.
#
# USAGE
#   genesi-caelestia-theme-sync           # one-shot: regenerate from the scheme
#   genesi-caelestia-theme-sync --watch   # apply once, then watch for changes
#
# Pure stdlib (no deps). Started with --watch from the caelestia hyprland.conf.
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

_CFG = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
_STATE = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
_DATA = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local/share"))

SCHEME = _STATE / "caelestia" / "scheme.json"
QT6CT_DIR = _CFG / "qt6ct"
COLORS = QT6CT_DIR / "colors" / "genesi-caelestia.conf"
QT6CT_CONF = QT6CT_DIR / "qt6ct.conf"
KDEGLOBALS = _CFG / "kdeglobals"
QT5CT_DIR = _CFG / "qt5ct"
QT5CT_COLORS = QT5CT_DIR / "colors" / "genesi-caelestia.conf"
# The .colors file KDE's scheme list is built from, and the thing kdeglobals'
# ColorScheme name has to resolve to. Under the user's data directory, because
# it is generated per user from whatever scheme is active right now.
COLOR_SCHEME = _DATA / "color-schemes" / "GenesiDynamic.colors"

# The name that shows up in KDE's own scheme list, written into kdeglobals'
# [General] ColorScheme.
#
# ── One token, used as the name AND as the file name ────────────────────────
#
# This used to be "Genesi Caelestia", and there was no file of that name
# anywhere -- which is the bug behind "Dolphin opens white, I set its colours
# to Default and it goes dark, I restart it and it is white again".
#
# There are two ways a KDE or Kirigami application arrives at a palette. It can
# read the [Colors:*] groups out of kdeglobals, which we write and which are
# correct -- that is the path taken when an app is told to use the default, and
# it is why setting Default by hand worked. Or it can resolve [General]
# ColorScheme to a .colors file and apply that, which is what happens at
# startup -- and a name that resolves to nothing does not mean "leave the
# palette alone", it means Breeze, which is light.
#
# So the file exists now. It has to be found by both of the ways KDE looks for
# it -- some code paths match the `Name=` inside the file, others match the
# file's own base name -- so the two are deliberately the same single token
# with no space in it. A prettier "Genesi Dynamic" would be a name that
# resolves through one path and not the other, which is the bug again with
# better spelling.
SCHEME_NAME = "GenesiDynamic"


def _hex(c, fallback="000000"):
    """Normalise a caelestia colour ('0a0f0f' / '#0a0f0f' / 'abc') to 'rrggbb'."""
    c = (c or "").lstrip("#").strip()
    if len(c) == 6:
        return c.lower()
    if len(c) == 3:
        return "".join(ch * 2 for ch in c).lower()
    return fallback


def load_scheme():
    """Return (colours dict, mode str) from caelestia's active scheme, or (None,_)."""
    try:
        s = json.loads(SCHEME.read_text())
        return (s.get("colours") or {}), (s.get("mode") or "dark")
    except Exception:
        return None, "dark"


def qt6ct_colorscheme(colours):
    """Build a qt6ct [ColorScheme]: 21 ARGB roles x 3 groups, from Material You.

    QPalette role order qt6ct expects: WindowText, Button, Light, Midlight, Dark,
    Mid, Text, BrightText, ButtonText, Base, Window, Shadow, Highlight,
    HighlightedText, Link, LinkVisited, AlternateBase, NoRole, ToolTipBase,
    ToolTipText, PlaceholderText.
    """
    def c(key, fb="000000"):
        return "#ff" + _hex(colours.get(key), fb)

    on_surface = c("onSurface", "e6e6e6")
    primary = c("primary", "4a90d9")
    outline = c("outline", "888888")

    active = [
        on_surface,                           # WindowText
        c("surfaceContainer", "2a2a2a"),      # Button
        c("surfaceBright", "3a3a3a"),         # Light
        c("surfaceContainerHigh", "333333"),  # Midlight
        c("surfaceContainerLowest", "0a0a0a"),# Dark
        c("surfaceContainerHigh", "333333"),  # Mid
        on_surface,                           # Text
        c("onPrimary", "ffffff"),             # BrightText
        on_surface,                           # ButtonText
        c("surfaceContainerLowest", "0a0a0a"),# Base
        c("surface", "1a1a1a"),               # Window
        c("shadow", "000000"),                # Shadow
        primary,                              # Highlight
        c("onPrimary", "ffffff"),             # HighlightedText
        primary,                              # Link
        c("secondary", "8888aa"),             # LinkVisited
        c("surfaceContainerLow", "202020"),   # AlternateBase
        c("surface", "1a1a1a"),               # NoRole
        c("surfaceContainerHigh", "333333"),  # ToolTipBase
        on_surface,                           # ToolTipText
        outline,                              # PlaceholderText
    ]
    disabled = list(active)
    for i in (0, 6, 8, 20):       # dim WindowText / Text / ButtonText / Placeholder
        disabled[i] = outline
    disabled[12] = c("surfaceContainerHigh", "333333")   # muted Highlight
    disabled[13] = on_surface                            # HighlightedText

    return ("[ColorScheme]\n"
            f"active_colors={', '.join(active)}\n"
            f"disabled_colors={', '.join(disabled)}\n"
            f"inactive_colors={', '.join(active)}\n")


def _set_appearance(text, kv):
    """Return qt6ct.conf text with the given keys set inside [Appearance]
    (replacing or inserting), preserving every other line/section."""
    lines = text.splitlines()
    out, in_appearance, seen = [], False, set()
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            # leaving [Appearance]: flush any keys we didn't see yet
            if in_appearance:
                for k, v in kv.items():
                    if k not in seen:
                        out.append(f"{k}={v}")
                        seen.add(k)
            in_appearance = (stripped == "[Appearance]")
            out.append(line)
            continue
        if in_appearance and "=" in stripped:
            key = stripped.split("=", 1)[0].strip()
            if key in kv:
                out.append(f"{key}={kv[key]}")
                seen.add(key)
                continue
        out.append(line)
    if in_appearance:  # file ended inside [Appearance]
        for k, v in kv.items():
            if k not in seen:
                out.append(f"{k}={v}")
    if "[Appearance]" not in text:  # no section at all — create it
        out = ["[Appearance]"] + [f"{k}={v}" for k, v in kv.items()] + out
    return "\n".join(out) + "\n"


def _rgb(colours, key, fb="000000"):
    """KDE writes colours as decimal 'r,g,b', not as hex."""
    h = _hex(colours.get(key), fb)
    return "%d,%d,%d" % (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))


def kdeglobals_groups(colours, mode):
    """
    The colour groups every KF6 and Kirigami app reads.

    Six groups plus the window manager's, because KDE does not have one palette
    — it has one per surface, and an app that only gets [Colors:Window] draws
    its list views in the default blue-grey while its chrome follows the scheme.
    That is worse than not theming it at all: it looks broken rather than
    untouched.

    Every group needs the same twelve keys. A missing key does not inherit from
    another group; it falls back to Breeze's value for that key, which is how a
    half-written scheme ends up with one stray blue link on every page.
    """
    def g(bg, alt, fg, dim):
        return {
            "BackgroundNormal": _rgb(colours, bg, "1a1a1a"),
            "BackgroundAlternate": _rgb(colours, alt, "202020"),
            "ForegroundNormal": _rgb(colours, fg, "e6e6e6"),
            "ForegroundInactive": _rgb(colours, dim, "888888"),
            "ForegroundActive": _rgb(colours, "primary", "4a90d9"),
            "ForegroundLink": _rgb(colours, "primary", "4a90d9"),
            "ForegroundVisited": _rgb(colours, "secondary", "8888aa"),
            "ForegroundNegative": _rgb(colours, "error", "d64541"),
            "ForegroundNeutral": _rgb(colours, "tertiary", "d6a441"),
            "ForegroundPositive": _rgb(colours, "secondary", "41d67a"),
            "DecorationFocus": _rgb(colours, "primary", "4a90d9"),
            "DecorationHover": _rgb(colours, "primary", "4a90d9"),
        }

    groups = {
        "General": {
            "ColorScheme": SCHEME_NAME,
            # Light or dark is not derivable from the colours by anything that
            # reads this file, and getting it wrong makes an app pick black
            # icons for a black background.
            "ColorSchemeHash": mode,
        },
        "Colors:Window": g("surface", "surfaceContainer", "onSurface",
                           "onSurfaceVariant"),
        # Views are lists and text areas -- the surface a document sits on.
        "Colors:View": g("surfaceContainerLowest", "surfaceContainerLow",
                         "onSurface", "onSurfaceVariant"),
        "Colors:Button": g("surfaceContainer", "surfaceContainerHigh",
                           "onSurface", "onSurfaceVariant"),
        "Colors:Selection": g("primary", "primary", "onPrimary", "onPrimary"),
        "Colors:Tooltip": g("surfaceContainerHigh", "surfaceContainerHighest",
                            "onSurface", "onSurfaceVariant"),
        "Colors:Complementary": g("surfaceContainerLowest", "surfaceContainerLow",
                                  "onSurface", "onSurfaceVariant"),
        "Colors:Header": g("surfaceContainer", "surfaceContainerHigh",
                           "onSurface", "onSurfaceVariant"),
        # Titlebars, for the KDE apps that draw their own.
        "WM": {
            "activeBackground": _rgb(colours, "surfaceContainer", "202020"),
            "activeForeground": _rgb(colours, "onSurface", "e6e6e6"),
            "inactiveBackground": _rgb(colours, "surface", "1a1a1a"),
            "inactiveForeground": _rgb(colours, "onSurfaceVariant", "888888"),
            "activeBlend": _rgb(colours, "primary", "4a90d9"),
            "inactiveBlend": _rgb(colours, "outline", "888888"),
        },
    }
    return groups


def merge_ini(text, groups):
    """
    Set the given sections' keys, keeping every other section and key.

    kdeglobals is not ours. It carries [Icons] from the package, whatever KDE
    apps have written into it, and whatever the user has. Rewriting the file
    from a template would take the icon theme with it -- which is the shape of
    the bug this project has already had once, where a first-login race
    clobbered kdeglobals and every selected item went black.
    """
    lines = text.splitlines() if text else []
    out, current, seen = [], None, {}
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            # Leaving a section we own: append the keys it did not already have.
            if current in groups:
                for k, v in groups[current].items():
                    if k not in seen.get(current, ()):
                        out.append("%s=%s" % (k, v))
            current = stripped[1:-1]
            seen.setdefault(current, set())
            out.append(line)
            continue
        if current in groups and "=" in stripped:
            key = stripped.split("=", 1)[0].strip()
            if key in groups[current]:
                out.append("%s=%s" % (key, groups[current][key]))
                seen[current].add(key)
                continue
        out.append(line)

    if current in groups:
        for k, v in groups[current].items():
            if k not in seen.get(current, ()):
                out.append("%s=%s" % (k, v))

    # Sections the file did not have at all.
    for name, kv in groups.items():
        if name in seen:
            continue
        if out and out[-1].strip():
            out.append("")
        out.append("[%s]" % name)
        out.extend("%s=%s" % (k, v) for k, v in kv.items())

    return "\n".join(out).rstrip("\n") + "\n"


def apply_color_scheme(colours, mode):
    """
    Write the .colors file that kdeglobals' ColorScheme name points at.

    Same colours as the groups in kdeglobals, in the file format KDE's own
    scheme list is built from. Both have to exist: apps that read the groups
    were already right, and apps that resolve the NAME were landing on Breeze
    because there was nothing to resolve it to.

    Written whole rather than merged, unlike kdeglobals -- this file is ours,
    it is regenerated on every scheme change, and there is nothing in it that
    anyone else has any business having written.
    """
    groups = kdeglobals_groups(colours, mode)
    out = [
        "# Auto-generated by genesi-caelestia-theme-sync from caelestia's",
        "# active Material You scheme. Overwritten on every scheme change.",
        "",
        "[General]",
        # Both, and identical: KDE matches this file by its Name in some code
        # paths and by its base name in others.
        f"Name={SCHEME_NAME}",
        f"ColorScheme={SCHEME_NAME}",
        "shadeSortColumn=true",
        "",
        # Disabled and inactive are DERIVED by KDE from these two effect
        # blocks rather than from colours, so leaving them out gives greyed-out
        # text that is grey in the Breeze sense -- computed against a light
        # background that is not there.
        "[ColorEffects:Disabled]",
        "ChangeSelectionColor=",
        "Color=56,56,56",
        "ColorAmount=0",
        "ColorEffect=0",
        "ContrastAmount=0.65",
        "ContrastEffect=1",
        "Enable=",
        "IntensityAmount=0.1",
        "IntensityEffect=2",
        "",
        "[ColorEffects:Inactive]",
        "ChangeSelectionColor=true",
        "Color=112,111,110",
        "ColorAmount=0.025",
        "ColorEffect=2",
        "ContrastAmount=0.1",
        "ContrastEffect=2",
        "Enable=false",
        "IntensityAmount=0",
        "IntensityEffect=0",
    ]
    for name, kv in groups.items():
        if name == "General":
            continue
        out.append("")
        out.append(f"[{name}]")
        out.extend(f"{k}={v}" for k, v in kv.items())
    COLOR_SCHEME.parent.mkdir(parents=True, exist_ok=True)
    COLOR_SCHEME.write_text("\n".join(out) + "\n")


def apply_kde(colours, mode):
    """Write the colour groups into kdeglobals, keeping everything else."""
    try:
        existing = KDEGLOBALS.read_text()
    except OSError:
        existing = ""
    KDEGLOBALS.parent.mkdir(parents=True, exist_ok=True)
    KDEGLOBALS.write_text(merge_ini(existing, kdeglobals_groups(colours, mode)))


def poke_kde():
    """
    Tell running KDE apps the palette changed.

    KF6 apps watch kdeglobals through KConfigWatcher and mostly repaint on their
    own, but the signal is what KDE itself emits and it is what the ones that do
    not watch are listening for. Without it, "the theme changed" means "the apps
    you open from now on"; with it, most of what is already open follows.

    Best effort by design: no dbus-send, no signal, no complaint. A theme sync
    that fails because a notification could not be delivered would be a worse
    program than one that quietly themes the next launch.
    """
    if not shutil.which("dbus-send"):
        return
    try:
        subprocess.run(
            ["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
             "org.kde.KGlobalSettings.notifyChange", "int32:2", "int32:0"],
            capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def apply_qt5(colours):
    """
    The same palette for qt5ct, for the Qt5 apps that are still around.

    The colour file is written unconditionally -- it is inert if nothing reads
    it -- but qt5ct.conf is only touched when it already exists. Creating one
    would be this package deciding that a machine uses qt5ct, which is not its
    call and would put a config file in front of a program that is not there.
    """
    QT5CT_COLORS.parent.mkdir(parents=True, exist_ok=True)
    QT5CT_COLORS.write_text(
        "# Auto-generated by genesi-caelestia-theme-sync.\n"
        + qt6ct_colorscheme(colours))
    conf = QT5CT_DIR / "qt5ct.conf"
    if not conf.exists():
        return
    conf.write_text(_set_appearance(conf.read_text(), {
        "color_scheme_path": str(QT5CT_COLORS),
        "custom_palette": "true",
    }))


def apply():
    """Regenerate the qt6ct colour scheme from caelestia's active scheme and
    point qt6ct.conf at it. No-op (keeps the static fallback) if no scheme."""
    colours, mode = load_scheme()
    if not colours:
        return False
    COLORS.parent.mkdir(parents=True, exist_ok=True)
    COLORS.write_text(
        "# Auto-generated by genesi-caelestia-theme-sync from caelestia's active\n"
        "# Material You scheme. Do not edit — it is overwritten on every scheme\n"
        "# change. Source: ~/.local/state/caelestia/scheme.json\n"
        + qt6ct_colorscheme(colours))
    icon = "Papirus" if mode == "light" else "Papirus-Dark"
    try:
        existing = QT6CT_CONF.read_text()
    except Exception:
        existing = "[Appearance]\nstandard_dialogs=default\nstyle=Fusion\n"
    QT6CT_CONF.parent.mkdir(parents=True, exist_ok=True)
    QT6CT_CONF.write_text(_set_appearance(existing, {
        "color_scheme_path": str(COLORS),
        "custom_palette": "true",
        "icon_theme": icon,
    }))

    # The other two toolkits. Wrapped so a failure in one does not stop the
    # others: a machine with no kdeglobals is not a reason for Qt apps to go
    # untouched, and the whole point of this program is that it either themes
    # everything it can or says which part it could not.
    for name, fn in (("kdeglobals", lambda: apply_kde(colours, mode)),
                     ("color-scheme",
                      lambda: apply_color_scheme(colours, mode)),
                     ("qt5ct", lambda: apply_qt5(colours)),
                     ("notify", poke_kde)):
        try:
            fn()
        except Exception as exc:
            sys.stderr.write("genesi-caelestia-theme-sync: %s: %s\n"
                             % (name, exc))
    return True


def watch():
    apply()
    last = None
    try:
        last = SCHEME.stat().st_mtime
    except OSError:
        pass
    while True:
        time.sleep(2)
        try:
            mtime = SCHEME.stat().st_mtime
        except OSError:
            continue
        if mtime != last:
            last = mtime
            apply()


def main():
    if "--watch" in sys.argv[1:]:
        watch()
    else:
        sys.exit(0 if apply() else 1)


if __name__ == "__main__":
    main()
