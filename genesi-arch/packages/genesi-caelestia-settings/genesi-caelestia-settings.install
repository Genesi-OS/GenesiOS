# genesi-caelestia-settings — post-upgrade migration of EXISTING users' Hyprland
# config.
#
# The shipped hyprland.conf lives in /etc/skel, which only seeds NEW accounts. An
# already-installed user keeps the copy Calamares made at account creation, so a
# package upgrade that fixes hyprland.conf (e.g. the Hyprland 0.55 dwindle/
# togglesplit breakage, or the new tray exec-once lines) never reaches them — the
# new binaries land in /usr/local/bin but nothing starts them and the old config
# still errors. The KDE side heals this with an in-session autostart (it needs the
# plasmashell scripting API), but here the target is a plain text file in $HOME,
# so we edit it directly from the (root) scriptlet.
#
# SAFE BY DESIGN: we only touch files that are Genesi's shipped caelestia config
# (header marker), back the file up once, change ONLY the two known-broken lines,
# and APPEND the tray/launcher/windowrule blocks only when they're missing. A
# user's own edits elsewhere are untouched; re-running is idempotent.

_migrate_hypr() {
    local cfg="$1" owner="$2"
    [ -f "$cfg" ] || return 0
    # Only Genesi's caelestia config (distinctive exec-once marker) -- never a
    # config the user wrote themselves.
    grep -q 'caelestia shell -d' "$cfg" || return 0
    # There used to be a "skip if fully up to date" gate here that listed every
    # previous migration by hand. Adding a section without also adding its
    # marker to that list meant the function returned BEFORE reaching the new
    # section, so it silently never ran -- which is exactly what happened to
    # the display keybinds: written, shipped, installed, and never applied to a
    # single existing config.
    #
    # The gate is gone. Every section below is individually idempotent (each
    # appends only when its own marker is absent, and each sed matches only the
    # broken form it repairs), so running the whole function on every upgrade is
    # correct by construction rather than by remembering. It costs a handful of
    # greps on one small file, once per upgrade.
    #
    # ci/hypr-migration-test.sh reads the markers straight out of this file and
    # fails the build if any section does not apply, so a forgotten section
    # cannot ship again.

    cp -n "$cfg" "$cfg.genesi-bak" 2>/dev/null || true

    # 1. dwindle:pseudotile was REMOVED in Hyprland 0.55 — drop the line.
    sed -i '/^[[:space:]]*pseudotile[[:space:]]*=[[:space:]]*true[[:space:]]*$/d' "$cfg"
    # 2. togglesplit is no longer a direct dispatcher (0.54+) — route via layoutmsg.
    sed -i 's/\(,[[:space:]]*J,[[:space:]]*\)togglesplit,[[:space:]]*$/\1layoutmsg, togglesplit/' "$cfg"
    # 2b. Hyprland 0.55 windowrule syntax: the rule and its matchers are now
    #     SPACE-separated, not comma — `windowrule = float, class:..` errors with
    #     "invalid field". Heal the comma form an earlier upgrade may have written.
    sed -i '/^windowrule = /s/,[[:space:]]*class:/ class:/' "$cfg"
    # 2c. Hyprland 0.55 rejects the noborder/rounding/move windowrules
    #     ("invalid field type noborder" / "rounding … garbage input"). They're
    #     cosmetic — drop them, keep only `float` (the popup rounds itself).
    sed -i -E '/^windowrule = (noborder|rounding|move).*genesi-ai-tray/d' "$cfg"

    # 3. tray applets + popup windowrule (append once).
    if ! grep -q 'genesi-ai-tray' "$cfg"; then
        cat >> "$cfg" <<'HYPR'

# ── Added by a genesi-caelestia-settings upgrade ──────────────────────────────
# Genesi system-tray applets (Hyprland ignores /etc/xdg/autostart, so start them
# here). They appear in the caelestia bar's StatusNotifierItem tray.
exec-once = genesi-update --tray
exec-once = genesi-ai-tray
exec-once = genesi-containers-tray
exec-once = genesi-ports-tray
# Float the AI Mode tray popup (only `float` — Hyprland 0.55 rejects the
# noborder/rounding/move rules; the popup rounds itself via its stylesheet).
windowrule = float class:^(genesi-ai-tray)$
HYPR
    fi

    # Users who already received the original tray block still need PortScope.
    if ! grep -q 'genesi-ports-tray' "$cfg"; then
        printf '%s\n' 'exec-once = genesi-ports-tray' >> "$cfg"
    fi

    # …and Studio Mode (its tray is the ONLY widget on this session — the KDE
    # plasmoid doesn't load without plasmashell).
    if ! grep -q 'genesi-studio-tray' "$cfg"; then
        printf '%s\n' 'exec-once = genesi-studio-tray' >> "$cfg"
    fi

    # Hyprland does not process XDG autostart. Keep the Quick Chat daemon warm;
    # it registers Ctrl+Alt+Space with hyprctl and its singleton socket makes
    # this safe alongside the systemd user unit.
    if ! grep -q 'genesi-ai-quick --background' "$cfg"; then
        printf '%s\n' 'exec-once = genesi-ai-quick --background' >> "$cfg"
    fi

    # 4. Windows-like SUPER tap → launcher (append once).
    if ! grep -q 'bindr = SUPER, SUPER_L' "$cfg"; then
        cat >> "$cfg" <<'HYPR'
# Tap SUPER alone to open the caelestia launcher (Windows-like).
bindr = SUPER, SUPER_L, exec, caelestia shell drawers toggle launcher
HYPR
    fi

    # 5. Dynamic-theme bridge (added in pkgrel 11) — start it if missing so Qt
    #    apps follow caelestia's scheme. Idempotent.
    if ! grep -q 'genesi-caelestia-theme-sync' "$cfg"; then
        printf '%s\n' 'exec-once = genesi-caelestia-theme-sync --watch' >> "$cfg"
    fi

    # 6. First-login default scheme = "dynamic" (added in pkgrel 12) so the
    #    light/white-theme toggle works (catppuccin mocha is dark-only). One-shot,
    #    marker-guarded — never overrides a scheme the user later picks. Idempotent.
    if ! grep -q 'genesi-scheme-init' "$cfg"; then
        cat >> "$cfg" <<'HYPR'
# Default to the "dynamic" scheme once so the light-theme toggle works (the
# stock "catppuccin mocha" is dark-only). Marker-guarded; runs once.
exec-once = sh -c 'm="$HOME/.config/caelestia/.genesi-scheme-init"; [ -e "$m" ] && exit 0; for i in 1 2 3 4 5 6; do if caelestia scheme set --name dynamic; then mkdir -p "$HOME/.config/caelestia"; touch "$m"; break; fi; sleep 3; done'
HYPR
    fi

    # 7. Quick Chat windowrules (append once). Hyprland TILED the frameless
    #    summon bar into a workspace-high slab (reported 2026-07-18, photo).
    #    Float it at its own compact size, centered, pinned to every workspace.
    if ! grep -q 'aiquick)' "$cfg"; then
        cat >> "$cfg" <<'HYPR'
# Genesi AI Quick Chat (Ctrl+Alt+Space): never tile the summon bar — float it
# at its own size, centered, on every workspace (it is drag-movable).
windowrule = float class:^(org\.genesi\.aiquick)$
windowrule = center class:^(org\.genesi\.aiquick)$
windowrule = pin class:^(org\.genesi\.aiquick)$
HYPR
    fi

    # 8. Display keybinds (added in pkgrel 21). The launcher entries for scale
    #    and rotation only reach people who go looking in `>`; these are the
    #    same actions on the keyboard. Guarded on the binary name so a user who
    #    rebound them keeps their own.
    if ! grep -q 'genesi-display' "$cfg"; then
        cat >> "$cfg" <<'HYPR'
# Display: scale and rotation from the keyboard. `-` is the screen in use.
bind = SUPER, equal, exec, genesi-display scale - up
bind = SUPER, minus, exec, genesi-display scale - down
bind = SUPER SHIFT, R, exec, genesi-display rotate - cycle
HYPR
    fi

    # sed -i / >> as root leave the file root-owned — hand it back to the user.
    chown "$owner" "$cfg" "$cfg.genesi-bak" 2>/dev/null || true
}

# Dark palette for plain-Qt apps under Hyprland. The shipped qt6ct.conf used to
# have custom_palette=false → qt6ct handed apps the default LIGHT palette (white
# apps on a dark desktop). Flip ONLY that old default (a user's own choice is
# left alone), point it at the Genesi dark scheme, and use the always-present
# Fusion style. Does NOT touch kdeglobals, so a dual-DE user's KDE theme is safe.
_migrate_qt6ct() {
    local qt6="$1" owner="$2"
    [ -f "$qt6" ] || return 0
    grep -q '^custom_palette=false' "$qt6" || return 0
    cp -n "$qt6" "$qt6.genesi-bak" 2>/dev/null || true
    sed -i 's/^custom_palette=false/custom_palette=true/' "$qt6"
    grep -q '^color_scheme_path=' "$qt6" \
        || sed -i '/^\[Appearance\]/a color_scheme_path=/usr/share/qt6ct/colors/genesi-dark.conf' "$qt6"
    sed -i 's/^style=Breeze$/style=Fusion/' "$qt6"
    chown "$owner" "$qt6" "$qt6.genesi-bak" 2>/dev/null || true
}

# Disable caelestia-cli's terminal colour-sequence application (theme.enableTerm).
# It writes OSC colour escapes to every /dev/pts on each scheme change (which fires
# on every wallpaper change under the dynamic scheme); on this setup those escapes
# surface as a "system message" notification dumping the raw rgb sequences. New
# users get cli.json from /etc/skel; existing users are merged here. We MERGE (only
# set theme.enableTerm=false) so a user's other cli.json keys are preserved.
_migrate_cli_json() {
    local cli="$1" owner="$2"
    python3 - "$cli" <<'PY' || return 0
import json, os, sys
p = sys.argv[1]
try:
    with open(p) as f:
        data = json.load(f)
    if not isinstance(data, dict):
        data = {}
except (FileNotFoundError, json.JSONDecodeError, OSError):
    data = {}
theme = data.get("theme")
if not isinstance(theme, dict):
    theme = {}
    data["theme"] = theme
if theme.get("enableTerm") is False:
    sys.exit(0)  # already disabled — leave the file untouched
theme["enableTerm"] = False
os.makedirs(os.path.dirname(p), exist_ok=True)
with open(p, "w") as f:
    json.dump(data, f, indent=2)
PY
    chown "$owner" "$(dirname "$cli")" "$cli" 2>/dev/null || true
}

# Fix the session drawer's logout for existing users. Upstream caelestia
# defaults logout to `loginctl terminate-user ""`, which kills every user
# process at once (sddm-helper included) — on real hardware that left an
# infinite black screen instead of returning to the SDDM greeter. We only SET
# session.commands.logout when the user hasn't configured one; any custom
# command (or any other shell.json key) is left untouched.
_migrate_shell_json() {
    local shl="$1" owner="$2"
    python3 - "$shl" <<'PY' || return 0
import json, os, sys
p = sys.argv[1]
try:
    with open(p) as f:
        data = json.load(f)
    if not isinstance(data, dict):
        data = {}
except (FileNotFoundError, json.JSONDecodeError, OSError):
    data = {}
session = data.get("session")
if not isinstance(session, dict):
    session = {}
    data["session"] = session
commands = session.get("commands")
if not isinstance(commands, dict):
    commands = {}
    session["commands"] = commands
changed = False

# 1. The session drawer's logout. Upstream's `loginctl terminate-user ""` kills
#    every user process at once and leaves an infinite black screen.
if not commands.get("logout"):
    commands["logout"] = ["hyprctl", "dispatch", "exit"]
    changed = True

# 2. The launcher actions.
#
# Without this, an EXISTING user gets nothing: shell.json ships through
# /etc/skel, which only ever seeds a NEW home. That is exactly why `>` showed
# no display controls after the first install carrying them -- the package was
# on disk and the file it wanted to deliver was not.
#
# caelestia's launcher.actions is a single property that REPLACES upstream's
# defaults rather than merging, so what gets written here is the whole list
# from our shipped shell.json -- theirs plus ours -- read from /etc/skel rather
# than duplicated in this scriptlet, so the two can never drift apart.
#
# A user who has customised their own actions keeps them, untouched. The point
# is to reach people who never had the key, not to overrule anyone.
launcher = data.get("launcher")
if not isinstance(launcher, dict):
    launcher = {}
    data["launcher"] = launcher

if not launcher.get("actions"):
    try:
        with open("/etc/skel/.config/caelestia/shell.json") as f:
            shipped = json.load(f)
        actions = shipped.get("launcher", {}).get("actions")
        if actions:
            launcher["actions"] = actions
            changed = True
    except (FileNotFoundError, json.JSONDecodeError, OSError, AttributeError):
        pass

# 3. The launcher has its OWN Logout action, separate from the session drawer's
#    command, and it carried the same black-screen `loginctl terminate-user`.
#    A user who already had an actions list would otherwise keep it forever.
for a in launcher.get("actions") or []:
    if isinstance(a, dict) and a.get("name") == "Logout"             and a.get("command") == ["loginctl", "terminate-user", ""]:
        a["command"] = ["hyprctl", "dispatch", "exit"]
        changed = True

if not changed:
    sys.exit(0)
os.makedirs(os.path.dirname(p), exist_ok=True)
with open(p, "w") as f:
    json.dump(data, f, indent=2)
PY
    chown "$owner" "$(dirname "$shl")" "$shl" 2>/dev/null || true
}

_migrate_user() {
    local home="$1" owner="$2"
    _migrate_hypr       "$home/.config/hypr/hyprland.conf"     "$owner"
    _migrate_qt6ct      "$home/.config/qt6ct/qt6ct.conf"       "$owner"
    _migrate_cli_json   "$home/.config/caelestia/cli.json"     "$owner"
    _migrate_shell_json "$home/.config/caelestia/shell.json"   "$owner"
}

_migrate_all() {
    local name pw uid gid gecos home shell
    while IFS=: read -r name pw uid gid gecos home shell; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 65000 ] 2>/dev/null || continue
        case "$shell" in */nologin|*/false|"") continue ;; esac
        [ -d "$home" ] || continue
        _migrate_user "$home" "$uid:$gid"
    done < <(getent passwd)
}

post_upgrade() {
    _migrate_all || true
    echo "==> Caelestia/Hyprland config updated for existing users (backup: "
    echo "    ~/.config/hypr/hyprland.conf.genesi-bak). Reload with 'hyprctl reload'"
    echo "    or re-login for the tray icons + fixes to take effect."
}

post_install() {
    # Fresh installs get the config straight from /etc/skel; run the migration
    # anyway so a manual `pacman -S` on a pre-existing user is also healed.
    _migrate_all || true
}
