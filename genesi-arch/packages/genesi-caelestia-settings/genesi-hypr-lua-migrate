#!/usr/bin/env python3
"""
genesi-hypr-lua-migrate -- move Genesi Hyprland desktops to the Lua config
when, and only when, the installed Hyprland needs it.

Hyprland 0.57 stopped reading hyprland.conf. A Genesi desktop upgraded past it
came up on Hyprland's autogenerated placeholder: no caelestia, no bar, none of
the keys, a "Welcome to Hyprland" window (user report, 2026-11-08). The fix is
a hyprland.lua, but WHEN to write it matters as much as what is in it:

  * Hyprland 0.54 and older: never. They cannot read Lua at all.
  * 0.55 and 0.56: never. They read hyprland.lua INSTEAD of hyprland.conf when
    both exist, so writing it there would throw away every edit the person
    made to their .conf, on a version where that .conf still works.
  * 0.57 and newer: yes, because the .conf is already dead.

Which is why this runs twice: from genesi-caelestia-settings' own upgrade
(the case where Hyprland got there first, as on the machine that reported
it), and from a pacman hook on the hyprland package (the case where we got
there first, and Hyprland arrives in a later update).

What it touches, per user:
  * only a Genesi caelestia desktop (its hyprland.conf starts the Genesi bar);
  * writes ~/.config/hypr/hyprland.lua when there is none, or when the one
    there is Hyprland's own placeholder (`hl.config({ autogenerated = true })`)
    -- that one is kept as hyprland.lua.autogenerated-bak. A hyprland.lua the
    person wrote is never replaced;
  * keeps hyprland.conf exactly as it was;
  * gives the Genesi drop-ins (genesi-center/display/input.conf) their Lua
    twins, so settings saved before the upgrade survive it;
  * copies the lines the person ADDED to their hyprland.conf (anything not in
    Genesi's own) into ~/.config/hypr/user.lua as comments, with a note.
    hyprlang cannot be loaded from Lua and a wrong automatic translation is
    worse than an honest list: nothing is silently lost, nothing is guessed.

Usage: genesi-hypr-lua-migrate [--home DIR --owner UID:GID] [--force-version V]
(no arguments = every login user). Exit status is always 0: a migration that
fails for one person must not fail anyone's pacman transaction.
"""
import os
import re
import shutil
import subprocess
import sys

SKEL_LUA = "/etc/skel/.config/hypr/hyprland.lua"
SKEL_CONF = "/etc/skel/.config/hypr/hyprland.conf"
GENESI_MARKER = re.compile(r"caelestia shell -d|genesi-bar shell --start")
AUTOGEN_MARKER = "autogenerated = true"
FIRST_LUA_ONLY = (0, 57)


def say(msg):
    print("genesi-hypr-lua-migrate: " + msg)


def version_tuple(v):
    nums = re.findall(r"\d+", v.split("-")[0].split("+")[0])
    return tuple(int(n) for n in nums[:3]) or (0,)


def hyprland_version(forced):
    if forced:
        return version_tuple(forced)
    try:
        out = subprocess.run(["pacman", "-Q", "hyprland"], capture_output=True, text=True, timeout=20).stdout
        if out.strip():
            return version_tuple(out.split()[1])
    except (OSError, subprocess.SubprocessError, IndexError):
        pass
    return None


def ours(line):
    """A line Genesi wrote: the shipped config, or one of its known additions."""
    return line in SHIPPED or line.startswith("# genesi-") or re.match(
        r"source\s*=\s*~?/?.*genesi-(center|display|input)\.conf", line) is not None


def added_lines(conf_text):
    out = []
    for raw in conf_text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ours(line):
            continue
        out.append(raw.rstrip())
    return out


def chown(path, owner):
    if owner is None:
        return
    try:
        uid, gid = (int(x) for x in owner.split(":"))
        os.chown(path, uid, gid)
    except (OSError, ValueError):
        pass


DROPINS = ("genesi-center", "genesi-display", "genesi-input")


def dropins(hypr, owner):
    """
    The settings Genesi Center, genesi-display and genesi-input saved before
    0.57 live in .conf drop-ins that 0.57 never reads. The tools now write a
    Lua twin beside each one on every change, but a setting saved BEFORE this
    update has no twin until it is changed again -- so the scale someone set
    would quietly reset at the upgrade. Generate the twins once here.

    Only a missing twin, or one we generated (its first line says so), is
    written: a genesi-*.lua with anything else in it is somebody's own.
    """
    try:
        import genesi_hypr_lua as hlua  # same directory as this script
    except ImportError:
        return
    for name in DROPINS:
        conf = os.path.join(hypr, name + ".conf")
        twin = os.path.join(hypr, name + ".lua")
        if not os.path.isfile(conf):
            continue
        if os.path.exists(twin):
            try:
                first = open(twin, encoding="utf-8", errors="replace").readline()
            except OSError:
                continue
            if not first.startswith("-- Generated by Genesi"):
                continue
        hlua.write_twin(conf, owner)


def migrate(home, owner):
    hypr = os.path.join(home, ".config", "hypr")
    conf = os.path.join(hypr, "hyprland.conf")
    lua = os.path.join(hypr, "hyprland.lua")
    user = os.path.join(hypr, "user.lua")
    try:
        conf_text = open(conf, encoding="utf-8", errors="replace").read()
    except OSError:
        return
    if not GENESI_MARKER.search(conf_text):
        return
    dropins(hypr, owner)
    if os.path.exists(lua):
        try:
            current = open(lua, encoding="utf-8", errors="replace").read()
        except OSError:
            return
        if AUTOGEN_MARKER not in current:
            return  # theirs, or already ours
        shutil.copy2(lua, lua + ".autogenerated-bak")
        chown(lua + ".autogenerated-bak", owner)
    shutil.copyfile(SKEL_LUA, lua)
    chown(lua, owner)
    extra = added_lines(conf_text)
    if extra and not os.path.exists(user):
        with open(user, "w", encoding="utf-8") as f:
            f.write(
                "-- Your own Hyprland settings. Loaded last by hyprland.lua, so they win.\n"
                "--\n"
                "-- Hyprland 0.57 no longer reads hyprland.conf. These lines were in yours\n"
                "-- and are not part of Genesi's config, so they are copied here, switched\n"
                "-- off: hyprlang cannot run as Lua, and a guessed translation could do\n"
                "-- something you did not mean. Rewrite the ones you still want in Lua\n"
                "-- (https://wiki.hypr.land/configuring/) and delete the rest. Your\n"
                "-- hyprland.conf is untouched.\n\n")
            for line in extra:
                f.write("-- " + line + "\n")
        chown(user, owner)
    say("%s: Hyprland now loads hyprland.lua%s" % (
        home, " (%d of your own lines listed in user.lua)" % len(extra) if extra else ""))


def users():
    import pwd  # Linux-only; the CI drives migrate() with --home instead
    for pw in pwd.getpwall():
        if 1000 <= pw.pw_uid < 65000 and not pw.pw_shell.endswith(("nologin", "false")) and os.path.isdir(pw.pw_dir):
            yield pw.pw_dir, "%d:%d" % (pw.pw_uid, pw.pw_gid)


def main(argv):
    global SHIPPED
    args = dict(zip(argv[::2], argv[1::2]))
    if not os.path.isfile(SKEL_LUA):
        return
    v = hyprland_version(args.get("--force-version"))
    if v is None or v < FIRST_LUA_ONLY:
        return  # no Hyprland, or one that still reads hyprland.conf
    try:
        SHIPPED = {l.strip() for l in open(SKEL_CONF, encoding="utf-8").read().splitlines() if l.strip()}
    except OSError:
        SHIPPED = set()
    targets = [(args["--home"], args.get("--owner"))] if "--home" in args else list(users())
    for home, owner in targets:
        try:
            migrate(home, owner)
        except Exception as e:  # noqa: BLE001 -- never fail a pacman transaction
            say("%s: skipped (%s)" % (home, e))


SHIPPED = set()

if __name__ == "__main__":
    if os.environ.get("GENESI_HYPR_SKEL"):
        SKEL_LUA = os.path.join(os.environ["GENESI_HYPR_SKEL"], "hyprland.lua")
        SKEL_CONF = os.path.join(os.environ["GENESI_HYPR_SKEL"], "hyprland.conf")
    main(sys.argv[1:])
