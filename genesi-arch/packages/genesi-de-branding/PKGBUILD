# Maintainer: Genesi OS Team
#
# Genesi "coat of paint" for the CachyOS-imported GTK desktops
# (GNOME/Xfce/Cinnamon/MATE). Unlike genesi-kde-settings / genesi-caelestia-
# settings — which are whole DE config bundles — this is a single, DE-agnostic
# integration package: a login-time autostart script (genesi-de-apply) that
# detects the running desktop and applies the Genesi wallpaper, a dark GTK
# theme, the green accent, nice icons and the essential launchers.
#
# WHY login-time instead of /etc/skel: skel only seeds NEW users, so existing
# accounts (and systems updated via `genesi update`) would never get the look.
# Running from /etc/xdg/autostart covers every user, new and existing.
pkgname=genesi-de-branding
pkgver=1.0.0
# pkgrel 2: (a) autostart the AI Mode + Containers SNI tray applets on the GTK
# desktops (they were installed but nothing launched them off KDE/Hyprland);
# (b) fix the wallpaper on GNOME/Cinnamon (needs picture-options) and Xfce
# (per-monitor property path + reload); (c) enable the GNOME AppIndicator
# extension so GNOME — which has no tray by default — can host the applets.
# VERSION in genesi-de-apply.sh bumped to 2 so it re-applies on upgrade.
# pkgrel 3: the tray + branding autostarts used OnlyShowIn=...;X-Cinnamon;...,
# but Cinnamon reports X-Cinnamon OR Cinnamon depending on version, so nothing
# ran there. Switch all three to NotShowIn=KDE; (run on every non-KDE session;
# Hyprland ignores autostart), which fixes Cinnamon and covers future DEs.
# pkgrel 4: extend the branding to LXDE (config files — no gsettings daemon) and
# Budgie (GNOME gsettings backend). VERSION -> 3 so it re-applies. LXQt/Openbox
# branding lands in later batches.
pkgrel=4
pkgdesc="Genesi OS look (wallpaper, dark theme, accent, launchers) for GNOME/Xfce/Cinnamon/MATE"
arch=('any')
url="https://github.com/Genesi-OS/GenesiOS"
license=('AGPL-3.0-or-later')
depends=('adw-gtk-theme' 'papirus-icon-theme')
# genesi-settings is NOT a hard dep: it's a genesi-* package that isn't in any
# repo yet at build time (makepkg would fail "Could not resolve all
# dependencies"), and it's always installed anyway via the always-on Genesi OS
# netinstall group. genesi-de-apply.sh guards the wallpaper path, so its absence
# just means no wallpaper is set — nothing breaks.
optdepends=('genesi-settings: Genesi wallpaper at /usr/share/wallpapers/genesi/wallpaper.png'
            'picom: rounded corners + blur on Xfce (real hardware only)'
            'genesi-code: pinned developer editor launcher'
            'genesi-ai-mode: AI Mode tray applet'
            'genesi-containers: containers tray applet'
            'gnome-shell-extension-appindicator: system tray host on GNOME (no tray by default)')
groups=('genesi')
source=('genesi-de-apply.sh'
        'genesi-de-branding.desktop'
        'genesi-ai-tray-autostart.desktop'
        'genesi-containers-tray-autostart.desktop'
        'picom-genesi.conf')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 genesi-de-apply.sh        "$pkgdir/usr/bin/genesi-de-apply"
    install -Dm644 genesi-de-branding.desktop "$pkgdir/etc/xdg/autostart/genesi-de-branding.desktop"
    # Autostart the Genesi SNI tray applets on the GTK desktops (scoped via
    # OnlyShowIn; TryExec skips them when the app isn't installed).
    install -Dm644 genesi-ai-tray-autostart.desktop \
        "$pkgdir/etc/xdg/autostart/genesi-ai-tray.desktop"
    install -Dm644 genesi-containers-tray-autostart.desktop \
        "$pkgdir/etc/xdg/autostart/genesi-containers-tray.desktop"
    install -Dm644 picom-genesi.conf          "$pkgdir/etc/genesi/picom-genesi.conf"
}
