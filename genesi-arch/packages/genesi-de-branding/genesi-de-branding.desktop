[Desktop Entry]
Type=Application
Name=Genesi Desktop Branding
Comment=Apply the Genesi look (wallpaper, theme, launchers) to this desktop
Exec=/usr/bin/genesi-de-apply
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
# Run everywhere EXCEPT KDE (which has its own branding). NotShowIn is more
# robust than enumerating OnlyShowIn tokens (Cinnamon reports X-Cinnamon OR
# Cinnamon depending on version, which broke the match). Hyprland ignores
# /etc/xdg/autostart, so it won't double-run there. The apply script itself
# still only acts on GNOME/Xfce/Cinnamon/MATE and no-ops elsewhere.
NotShowIn=KDE;
