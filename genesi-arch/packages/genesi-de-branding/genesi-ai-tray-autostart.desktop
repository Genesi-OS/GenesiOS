[Desktop Entry]
# genesi-de-branding autostarts the AI Mode SNI tray applet on the GTK desktops.
# KDE uses the Plasma widget and Hyprland starts it from caelestia's exec-once,
# so this entry is scoped to GNOME/Xfce/Cinnamon/MATE only. TryExec skips it
# silently when genesi-ai-mode isn't installed.
Type=Application
Name=Genesi AI Mode Tray
Comment=AI Mode status tray applet
Exec=/usr/local/bin/genesi-ai-tray
TryExec=/usr/local/bin/genesi-ai-tray
Icon=genesi-ai-monitor
NoDisplay=true
X-GNOME-Autostart-enabled=true
# Everywhere except KDE (plasmoid) — Hyprland ignores autostart (caelestia
# exec-once handles it). NotShowIn avoids the Cinnamon X-Cinnamon/Cinnamon
# token mismatch that kept the tray from starting there.
NotShowIn=KDE;
