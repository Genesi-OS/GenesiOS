# Maintainer: Genesi OS Team
# Source: https://github.com/Genesi-OS/genesi-update (fork of CachyOS/cachy-update)
pkgname=genesi-update
pkgver=1.0.0
# 2026-06-01 (2): add genesi-update.install — enable genesi-update.timer for all
# users globally. It shipped disabled, so the auto update-check never ran and
# the systray "updates available" icon never lit up on installed systems.
# 2026-08-07 (3): the tray applet moved from PyQt6 to libappindicator, so the
# icon finally appears in the Hyprland/caelestia bar. Deps follow.
# 2026-08-21 (4): the systray applet segfaulted within seconds of logging in on
# a fresh install -- python3.14 dumping core, reported from a KDE VM. The applet
# rebuilds its whole menu every 5s, and
# app_indicator_set_secondary_activate_target() keeps a BARE pointer to the row
# it is handed. The old menu was then finalised under it, so the next rebuild
# called gtk_widget_get_parent() on freed memory: Gtk-CRITICAL first, SIGSEGV a
# few cycles later. Fixed upstream (genesi-update 9277922) by installing the
# menu in the only safe order -- set_menu, then set_secondary_activate_target,
# then release the previous references -- and by holding the live menu on the
# instance, since the C side is not holding it for us.
# 2026-08-21 (5): every journal carried "Failed to start Launch the
# Genesi-Update systray applet", six restarts deep, next to a tray icon that was
# working fine. The applet is launched from TWO places on purpose so it appears
# on every desktop Genesi ships -- the systemd user service for systemd-aware
# Wayland compositors, /etc/xdg/autostart for the classic desktops that never
# reach graphical-session.target -- so on a session honouring both, one wins the
# lock and the other finds it taken. That is the design working, and it was
# being reported as exit 3, so systemd retried to its start limit and called it
# a failure. The duplicate now says the applet is already running and exits 0
# (genesi-update 2075a23), the same conclusion genesi-ai-quick reached with its
# per-user socket. Neither launcher is removed: dropping either one loses a
# desktop.
pkgrel=5
pkgdesc="Interactive update notifier & applier for Genesi OS with systray applet"
install='genesi-update.install'
arch=('any')
url="https://github.com/Genesi-OS/genesi-update"
license=('AGPL-3.0-or-later')
depends=(
    'bash'
    'systemd'
    'pacman'
    'pacman-contrib'
    'archlinux-contrib'
    'curl'
    'fakeroot'
    'htmlq'
    'diffutils'
    'hicolor-icon-theme'
    'python'
    # The tray applet is libappindicator (Gtk), NOT Qt: Qt 6.11's SNI never
    # serves its properties to the caelestia (Quickshell) bar, so the icon
    # simply never appeared under Hyprland. Same reason genesi-containers-tray
    # and genesi-ai-tray moved off Qt.
    'python-gobject'
    'gtk3'
    'libayatana-appindicator'
    'librsvg'
    'glib2'
    'xdg-utils'
    'libnotify'
)
optdepends=(
    # The applet speaks SNI (StatusNotifierItem), which every panel in the
    # Genesi chooser supports EXCEPT LXDE's lxpanel, whose tray is XEmbed-only.
    # snixembed proxies one to the other for those panels.
    'snixembed: tray icon on XEmbed-only panels (LXDE)'
    'paru: AUR support'
    'yay: AUR support'
    'pikaur: AUR support'
    'flatpak: Flatpak support'
    'sudo: privilege elevation'
    'sudo-rs: privilege elevation'
    'opendoas: privilege elevation'
)
makedepends=('make' 'scdoc' 'gettext')
provides=('genesi-update')
conflicts=('genesi-updater')
replaces=('genesi-updater')
source=("git+https://github.com/Genesi-OS/genesi-update.git#branch=main")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/genesi-update"
    # Skip msgfmt for now — the rebrand sed pass collapsed `Arch-Update` and
    # `Cachy-Update` into the same `Genesi-Update` string, which produces
    # duplicate msgids in every .po file. Translations can be re-introduced
    # later by regenerating the .pot from sources and running msgmerge.
    make locales=""
}

package() {
    cd "${srcdir}/genesi-update"
    make PREFIX=/usr DESTDIR="${pkgdir}" locales="" install
}
