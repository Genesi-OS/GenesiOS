# Maintainer: Genesi OS Team <dev@genesios.org>
#
# pkgrel 3: rework endpoint discovery. The old inspect only probed a fixed
# /swagger-style path list and, even when it found an OpenAPI doc, never read its
# `paths` — so most backends showed nothing. Now inspect-json discovers endpoints
# in layers: (1) parse OpenAPI/Swagger from ~11 well-known spec URLs (full path +
# method list), (2) GraphQL introspection, (3) OUT-OF-THE-BOX — read routes from
# the project source at /proc/PID/cwd by framework convention (Next.js/Express/
# FastAPI/Flask/Django/Spring/Rails/Go) so it works with no spec at all, (4) a
# GET-only liveness probe as fallback. All localhost, no destructive methods.
# pkgrel 4: make inspection side-effect-safe. pkgrel 3 probed the network first,
# hitting app routes like GET /api — which crashes a backend whose handler does
# req.json() on an empty body. Now source discovery runs FIRST (zero requests),
# the only unconditional request is a benign GET /, no probe path lives under
# /api/, and the network fallback runs only when source yields nothing. The CLI
# also auto-resolves the PID from the port, so source discovery works even
# without the GUI passing it.
# pkgrel 5: the discovered-endpoints list now scrolls inside the detail card
# (a backend can expose dozens of endpoints) instead of overflowing it.
pkgname=genesi-ports
pkgver=1.0.0
# 2026-08-26 (7): the design pass, built against devtools/preview.py.
# THE INSPECTOR HAD NO EMPTY STATE. With nothing selected it was a heading and
# a paragraph at the top of a full-height card, and eight hundred pixels of
# nothing underneath. It is a centred state now, and it steps aside entirely
# below 1150px, where the list needs the room more than it does.
# THE TWO FILTER LISTS WERE DIFFERENT CONTROLS. PROTOCOL was chips with dots,
# EXPOSURE was plain text rows -- the same job, "pick one of a set", drawn two
# ways, so the second read as a list of links rather than a filter. They match.
# StudioTheme gains the shape/rhythm/type scale, mirroring the shared Theme
# token for token: three themes in this codebase inventing three sets of radii
# is the thing those tokens exist to stop. The palettes differ on purpose; the
# geometry should not.
# `theme: theme` binds the property TO ITSELF -- QML resolves a bare name on
# the right-hand side against the object's own properties before the enclosing
# scope's ids -- so every GButton/StudioCard/StatusBanner written that way was
# handed `undefined` and rendered unstyled. Swept here too; the id is
# `appTheme` now. ci/qml-sanity-test.py fails on the pattern from now on.
pkgrel=10
pkgdesc='Genesi PortScope: native ports/processes dashboard, Plasma widget and tray applet'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL-3.0-or-later')
depends=(
    'python' 'pyside6' 'kirigami' 'qqc2-desktop-style' 'qt6-svg'
    'iproute2' 'procps-ng' 'polkit'
    'python-gobject' 'libayatana-appindicator' 'gtk3'
)
optdepends=('plasma-workspace: Plasma 6 PortScope panel widget')
install='genesi-ports.install'
source=()
sha256sums=()

package() {
    install -Dm755 "${startdir}/genesi-ports" "$pkgdir/usr/bin/genesi-ports"
    install -Dm755 "${startdir}/genesi-ports-gui" "$pkgdir/usr/bin/genesi-ports-gui"
    install -Dm755 "${startdir}/genesi-ports-tray" "$pkgdir/usr/bin/genesi-ports-tray"
    install -Dm755 "${startdir}/genesi-ports-panel-migrate" \
        "$pkgdir/usr/bin/genesi-ports-panel-migrate"

    install -Dm644 "${startdir}/app/genesi_ports.py" \
        "$pkgdir/usr/share/genesi-ports/app/genesi_ports.py"
    install -Dm644 "${startdir}/app/Main.qml" \
        "$pkgdir/usr/share/genesi-ports/app/Main.qml"
    for comp in Theme GlassCard StudioTheme StudioCard GButton StatusBanner I18n; do
        install -Dm644 "${startdir}/../genesi-ui-kit/components/${comp}.qml" \
            "$pkgdir/usr/share/genesi-ports/app/${comp}.qml"
    done

    install -Dm644 "${startdir}/org.genesi.ports.desktop" \
        "$pkgdir/usr/share/applications/org.genesi.ports.desktop"
    install -Dm644 "${startdir}/genesi-ports-tray.desktop" \
        "$pkgdir/etc/xdg/autostart/genesi-ports-tray.desktop"
    install -Dm644 "${startdir}/genesi-ports-panel-migrate.desktop" \
        "$pkgdir/etc/xdg/autostart/genesi-ports-panel-migrate.desktop"
    install -Dm644 "${startdir}/genesi-ports.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/genesi-ports.svg"

    install -dm755 "$pkgdir/usr/share/plasma/plasmoids/org.genesi.ports"
    cp -r "${startdir}/plasmoid/"* \
        "$pkgdir/usr/share/plasma/plasmoids/org.genesi.ports/"
}
