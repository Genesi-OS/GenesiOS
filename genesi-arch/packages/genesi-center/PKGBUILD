# Maintainer: Genesi OS Team
#
# genesi-center — the desktop's control surface.
#
# Roadmap 7.4: "a Genesi settings app with real art direction". The bar it was
# measured against is Ryoku's, and the useful half of what they do is the
# architecture rather than the look:
#
#   * a data plane that is a CLI printing JSON (`ryoku-hub keybinds`,
#     `hypr get`), and a front end that only draws
#   * one file per page, one rail that owns navigation
#   * a written design contract every page obeys
#
# Genesi already had the first of those everywhere -- genesi-display,
# genesi-bar, genesi-ai-mode all print JSON for a GUI to read -- so this app is
# the same shape: `genesi-center-data` reads the machine, the QML draws it, and
# neither knows the other's business. What it does NOT copy is the appearance:
# Ryoku's is warm bone on black, and wearing it would make Genesi look like
# Ryoku. app/Tokens.qml is where ours is decided, and it says why.
#
# The other apps here derive their colours from the system scheme through the
# shared genesi-ui-kit. This one deliberately does not, so it is not bundled:
# Center is the brand surface, and a control centre that restates itself in
# whatever hue the wallpaper produced has no identity to recognise.
pkgname=genesi-center
pkgver=0.1.0
# 2: the rail, the animations and the artwork all landed while this stayed
# at 1, so the repository held the newest code under a version every machine
# already had and `genesi update` correctly did nothing. ci/pkgrel-bump-test.py
# now fails the build on it.
# 3: the Displays page, and primary read from genesi-display rather than
# inferred from a monitor sitting at 0,0.
# 4: the Bar page, and the rail hides what the running session cannot do --
# a control that appears to work and changes nothing is worse than a
# missing page.
pkgrel=14
pkgdesc='Genesi control centre — system overview, resources and settings'
arch=('any')
groups=('genesi')
license=('AGPL-3.0-or-later')
url='https://github.com/Genesi-OS/GenesiOS'
# pyside6 for the engine; qqc2-desktop-style so plain Qt Quick Controls do not
# fall back to the Basic style. coreutils for `du`, which the storage ring
# needs and which is not worth reimplementing in Python.
# qt6-svg: the brand mark is drawn from art/genesi-leaf.svg, and without
# the SVG image plugin an Image with an .svg source silently renders
# nothing -- the mark would simply be absent, with no error.
# noto-fonts-cjk: the rail's tag column is Japanese. Nothing else on a
# Genesi install guarantees a font that can draw it, and Qt answers a
# missing glyph with a box rather than an error -- which is what the
# reporter saw. A design that uses a script has to ship the script.
depends=('python' 'pyside6' 'qqc2-desktop-style' 'qt6-svg' 'coreutils'
         'noto-fonts-cjk')
# What the pages OPEN. genesi-update-center is not here any more: the app used
# to offer a card that ran a command by that name, and no such command exists --
# the package is a polkit helper and a Plasma applet.
optdepends=('genesi-snapshots: the Snapshots page and its quick tool'
            'genesi-channel: the update-channel tool the Settings page opens'
            'genesi-ai-mode: the Local AI page and the System Monitor tool'
            'genesi-code: the editor quick tool')
source=()

check() {
    # The data plane must parse and must answer every section it advertises.
    # A GUI that starts and shows dashes is the failure this catches, and it
    # cannot be caught from the QML side.
    python -c "import ast,io;ast.parse(io.open('${startdir}/genesi-center-data',encoding='utf-8').read())"
    # The writer is the half that TOUCHES a config. A syntax error in it
    # is a settings page whose every control fails, so it is parsed here
    # too rather than discovered on a desk.
    python -c "import ast,io;ast.parse(io.open('${startdir}/genesi-center-set',encoding='utf-8').read())"
    python -c "import ast,io;ast.parse(io.open('${startdir}/genesi-console',encoding='utf-8').read())"
    python -c "import ast,io;ast.parse(io.open('${startdir}/app/genesi_center.py',encoding='utf-8').read())"
    sh -n "${startdir}/genesi-center"
    # ...and every section must actually ANSWER. Parsing proves the file
    # is Python; this proves a page that asks for `resources` gets JSON
    # rather than a traceback on stderr and {} in the window. Sections
    # whose tools are absent in the build container return
    # {"available": false}, which is a valid answer and the point.
    # Written without line continuations on purpose. The first version of this
    # loop was generated through a heredoc that turned every "backslash +
    # newline" into a literal \n, so the shell read `\n` as the word `n` and
    # asked the data plane for a section by that name. It failed the build --
    # loudly, which is the good outcome -- but it is a trap worth not laying
    # again in a file that is only ever run in CI.
    _sections="session telemetry core storage activity system resources input"
    _sections="$_sections audio appearance launcher windows shortcuts ai"
    _sections="$_sections snapshots console desktop"
    for _s in $_sections; do
        if ! python "${startdir}/genesi-center-data" "$_s" | python -c "import json,sys;json.load(sys.stdin)"; then
            echo "genesi-center-data $_s did not answer with JSON" >&2
            return 1
        fi
    done
}

package() {
    install -Dm755 "${startdir}/genesi-center" \
        "${pkgdir}/usr/bin/genesi-center"
    install -Dm755 "${startdir}/genesi-console" \
        "${pkgdir}/usr/bin/genesi-console"
    install -Dm755 "${startdir}/genesi-center-set" \
        "${pkgdir}/usr/bin/genesi-center-set"
    install -Dm755 "${startdir}/genesi-center-data" \
        "${pkgdir}/usr/bin/genesi-center-data"

    install -Dm644 "${startdir}/app/genesi_center.py" \
        "${pkgdir}/usr/share/genesi-center/app/genesi_center.py"
    install -Dm644 "${startdir}/app/Main.qml" \
        "${pkgdir}/usr/share/genesi-center/app/Main.qml"
    install -Dm644 "${startdir}/app/Tokens.qml" \
        "${pkgdir}/usr/share/genesi-center/app/Tokens.qml"
    install -Dm644 "${startdir}/app/qmldir" \
        "${pkgdir}/usr/share/genesi-center/app/qmldir"

    install -Dm644 "${startdir}/app/components/"*.qml \
        -t "${pkgdir}/usr/share/genesi-center/app/components/"
    install -Dm644 "${startdir}/app/pages/"*.qml \
        -t "${pkgdir}/usr/share/genesi-center/app/pages/"

    # The art is optional on purpose: OverviewPage falls back to a procedural
    # glow, so a build without the asset still looks finished rather than
    # showing an empty rectangle where the tree belongs.
    if compgen -G "${startdir}/app/art/*" > /dev/null; then
        install -Dm644 "${startdir}/app/art/"* \
            -t "${pkgdir}/usr/share/genesi-center/app/art/"
    fi

    install -Dm644 "${startdir}/org.genesi.center.desktop" \
        "${pkgdir}/usr/share/applications/org.genesi.center.desktop"

    # The .desktop says Icon=genesi-center and nothing installed a file by that
    # name, so the launcher had nothing to draw: a blank tile in the menu and in
    # the taskbar, with no error anywhere. The same silent shape as a launcher
    # action whose binary was never installed.
    install -Dm644 "${startdir}/app/art/genesi-leaf.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/genesi-center.svg"
}
