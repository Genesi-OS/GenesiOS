def die(msg):
    sys.stderr.write("genesi-center-set: " + msg + "\n")
    sys.exit(1)


def coerce(spec, raw, what):
    kind = spec[0]
    if kind == "bool":
        low = str(raw).strip().lower()
        if low in ("1", "true", "yes", "on"):
            return True
        if low in ("0", "false", "no", "off"):
            return False
        die(f"{what} is a switch; got {raw!r}")
    if kind == "int":
        try:
            v = int(float(raw))
        except (TypeError, ValueError):
            die(f"{what} is a whole number; got {raw!r}")
        lo, hi = spec[1], spec[2]
        # Clamped rather than refused. The value comes from a slider whose
        # range the page already limits, so out of range means the page and
        # this list disagree -- and the useful thing then is the nearest legal
        # value, not a dialog.
        return max(lo, min(hi, v))
    if kind == "float":
        try:
            v = float(raw)
        except (TypeError, ValueError):
            die(f"{what} is a number; got {raw!r}")
        return max(spec[1], min(spec[2], round(v, 3)))
    if kind == "enum":
        if str(raw) not in spec[1]:
            die(f"{what} must be one of: " + ", ".join(spec[1]))
        return str(raw)
    # str
    if not re.fullmatch(r"[A-Za-z0-9_,:+.\- ]*", str(raw)):
        die(f"{what} may only hold letters, digits and , : + . - _")
    return str(raw)


def hypr_write(option, value):
    """Put one option in the drop-in, replacing any line already setting it."""
    os.makedirs(os.path.dirname(DROPIN), exist_ok=True)
    try:
        with open(DROPIN, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []

    if not lines:
        lines = [MARK, ""]

    # Hyprland nests: `input:touchpad:tap-to-click` is written flat here on
    # purpose. A flat keyword line is legal, it is what `hyprctl keyword`
    # takes, and it means this never has to parse or rebuild someone's braces.
    out = [l for l in lines if not re.match(r"^\s*%s\s*=" % re.escape(option), l)]
    out.append(f"{option} = {value}")

    with open(DROPIN, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("\n".join(out).rstrip() + "\n")

    ensure_sourced()


def cmd_hypr(option, raw):
    spec = HYPR.get(option)
    if spec is None:
        die(f"{option!r} is not an option this writes. "
            "`genesi-center-set options` lists them.")
    value = coerce(spec, raw, option)
    if isinstance(value, bool):
        value = 1 if value else 0

    hypr_write(option, value)

    # Applied second: if the write failed we already stopped, and a keyword
    # that lands without the drop-in behind it is the setting that forgets
    # itself.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            subprocess.run(["hyprctl", "keyword", option, str(value)],
                           capture_output=True, timeout=8)
        except (OSError, subprocess.SubprocessError):
            pass
    print(f"{option} = {value}")


def cmd_caelestia(pairs):
    """
    Set one or more values in shell.json, in ONE read-modify-write.

    ── Why this takes a list ────────────────────────────────────────────────

    Dropping a widget on the desktop changes three things: its x, its y, and
    the fact that it is placed by hand now. As three invocations that was three
    processes reading the same file, each editing its own copy, each writing
    the whole thing back -- so two of the three edits were overwritten by
    whoever finished last. The symptom was a widget that could be dragged
    anywhere and snapped back the moment you let go.

    Worse, they all wrote through a temporary file at the SAME path. os.replace
    is atomic, so the story ended there in theory; in practice the second
    process opened that shared temp with "w" while the first was still writing
    into it, and the file that finally got renamed over shell.json was two
    JSON documents spliced together. That is the "erro de json" at the next
    login, the widgets that vanished with it, and the Genesi Center pages that
    came up empty -- every one of them was this.

    So: one process, one write, one temp file named after this process.
    """
    if not pairs:
        die("nothing to set. Pass one or more `<path> <value>` pairs.")
    resolved = []
    for path, raw in pairs:
        spec = CAELESTIA_PATHS.get(path)
        if spec is None:
            die(f"{path!r} is not a value this writes. "
                "`genesi-center-set options` lists them.")
        resolved.append((path, coerce(spec, raw, path)))

    cfg = read_caelestia()

    for path, value in resolved:
        parts = path.split(".")
        node = cfg
        for p in parts[:-1]:
            if not isinstance(node.get(p), dict):
                node[p] = {}
            node = node[p]
        node[parts[-1]] = value

    os.makedirs(os.path.dirname(CAELESTIA), exist_ok=True)
    # Written whole, through a temporary file in the same directory: a crash
    # halfway through leaves the old config rather than a truncated one, and a
    # truncated shell.json is a desktop that comes up with no bar.
    #
    # The pid is in the name because two of these CAN still overlap -- a drop
    # is one call now, but the desktop menu and the Center are two programs.
    # A shared scratch file makes them corrupt each other's writes; a private
    # one makes them merely race, and the loser's change is simply not saved.
    tmp = f"{CAELESTIA}.genesi-tmp.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8", newline="\n") as fh:
            json.dump(cfg, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
            fh.flush()
            # The rename is atomic; the CONTENT reaching the disk is not. A
            # power cut between the two leaves a file that exists, is named
            # right, and is full of zeroes.
            os.fsync(fh.fileno())
        os.replace(tmp, CAELESTIA)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        die(f"cannot write {CAELESTIA}: {e}")
    for path, value in resolved:
        print(f"{path} = {json.dumps(value)}")


def read_caelestia():
    """
    shell.json as a dict -- and a way back when it is not one.

    A config file this cannot parse is not a reason to stop: the desktop is
    already broken at that point, and the one program that could fix it
    refusing to run is the worst possible moment to be strict. So the
    unreadable file is MOVED ASIDE, under a name that says what it is, and the
    write starts from nothing.

    Moved, never deleted. Restoring it is a `mv` away, which matters because
    the thing that lands here is somebody's whole desktop configuration.
    """
    try:
        text = open(CAELESTIA, encoding="utf-8").read()
    except FileNotFoundError:
        return {}
    except OSError as e:
        die(f"cannot read {CAELESTIA}: {e}")

    try:
        cfg = json.loads(text)
    except json.JSONDecodeError as e:
        # Salvage first. The way this file got broken was two writers splicing
        # their output together, and a spliced JSON document has a very
        # particular shape: a COMPLETE object, then rubbish. json says so --
        # "Extra data" with the offset where the good part ended -- so the
        # prefix parses, and the prefix is the user's actual configuration.
        #
        # Worth the twelve lines. The alternative is handing somebody a default
        # desktop and telling them their settings are in a .broken file they
        # now have to merge by hand.
        cfg = None
        if e.pos > 0:
            try:
                salvaged = json.loads(text[:e.pos])
                if isinstance(salvaged, dict):
                    cfg = salvaged
            except json.JSONDecodeError:
                cfg = None
        broken = f"{CAELESTIA}.broken"
        try:
            os.replace(CAELESTIA, broken)
        except OSError:
            die(f"{CAELESTIA} is not valid JSON ({e}) and cannot be moved "
                "aside. Fix or delete it by hand.")
        sys.stderr.write(
            f"genesi-center-set: {CAELESTIA} was not valid JSON ({e}).\n"
            f"                   Kept a copy at {broken}.\n"
            + (f"                   Recovered {len(cfg)} section(s) from it.\n"
               if cfg is not None else
               "                   Nothing was recoverable; starting fresh.\n"))
        return cfg if cfg is not None else {}
    if not isinstance(cfg, dict):
        die(f"{CAELESTIA} is valid JSON but not an object.")
    return cfg


# ── Keybinds ─────────────────────────────────────────────────────────────────
#
# Rebinding is `unbind` the old combination, then `bind` the new one, both in
# our drop-in. hyprland.conf sources it LAST, so an unbind there removes a bind
# the shipped config made above it -- which is what lets this change a shortcut
# without editing a file that is not ours.
#
# Each override is a three-line block marked with the ORIGINAL combination, so
# rebinding the same shortcut twice replaces its block rather than stacking a
# second unbind on top of the first.
BIND_MARK = "# genesi-bind"

# A shortcut the user INVENTED, as opposed to one they moved. It gets a
# mark of its own for two reasons: there is no original combination to
# unbind, and there is nothing to "put back" -- the page must offer to
# delete it instead, and it can only tell the two apart by the mark.
NEWBIND_MARK = "# genesi-newbind"

MODS = ("SUPER", "ALT", "CTRL", "SHIFT")

# Key names, loosely: what Hyprland accepts is xkb's list, which is long. This
# refuses anything with a space, a comma or a quote -- the three things that
# would break the config LINE rather than merely name a key that does not
# exist. A key that does not exist is a bind that never fires; a broken line is
# a config Hyprland refuses to load.
KEY_RE = re.compile(r"^[A-Za-z0-9_+\-]{1,32}$")

# Dispatchers a page may bind. `exec` is the interesting one and also the one
# that runs arbitrary commands -- which is fine, it is the user's machine and
# their keyboard, but it means the ARGUMENT has to survive being written to a
# config file, so newlines and braces are refused below.
DISPATCHERS = {
    "exec", "killactive", "togglefloating", "fullscreen", "fakefullscreen",
    "workspace", "movetoworkspace", "movetoworkspacesilent", "movefocus",
    "movewindow", "resizeactive", "togglesplit", "layoutmsg", "pseudo",
    "togglespecialworkspace", "exit", "pin", "centerwindow",
}


def check_combo(mods, key, what):
    parts = [m.strip().upper() for m in mods.split() if m.strip()]
    for m in parts:
        if m not in MODS:
            die(f"{what}: {m!r} is not a modifier. Use " + ", ".join(MODS))
    if not KEY_RE.match(key.strip()):
        die(f"{what}: {key!r} is not a usable key name")
    return " ".join(parts), key.strip()


def read_dropin():
    try:
        with open(DROPIN, encoding="utf-8") as fh:
            return fh.read().splitlines()
    except OSError:
        return []


def write_dropin(lines):
    os.makedirs(os.path.dirname(DROPIN), exist_ok=True)
    if not lines or lines[0] != MARK:
        lines = [MARK, ""] + [l for l in lines if l != MARK]
    with open(DROPIN, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("\n".join(lines).rstrip() + "\n")
    ensure_sourced()


def drop_bind_block(lines, tag):
    """
    Remove the block for one combination, whichever kind it is.

    An override is three lines (mark, unbind, bind); a shortcut we created is
    two (mark, bind). The count has to come from the mark that was actually
    found -- skipping a fixed three past a two-line block eats whatever line
    follows it, which is somebody else's shortcut.
    """
    out, skip = [], 0
    for line in lines:
        if skip > 0:
            skip -= 1
            continue
        stripped = line.strip()
        if stripped == f"{BIND_MARK} {tag}":
            skip = 2          # the unbind and the bind under it
            continue
        if stripped == f"{NEWBIND_MARK} {tag}":
            skip = 1          # just the bind under it
            continue
        out.append(line)
    return out


def reload_hypr():
    """
    `hyprctl reload`, not two `hyprctl keyword` calls.

    A keyword is a config ASSIGNMENT, and `unbind` is not one -- so
    `hyprctl keyword unbind "SUPER, V"` removed nothing while the paired
    `keyword bind` happily added the new combination. Both fired, which is what
    "it duplicates the shortcut" was.

    A reload re-reads hyprland.conf and the drop-in it sources, in that order,
    so an unbind above a bind does what it does in a file.
    """
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    try:
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        pass


def cmd_bind(old_combo, new_combo, dispatcher, arg):
    """
    Move a shortcut. `old_combo` and `new_combo` are "MODS,KEY".

    The old one is unbound whether or not it is the same as the new one: a
    person changing only the command behind a key still needs the shipped bind
    for that key taken out of the way, or both fire.
    """
    if dispatcher not in DISPATCHERS:
        die(f"{dispatcher!r} is not a dispatcher this writes. "
            "`genesi-center-set options` lists them.")
    if re.search(r"[\r\n{}]", arg):
        die("a shortcut's argument may not contain newlines or braces")

    om, ok = check_combo(*old_combo.split(",", 1), what="the old shortcut")
    nm, nk = check_combo(*new_combo.split(",", 1), what="the new shortcut")

    tag = f"{om},{ok}"
    lines = drop_bind_block(read_dropin(), tag)
    lines += [
        f"{BIND_MARK} {tag}",
        f"unbind = {om}, {ok}",
        f"bind = {nm}, {nk}, {dispatcher}" + (f", {arg}" if arg else ""),
    ]
    write_dropin(lines)

    # `hyprctl reload`, not two `hyprctl keyword` calls.
    #
    # A keyword is a config ASSIGNMENT, and `unbind` is not one -- so
    # `hyprctl keyword unbind "SUPER, V"` removed nothing while the paired
    # `keyword bind` happily added the new combination. Both fired, which is
    # what "it duplicates the shortcut" was.
    #
    # A reload re-reads hyprland.conf and the drop-in it sources, in that
    # order, so the unbind above the bind does what it does in a file. It costs
    # a moment and it is the only form that is actually correct.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            subprocess.run(["hyprctl", "reload"], capture_output=True,
                           timeout=15)
        except (OSError, subprocess.SubprocessError):
            pass
    print(f"{om}, {ok}  ->  {nm}, {nk}, {dispatcher}"
          + (f", {arg}" if arg else ""))


def cmd_unbind(combo):
    """Drop our override for one shortcut, putting the shipped bind back."""
    m, k = check_combo(*combo.split(",", 1), what="the shortcut")
    tag = f"{m},{k}"
    lines = read_dropin()
    kept = drop_bind_block(lines, tag)
    if len(kept) == len(lines):
        die(f"no override for {m}, {k}")
    write_dropin(kept)
    # The shipped bind comes back on the next reload; say so rather than
    # letting a live session look like the reset did nothing.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            subprocess.run(["hyprctl", "reload"], capture_output=True,
                           timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass
    print(f"reset {m}, {k}")


def cmd_newbind(combo, dispatcher, arg):
    """
    A shortcut that did not exist before.

    No `unbind` line, because nothing shipped this combination -- and unbinding
    a combination nothing bound is not harmless bookkeeping, it is a line in
    the drop-in that would silently kill the bind if the user later added one
    for that key in their own config above ours.

    Rebinding the same new combination replaces its block rather than stacking
    a second bind on the first, the same way cmd_bind does.
    """
    if dispatcher not in DISPATCHERS:
        die(f"{dispatcher!r} is not a dispatcher this writes. "
            "`genesi-center-set options` lists them.")
    if re.search(r"[\r\n{}]", arg):
        die("a shortcut's argument may not contain newlines or braces")

    mods, key = check_combo(*combo.split(",", 1), what="the shortcut")
    tag = f"{mods},{key}"

    lines = drop_bind_block(read_dropin(), tag)
    lines += [
        f"{NEWBIND_MARK} {tag}",
        f"bind = {mods}, {key}, {dispatcher}" + (f", {arg}" if arg else ""),
    ]
    write_dropin(lines)
    reload_hypr()


def cmd_delbind(combo):
    """Remove a shortcut this created. Leaves overrides alone."""
    mods, key = check_combo(*combo.split(",", 1), what="the shortcut")
    lines = drop_bind_block(read_dropin(), f"{mods},{key}")
    write_dropin(lines)
    reload_hypr()


# This app's own settings, which are not caelestia's and do not belong in its
# file. One key so far; the shape is a JSON object so the second one costs
# nothing.
CENTER_SETTINGS = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "genesi", "center", "settings.json")

CENTER_KEYS = {
    "followSystemTheme": "bool",
}


def cmd_center(key, raw):
    """Set one of this app's own settings."""
    if key not in CENTER_KEYS:
        die(f"{key!r} is not a setting this app keeps. "
            "Known: " + ", ".join(sorted(CENTER_KEYS)))
    value = coerce((CENTER_KEYS[key],), raw, key)

    try:
        with open(CENTER_SETTINGS, encoding="utf-8") as fh:
            data = json.load(fh)
        if not isinstance(data, dict):
            data = {}
    except (OSError, ValueError):
        data = {}

    data[key] = value
    os.makedirs(os.path.dirname(CENTER_SETTINGS), exist_ok=True)
    with open(CENTER_SETTINGS, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")


def cmd_binds():
    """Every override this has written, so a page can mark them."""
    out = []
    lines = read_dropin()
    for i, line in enumerate(lines):
        if not line.strip().startswith(BIND_MARK):
            continue
        tag = line.strip()[len(BIND_MARK):].strip()
        new = lines[i + 2] if i + 2 < len(lines) else ""
        m = re.match(r"\s*bind\s*=\s*([^,]*),\s*([^,]+),\s*([^,]+)(?:,\s*(.*))?",
                     new)
        om, _, ok = tag.partition(",")
        out.append({
            "original": {"mods": om.split(), "key": ok},
            "bound": {
                "mods": m.group(1).split() if m else [],
                "key": m.group(2).strip() if m else "",
                "dispatcher": m.group(3).strip() if m else "",
                "arg": (m.group(4) or "").strip() if m else "",
            } if m else None,
        })
    created = []
    for i, line in enumerate(lines):
        if not line.strip().startswith(NEWBIND_MARK):
            continue
        tag = line.strip()[len(NEWBIND_MARK):].strip()
        # ONE line under the mark, not two: a shortcut nobody shipped has
        # nothing to unbind above it.
        bound = lines[i + 1] if i + 1 < len(lines) else ""
        m = re.match(r"\s*bind\s*=\s*([^,]*),\s*([^,]+),\s*([^,]+)(?:,\s*(.*))?",
                     bound)
        if not m:
            continue
        mods, _, key = tag.partition(",")
        created.append({
            "mods": mods.split(),
            "key": key,
            "dispatcher": m.group(3).strip(),
            "arg": (m.group(4) or "").strip(),
        })

    json.dump({"overrides": out, "created": created, "dropin": DROPIN},
              sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def cmd_options():
    out = {
        "hypr": {k: list(v) for k, v in HYPR.items()},
        "caelestia": {k: list(v) for k, v in CAELESTIA_PATHS.items()},
        "genesi_only": dict(GENESI_ONLY),
        "mods": list(MODS),
        "dispatchers": sorted(DISPATCHERS),
        "dropin": DROPIN,
    }
    json.dump(out, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        return 2
    what = sys.argv[1]
    if what == "options":
        cmd_options()
    elif what == "hypr" and len(sys.argv) == 4:
        cmd_hypr(sys.argv[2], sys.argv[3])
    elif what == "caelestia" and len(sys.argv) >= 4 and len(sys.argv) % 2 == 0:
        # Pairs, so a caller that changes three things at once changes them in
        # one write. An odd argument count is a path with no value, which is
        # worth refusing rather than guessing at.
        rest = sys.argv[2:]
        cmd_caelestia(list(zip(rest[0::2], rest[1::2])))
    elif what == "binds":
        cmd_binds()
    elif what == "bind" and len(sys.argv) in (6, 7):
        # old "MODS,KEY", new "MODS,KEY", dispatcher, [arg]
        cmd_bind(sys.argv[2], sys.argv[3], sys.argv[4],
                 sys.argv[5] if len(sys.argv) > 5 else "")
    elif what == "unbind" and len(sys.argv) == 3:
        cmd_unbind(sys.argv[2])
    elif what == "newbind" and len(sys.argv) in (4, 5):
        # "MODS,KEY", dispatcher, [arg]
        cmd_newbind(sys.argv[2], sys.argv[3],
                    sys.argv[4] if len(sys.argv) > 4 else "")
    elif what == "delbind" and len(sys.argv) == 3:
        cmd_delbind(sys.argv[2])
    elif what == "center" and len(sys.argv) == 4:
        cmd_center(sys.argv[2], sys.argv[3])
    else:
        sys.stderr.write(
            "usage: genesi-center-set {hypr <option> <value>"
            " | caelestia <path> <value>"
            " | bind <old MODS,KEY> <new MODS,KEY> <dispatcher> [arg]"
            " | unbind <MODS,KEY>"
            " | newbind <MODS,KEY> <dispatcher> [arg]"
            " | delbind <MODS,KEY> | binds | options}\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
