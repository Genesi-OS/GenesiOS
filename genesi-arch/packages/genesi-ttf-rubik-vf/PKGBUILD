# Maintainer: Genesi OS Team
#
# ttf-rubik-vf (Google Fonts "Rubik", variable-font build) repackaged for the
# [genesi] repo. caelestia-shell uses Rubik as its UI font and hard-depends on
# this exact package name. AUR-only upstream; mirrored here so the Calamares
# netinstall (pacman, no AUR) installs it. provides=ttf-rubik-vf so caelestia's
# dependency resolves to this build.
pkgname=genesi-ttf-rubik-vf
pkgver=2.3.0
# pkgrel 2: fetch the pinned Rubik commit as one archive instead of five raw
# GitHub URLs. CI hit GitHub raw HTTP 429 on AUTHORS.txt, aborting the whole
# package publish; one codeload tarball is less rate-limit-prone and keeps the
# source snapshot atomic.
pkgrel=2
_commit=e337a5f69a9bea30e58d05bd40184d79cc099628
pkgdesc="Rubik variable font, UI font for caelestia-shell (Genesi repackage of ttf-rubik-vf)"
arch=("any")
url="https://github.com/googlefonts/rubik"
license=("OFL")
provides=('ttf-rubik-vf')
conflicts=('ttf-rubik-vf')
source=(
  "${pkgname}-${_commit}.tar.gz::https://codeload.github.com/googlefonts/rubik/tar.gz/${_commit}"
)
sha256sums=('SKIP')

package() {
  cd "${srcdir}/rubik-${_commit}"
  install -d "${pkgdir}/usr/share/fonts/TTF"
  install -m644 fonts/variable/*.ttf "${pkgdir}/usr/share/fonts/TTF/"
  install -D -m644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" OFL.txt AUTHORS.txt CONTRIBUTORS.txt
}
