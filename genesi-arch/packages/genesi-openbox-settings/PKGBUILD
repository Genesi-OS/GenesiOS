# Maintainer: Genesi OS Team
#
# Genesi rebrand of cachyos-openbox-settings (the tint2 + jgmenu/obmenu + picom +
# nitrogen Openbox setup), same pattern as genesi-kde-settings: pull the upstream
# tarball, ship its etc/ + usr/ config, then rebrand the visible strings and
# repoint the wallpaper at the Genesi one. Openbox ships no config of its own, so
# without this the session is a bare black screen.
_cachyver=1.0.4
pkgname=genesi-openbox-settings
pkgver=1.0.4
# pkgrel 2: nitrogen was dropped from the repos (target not found), so set the
# wallpaper via feh in the openbox autostart instead.
pkgrel=2
pkgdesc='Genesi OS Openbox settings (tint2, jgmenu, picom, dark theme)'
arch=('any')
url="https://github.com/Genesi-OS/GenesiOS"
license=(GPL-1.0-only)
makedepends=('coreutils')
# Mirrors cachyos-openbox-settings' deps — the config references all of these
# NO runtime depends on purpose: this package only COPIES config files, so it
# needs nothing to build — and declaring the tools broke CI. The "install build
# deps" step pre-installs every depends[], and picom-ibhagwan-git (AUR) +
# nitrogen weren't in the build container, failing the whole publish. The tools
# the config references (openbox, tint2, nitrogen, picom, rofi, dunst, the nord
# GTK theme, a terminal, …) are installed by the Openbox NETINSTALL group, which
# resolves against the full target repos.
depends=()
install=$pkgname.install
# Replace the CachyOS package. Deliberately do NOT claim the generic
# cachyos-desktop-settings singleton (see genesi-kde-settings pkgrel 7) — only
# the openbox one. Still conflicts cachyos-picom-config (overlapping picom
# config), so that's dropped from the Openbox netinstall group.
provides=('cachyos-openbox-settings')
conflicts=('cachyos-openbox-settings' 'cachyos-picom-config')
source=("cachyos-openbox-settings-$_cachyver.tar.gz::https://github.com/cachyos/cachyos-openbox-settings/archive/$_cachyver.tar.gz")
sha512sums=('0c7925b6a293052821f00eb234ebc1cbbada014f4534f1472a56a9cc22db6cebb71e32f3672a7784ba7eb6a7c218ea1578e8a9ee54396000f7f8c40782c614e5')

package() {
    local _src="$srcdir/cachyos-openbox-settings-$_cachyver"
    [ -d "$_src/etc" ] && cp -rf "$_src/etc" "$pkgdir/"
    [ -d "$_src/usr" ] && cp -rf "$_src/usr" "$pkgdir/"

    # Rebrand visible "CachyOS" strings in the shipped text config/menus.
    grep -rlZ "CachyOS" "$pkgdir" 2>/dev/null | while IFS= read -r -d '' f; do
        sed -i 's/CachyOS/Genesi OS/g' "$f" 2>/dev/null || true
    done

    # Wallpaper: nitrogen was dropped from the Arch/CachyOS repos, so the config's
    # `nitrogen --restore` can't run. Set it with feh (in the Openbox group)
    # instead — neutralise the nitrogen line in the openbox autostart and make
    # sure a feh line points at the Genesi wallpaper.
    local _wall="/usr/share/wallpapers/genesi/wallpaper.png"
    find "$pkgdir" -path '*openbox/autostart' 2>/dev/null | while read -r f; do
        sed -i "s#nitrogen --restore.*#feh --bg-scale $_wall \&#" "$f" 2>/dev/null || true
        grep -q "wallpapers/genesi/wallpaper.png" "$f" 2>/dev/null \
            || printf '\nfeh --bg-scale %s &\n' "$_wall" >> "$f" 2>/dev/null || true
    done
    # If nitrogen ever returns, keep its saved config pointing at ours too.
    find "$pkgdir" -name 'bg-saved.cfg' 2>/dev/null | while read -r f; do
        sed -i "s#^file=.*#file=$_wall#" "$f" 2>/dev/null || true
    done
}
