// Genesi OS Plymouth theme. Asset sizes are fixed so it stays crisp and
// centered at common VM, laptop and HiDPI boot resolutions.
Window.SetBackgroundTopColor(0.018, 0.047, 0.043);
Window.SetBackgroundBottomColor(0.008, 0.020, 0.019);

center_x = Window.GetWidth() / 2;
center_y = Window.GetHeight() / 2 - 28;

ring.image = Image("ring.png");
ring.sprite = Sprite(ring.image);
ring.sprite.SetPosition(center_x - ring.image.GetWidth() / 2,
                        center_y - ring.image.GetHeight() / 2 - 54, 4);

logo.image = Image("mark.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(center_x - logo.image.GetWidth() / 2,
                        center_y - logo.image.GetHeight() / 2 - 54, 8);

title.image = Image.Text("Genesi OS", 0.91, 0.97, 0.95, 1, "Sans Bold 28");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(center_x - title.image.GetWidth() / 2, center_y + 74, 8);

status.image = Image.Text("Starting your workspace", 0.47, 0.61, 0.57, 1, "Sans 11");
status.sprite = Sprite(status.image);
status.sprite.SetPosition(center_x - status.image.GetWidth() / 2, center_y + 116, 8);

track.image = Image("progress-track.png");
track.sprite = Sprite(track.image);
track.x = center_x - track.image.GetWidth() / 2;
track.y = center_y + 151;
track.sprite.SetPosition(track.x, track.y, 6);

fill.original = Image("progress-fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(track.x, track.y, 7);

dot.image = Image("dot.png");
dot1.sprite = Sprite(dot.image);
dot2.sprite = Sprite(dot.image);
dot3.sprite = Sprite(dot.image);
dot1.sprite.SetPosition(center_x - 25, center_y + 177, 8);
dot2.sprite.SetPosition(center_x - 5, center_y + 177, 8);
dot3.sprite.SetPosition(center_x + 15, center_y + 177, 8);

fun progress_callback(duration, progress) {
    width = fill.original.GetWidth() * progress;
    if (width < 1) width = 1;
    fill.image = fill.original.Scale(width, fill.original.GetHeight());
    fill.sprite.SetImage(fill.image);
}
Plymouth.SetBootProgressFunction(progress_callback);

global.frame = 0;
fun refresh_callback() {
    global.frame++;
    wave = global.frame * 0.075;
    ring.sprite.SetOpacity(0.32 + 0.20 * Math.Sin(wave));
    logo.sprite.SetOpacity(0.90 + 0.10 * Math.Sin(wave));
    dot1.sprite.SetOpacity(0.64 + 0.36 * Math.Sin(wave));
    dot2.sprite.SetOpacity(0.64 + 0.36 * Math.Sin(wave + 1.7));
    dot3.sprite.SetOpacity(0.64 + 0.36 * Math.Sin(wave + 3.4));
}
Plymouth.SetRefreshFunction(refresh_callback);

prompt.sprite = Sprite();
fun show_prompt(text, bullets) {
    prompt.image = Image.Text(text + "  " + bullets, 0.91, 0.97, 0.95, 1, "Sans 13");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(center_x - prompt.image.GetWidth() / 2, center_y + 118, 20);
}
fun display_password_callback(text, bullets) { show_prompt(text, bullets); }
fun display_question_callback(text, entry) { show_prompt(text, entry); }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun message_callback(text) {
    status.image = Image.Text(text, 0.64, 0.75, 0.71, 1, "Sans 11");
    status.sprite.SetImage(status.image);
    status.sprite.SetPosition(center_x - status.image.GetWidth() / 2, center_y + 116, 8);
}
Plymouth.SetMessageFunction(message_callback);
