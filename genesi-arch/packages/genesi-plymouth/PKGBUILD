# Maintainer: Genesi OS Team <dev@genesios.org>
pkgname=genesi-plymouth
pkgver=1.0.0
# 2026-08-21: the leaf was clipped along its bottom edge on the boot splash.
# The outline path ends at y=256 -- exactly the old viewBox edge -- and it is a
# 13px STROKE, which paints 6.5px either side of the path, so the tip reached
# y=262.5 and was cut off. Counting the stroke, the real ink runs y=11.5 to
# y=262.5: 251 tall, centred on y=137. viewBox is now "0 9 256 256", which holds
# it with 2.5px to spare top and bottom. The box stays 256 square on purpose --
# the rendered logo is exactly the size it was, only no longer clipped.
pkgrel=3
pkgdesc='Genesi OS animated Plymouth boot splash'
arch=('any')
url='https://github.com/Genesi-OS/GenesiOS'
license=('AGPL-3.0-or-later')
depends=('plymouth' 'mkinitcpio' 'genesi-grub-theme')
makedepends=('librsvg')
install='genesi-plymouth.install'
source=('genesi.plymouth' 'genesi.script' 'logo.svg' 'ring.svg' 'dot.svg'
        'progress-track.svg' 'progress-fill.svg')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    local theme="$pkgdir/usr/share/plymouth/themes/genesi"
    install -Dm644 genesi.plymouth "$theme/genesi.plymouth"
    install -Dm644 genesi.script "$theme/genesi.script"

    rsvg-convert -w 176 -h 176 -o "$theme/mark.png" logo.svg
    rsvg-convert -w 212 -h 212 -o "$theme/ring.png" ring.svg
    rsvg-convert -w 10 -h 10 -o "$theme/dot.png" dot.svg
    rsvg-convert -w 320 -h 4 -o "$theme/progress-track.png" progress-track.svg
    rsvg-convert -w 320 -h 4 -o "$theme/progress-fill.png" progress-fill.svg
}
