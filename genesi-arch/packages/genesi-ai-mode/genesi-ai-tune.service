[Unit]
Description=Genesi AI Autotuner - calibrate inference knobs on this hardware
Documentation=https://github.com/Genesi-OS/GenesiOS
# Sweeps ubatch / flash-attn / KV type / threads with llama-bench on the REAL
# model + hardware and writes the fastest config to /var/lib/genesi-ai-mode/
# tune.json, which genesi-ai-turbo reads as its defaults. Oneshot, driven by
# genesi-ai-tune.timer (nightly). The tool self-gates: it exits early unless the
# machine is on AC and no Turbo session is generating, so it never steals the GPU
# from you. Order after ollama so model blobs are group-readable.
After=ollama.service genesi-aid.service
Wants=genesi-aid.service

[Service]
Type=oneshot
# Low priority: a nightly calibration must never contend with anything the user
# is doing. Nice + idle IO so it yields instantly.
Nice=15
IOSchedulingClass=idle
ExecStart=/usr/local/bin/genesi-ai-tune
# The bench is bounded but a huge model on a slow box can take a while.
TimeoutStartSec=2400

# Needs the GPU + to read the model blobs and write the state dir. StateDirectory
# ensures /var/lib/genesi-ai-mode exists and is writable (shared with genesi-aid).
StateDirectory=genesi-ai-mode
NoNewPrivileges=true
ProtectSystem=true
ProtectHome=true
