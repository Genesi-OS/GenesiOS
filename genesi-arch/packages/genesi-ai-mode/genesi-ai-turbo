#!/usr/bin/env python3
"""
Genesi Turbo — speculative decoding for local models (faster than any stock OS).

ollama doesn't expose speculative decoding, so Turbo drives llama.cpp's
`llama-server` directly: a small same-family DRAFT model proposes tokens and the
big TARGET model verifies several at once. The output is IDENTICAL to the target
model, but decode is typically 1.5-3x faster. Reuses the GGUF weights ollama
already downloaded — no re-download.

  genesi-ai-turbo bench <model> [draft]   prove the speedup (spec vs no-spec)
  genesi-ai-turbo serve <model> [--spec]  run a Turbo server on :11435
                                          (defers to a mesh peer already
                                          serving one; --local overrides)
  genesi-ai-turbo recommend [--installed] print the biggest model that fits VRAM
                                          (--installed: only ones already pulled)
  genesi-ai-turbo share on|off            bind Turbo to the LAN (what
                                          `genesi-mesh serve` calls — prefer
                                          that; sharing compute is Mesh's job)
  genesi-ai-turbo <model> [--spec]        same as `serve`

<model> is either an ollama tag (llama3.1:8b) or ANY GGUF on this machine —
a path (./mistral.gguf, ~/Downloads/x.gguf) or gguf:<name> from the Genesi GGUF
library. Every Turbo feature (MoE expert-offload, Fit, spec, autotune) works the
same either way, so a model downloaded straight from Hugging Face needs no
ollama import step at all:

  genesi-ai-turbo gguf-list               JSON of the local GGUF library
  genesi-ai-turbo gguf-import <src>       add a .gguf file (or URL) to the library
  genesi-ai-turbo gguf-info <path>        one GGUF's metadata + how it will run
  genesi-ai-turbo serve ~/Downloads/qwen3-30b-a3b-q4.gguf

  --spec / --speculative   enable speculative decoding (a draft model proposes
                           tokens; faster decode on a mature GPU driver, but can
                           REGRESS on Vulkan/NVK). Default OFF = plain full GPU
                           offload, the reliable win. (== GENESI_TURBO_SPEC=1)

Needs llama-server, shipped by Genesi (Vulkan, any GPU):
  sudo pacman -S genesi-llama-cpp

Tuning knobs (env vars, no rebuild needed — for on-hardware tuning):
  GENESI_TURBO_CTX=8192          context window
  GENESI_TURBO_UBATCH=<n>        physical prefill batch / n_ubatch
                                 (default 1024 on GPU, 512 on CPU; lower it if a
                                  small GPU OOMs, raise it on a big GPU)
  GENESI_TURBO_BATCH=2048        logical prefill batch
  GENESI_TURBO_CACHE_REUSE=256   min prefix chunk reused across requests (KV)
  GENESI_TURBO_MLOCK=1           pin model in RAM (opt-in; risky on low RAM)
  GENESI_TURBO_NCMOE=<n>         MoE: force N layers' experts onto CPU RAM (auto
                                 by VRAM otherwise; only used for MoE models that
                                 spill VRAM)
  GENESI_TURBO_NO_MOE=1          disable MoE expert-offload (fall back to plain
                                 partial offload; `serve` also auto-falls-back to
                                 this if --n-cpu-moe trips the model loader)
  GENESI_TURBO_THREADS=<n>       CPU inference threads for DECODE (default: fast/
                                 perf cores)
  GENESI_TURBO_THREADS_BATCH=<n> CPU threads for PREFILL (default: all logical
                                 cores — prefill is compute-bound, SMT helps)
  GENESI_TURBO_PRIO=2            CPU thread scheduling priority (above-normal)
  GENESI_TURBO_NO_CPU_TUNE=1     skip the CPU prefill-threads / priority tuning
  GENESI_TURBO_NO_NGRAM=1        disable model-free n-gram/prompt-lookup spec
                                 (on by default when no draft model — free win on
                                 code/agent/RAG output, harmless otherwise)
  GENESI_TURBO_SELF_DRAFT=1      when no same-family draft exists, build a low-bit
                                 self-draft (Q2) of the model for speculation
                                 (opt-in; modest ~1.1-1.3x and only if both fit
                                 VRAM, so usually a no-op on an 8 GB card)
  GENESI_TURBO_FIT=1             Genesi Fit: if the model would SPILL VRAM,
                                 requantize it DOWN to the best quant that fits
                                 100% on the GPU and serve that. A spilling model
                                 crawls at CPU/PCIe bandwidth; a slightly-lower
                                 quant that FITS runs at full GPU speed (spec then
                                 stacks on top) — usually a far bigger win than the
                                 small quality cost. One-off llama-quantize, cached
                                 in ~/.cache/genesi-turbo/fitted. Opt-in (quality
                                 tradeoff). No-op if it already fits / nothing fits.
  GENESI_TURBO_SPILL_SPEC=1      keep the GPU draft EVEN when the target spills
                                 VRAM. Speculative verification reads the CPU-
                                 resident layers over PCIe once per batch, so K
                                 accepted tokens cost ~1 weight-stream — a decode
                                 win plain ollama can't match on a too-big model
                                 (measured +29% on a spilling 14B). DEFAULT ON for
                                 CUDA (disable: GENESI_TURBO_NO_SPILL_SPEC); opt-in
                                 on Vulkan/NVK where it regressed. ~0.4 GB VRAM.
  GENESI_TURBO_NO_SPILL_SPEC=1   disable spill-spec on CUDA (see above)
  GENESI_TURBO_DRAFT_MAX=8       max tokens the draft proposes (speculative only)
  GENESI_TURBO_DRAFT_MIN=1       min draft length — floor for dynamic draft length
  GENESI_TURBO_DRAFT_P=0.6       stop drafting below this acceptance probability
  GENESI_TURBO_SLOT_PATH=<dir>   where to persist prompt/KV slots to disk
  GENESI_TURBO_NO_SLOT_CACHE=1   disable persistent prompt/KV cache to disk
  GENESI_TURBO_DRAFT_MAX=8       max tokens the draft proposes (speculative only)
  GENESI_TURBO_DRAFT_MIN=1       min draft length — floor for dynamic draft length
  GENESI_TURBO_DRAFT_P=0.6       stop drafting below this acceptance probability
  GENESI_TURBO_SLOT_PATH=<dir>   where to persist prompt/KV slots to disk
  GENESI_TURBO_NO_SLOT_CACHE=1   disable persistent prompt/KV cache to disk
  GENESI_TURBO_SPEC=1            force speculative decoding ON for `serve`
  GENESI_TURBO_NO_SPEC=1         force speculative decoding OFF for `serve`
                                 Default (neither set): AUTO — spec is ON when the
                                 installed llama-server is the CUDA build (the
                                 proven win on a mature driver) and OFF on Vulkan/
                                 NVK (where the draft+verify can cost more than
                                 plain offload saves). It also self-disables when
                                 the target model spills VRAM (no draft then).
  GENESI_TURBO_FORCE_DRAFT=1     force the draft even on CPU-only (usually slower)
  GENESI_TURBO_PARALLEL=<n>      continuous batching: serve N concurrent
                                 sequences from ONE loaded model, so Genesi Code
                                 agents + other Genesi apps + the prefill-as-you-
                                 type warm requests all share the SAME weights in
                                 VRAM and decode in parallel (aggregate tokens/s
                                 scales ~with N — the weight read is amortized
                                 across the batch). 0/unset = AUTO by VRAM
                                 headroom (stays 1 when the model spills or on
                                 CPU). Total KV = ctx * N.
  GENESI_TURBO_FA=on|off|auto    override flash-attention (default: on for GPU,
                                 auto for CPU)
  GENESI_TURBO_KV=q8_0|f16|...   override the KV cache type (default: q8_0 on GPU,
                                 f16 on CPU)
  GENESI_TURBO_NO_TUNE=1         ignore the autotuned per-machine profile written
                                 by genesi-ai-tune (use the built-in heuristics)
"""
import os
import re
import sys
import json
import time
import signal
import shutil
import socket
import tempfile
import subprocess
import urllib.parse
import urllib.request

TURBO_PORT = 11435

# Which address llama-server binds. Loopback by default: Turbo has no auth, and
# a warm inference server reachable from the LAN is a real exposure.
#
# GENESI_TURBO_HOST=0.0.0.0 makes one machine serve the whole house, which is
# the RIGHT shape when only one box has the GPU. The alternative -- Genesi Mesh
# -- pools VRAM by shipping layer activations over the wire for EVERY token, so
# it is how you run a model that fits nowhere, not how you make a fitting model
# fast. Measured on a 3B over WiFi: the remote GPU sat at 2-3% utilisation,
# idle, waiting on a 9 ms round trip. Serving the same model over HTTP from the
# machine that owns the GPU moves text instead of tensors and the network stops
# mattering.
TURBO_HOST = os.environ.get("GENESI_TURBO_HOST", "127.0.0.1").strip() or "127.0.0.1"



def _turbo_url():
    """Where CLIENTS should send inference, resolved fresh at each call.

    Order: an explicit GENESI_TURBO_URL, then a mesh peer advertising Turbo,
    then loopback. Nobody should have to set the variable -- a machine with no
    GPU that can see a peer serving Turbo finds it through the same discovery
    that already powers the mesh. The override stays first so a hand-built setup
    always beats discovery.

    Resolved per call rather than cached at import: peers come and go, and the
    long-lived processes that use this (the passive helpers) would otherwise be
    pinned to whatever was true the moment they started."""
    override = (os.environ.get("GENESI_TURBO_URL") or "").strip()
    if override:
        return override.rstrip("/")
    sys.path.insert(0, "/usr/lib/genesi-mesh")
    try:
        import genesi_mesh_common as _mesh
    except ImportError:
        return "http://127.0.0.1:%d" % TURBO_PORT
    try:
        return _mesh.turbo_url()
    except Exception:
        # Discovery must never be the reason inference fails: a malformed
        # peers.json, a permissions change, anything -- fall back to local.
        return "http://127.0.0.1:%d" % TURBO_PORT
PROMPT = "Explain how a CPU instruction pipeline works, in about 200 words."

# (family substring in the target tag -> a tiny, SAME-tokenizer draft model)
# The draft MUST share the target's vocab/tokenizer or speculation gets near-zero
# acceptance (or fails), so map each family to its OWN smallest member — never a
# cross-generation draft (e.g. gemma3 must use gemma3:1b, NOT gemma2). Longest /
# most-specific prefixes first (pick_draft uses startswith).
DRAFT_FOR = [
    ("llama3.3", "llama3.2:1b"),
    ("llama3.1", "llama3.2:1b"),
    ("llama3.2", "llama3.2:1b"),
    ("llama3",   "llama3.2:1b"),
    ("qwen2.5",  "qwen2.5:0.5b"),
    ("qwen2",    "qwen2.5:0.5b"),
    ("qwen3",    "qwen3:0.6b"),
    ("gemma3",   "gemma3:1b"),
    ("gemma2",   "gemma2:2b"),
]
TINY = (":0.5b", ":0.6b", ":1b", ":1.5b")


def _daemon_models_dir():
    """The OLLAMA_MODELS the ollama systemd service actually runs with.

    This is the source of truth: the daemon writes models *here*, and on
    Genesi/Arch it is set to bare /var/lib/ollama — with blobs/ and manifests/
    directly inside, NOT under a models/ subdir. Guessing conventional paths
    misses this, so we ask systemd what the running daemon uses."""
    try:
        out = subprocess.run(
            ["systemctl", "show", "ollama", "-p", "Environment"],
            capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return None
    # Line looks like: Environment=HOME=/var/lib/ollama OLLAMA_MODELS=/var/lib/ollama ...
    for tok in out.replace("Environment=", "", 1).split():
        if tok.startswith("OLLAMA_MODELS="):
            return tok.split("=", 1)[1].strip() or None
    return None


def _candidate_model_dirs():
    """Yield every plausible Ollama model root, in priority order.

    The daemon may store models in any of these depending on how Ollama was
    installed: an explicit OLLAMA_MODELS (Genesi/Arch use bare /var/lib/ollama,
    blobs+manifests directly inside), the upstream installer's
    /usr/share/ollama/.ollama, or a user's ~/.ollama. Crucially, MORE THAN ONE
    can exist at once — e.g. empty/stale .../models/manifests dirs sitting next
    to the real ones — so callers must probe *every* root for the specific
    model they want instead of locking onto the first dir with a manifests/
    subdir. We list the systemd daemon's real OLLAMA_MODELS first."""
    seen = set()
    for d in (os.environ.get("OLLAMA_MODELS"),
              _daemon_models_dir(),
              "/var/lib/ollama",
              "/usr/share/ollama/.ollama/models",
              "/usr/share/ollama",
              "/var/lib/ollama/.ollama/models",
              "/var/lib/ollama/models",
              os.path.expanduser("~/.ollama/models")):
        if d and d not in seen and os.path.isdir(os.path.join(d, "manifests")):
            seen.add(d)
            yield d


def models_dir():
    """First existing model root (any with a manifests/ dir), or None.

    Kept for the permission-fix path; model *resolution* uses gguf_path, which
    searches all roots — see _candidate_model_dirs()."""
    for d in _candidate_model_dirs():
        return d
    return None


def gguf_path(tag):
    """The GGUF blob ollama stored for `tag` (e.g. 'llama3.1:8b'), or None.

    Searches every candidate model root (not just the first one with a
    manifests/ dir) so a stale/empty root can't shadow the one the daemon
    actually pulled into."""
    name, _, ver = tag.partition(":")
    ver = ver or "latest"
    roots = list(_candidate_model_dirs())
    if not roots:
        print("[!] No Ollama models directory found (no manifests/ dir anywhere)",
              file=sys.stderr)
        return None
    last_err = None
    for md in roots:
        man = os.path.join(md, "manifests", "registry.ollama.ai", "library", name, ver)
        if not os.path.isfile(man):
            last_err = f"[!] Manifest not found: {man}"
            continue
        try:
            m = json.load(open(man))
        except Exception as e:
            last_err = f"[!] Error reading manifest {man}: {e}"
            continue
        for layer in m.get("layers", []):
            if layer.get("mediaType", "").endswith("image.model"):
                digest = layer.get("digest", "")
                # Ollama sometimes uses sha256-xxx, sometimes sha256:xxx in digest, but the file is always sha256-xxx
                blob_name = digest.replace(":", "-")
                blob = os.path.join(md, "blobs", blob_name)
                if not os.path.isfile(blob):
                    last_err = f"[!] Blob not found: {blob}"
                    break
                if not os.access(blob, os.R_OK):
                    last_err = f"[!] Permission denied to read blob: {blob}"
                    break
                return blob
        else:
            last_err = f"[!] No image.model layer found in manifest {man}"
    # Nothing matched in any root — report the most specific reason we hit.
    if last_err:
        print(last_err, file=sys.stderr)
    return None


# ── Genesi GGUF library ──────────────────────────────────────────────────────
# Any .gguf on the machine is a first-class Turbo model. llama-server reads the
# architecture, context length and chat template straight out of the GGUF header,
# so a file downloaded from Hugging Face needs NO ollama import step — pointing
# `-m` at it is enough. That matters most for MoE models: the quants that make a
# 30B-A3B usable on an 8 GB card live on HF, and ollama's own runner doesn't
# expose the expert-offload flag (--n-cpu-moe) that makes them fast. Everything
# below is just discovery + bookkeeping; the serving path is unchanged.

# Where `gguf-import` puts files, and the roots we scan for existing ones.
def gguf_library_dir():
    """The Genesi GGUF library (created on demand). Override: GENESI_GGUF_DIR."""
    env = os.environ.get("GENESI_GGUF_DIR", "").split(":")[0].strip()
    if env:
        return os.path.expanduser(env)
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(data, "genesi", "models")


def _gguf_scan_dirs():
    """Every directory we look in for .gguf files, best-known first. Includes the
    usual places a browser drops a Hugging Face download so the user doesn't have
    to move the file at all."""
    dirs, seen = [], set()
    for d in ([os.path.expanduser(p) for p in
               os.environ.get("GENESI_GGUF_DIR", "").split(":") if p.strip()]
              + [gguf_library_dir(),
                 os.path.expanduser("~/Downloads"),
                 os.path.expanduser("~/Models"),
                 os.path.expanduser("~/.cache/huggingface/hub"),
                 "/var/lib/genesi/models"]):
        rp = os.path.realpath(d)
        if rp not in seen and os.path.isdir(d):
            seen.add(rp)
            dirs.append(d)
    return dirs


# A sharded model is "model-00001-of-00003.gguf"; llama.cpp loads the whole set
# when pointed at the FIRST shard, so we list only that one and hide the rest.
_SHARD_RE = re.compile(r"-(\d{5})-of-(\d{5})\.gguf$", re.I)


def _is_hidden_shard(path):
    m = _SHARD_RE.search(os.path.basename(path))
    return bool(m) and m.group(1) != "00001"


def scan_gguf_library(max_depth=3):
    """Every usable .gguf on this machine as a list of dicts (see gguf_describe).
    Bounded-depth walk so a huge home directory can't stall the UI."""
    out, seen = [], set()
    for root in _gguf_scan_dirs():
        base_depth = root.rstrip(os.sep).count(os.sep)
        for dirpath, dirnames, filenames in os.walk(root):
            if dirpath.count(os.sep) - base_depth >= max_depth:
                dirnames[:] = []
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for fn in filenames:
                if not fn.lower().endswith(".gguf"):
                    continue
                p = os.path.join(dirpath, fn)
                rp = os.path.realpath(p)
                if rp in seen or _is_hidden_shard(p):
                    continue
                # Genesi Fit's requantized copies are derived artifacts, not
                # models the user picked — keep them out of the library list.
                if os.sep + ".cache" + os.sep + "genesi-turbo" + os.sep in rp:
                    continue
                seen.add(rp)
                try:
                    if os.path.getsize(p) < 1024 * 1024:      # stub/partial download
                        continue
                except OSError:
                    continue
                out.append(gguf_describe(p))
    out.sort(key=lambda d: d.get("name", "").lower())
    return out


def is_gguf_ref(ref):
    """True when `ref` names a GGUF file rather than an ollama tag."""
    if not ref:
        return False
    r = str(ref)
    return (r.startswith("gguf:") or r.lower().endswith(".gguf")
            or (os.sep in r and os.path.isfile(os.path.expanduser(r))))


def resolve_gguf_ref(ref):
    """A GGUF reference -> an absolute readable path, or None.

    Accepts an absolute/relative path, ~-expanded, or `gguf:<name>` which is
    matched against the library by file name (with or without the .gguf suffix)."""
    if not ref:
        return None
    r = str(ref)
    if r.startswith("gguf:"):
        want = r[5:].strip().lower()
        if not want:
            return None
        for entry in scan_gguf_library():
            base = os.path.basename(entry["path"]).lower()
            if want in (base, base[:-5], entry.get("name", "").lower()):
                return entry["path"]
        return None
    p = os.path.abspath(os.path.expanduser(r))
    return p if os.path.isfile(p) and os.access(p, os.R_OK) else None


# GGUF file_type -> the quant name users recognise. Mirrors _FT_BPW above.
_FT_NAME = {0: "F32", 1: "F16", 2: "Q4_0", 3: "Q4_1", 7: "Q8_0", 8: "Q5_0",
            9: "Q5_1", 10: "Q2_K", 11: "Q3_K_S", 12: "Q3_K_M", 13: "Q3_K_L",
            14: "Q4_K_S", 15: "Q4_K_M", 16: "Q5_K_S", 17: "Q5_K_M", 18: "Q6_K",
            19: "IQ2_XXS", 20: "IQ4_NL", 30: "IQ4_XS"}


def gguf_describe(path):
    """Everything the UI needs about one GGUF, read from its header (cheap — no
    weights are loaded). Never raises: unreadable fields simply come back empty."""
    try:
        size_gb = os.path.getsize(path) / (1024.0 ** 3)
    except OSError:
        size_gb = 0.0
    meta = gguf_meta(path, (".expert_count", ".block_count", ".context_length",
                            ".file_type", "general.architecture",
                            "general.name", "general.size_label"))
    experts = int(meta.get(".expert_count") or 0)
    ft = meta.get(".file_type")
    try:
        ft = int(ft)
    except (TypeError, ValueError):
        ft = -1
    bpw = _FT_BPW.get(ft, 4.8)
    # Total parameters: prefer the model's own label, else infer from the file
    # size and bits-per-weight (size_gb * 8 / bpw), which is accurate to ~5%.
    label = str(meta.get("general.size_label") or "").strip()
    params_b = 0.0
    m = re.match(r"^(\d+(?:\.\d+)?)\s*[Bb]$", label)
    if m:
        params_b = float(m.group(1))
    # NOTE: a MoE label like "8x7B" or "32x2.4B" is NOT a multiplication. Experts
    # share the attention and embedding weights, so the real total is far lower
    # than the product (Mixtral 8x7B is 46.7B, not 56; gpt-oss 32x2.4B is 21B,
    # not 76.8). Multiplying it reported gpt-oss-20b as "76.8B" in the pickers.
    # Fall through to the size estimate below, which is accurate to a few percent
    # because it measures the bytes actually on disk.
    if params_b <= 0 and size_gb > 0 and bpw > 0:
        params_b = size_gb * 8.0 / bpw
    name = (str(meta.get("general.name") or "").strip()
            or os.path.basename(path)[:-5])
    return {
        "path": path,
        "file": os.path.basename(path),
        "name": name,
        "arch": str(meta.get("general.architecture") or "").strip(),
        "size_gb": round(size_gb, 2),
        "params_b": round(params_b, 1),
        "quant": _FT_NAME.get(ft, ""),
        "experts": experts,
        "moe": experts > 1,
        "blocks": int(meta.get(".block_count") or 0),
        "context": int(meta.get(".context_length") or 0),
        "in_library": os.path.realpath(path).startswith(
            os.path.realpath(gguf_library_dir())),
    }


def gguf_fit_report(entry):
    """How this GGUF will actually run on THIS machine — the honest expectation,
    not a download button. Returns (verdict, detail) where verdict is one of
    'gpu' (fits VRAM entirely), 'moe' (spills, but expert-offload keeps it fast),
    'spill' (spills as a dense model — slow) or 'cpu' (no usable GPU)."""
    vram_gb = _detect_vram_mb() / 1024.0
    ram_gb = _total_ram_gb()
    budget = max(vram_gb - 1.2, 0.0)          # runtime + KV headroom
    size = float(entry.get("size_gb") or 0.0)
    if vram_gb < 1.0:
        if size > ram_gb * 0.7:
            return "cpu", (f"needs ~{size:.1f} GB but only ~{ram_gb * 0.7:.1f} GB "
                           "of RAM is safely usable — expect swapping")
        return "cpu", (f"CPU only ({ram_gb:.0f} GB RAM) — works, but decode is "
                       "limited by memory bandwidth")
    if size <= budget:
        return "gpu", (f"fits your {vram_gb:.1f} GB VRAM completely "
                       f"({size:.1f} GB) — full GPU speed")
    if entry.get("moe"):
        active = (float(entry.get("params_b") or 0.0)
                  / max(int(entry.get("experts") or 1), 1))
        need_ram = size * 1.15
        if need_ram > ram_gb * 0.7:
            return "spill", (f"MoE, but its experts need ~{size:.1f} GB of RAM and "
                             f"only ~{ram_gb * 0.7:.1f} GB is safely usable")
        return "moe", (f"too big for {vram_gb:.1f} GB VRAM, but it is MoE — Turbo "
                       f"keeps attention on the GPU and streams the experts from "
                       f"RAM (~{active:.1f}B active/token), so it runs far faster "
                       "than a dense model this size")
    return "spill", (f"{size:.1f} GB vs a {budget:.1f} GB VRAM budget — part of it "
                     "runs on the CPU, so decode will be slow. A smaller quant or "
                     "an MoE model of the same size will be much faster")


def import_gguf(src, move=False, progress=None):
    """Add `src` (a local .gguf path or an http(s) URL) to the GGUF library and
    return its new path. Raises ValueError/OSError with a user-readable message.

    Copy (not move) by default: the user's download stays where they put it."""
    lib = gguf_library_dir()
    os.makedirs(lib, exist_ok=True)
    src = str(src).strip()
    if src.startswith("file://"):
        src = urllib.parse.unquote(urllib.parse.urlparse(src).path)
    if src.startswith(("http://", "https://")):
        return _download_gguf(src, lib, progress)
    p = os.path.abspath(os.path.expanduser(src))
    if not os.path.isfile(p):
        raise ValueError(f"not a file: {src}")
    if not p.lower().endswith(".gguf"):
        raise ValueError("not a .gguf file — Genesi serves GGUF weights "
                         "(convert safetensors first, or download the GGUF build)")
    with open(p, "rb") as fh:
        if fh.read(4) != b"GGUF":
            raise ValueError("this file is not a valid GGUF (bad magic header) — "
                             "it may be an incomplete download")
    dest = os.path.join(lib, os.path.basename(p))
    if os.path.realpath(dest) == os.path.realpath(p):
        return p                                   # already in the library
    if os.path.exists(dest):
        raise ValueError(f"{os.path.basename(p)} is already in the library")
    free = shutil.disk_usage(lib).free
    need = os.path.getsize(p)
    if not move and free < need + (256 * 1024 * 1024):
        raise OSError(f"not enough free space: needs {need / 1024**3:.1f} GB, "
                      f"{free / 1024**3:.1f} GB available")
    if move:
        try:
            os.replace(p, dest)                    # same filesystem: instant
            return dest
        except OSError:
            pass                                   # cross-device: fall back to copy
    tmp = dest + ".part"
    try:
        shutil.copyfile(p, tmp)
        os.replace(tmp, dest)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    if move:
        try:
            os.unlink(p)
        except OSError:
            pass
    return dest


def _download_gguf(url, lib, progress=None):
    """Fetch a .gguf over http(s) into the library, resumable-safe (writes to
    .part and renames on success so a cancelled download is never served)."""
    name = os.path.basename(urllib.parse.urlparse(url).path) or "model.gguf"
    if not name.lower().endswith(".gguf"):
        raise ValueError("that URL doesn't point at a .gguf file")
    dest = os.path.join(lib, name)
    if os.path.exists(dest):
        raise ValueError(f"{name} is already in the library")
    tmp = dest + ".part"
    req = urllib.request.Request(url, headers={"User-Agent": "genesi-ai-turbo"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            total = int(r.headers.get("Content-Length") or 0)
            free = shutil.disk_usage(lib).free
            if total and free < total + (256 * 1024 * 1024):
                raise OSError(f"not enough free space: needs "
                              f"{total / 1024**3:.1f} GB, "
                              f"{free / 1024**3:.1f} GB available")
            done = 0
            with open(tmp, "wb") as fh:
                while True:
                    chunk = r.read(1024 * 1024)
                    if not chunk:
                        break
                    fh.write(chunk)
                    done += len(chunk)
                    if progress and total:
                        progress(done, total)
        with open(tmp, "rb") as fh:
            if fh.read(4) != b"GGUF":
                raise ValueError("the downloaded file is not a valid GGUF")
        os.replace(tmp, dest)
        return dest
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _fix_ollama_permissions():
    """Try to open up the Ollama models tree so any local user can read the
    GGUF blobs. Ollama's systemd service runs as the `ollama` user, so newly
    pulled files are readable only by root/ollama.  The genesi-ollama.conf
    drop-in fixes this on service start, but models pulled *after* that need
    a one-shot chmod. We try pkexec first (graphical polkit prompt, no
    terminal), then fall back to sudo (works in a tty session)."""
    # Candidate roots — the daemon may use any of these.
    candidates = [
        "/var/lib/ollama",
        "/usr/share/ollama/.ollama",
    ]
    # Also consider OLLAMA_MODELS env if set.
    env_models = os.environ.get("OLLAMA_MODELS")
    if env_models:
        candidates.insert(0, os.path.dirname(env_models)
                          if env_models.endswith("/models") else env_models)

    for root in candidates:
        models = os.path.join(root, "models")
        # Also check the hidden .ollama/models subpath common in systemd setups.
        for mdir in (models, os.path.join(root, ".ollama", "models")):
            if not os.path.isdir(mdir):
                continue
            # Build the chmod command: make dirs traversable, files readable.
            sh = (f"chmod a+rx {root} {mdir} 2>/dev/null; "
                  f"chmod -R a+rX {mdir}/blobs {mdir}/manifests 2>/dev/null || true")
            # Try pkexec (graphical prompt), then sudo (tty).
            for escalator in ("pkexec", "sudo"):
                if not shutil.which(escalator):
                    continue
                print(f":: fixing model permissions via {escalator}…",
                      flush=True)
                rc = subprocess.run(
                    [escalator, "/bin/sh", "-c", sh],
                    timeout=120).returncode
                if rc == 0:
                    return True
            break  # found the dir, no point checking more candidates
    return False


def ensure(tag):
    """Make sure `tag` is available; return its GGUF path (or None on failure).

    `tag` may be an ollama tag OR a direct GGUF reference (path / gguf:<name>).
    Resolving both here is what makes every downstream Turbo feature — MoE
    expert-offload, Fit, speculative decoding, autotuned profiles — work
    identically for a file the user downloaded from Hugging Face, with no import
    step and no ollama involvement at all."""
    if is_gguf_ref(tag):
        p = resolve_gguf_ref(tag)
        if not p:
            print(f"[!] GGUF not found: {tag}", file=sys.stderr)
        return p
    p = gguf_path(tag)
    if p:
        return p
    print(f":: pulling {tag} ...", flush=True)
    if subprocess.run(["ollama", "pull", tag]).returncode != 0:
        return None
    p = gguf_path(tag)
    if p:
        return p
    # Pull succeeded but we still can't resolve the GGUF. Almost always the
    # daemon (ollama user) wrote files the current user can't traverse/read, so
    # open up the perms and try once more across all roots.
    print("\n[!] Model pulled but its files aren't readable — fixing permissions…",
          file=sys.stderr, flush=True)
    if _fix_ollama_permissions():
        p = gguf_path(tag)
        if p:
            return p
    print("[!] Still cannot read the model. Run manually:", file=sys.stderr)
    print("    sudo chmod -R a+rX /var/lib/ollama /usr/share/ollama/.ollama",
          file=sys.stderr)
    return p


def pick_draft(main):
    # A direct GGUF has no reliable family/tokenizer mapping to an ollama tag, and
    # a draft with a MISMATCHED tokenizer silently corrupts speculation. So we
    # never guess a sibling for one — GENESI_TURBO_SELF_DRAFT=1 still works (a Q2
    # quant of the same file is tokenizer-identical by construction).
    if is_gguf_ref(main):
        return None
    low = main.lower()
    if any(t in low for t in TINY):
        return None                       # already tiny — nothing to speculate
    for key, draft in DRAFT_FOR:
        if low.startswith(key):
            return draft
    return None


def self_draft_path(main_gguf):
    """A low-bit (Q2_K) quant of the SAME model, to use as a speculative draft
    when the family has no published tiny sibling (mistral, gemma1, phi…). Same
    tokenizer is GUARANTEED (it's literally the same model), so acceptance is high.
    Built once with `llama-quantize` and cached under ~/.cache/genesi-turbo/drafts.

    HONEST CAVEAT: a self-draft has the SAME number of layers as the target, so
    it's only ~memory-ratio faster (≈2× for Q2 vs Q4), not the ~10× a 1B-drafts-7B
    sibling gives — net gain is a modest ~1.1–1.3×, AND both must fit VRAM (on an
    8 GB card a 7B target + its Q2 draft usually DON'T, so server_cmd's fit check
    drops it). Hence opt-in: GENESI_TURBO_SELF_DRAFT=1. Returns a path or None."""
    qbin = llama_bin("llama-quantize")
    if not qbin:
        return None
    cache = os.path.expanduser("~/.cache/genesi-turbo/drafts")
    try:
        os.makedirs(cache, exist_ok=True)
    except OSError:
        return None
    out = os.path.join(cache, os.path.basename(main_gguf) + ".q2k.gguf")
    if os.path.isfile(out) and os.path.getsize(out) > 0:
        return out
    quant = os.environ.get("GENESI_TURBO_SELF_DRAFT_QUANT", "Q2_K")
    print(f":: building a {quant} self-draft (one-off, ~1-2 min) → {out}",
          flush=True)
    try:
        r = subprocess.run([qbin, main_gguf, out, quant], timeout=1800)
    except Exception as e:
        print(f"   [!] self-draft quantize failed: {e}", file=sys.stderr)
        return None
    if r.returncode == 0 and os.path.isfile(out):
        return out
    # Clean up a partial file so we retry cleanly next time.
    try:
        os.remove(out)
    except OSError:
        pass
    print("   [!] self-draft quantize did not produce a model — skipping.",
          file=sys.stderr)
    return None


# GGUF general.file_type enum -> effective bits-per-weight, for common quants.
# Used by Genesi Fit to size a requantized model without loading it. Unknown
# types fall back to Q4_K_M's ~4.8 bpw (the ollama default).
_FT_BPW = {0: 32.0, 1: 16.0, 2: 4.5, 3: 4.5, 7: 8.5, 8: 5.5, 9: 6.0,
           10: 2.6, 11: 3.4, 12: 3.9, 13: 4.3, 14: 4.5, 15: 4.8, 16: 5.5,
           17: 5.6, 18: 6.6, 19: 3.4, 20: 4.6}
# Candidate fit targets, best quality first. (llama-quantize name, ~bpw). We
# pick the LARGEST (best) one whose output fits VRAM.
_FIT_QUANTS = [("IQ4_XS", 4.25), ("Q3_K_M", 3.9), ("IQ3_XXS", 3.06),
               ("Q2_K", 2.6)]


def fit_path(main_gguf, budget_gb):
    """Genesi Fit — requantize a SPILLING model DOWN to the best quant that fits
    100% in VRAM, cached. A spilling model decodes at slow CPU-RAM/PCIe bandwidth;
    a slightly-lower quant that FITS decodes at full GPU bandwidth, which is
    usually a FAR bigger win than the small quality cost (and spec then stacks on
    top). Opt-in (GENESI_TURBO_FIT=1) because it trades a little quality; returns
    the fitted GGUF path, or None if it already fits / nothing fits / no
    llama-quantize. Built once with llama-quantize, cached under
    ~/.cache/genesi-turbo/fitted."""
    if not _env_flag("GENESI_TURBO_FIT"):
        return None
    qbin = llama_bin("llama-quantize")
    if not qbin or budget_gb <= 0:
        return None
    try:
        src_gb = os.path.getsize(main_gguf) / (1024**3)
    except OSError:
        return None
    # Already fits with a little KV headroom? Fit is unnecessary.
    if src_gb <= budget_gb - 0.3:
        return None
    ft = gguf_meta(main_gguf, (".file_type",)).get(".file_type")
    src_bpw = _FT_BPW.get(int(ft) if ft is not None else -1, 4.8)
    # Largest target quant whose projected output fits VRAM (minus KV headroom).
    target = None
    for name, bpw in _FIT_QUANTS:
        if bpw >= src_bpw:                 # never requantize up or sideways
            continue
        out_gb = src_gb * (bpw / src_bpw)
        if out_gb <= budget_gb - 0.3:
            target = (name, out_gb)
            break
    if not target:
        return None                        # even Q2_K wouldn't fit — leave it spilled
    name, out_gb = target
    cache = os.path.expanduser("~/.cache/genesi-turbo/fitted")
    try:
        os.makedirs(cache, exist_ok=True)
    except OSError:
        return None
    out = os.path.join(cache, os.path.basename(main_gguf) + f".{name}.gguf")
    if os.path.isfile(out) and os.path.getsize(out) > 0:
        return out
    print(f":: Genesi Fit: requantizing to {name} (~{out_gb:.1f} GB, fits your "
          f"VRAM) — one-off, a couple minutes → {out}", flush=True)
    try:
        r = subprocess.run([qbin, main_gguf, out, name], timeout=3600)
    except Exception as e:
        print(f"   [!] Genesi Fit quantize failed: {e}", file=sys.stderr)
        return None
    if r.returncode == 0 and os.path.isfile(out):
        return out
    try:
        os.remove(out)
    except OSError:
        pass
    print("   [!] Genesi Fit did not produce a model — serving the original.",
          file=sys.stderr)
    return None


def _vram_budget_gb():
    """VRAM available for weights (GB): largest GPU minus overhead/KV headroom.
    Mirrors server_cmd's budget so Genesi Fit targets the same fit test."""
    vram_gb = _detect_vram_mb() / 1024.0
    return max(vram_gb - 1.2, 0.0) if vram_gb >= 1.0 else 0.0


def llama_bin(name):
    for cand in (name, "/usr/bin/" + name):
        b = shutil.which(cand) or (cand if os.path.exists(cand) else None)
        if b:
            return b
    return None


def _env_int(name, default):
    try:
        v = int(os.environ.get(name, "").strip())
        return v if v > 0 else default
    except Exception:
        return default


def _env_flag(name):
    return os.environ.get(name, "").strip().lower() in ("1", "true", "yes", "on")


def _nvidia_vram_mb():
    """Total VRAM (MiB) of the largest NVIDIA GPU via nvidia-smi, or 0.

    Works only with the proprietary/open NVIDIA driver. On the live ISO (and any
    nouveau/NVK setup) the binary may exist but the query fails — hence the
    Vulkan fallback below."""
    if not shutil.which("nvidia-smi"):
        return 0
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return 0
    best = 0
    for line in out.splitlines():
        v = line.strip()
        if v.isdigit():
            best = max(best, int(v))
    return best


def _vulkan_vram_mb():
    """Total VRAM (MiB) of the largest GPU as seen by llama.cpp's own backend,
    via `llama-server --list-devices`. Vendor-agnostic (NVK/nouveau, RADV, ANV,
    NVIDIA) and, crucially, reports exactly what we can actually offload to —
    the same Vulkan device the server will use. Returns 0 if unavailable."""
    binp = llama_bin("llama-server")
    if not binp:
        return 0
    try:
        r = subprocess.run([binp, "--list-devices"],
                           capture_output=True, text=True, timeout=20)
        text = (r.stdout or "") + (r.stderr or "")
    except Exception:
        return 0
    best = 0
    # device lines look like: "  Vulkan0: NVIDIA GeForce RTX 3050 (8448 MiB, ...)"
    for m in re.finditer(r"\((\d+)\s*MiB", text):
        best = max(best, int(m.group(1)))
    return best


def _detect_vram_mb():
    """Best VRAM (MiB) we can find: nvidia-smi first (proprietary/open driver),
    then the Vulkan backend (covers the live-ISO nouveau case + AMD/Intel)."""
    return _nvidia_vram_mb() or _vulkan_vram_mb()


_BACKEND_CACHE = None


def backend_is_cuda():
    """True when the installed llama-server is the CUDA build.

    Speculative decoding is the proven Turbo win on the mature CUDA driver, so on
    a CUDA build `serve` enables it by default; on the Vulkan build (genesi-llama-
    cpp, which runs on any GPU incl. nouveau/NVK) it can REGRESS, so it stays off.
    We tell them apart by the device backend llama.cpp itself reports: the CUDA
    build lists `CUDA0: ...`, the Vulkan build lists `Vulkan0: ...`. Cached. Honour
    GENESI_TURBO_NO_SPEC / GENESI_TURBO_SPEC at the call site, not here."""
    global _BACKEND_CACHE
    if _BACKEND_CACHE is not None:
        return _BACKEND_CACHE
    _BACKEND_CACHE = False
    binp = llama_bin("llama-server")
    if binp:
        try:
            r = subprocess.run([binp, "--list-devices"],
                               capture_output=True, text=True, timeout=20)
            text = (r.stdout or "") + (r.stderr or "")
            # Match a real CUDA device line, not just the word "cuda" in help.
            _BACKEND_CACHE = bool(re.search(r"\bCUDA\d", text))
        except Exception:
            _BACKEND_CACHE = False
    return _BACKEND_CACHE


# GGUF metadata value types (https://github.com/ggml-org/ggml gguf spec).
_GGUF_SCALAR = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1,
                10: 8, 11: 8, 12: 8}     # type -> byte size
_GGUF_FMT = {0: "B", 1: "b", 2: "H", 3: "h", 4: "I", 5: "i", 6: "f",
             7: "?", 10: "Q", 11: "q", 12: "d"}
_GGUF_STRING = 8
_GGUF_ARRAY = 9


def gguf_meta(path, suffixes):
    """Read selected metadata keys from a GGUF file header WITHOUT loading the
    model. Returns {suffix: value} for any key whose name ends with one of
    `suffixes` (e.g. '.expert_count', '.block_count'). Pure stdlib, bounded, and
    fully defensive — a malformed/partial header yields {} so callers fall back
    to their default behaviour. We need this to spot Mixture-of-Experts models
    (expert_count > 1): their huge expert tensors can be streamed from CPU RAM
    cheaply (only a few experts fire per token), so a ~30B-A3B can run at ~7B
    speed on an 8 GB card instead of crawling when dense layers spill over PCIe."""
    import struct
    found = {}
    try:
        f = open(path, "rb")
    except OSError:
        return found
    with f:
        if f.read(4) != b"GGUF":
            return found
        try:
            ver = struct.unpack("<I", f.read(4))[0]
            cfmt = "<Q" if ver >= 2 else "<I"     # v2/v3 counts are 64-bit
            csz = 8 if ver >= 2 else 4
            f.read(csz)                            # tensor_count (skip)
            n_kv = struct.unpack(cfmt, f.read(csz))[0]
        except Exception:
            return found

        def rd_str():
            ln = struct.unpack(cfmt, f.read(csz))[0]
            return f.read(ln)

        def skip(vt):
            if vt in _GGUF_SCALAR:
                f.seek(_GGUF_SCALAR[vt], 1)
            elif vt == _GGUF_STRING:
                rd_str()
            elif vt == _GGUF_ARRAY:
                et = struct.unpack("<I", f.read(4))[0]
                n = struct.unpack(cfmt, f.read(csz))[0]
                if et in _GGUF_SCALAR:
                    f.seek(_GGUF_SCALAR[et] * n, 1)        # fast-skip numeric arrays
                else:
                    for _ in range(n):
                        skip(et)
            else:
                raise ValueError("bad gguf type")

        def read(vt):
            if vt in _GGUF_SCALAR:
                return struct.unpack("<" + _GGUF_FMT[vt], f.read(_GGUF_SCALAR[vt]))[0]
            if vt == _GGUF_STRING:
                return rd_str().decode("utf-8", "replace")
            raise ValueError("unread gguf type")

        try:
            for _ in range(min(int(n_kv), 100000)):
                key = rd_str().decode("utf-8", "replace")
                vt = struct.unpack("<I", f.read(4))[0]
                hit = next((s for s in suffixes if key.endswith(s)), None)
                if hit is not None and vt != _GGUF_ARRAY:
                    found[hit] = read(vt)
                else:
                    skip(vt)
                if len(found) >= len(suffixes):
                    break
        except Exception:
            pass
    return found


_HELP_CACHE = None


def _llama_help():
    """Cached `llama-server --help` text, so we can pick flag names that match
    the INSTALLED build. llama.cpp renames/removes flags often — e.g. --draft
    was removed in favor of --spec-draft-n-max, and model-free --spec-type ngram
    speculation was added — and genesi-llama-cpp tracks upstream master. Empty
    string if llama-server isn't available."""
    global _HELP_CACHE
    if _HELP_CACHE is None:
        binp = llama_bin("llama-server")
        if not binp:
            _HELP_CACHE = ""
        else:
            try:
                r = subprocess.run([binp, "--help"], capture_output=True,
                                   text=True, timeout=15)
                _HELP_CACHE = (r.stdout or "") + (r.stderr or "")
            except Exception:
                _HELP_CACHE = ""
    return _HELP_CACHE


def _pick_flag(help_txt, *candidates):
    """Return the first candidate flag name that the INSTALLED llama-server
    actually lists in --help, or None. llama.cpp renames speculative-decoding
    flags often across versions, so we never hardcode one name — we probe and
    use whatever this build supports (and silently skip the feature if none)."""
    for c in candidates:
        if c in help_txt:
            return c
    return None


# Advisor model catalogue (ollama tag -> params in billions), biggest last. Used
# by `recommend` to pick the largest model that still runs 100% in VRAM.
RECOMMEND_MODELS = [
    ("llama3.2:1b",  1.2), ("llama3.2:3b",  3.2),
    ("llama3.1:8b",  8.0), ("qwen2.5:7b",   7.6),
    ("qwen2.5:14b", 14.8), ("qwen2.5:32b", 32.5),
]

# MoE "power picks" (ollama tag -> total params B, active params B). These run
# FAR bigger brains than a dense model that fits VRAM, because only the active
# experts compute per token — Turbo keeps attention on the GPU and streams the
# cold experts from RAM (--n-cpu-moe). Constraint is system RAM (to hold the
# experts), not VRAM. Biggest last.
MOE_MODELS = [
    ("gpt-oss:20b",    21.0, 3.6),
    ("qwen3:30b-a3b",  30.0, 3.3),
]


def _total_ram_gb():
    """Total system RAM in GB from /proc/meminfo, or 0.0."""
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) / (1024.0 * 1024.0)
    except Exception:
        pass
    return 0.0


def recommend_moe(vram_mb, ram_gb):
    """Biggest MoE whose experts fit in system RAM and whose attention fits VRAM,
    or None. The win: ~30B-class quality at ~7B speed on a small card."""
    if vram_mb < 4000:                 # need a bit of VRAM for attention + KV
        return None
    ram_budget = ram_gb * 0.7          # leave headroom for the OS + apps
    best = None
    for tag, total, active in MOE_MODELS:
        total_gb = total * 4.8 / 8.0   # Q4 GGUF size ≈ params * bpw / 8
        if total_gb <= ram_budget and (best is None or total > best[1]):
            best = (tag, total, active)
    return best


def tag_installed(tag):
    """Is `tag` already pulled? Quietly — gguf_path() reports misses on stderr,
    which is right when a user asked for that model and wrong when we are merely
    surveying a catalogue."""
    name, _, ver = tag.partition(":")
    ver = ver or "latest"
    return any(os.path.isfile(os.path.join(md, "manifests", "registry.ollama.ai",
                                           "library", name, ver))
               for md in _candidate_model_dirs())


def recommend_model(installed_only=False):
    """Advisor → Turbo model pick: the BIGGEST model whose Q4_K_M weights fit
    100% in VRAM (so Turbo offloads it fully — the single biggest speed lever).
    Returns (tag, vram_mb, budget_gb). Falls back to a small model with no GPU.

    installed_only restricts the pick to models already on disk, and returns
    tag=None when none qualify. That is the mode a SERVICE wants: the plain
    recommendation is advice about what this GPU could run, and genesi-turbo
    was using it to decide what to serve at boot — so a machine that had a 3B
    downloaded got an unrequested multi-GB pull of an 8B on startup instead."""
    vram_mb = _detect_vram_mb()
    budget = max(vram_mb / 1024.0 - 1.2, 0.0)     # overhead + KV headroom
    best = None
    for tag, p in RECOMMEND_MODELS:
        q4 = p * 4.8 / 8.0                          # GGUF GB ≈ params * bpw / 8
        if q4 > budget or (best is not None and p <= best[1]):
            continue
        if installed_only and not tag_installed(tag):
            continue
        best = (tag, p)
    if installed_only:
        return (best[0] if best else None), vram_mb, budget
    tag = best[0] if best else ("llama3.2:3b" if budget >= 1.8 else "llama3.2:1b")
    return tag, vram_mb, budget


def cmd_recommend(installed_only=False):
    """Print the recommended Turbo model. stdout = just the tag (machine-readable
    for the Monitor); human detail goes to stderr.

    With --installed, prints nothing when no downloaded model fits, so a caller
    can fall back rather than trigger a download it never asked for."""
    tag, vram_mb, budget = recommend_model(installed_only)
    if tag is None:
        print(":: no downloaded model fits this GPU — nothing to recommend "
              "without pulling one", file=sys.stderr)
        return
    print(tag)
    if vram_mb > 0:
        print(f":: {vram_mb / 1024.0:.1f}GB VRAM → fits ~{budget:.1f}GB on GPU → "
              f"recommended Turbo model: {tag}", file=sys.stderr)
    else:
        print(":: no GPU/VRAM detected → small CPU-friendly model recommended: "
              f"{tag}", file=sys.stderr)
    # MoE power pick: a much bigger brain that still runs fast here via expert
    # offload (only stdout stays machine-readable; this is human advice).
    moe = recommend_moe(vram_mb, _total_ram_gb())
    if moe:
        print(f":: power pick (MoE): {moe[0]} — {moe[1]:.0f}B brain, only "
              f"~{moe[2]:.0f}B active/token, so Turbo runs it at small-model speed "
              f"(experts streamed from RAM). Pull it and run Turbo as usual.",
              file=sys.stderr)


def _performance_cores(fallback):
    """Best-effort count of the FAST physical cores for CPU inference.

    On Intel hybrid CPUs (P + E cores, e.g. the i5-13420H) spreading llama.cpp
    across the slow E-cores adds cross-core sync stalls and REGRESSES tokens/s,
    so we count only the top-frequency physical cores (one entry per core_id,
    HT siblings deduped). Falls back to `fallback` (physical core count) on any
    machine that doesn't expose the topology (VMs, odd kernels)."""
    base = "/sys/devices/system/cpu"
    try:
        core_freq = {}                       # physical core_id -> max freq (kHz)
        for cpu in os.listdir(base):
            if not re.fullmatch(r"cpu\d+", cpu):
                continue
            try:
                with open(f"{base}/{cpu}/topology/core_id") as f:
                    cid = int(f.read().strip())
                with open(f"{base}/{cpu}/cpufreq/cpuinfo_max_freq") as f:
                    mf = int(f.read().strip())
            except (OSError, ValueError):
                return fallback              # incomplete data -> don't guess
            core_freq[cid] = max(core_freq.get(cid, 0), mf)
        if not core_freq:
            return fallback
        top = max(core_freq.values())
        # P-cores sit within ~5% of the top clock; E-cores are well below it.
        fast = sum(1 for f in core_freq.values() if f >= top * 0.95)
        return fast if fast >= 1 else fallback
    except OSError:
        return fallback


TUNE_PROFILE_PATHS = (
    "/var/lib/genesi-ai-mode/tune.json",
    os.path.expanduser("~/.cache/genesi-turbo/tune.json"),
)


def _hw_sig():
    """A coarse hardware signature so an autotuned profile only applies to the
    machine it was measured on. VRAM bucket (GB) + logical CPU count — cheap and
    stable across reboots; two boxes with the same signature will tune alike."""
    return f"v{_detect_vram_mb() // 1024}c{os.cpu_count() or 0}"


def load_tune_profile(main_gguf):
    """Best autotuned server params for THIS model on THIS machine, or {}.

    genesi-ai-tune measures the real hardware with llama-bench (sweeping ubatch /
    flash-attn / KV type / threads) and writes the winning knobs per (model,
    hardware signature). We read them here and feed them as the DEFAULTS for the
    matching flags, so a machine that self-calibrated overnight beats the generic
    heuristic. Precedence stays: explicit GENESI_TURBO_* env > tuned profile >
    built-in default. Fully defensive — any missing file / parse error yields {}
    so the heuristic stands. Disable entirely with GENESI_TURBO_NO_TUNE=1."""
    if _env_flag("GENESI_TURBO_NO_TUNE"):
        return {}
    key = os.path.basename(main_gguf or "")
    sig = _hw_sig()
    for p in TUNE_PROFILE_PATHS:
        try:
            db = json.load(open(p))
        except Exception:
            continue
        ent = (db.get(key) or {}).get(sig)
        if isinstance(ent, dict):
            return ent
    return {}


# server_cmd() is called several times per launch — once for the real command
# and again for each fallback variant _serve_with_fallback builds — and it
# re-plans the mesh every time. Printing from there repeated the whole [mesh]
# block four times in one start. These two keep the OUTPUT to once per launch
# without making the planning itself stateful (a cached plan would go stale
# exactly when it matters: between the failed pooled attempt and the retry).
_mesh_said = set()          # lines already shown this run
_mesh_quiet = False         # set while building a variant the user did not ask for


def _mesh_say(line):
    """Print a [mesh] line at most once, and never while rebuilding variants."""
    if _mesh_quiet or not line or line in _mesh_said:
        return
    _mesh_said.add(line)
    print("   [mesh] %s" % line, flush=True)


def _mesh_opted_in(_mesh, forced):
    """True when this machine was deliberately set up for a mesh.

    Governs whether Turbo EXPLAINS a mesh it decided not to use. The distinction
    matters because the two audiences want opposite things: on a machine that
    never joined a mesh, a line about it on every start is noise about a feature
    the user does not have; on a machine where they ran init/join/worker/peer
    and are waiting for pooling to kick in, silence is the bug.

    Any deliberate act counts — an explicit endpoint override, a secret from
    init/join, worker mode, or a hand-registered peer."""
    if forced:
        return True
    if _mesh is None:
        return False
    try:
        if os.path.exists(_mesh.SECRET_PATH):
            return True
        conf = _mesh.load_conf()
        return bool(_mesh.conf_flag(conf, "worker")
                    or str(conf.get("peers", "") or "").strip())
    except Exception:
        return False


def mesh_plan(main_gb):
    """Ask Genesi Mesh whether this model should be spread across machines.

    Returns (endpoints, extra_budget_gb, reason) — ([], 0.0, "") whenever the
    mesh is absent, empty, disabled, or simply not worth using.

    Mesh is a LAST RESORT by construction, not a speed-up: every token's
    activations cross the network, so pooling a model that already fits locally
    makes it SLOWER. genesi_mesh_common.plan_pool encodes that rule, and we
    honour its verdict rather than second-guessing it here. The payoff is
    binary: a model that would otherwise not run at all, runs.

    Fails open in every direction — no genesi-mesh package, no daemon, no peers,
    an llama-server without --rpc: Turbo behaves exactly as it does today.

    Failing open used to mean failing SILENT. Four different situations — no
    peers, no --rpc, mesh switched off, model too big even pooled — all returned
    the same empty tuple and printed nothing, so a user who had set up a mesh
    and was waiting for it got a completely ordinary local start with no hint
    that pooling had been considered and declined, or why. Turbo knows the
    answer in every one of those cases; it just never said it."""
    forced = os.environ.get("GENESI_MESH_ENDPOINTS", "").strip()

    sys.path.insert(0, "/usr/lib/genesi-mesh")
    try:
        import genesi_mesh_common as _mesh
    except ImportError:
        _mesh = None                # genesi-mesh not installed: nothing to do

    opted_in = _mesh_opted_in(_mesh, forced)

    def _decline(why):
        """Skip the mesh, saying why to the people who are waiting for it."""
        if opted_in and why:
            _mesh_say("not used: " + why)
        return [], 0.0, ""

    if _env_flag("GENESI_TURBO_NO_MESH"):
        return _decline("disabled by GENESI_TURBO_NO_MESH")

    if not _pick_flag(_llama_help(), "--rpc"):
        if forced:
            print("   [mesh] GENESI_MESH_ENDPOINTS is set but this llama-server "
                  "has no --rpc (needs a GGML_RPC=ON build) — ignoring.",
                  flush=True)
            return [], 0.0, ""
        return _decline("this llama-server has no --rpc — it needs a llama.cpp "
                        "built with GGML_RPC=ON (`genesi-mesh doctor`)")

    # An explicit override wins, so a user can point at machines that discovery
    # cannot reach (different subnet, a VPN, a host with discovery off).
    if forced:
        return [e.strip() for e in forced.split(",") if e.strip()], 0.0, \
               "forced via GENESI_MESH_ENDPOINTS"

    if _mesh is None:
        return [], 0.0, ""

    try:
        peers = _mesh.read_peers()
        # Pass the FULL probe, not just a VRAM number: plan_pool has to know
        # whether this machine's GPU is integrated. On a laptop with only
        # integrated graphics the shared memory would otherwise look like real
        # VRAM, the model would appear to "fit locally", and the mesh would be
        # refused in exactly the case it exists for.
        #
        # Called even with an empty peer list, because plan_pool answers the
        # question we actually need: with no peers it reports whether the model
        # fits locally anyway, which decides whether an empty mesh is worth
        # mentioning at all.
        conf = _mesh.load_conf()
        plan = _mesh.plan_pool(
            _mesh.probe_gpu(), peers, main_gb,
            pool_integrated=_mesh.conf_flag(conf, "pool_integrated"))
    except Exception:
        # Never let a mesh problem stop a local server from starting.
        return [], 0.0, ""

    if plan.get("use_mesh"):
        return (plan["endpoints"],
                max(plan["pooled_gb"] - plan["local_gb"], 0.0),
                plan["reason"])

    reason = plan.get("reason") or ""

    # The model fitting locally is the correct, healthy outcome, not a problem
    # — and it is the COMMON case on exactly the machines that have a mesh, the
    # ones with a GPU big enough to be a worker. Announcing it on every start
    # would train the user to ignore the [mesh] prefix, which costs us the
    # messages that do matter.
    if reason.startswith("fits in local VRAM"):
        return [], 0.0, ""

    if not peers:
        # plan_pool says "no worker peers online" here, which is true but reads
        # as "your peers are idle" when the real state is an empty table. That
        # is nearly always discovery, and discovery has one specific failure.
        reason = ("no peers online. Multicast discovery cannot cross a VPN — "
                  "register the worker with `sudo genesi-mesh peer <addr>` on "
                  "BOTH machines, or check `genesi-mesh doctor`")
    return _decline(reason)


def server_cmd(main_gguf, draft_gguf):
    binp = llama_bin("llama-server")
    if not binp:
        return None

    try:
        s = json.load(open("/run/genesi-ai-mode/state.json"))
        hw = s.get("hardware") or {}
        gpus = hw.get("gpus") or []
        vram_mb = max([g.get("vram_mb") or 0 for g in gpus], default=0)
        ram_mb = hw.get("ram_mb") or 0
        phys_cores = hw.get("physical_cores") or 4
    except Exception:
        vram_mb = 0
        ram_mb = 0
        phys_cores = 4

    # state.json is the primary source, but the daemon can miss the GPU (it
    # profiles at boot, possibly before the driver is ready, and nvidia-smi
    # doesn't work under nouveau/NVK at all). If there's no VRAM figure, detect
    # it directly (nvidia-smi, then the Vulkan backend) so we still offload to
    # the GPU instead of silently falling back to CPU.
    if vram_mb <= 0:
        vram_mb = _detect_vram_mb()

    gpu = vram_mb > 0 or shutil.which("nvidia-smi") is not None
    vram_gb = vram_mb / 1024.0
    budget_gb = max(vram_gb - 1.2, 0.5) if vram_gb >= 1.0 else 0.0

    try:
        main_gb = os.path.getsize(main_gguf) / (1024**3)
    except OSError:
        main_gb = 0.0

    try:
        draft_gb = os.path.getsize(draft_gguf) / (1024**3) if draft_gguf else 0.0
    except OSError:
        draft_gb = 0.0

    # Genesi Mesh: when the model does not fit this machine's VRAM but DOES fit
    # across the GPUs of paired machines on the LAN, llama.cpp can treat each
    # remote GPU as an extra device (`--rpc host:port`) and spread the layers.
    # The budget grows accordingly, so every fit decision below — full offload
    # vs partial vs MoE expert-offload — is made against the POOLED VRAM.
    # mesh_plan returns nothing unless pooling genuinely beats running locally.
    mesh_endpoints, mesh_extra_gb, mesh_reason = mesh_plan(main_gb)
    if mesh_endpoints:
        budget_gb += mesh_extra_gb
        gpu = True
        _mesh_say(mesh_reason)
        _mesh_say("pooling across: %s" % ", ".join(mesh_endpoints))
        _mesh_say("note: layer activations cross the network each token, "
                  "so this trades speed for being able to run the model at all.")

    fits_main = main_gb <= budget_gb if budget_gb > 0 else False
    fits_both = (main_gb + draft_gb) <= budget_gb if budget_gb > 0 else False

    # Mixture-of-Experts detection. A MoE model only activates a few experts per
    # token, so when it doesn't fit VRAM we DON'T spill random dense layers over
    # the slow PCIe bus — we keep all attention on the GPU and push just the
    # expert (FFN) tensors to CPU RAM (`--n-cpu-moe K`). Result: big-model brains
    # at near-small-model speed on a small card. Reading the GGUF header is cheap
    # and defensive (any failure -> {} -> we fall back to plain partial offload).
    moe = gguf_meta(main_gguf, (".expert_count", ".block_count"))
    is_moe = (int(moe.get(".expert_count") or 0) > 1
              and not _env_flag("GENESI_TURBO_NO_MOE"))
    n_cpu_moe = None            # how many layers' experts to keep on CPU (MoE)
    ncmoe_flag = None           # the flag name this llama.cpp build supports

    # Decide WHERE we run and HOW MANY layers go on the GPU. ngl_value:
    #   None  -> CPU only
    #   "999" -> full offload (the whole model fits in VRAM, fastest)
    #   "auto" -> let llama.cpp fit as many layers as the VRAM holds (a blind
    #             -ngl 999 OOMs a small/partially-full card; "auto" is VRAM-safe)
    # Spec decoding only pays off when BOTH target and draft fit on the GPU.
    ngl_value = None
    if gpu:
        if fits_both:
            ngl_value = "999"                # target + draft both fit -> spec on GPU
        elif fits_main:
            if draft_gguf:
                print(f"   [!] Draft model dropped: not enough VRAM for both (budget: {budget_gb:.1f}GB).", flush=True)
            draft_gguf = None
            ngl_value = "999"
        else:
            if vram_gb > 0:
                print(f"   [!] WARNING: Model ({main_gb:.1f}GB) exceeds safe VRAM budget ({budget_gb:.1f}GB).", flush=True)
                print("       Part of it runs on the CPU, so decode will be SLOW no "
                      "matter the backend. For full-GPU speed pick a model that "
                      "fits — see `genesi-ai-turbo recommend` — or pull a smaller "
                      "quant (e.g. a q3_K_M / IQ4_XS tag) of this model.", flush=True)
                if not _env_flag("GENESI_TURBO_FIT"):
                    print("       → or set GENESI_TURBO_FIT=1 to AUTO-FIT this model to "
                          "your VRAM (Genesi Fit requantizes it to the best quant that "
                          "fits → full-GPU speed, small quality tradeoff).", flush=True)
            free_ram_gb = (ram_mb / 1024.0) * 0.6
            if ram_mb > 0 and main_gb > free_ram_gb:
                print("   [!] DANGER: System RAM is too low to safely offload. Expect severe lag or OOM.", flush=True)
            # spill-spec: keep the tiny GPU draft EVEN when the target spills VRAM.
            # DEFAULT ON for CUDA now (measured +29% on a spilling qwen2.5:14b on an
            # RTX 3050: 9.0 -> 11.7 tok/s, 37/54 draft tokens accepted) — disable
            # with GENESI_TURBO_NO_SPILL_SPEC. Still opt-in on Vulkan/NVK
            # (GENESI_TURBO_SPILL_SPEC=1) where it regressed.
            spill_spec = (_env_flag("GENESI_TURBO_SPILL_SPEC")
                          or (backend_is_cuda()
                              and not _env_flag("GENESI_TURBO_NO_SPILL_SPEC")))
            if draft_gguf and not is_moe and spill_spec:
                # Turbo's biggest lever over plain ollama for a model too big for
                # the card. The spilled layers live in CPU RAM and stream over the
                # SLOW PCIe bus once per forward pass; speculative VERIFICATION
                # checks K draft tokens in a single pass, so the expensive PCIe
                # weight-stream is amortized — K accepted tokens cost ~1 stream
                # instead of K. Autoregressive ollama can't do this. The draft is
                # tiny (~0.4 GB, GPU-resident via -ngld below), costing one fewer
                # target layer on the GPU — a trivial price for the measured win.
                print("   [spill-spec] target spills VRAM but keeping the GPU draft: "
                      "speculative verification amortizes the slow PCIe weight reads. "
                      "Disable with GENESI_TURBO_NO_SPILL_SPEC if it regresses/OOMs.",
                      flush=True)
            elif draft_gguf:
                print("   [!] Draft model dropped: the target model is already spilling VRAM.", flush=True)
                draft_gguf = None            # default: don't speculate when spilling
            if is_moe and vram_gb > 2.0:
                # MoE expert-offload (the out-of-the-box win): keep ALL attention
                # layers on the GPU (-ngl 999) and move just enough layers' EXPERT
                # tensors to CPU RAM to fit the VRAM budget. Only a couple of
                # experts fire per token, so streaming them from RAM costs far less
                # than spilling whole dense layers over PCIe.
                ncmoe_flag = _pick_flag(_llama_help(), "--n-cpu-moe", "--cpu-moe")
            if is_moe and ncmoe_flag and vram_gb > 2.0:
                blocks = int(moe.get(".block_count") or 0)
                # ≈90% of a big MoE's bytes are expert tensors; size per layer.
                per_layer = (main_gb * 0.9 / blocks) if blocks > 0 else 0.0
                if ncmoe_flag == "--n-cpu-moe" and per_layer > 0:
                    over = max(main_gb - budget_gb, 0.0)
                    k = int(over / per_layer) + 2            # +headroom for KV/ctx
                    k = max(1, min(blocks, k))
                    n_cpu_moe = _env_int("GENESI_TURBO_NCMOE", k)
                    print(f"   [moe] Mixture-of-Experts: experts of {n_cpu_moe}/{blocks} "
                          f"layers on CPU RAM, attention 100% on GPU — big-model "
                          f"brains at small-model speed.", flush=True)
                else:
                    # Build only exposes the all-or-nothing --cpu-moe (all experts
                    # on CPU). Still a huge win vs random dense spill.
                    n_cpu_moe = -1                            # sentinel: --cpu-moe
                    print("   [moe] Mixture-of-Experts: all expert tensors on CPU "
                          "RAM, attention 100% on GPU (--cpu-moe).", flush=True)
                ngl_value = "999"            # all attention layers on the GPU
            elif vram_gb > 2.0:
                # Dense model: partial offload — fit as many layers as the VRAM
                # holds instead of forcing all of them. 'auto' needs a recent
                # llama.cpp; older builds force all layers.
                ngl_value = "auto" if "--gpu-layers" in _llama_help() and "auto" in _llama_help() else "999"
    else:
        # CPU-only. Running a second (draft) model on the same cores almost
        # always costs more than the speculation saves, and the extra weights
        # risk OOM on low-RAM laptops. This is exactly what made Turbo SLOWER
        # than stock ollama on an 8GB CPU-only notebook (it kept the draft).
        # Disable it unless the user explicitly opts in.
        if draft_gguf and not _env_flag("GENESI_TURBO_FORCE_DRAFT"):
            print("   [!] CPU-only: speculative decoding disabled (a CPU draft slows decode). "
                  "Set GENESI_TURBO_FORCE_DRAFT=1 to override.", flush=True)
            draft_gguf = None

    # GPU offload active (full or partial) gates the GPU-only tunings below.
    use_ngl_999 = ngl_value is not None

    # Autotuned per-machine profile (genesi-ai-tune), if one exists for this
    # model + hardware. Its values become the DEFAULTS below; an explicit env var
    # still wins (precedence: env > tuned > heuristic).
    tune = load_tune_profile(main_gguf)

    # 4096 was a chat-sized default and it is too small for agent work: Genesi
    # Code sends its instructions, the open file, and every tool result back on
    # each step, so the first file the model read pushed the request past the
    # window and llama-server rejected the turn ("request (4119 tokens) exceeds
    # the available context size (4096 tokens)"). 8192 costs a few hundred MB of
    # KV on a quantized cache and buys a whole working agent.
    ctx = _env_int("GENESI_TURBO_CTX", 8192)
    # Prefill (reading the prompt) is compute-bound, so a bigger physical batch
    # (n_ubatch / -ub) reads the prompt in fewer, fatter passes. Larger -ub costs
    # more compute-buffer memory, so default to a modest bump only on GPU and the
    # llama.cpp default (512) on CPU. Env-overridable for on-HW tuning; a tuned
    # profile overrides the heuristic default.
    batch = _env_int("GENESI_TURBO_BATCH", int(tune.get("batch") or 2048))
    ubatch = _env_int("GENESI_TURBO_UBATCH",
                      int(tune.get("ubatch") or (1024 if gpu else 512)))
    threads = _env_int("GENESI_TURBO_THREADS",
                       int(tune.get("threads") or _performance_cores(phys_cores)))

    # Continuous batching (OS-wide throughput). One loaded model serves N
    # concurrent sequences from separate slots, so multiple Genesi apps / Genesi
    # Code agents — and the prefill-as-you-type warm requests — share the SAME
    # weights in VRAM and decode in parallel: aggregate tokens/s scales ~with N
    # because the expensive per-token weight read is amortized across the batch.
    # Each slot keeps the full per-request context (total KV = ctx * N), so we
    # only raise N above 1 when the model is FULLY offloaded and there's clear
    # VRAM headroom; a spilling or CPU-bound model stays single-slot (extra slots
    # would only add KV pressure with no shared-weight win). Pin/disable with
    # GENESI_TURBO_PARALLEL.
    n_parallel = _env_int("GENESI_TURBO_PARALLEL", int(tune.get("parallel") or 0))
    if n_parallel <= 0:                          # 0 / unset -> auto, CONSERVATIVE
        n_parallel = 1
        # Extra slots only help CONCURRENT clients; for a single chat they add KV
        # (total_ctx = ctx*N) and cont-batching scheduling, which measurably slowed
        # single-stream decode. So auto adds AT MOST one extra slot, and only with
        # generous headroom left AFTER that slot's KV — single-stream latency must
        # never regress for throughput nobody's using. Heavy multi-agent workloads
        # (Genesi Code) should pin GENESI_TURBO_PARALLEL=4 explicitly.
        # Never over the mesh. This heuristic was written for a LOCAL card,
        # where a spare slot costs some idle VRAM and nothing else. Pooled,
        # every one of its assumptions inverts:
        #
        #   * the headroom it measures is on ANOTHER machine, sampled when we
        #     planned and spendable by that machine's own workload before we
        #     load — so being wrong is not a tight fit, it is a failed load
        #     minutes in;
        #   * the extra slot's KV lands on the remote GPU, so every access to
        #     it crosses the network;
        #   * extra slots buy CONCURRENT throughput, which is not what anyone
        #     pooling is here for. They accepted network latency per token to
        #     run a model at all.
        #
        # Measured: on a 1.9 GB model with 5.3 GB pooled this chose 2 slots,
        # so -c became 16384, and the load died on the worker. The single-slot
        # retry — identical but for this — came up and served fine.
        if ngl_value == "999" and fits_main and not is_moe and not mesh_endpoints:
            kv_per_slot = 0.5                     # GB, generous q8 KV @ 4k upper bound
            if (budget_gb - main_gb) > (2.0 + kv_per_slot):
                n_parallel = 2
    n_parallel = max(1, min(n_parallel, 8))
    total_ctx = ctx * n_parallel                 # per-slot ctx preserved

    cmd = [binp, "-m", main_gguf, "--host", TURBO_HOST,
           "--port", str(TURBO_PORT),
           "-c", str(total_ctx),
           # Remote GPUs first: --rpc must be on the command line before -ngl is
           # interpreted, since the RPC devices are what the layer count is
           # distributed across. Empty unless mesh_plan approved pooling.
           *(["--rpc", ",".join(mesh_endpoints)] if mesh_endpoints else []),
           "-b", str(batch),               # logical prefill batch
           "-ub", str(ubatch),             # physical prefill batch (n_ubatch)
           # KV-cache reuse: keep matching prefix chunks across requests via KV
           # shifting, so a repeated system prompt isn't re-prefilled every turn
           # (near-instant on the 2nd+ message). Pure win, negligible memory.
           "--cache-reuse", str(_env_int("GENESI_TURBO_CACHE_REUSE", 256)),
           "--threads", str(threads)]

    # Enable the extra slots + continuous batching when N > 1. cont-batching is
    # default-on in recent llama.cpp; add the explicit flag only on builds that
    # still expose it (older ones default it off), gated on --help so we never
    # pass a removed argument.
    if n_parallel > 1:
        cmd += ["--parallel", str(n_parallel)]
        if "--cont-batching" in _llama_help():
            cmd += ["--cont-batching"]
           # NOTE: NO --prompt-cache / --prompt-cache-all here. Those are
           # llama-CLI (main) flags; llama-server rejects them with
           #   error: invalid argument: --prompt-cache
           # and refuses to start (broke every Turbo launch, 2026-06-05).
           # In-session prefix reuse is already handled by --cache-reuse above;
           # cross-restart persistence in llama-server is a runtime API
           # (--slot-save-path + /slots?action=save), not a startup flag.

    # Apply the model's OWN chat template from the GGUF instead of llama.cpp's
    # legacy built-in guesses. This is what turns a reasoning model's channels
    # into structured fields — gpt-oss's harmony analysis channel becomes
    # `reasoning_content` and its tool calls become `tool_calls` — and it is
    # REQUIRED before the server will accept a request carrying `tools` at all.
    # Without it Genesi Code could only ever see the final answer, so a model
    # that announced a tool on another channel looked like it had done nothing.
    # Gated on --help: older builds don't have the flag and refuse to start on an
    # unknown argument.
    if "--jinja" in _llama_help():
        cmd += ["--jinja"]

    # Flash attention + quantized KV cache are a clear win on the GPU (they cut
    # memory bandwidth, which is the bottleneck there), but on CPU the q8_0 KV
    # has to be de-quantized every single step and CPU flash-attn isn't faster —
    # both REGRESS tokens/s. So: GPU gets -fa on + q8_0 KV; CPU gets f16 KV
    # (llama.cpp default, no flag) and lets llama.cpp auto-decide flash-attn.
    # Heuristic default: GPU -> -fa on + q8_0 KV; CPU -> auto FA + f16 KV. A tuned
    # profile or an explicit env var (GENESI_TURBO_FA / GENESI_TURBO_KV) overrides
    # either — the autotuner sometimes finds f16 KV faster on a big card, etc.
    fa = (os.environ.get("GENESI_TURBO_FA", "").strip()
          or str(tune.get("fa") or "").strip()
          or ("on" if use_ngl_999 else "auto"))
    cmd += ["-fa", fa]
    kv = (os.environ.get("GENESI_TURBO_KV", "").strip()
          or str(tune.get("kv") or "").strip()
          or ("q8_0" if use_ngl_999 else ""))
    if kv:
        cmd += ["--cache-type-k", kv,        # quantized KV halves KV bandwidth
                "--cache-type-v", kv]

    if ngl_value:
        cmd += ["-ngl", ngl_value]

    # MoE expert-offload flag (set above when a Mixture-of-Experts model spills
    # VRAM): --n-cpu-moe K keeps K layers' experts on CPU RAM; --cpu-moe keeps
    # them all there. Attention stays on the GPU via -ngl 999.
    if n_cpu_moe is not None and ncmoe_flag:
        if ncmoe_flag == "--n-cpu-moe" and n_cpu_moe > 0:
            cmd += ["--n-cpu-moe", str(n_cpu_moe)]
        else:
            cmd += ["--cpu-moe"]

    # mlock: pin the model in RAM (no swap/reclaim) for steady CPU inference.
    # Opt-in only — risky on low-RAM machines and the live ISO (RAM-backed fs),
    # so default OFF; enable with GENESI_TURBO_MLOCK=1.
    if _env_flag("GENESI_TURBO_MLOCK"):
        cmd += ["--mlock"]

    help_txt = _llama_help()

    # CPU decode tuning (GPU-less boxes, where decode is CPU-bound). Two real wins:
    #  - SPLIT the thread counts: --threads stays the fast PHYSICAL cores for
    #    DECODE (memory-bandwidth-bound — SMT siblings / E-cores just add sync
    #    stalls), while --threads-batch uses ALL logical cores for PREFILL
    #    (compute-bound — SMT actually helps there). Reading the prompt gets faster
    #    without slowing generation.
    #  - --prio 2 (above-normal thread scheduling priority) cuts run-to-run jitter
    #    from other desktop processes. Both gated on --help (names vary) and
    #    env-tunable; skip the lot with GENESI_TURBO_NO_CPU_TUNE=1.
    if not gpu and not _env_flag("GENESI_TURBO_NO_CPU_TUNE"):
        tb_flag = _pick_flag(help_txt, "--threads-batch", "-tb")
        if tb_flag:
            cmd += [tb_flag, str(_env_int("GENESI_TURBO_THREADS_BATCH",
                                          os.cpu_count() or threads))]
        if "--prio" in help_txt:
            cmd += ["--prio", str(_env_int("GENESI_TURBO_PRIO", 2))]

    # Persistent prompt/KV cache to disk (Zero Cold-Start). --slot-save-path
    # enables llama-server's runtime slot save/restore API (/slots?action=save|
    # restore), so a long system-prompt's KV can survive a server restart — the
    # first reply of a returning chat stays fast even after a reboot. Harmless
    # when unused: it only enables the capability + a save dir, never changes
    # decode. Path defaults to a per-user cache; gated on the binary supporting
    # the flag. Disable with GENESI_TURBO_NO_SLOT_CACHE=1.
    if "--slot-save-path" in help_txt and not _env_flag("GENESI_TURBO_NO_SLOT_CACHE"):
        slot_dir = (os.environ.get("GENESI_TURBO_SLOT_PATH")
                    or os.path.expanduser("~/.cache/genesi-turbo/slots"))
        try:
            os.makedirs(slot_dir, exist_ok=True)
            cmd += ["--slot-save-path", slot_dir]
        except OSError:
            pass

    if draft_gguf:
        # Speculative decoding with a same-family draft model. The draft-count
        # flag was renamed in recent llama.cpp: master uses --spec-draft-n-max,
        # older builds use --draft. Pick whatever the installed binary lists so
        # the server doesn't refuse to start on a "removed argument".
        draft_max = _env_int("GENESI_TURBO_DRAFT_MAX", 8)
        max_flag = _pick_flag(help_txt, "--spec-draft-n-max", "--draft-max", "--draft")
        cmd += ["-md", draft_gguf]
        if max_flag:
            cmd += [max_flag, str(draft_max)]
        # The draft MUST be GPU-resident too (-ngld). Without it the draft runs
        # on the CPU while the target is on the GPU, so the slow CPU draft
        # becomes the bottleneck and speculation yields no speedup.
        if use_ngl_999:
            cmd += ["-ngld", "999"]
        # Dynamic draft length (Lote C): instead of always proposing a fixed N
        # tokens, let the draft length ADAPT to the live acceptance rate —
        # speculate more on easy/repetitive spans, back off on hard ones. We set
        # a floor (--draft-min) and a probability threshold (--draft-p-min) so
        # llama.cpp stops drafting once the draft's confidence drops. Beats a
        # fixed N. Flag names vary by version, so each is gated on --help and
        # simply skipped on a build that doesn't expose it (then N stays fixed).
        # Env-tunable: GENESI_TURBO_DRAFT_MIN / GENESI_TURBO_DRAFT_P.
        min_flag = _pick_flag(help_txt, "--spec-draft-n-min", "--draft-min", "--draft-n-min")
        if min_flag:
            cmd += [min_flag, str(_env_int("GENESI_TURBO_DRAFT_MIN", 1))]
        p_flag = _pick_flag(help_txt, "--spec-draft-p-min", "--draft-p-min")
        if p_flag:
            cmd += [p_flag, (os.environ.get("GENESI_TURBO_DRAFT_P", "").strip() or "0.6")]
        # Recent llama.cpp LOADS the draft but does NOT speculate unless an
        # implementation is selected: --spec-type defaults to 'none', which logs
        # "no implementations specified for speculative decoding" — the draft
        # just wastes VRAM with zero speedup (exactly what we saw). draft-simple
        # is the classic draft-model speculation. Older builds without
        # --spec-type speculate from -md alone, so we only add it when supported.
        if "--spec-type" in help_txt:
            cmd += ["--spec-type", "draft-simple"]
    elif "--spec-type" in help_txt and not _env_flag("GENESI_TURBO_NO_NGRAM"):
        # No draft model: model-free n-gram / prompt-lookup speculation. It
        # speculates from the context's OWN n-grams — no second model, no extra
        # VRAM, negligible compute. HUGE on code / agent / RAG / edit workloads
        # where the output copies chunks of the input (Genesi Code!), and harmless
        # on novel text (output is identical either way). Now enabled on GPU too,
        # not just CPU-only: ollama doesn't do this by default, so it's a real
        # Turbo edge for fitting models that have NO same-family draft (mistral,
        # gemma1, phi…) — exactly the case where Turbo used to equal plain ollama.
        # It's also the engine behind "retrieval speculation": when MemPalace
        # injects a relevant PAST answer into the context, n-gram picks those
        # tokens straight up (REST-lite, no llama.cpp fork). Disable with
        # GENESI_TURBO_NO_NGRAM=1.
        cmd += ["--spec-type", "ngram-simple"]

    return cmd


def wait_ready(timeout=900):   # big models on a CPU-only VM can take 5-8 min
    end = time.time() + timeout
    while time.time() < end:
        try:
            with urllib.request.urlopen(f"{_turbo_url()}/health",
                                        timeout=2) as r:
                if json.loads(r.read()).get("status") == "ok":
                    return True
        except Exception:
            pass
        time.sleep(1)
    return False


def turbo_healthy(url=None, timeout=2):
    """Is a Turbo serving at `url`? Defaults to THIS machine's own.

    Local by default, deliberately. Every caller that omits the argument is
    waiting on a server it just started here, and _turbo_url() can legitimately
    point at a PEER's Turbo while ours is still loading — so resolving through
    it would let a peer's /health answer make a failed local load look like a
    success, then hand the user a server that was never running."""
    base = url or "http://127.0.0.1:%d" % TURBO_PORT
    try:
        with urllib.request.urlopen(base.rstrip("/") + "/health",
                                    timeout=timeout) as r:
            return json.loads(r.read()).get("status") == "ok"
    except Exception:
        return False


def remote_turbo():
    """A PEER's Turbo that is up and answering, or None.

    Only a peer's: never this machine's own, so callers can use it to decide
    whether starting a local server is pointless."""
    url = _turbo_url()
    if url.startswith("http://127.0.0.1") or url.startswith("http://localhost"):
        return None
    return url if turbo_healthy(url, timeout=3) else None


def _turbo_host_of(url):
    """The host part of a Turbo URL, for printing a `genesi-mesh use` command."""
    return url.split("//", 1)[-1].split(":")[0]


def _mesh_gpu():
    """(has_dedicated_gpu, why) as GENESI MESH sees this machine.

    Deliberately the mesh's probe and not _detect_vram_mb(). That one falls back
    to what Vulkan reports, and inside a VM the software rasteriser answers with
    a slice of system RAM -- so a machine with no GPU at all measured several GB
    of "VRAM" and every has-a-GPU test passed. It also means `serve` and
    `genesi-mesh plan` now agree; they were reading two different numbers and
    only one of them was on screen."""
    try:
        sys.path.insert(0, "/usr/lib/genesi-mesh")
        import genesi_mesh_common as _mesh
        gpu = _mesh.probe_gpu()
    except Exception:
        return _vram_budget_gb() > 0, "no mesh probe; using local VRAM detection"
    if gpu.get("integrated"):
        return False, "integrated graphics (no dedicated VRAM)"
    mb = int(gpu.get("vram_mb") or 0)
    return mb > 0, ("%s, %d MiB" % (gpu.get("backend", "?"), mb) if mb
                    else "no GPU detected")


def _turbo_source():
    """The configured turbo_source, or 'auto'."""
    try:
        sys.path.insert(0, "/usr/lib/genesi-mesh")
        import genesi_mesh_common as _mesh
        return str(_mesh.load_conf().get("turbo_source", "auto") or "auto").strip()
    except Exception:
        return "auto"


def port_busy(port=TURBO_PORT):
    """True only if something is ACTIVELY LISTENING on TURBO_HOST:<port>.

    We set SO_REUSEADDR before bind. Without it, a just-stopped llama-server
    leaves the port in TIME_WAIT (the kernel holds 127.0.0.1:11435 for ~1-2 min
    for its closed client connections), so a plain bind() fails with EADDRINUSE
    and we'd WRONGLY report "busy" — that's the "toggle Turbo off then on within a
    few minutes fails as if it's already running, and pkill finds nothing on the
    port" bug. SO_REUSEADDR lets bind succeed over a TIME_WAIT remnant, so this
    returns True only for a LIVE listener. (llama-server's HTTP backend also binds
    with SO_REUSEADDR, so it can re-take the port immediately too.)"""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind((TURBO_HOST, port))
            return False
        except OSError:
            return True


def free_turbo_port():
    """Free our port by stopping any llama-server holding it, and WAIT until the
    socket is actually released.

    The old version just fired `pkill` (SIGTERM) and slept 1.5s. llama-server
    catches SIGTERM and unwinds the model + GPU context first, so it often still
    held the port after the sleep — then the very next `serve` saw the port busy
    and bailed with "already running", even though the user had just toggled
    Turbo off. That's the flaky on/off the user hit. Now: SIGTERM, poll until the
    port frees, then escalate to SIGKILL if it's still bound."""
    if not shutil.which("pkill"):
        return
    pattern = f"llama-server.*--port {TURBO_PORT}"
    subprocess.run(["pkill", "-f", pattern], check=False)
    # Give it up to ~6s to shut down cleanly and release the socket.
    for _ in range(24):
        if not port_busy():
            return
        time.sleep(0.25)
    # Still holding the port — force kill, then wait a final moment for the
    # kernel to reclaim the socket.
    subprocess.run(["pkill", "-9", "-f", pattern], check=False)
    for _ in range(16):
        if not port_busy():
            return
        time.sleep(0.25)


def measure(n=256):
    body = json.dumps({"prompt": PROMPT, "n_predict": n,
                       "temperature": 0.7, "cache_prompt": False}).encode()
    req = urllib.request.Request(f"{_turbo_url()}/completion",
                                 data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=900) as r:
        t = json.loads(r.read()).get("timings", {})
    return t.get("predicted_per_second"), t.get("predicted_n")


def stop(proc):
    try:
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=10)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass


def _tail(path, n=18):
    try:
        return "".join(open(path).readlines()[-n:])
    except Exception:
        return ""


def cmd_bench(main, draft):
    main_g = ensure(main)
    if not main_g:
        sys.exit(f"could not resolve/pull {main}")
    if not llama_bin("llama-server"):
        sys.exit("llama-server not found — install the Genesi Vulkan build:\n"
                 "  sudo pacman -S genesi-llama-cpp   (ships llama.cpp + Vulkan)")
    draft = draft or pick_draft(main)
    if not draft:
        sys.exit(f"no same-family draft for {main}; pass one explicitly:\n"
                 f"  genesi-ai-turbo bench {main} qwen2.5:0.5b")
    draft_g = ensure(draft)
    if not draft_g:
        sys.exit(f"could not resolve/pull draft {draft}")

    # bench measures SINGLE-STREAM decode, so pin one slot: extra idle slots
    # would only reserve VRAM (and bench has no fallback chain to recover an OOM
    # that `serve` would). A user who explicitly exported GENESI_TURBO_PARALLEL
    # still gets theirs (setdefault).
    os.environ.setdefault("GENESI_TURBO_PARALLEL", "1")

    results = {}
    for label, dg in (("no-spec", None), ("turbo (spec)", draft_g)):
        print(f":: starting {label} ...", flush=True)
        # bench is a diagnostic: force the draft through even on CPU-only so the
        # user can SEE the real spec-vs-no-spec delta on their own hardware.
        # `serve` auto-disables the draft on CPU (where it's a net loss); here we
        # want the measurement, not the policy.
        if dg:
            os.environ["GENESI_TURBO_FORCE_DRAFT"] = "1"
        cmd = server_cmd(main_g, dg)
        print("   " + " ".join(cmd), flush=True)
        log = tempfile.NamedTemporaryFile("w", delete=False, suffix=".log").name
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=open(log, "w"))
        try:
            if not wait_ready():
                print(f"   {label}: server never became ready — last log lines:")
                print(_tail(log))
                continue
            tps, ntok = measure()
            results[label] = tps
            print(f"   {label}: {tps:.1f} tok/s ({ntok} tokens)")
        finally:
            stop(proc)
        time.sleep(2)

    a, b = results.get("no-spec"), results.get("turbo (spec)")
    print(f"\n  Genesi Turbo — {main}  (draft: {draft})\n")
    if a and b:
        print(f"  {'no-spec':16}{a:8.1f} tok/s")
        print(f"  {'turbo (spec)':16}{b:8.1f} tok/s")
        print(f"\n  >> {a:.1f} -> {b:.1f} tok/s   ({(b - a) / a * 100:+.0f}%)  "
              f"same output, speculative decoding")
    else:
        print("  (incomplete — run `genesi-ai-turbo serve %s` to see server logs)" % main)


# llama.cpp's own words when a remote mesh device cannot give us the memory:
#   failed to allocate RPC0[100.64.162.89:50052] buffer of size 2011539712
_RPC_ALLOC_RE = re.compile(
    r"failed to allocate RPC\d+\[([^\]]+)\] buffer of size (\d+)")


def _exit_note(code):
    """How the process ended, in words. Popen reports a signal as a NEGATIVE
    returncode, and that distinction carries the diagnosis: a clean non-zero
    exit means llama.cpp decided to stop and (usually) said why, while a signal
    means it was killed mid-flight and the log stops wherever it happened to
    be — which is why an empty-looking log is itself information."""
    if code is None:
        return "still running"
    if code < 0:
        try:
            name = signal.Signals(-code).name
        except (ValueError, AttributeError):
            name = "signal %d" % -code
        return "killed by %s" % name
    return "exit code %d" % code


def _explain_load_failure(text, code=None, pooled=False):
    """Turn a loader error into something the user can act on, or "".

    Only patterns we can genuinely diagnose. A confident wrong guess is worse
    than the raw log, which at least does not send anyone down the wrong path,
    so anything unrecognised falls through to printing the log as before."""
    text = text or ""

    # Died mid-load, over the mesh, with nothing to say. llama.cpp reports the
    # errors it can see; a crash during RPC setup usually means the two machines
    # are not running the same llama.cpp. The RPC backend's wire format is
    # explicitly not stable between builds, and a mismatch does not fail
    # politely — it corrupts a message and takes the process down.
    if pooled and code is not None and code != 0 \
            and not _RPC_ALLOC_RE.search(text) \
            and "error" not in text.lower():
        return (
            "   It stopped during load (%s) without reporting an error, which "
            "over the\n   mesh usually means the two machines are running "
            "DIFFERENT llama.cpp builds.\n   The RPC wire format is not stable "
            "between versions and a mismatch does not\n   fail politely. "
            "Compare them:\n"
            "       llama-server --version          (here)\n"
            "       llama-server --version          (on the worker)\n"
            "   They must match. Full log: run the printed command by hand to "
            "see everything."
            % _exit_note(code))

    match = _RPC_ALLOC_RE.search(text)
    if match:
        endpoint, size = match.group(1), int(match.group(2))
        return (
            "   The mesh worker at %s could not give us %.1f GB.\n"
            "   Its GPU has the capacity but not that much FREE right now — "
            "something\n   else on that machine is using it, and a local model "
            "is the usual cause.\n"
            "   Check from here:      genesi-mesh peers     (shows free / total "
            "VRAM)\n"
            "   or on the worker:     nvidia-smi"
            % (endpoint, size / (1024.0 ** 3)))
    return ""


def _serve_with_fallback(main_g, draft_g):
    """Launch the Turbo server, degrading GRACEFULLY if an optimisation makes it
    fail to load. Some models load in ollama (its own bundled llama.cpp) but trip
    our system llama-server — usually `--n-cpu-moe` (MoE expert-offload) or a draft
    model. Instead of just dying with a scary loader error, we try the optimised
    command and, if it doesn't come up, retry without the riskier extras, ending
    with plain full/auto offload (exactly what ollama does). The final, plainest
    variant is exec'd so the steady-state process is llama-server itself (clean
    stop / health / port handling). For an already-plain command (no MoE, no
    draft) this is a single exec — zero behaviour change from before."""
    full = server_cmd(main_g, draft_g)
    if not full:
        return
    variants = [("optimised", full)]
    risky = ("--n-cpu-moe" in full) or ("--cpu-moe" in full) or bool(draft_g)
    if ("--n-cpu-moe" in full) or ("--cpu-moe" in full):
        os.environ["GENESI_TURBO_NO_MOE"] = "1"
        nomoe = server_cmd(main_g, draft_g)
        os.environ.pop("GENESI_TURBO_NO_MOE", None)
        if nomoe and nomoe != full:
            variants.append(("no-MoE offload", nomoe))
    if draft_g:
        os.environ["GENESI_TURBO_NO_MOE"] = "1"
        plain = server_cmd(main_g, None)
        os.environ.pop("GENESI_TURBO_NO_MOE", None)
        if plain and all(plain != c for _, c in variants):
            variants.append(("plain offload", plain))

    # Final safety net: if any variant still asks for multiple slots, the extra
    # per-slot KV could tip a full card into OOM. Continuous batching is a
    # throughput win, never worth failing to start over — so keep a single-slot,
    # no-draft, no-MoE version as the last resort the user always boots into.
    if any("--parallel" in c for _, c in variants):
        os.environ["GENESI_TURBO_PARALLEL"] = "1"
        os.environ["GENESI_TURBO_NO_MOE"] = "1"
        solo = server_cmd(main_g, None)
        os.environ.pop("GENESI_TURBO_PARALLEL", None)
        os.environ.pop("GENESI_TURBO_NO_MOE", None)
        if solo and all(solo != c for _, c in variants):
            variants.append(("single-slot offload", solo))
        risky = True

    # Pooling is an optimisation that can fail for a reason this machine cannot
    # see. The worker's free VRAM is measured when we PLAN and consumed when we
    # LOAD, and the peer can start its own model in between — so a pooled run
    # that was honestly planned still dies with
    #
    #     failed to allocate RPC0[host:50052] buffer of size 2011539712
    #
    # Worse, a pooled command is otherwise "not risky", so it went straight to
    # os.execvp: Turbo replaced itself with llama-server, and when the load
    # failed there was no Turbo left to explain it or to retry. The local
    # variant goes LAST so the process the user ends up in never depends on
    # another machine staying free.
    if "--rpc" in full:
        global _mesh_quiet
        # Building this variant re-plans the mesh with pooling switched off,
        # which would otherwise announce "[mesh] not used: disabled by
        # GENESI_TURBO_NO_MESH" — reporting our own scaffolding back to the user
        # as if it were their configuration.
        _mesh_quiet = True
        os.environ["GENESI_TURBO_NO_MESH"] = "1"
        local = server_cmd(main_g, draft_g)
        os.environ.pop("GENESI_TURBO_NO_MESH", None)
        _mesh_quiet = False
        if local and all(local != c for _, c in variants):
            variants.append(("local only, without the mesh", local))
            risky = True

    last = len(variants) - 1
    skip_mesh = False
    for i, (label, cmd) in enumerate(variants):
        # Once a worker has told us it cannot spare the memory, every remaining
        # pooled variant asks the same machine for the same thing and waits the
        # same minutes to be refused again. Jump to the first variant that does
        # not need it. (Never skip the LAST one — it is the exec'd fallback, and
        # by construction it is the local one.)
        if skip_mesh and "--rpc" in cmd and i != last:
            continue
        if risky:
            print(f":: Genesi Turbo: trying {label}…", flush=True)
        print("   " + " ".join(cmd), flush=True)
        if i == last:
            os.execvp(cmd[0], cmd)            # final attempt becomes the process
            return
        log = tempfile.NamedTemporaryFile("w", delete=False, suffix=".log").name
        # stdout used to go to /dev/null. llama.cpp splits its output across both
        # streams, so a failure whose last words went to stdout left a log that
        # stopped at "loading model" and explained nothing — which is exactly
        # what a failing pooled load looked like. Keep everything.
        proc = subprocess.Popen(cmd, stdout=open(log, "w"),
                                stderr=subprocess.STDOUT)
        ok, end = False, time.time() + 900    # a big model can take minutes to load
        while time.time() < end:
            if turbo_healthy():
                ok = True
                break
            if proc.poll() is not None:       # process exited = load failed
                break
            time.sleep(1)
        if ok:
            print(f":: Genesi Turbo up ({label}). API: "
                  f"{_turbo_url()}/v1   Ctrl-C to stop", flush=True)
            try:
                proc.wait()
            except KeyboardInterrupt:
                stop(proc)
            return
        tail = _tail(log)
        explained = _explain_load_failure(tail, proc.returncode,
                                          "--rpc" in cmd)
        if explained:
            skip_mesh = bool(_RPC_ALLOC_RE.search(tail))
            print("[!] %s failed to come up.\n%s" % (label, explained),
                  file=sys.stderr, flush=True)
        else:
            print(f"[!] {label} failed to come up ({_exit_note(proc.returncode)})"
                  f" — falling back:\n{tail}", file=sys.stderr, flush=True)
        try:
            proc.kill()
        except Exception:
            pass
        free_turbo_port()


def cmd_serve(main, draft, spec=False):
    # Port already taken? This is common — the Monitor or a previous terminal
    # already started Turbo. If it's healthy, reuse it (don't fail to bind).
    # If it's bound but unresponsive, it's a stale llama-server: free the port.
    if port_busy():
        if turbo_healthy():
            print(f":: Turbo is already running at http://127.0.0.1:{TURBO_PORT}"
                  " — reusing it.")
            return
        print(f"[!] Port {TURBO_PORT} is held by an unresponsive process — freeing it…",
              file=sys.stderr, flush=True)
        free_turbo_port()
        if port_busy():
            sys.exit(f"port {TURBO_PORT} is still busy. Stop the process manually:\n"
                     f"  pkill -f 'llama-server.*{TURBO_PORT}'")

    # A peer already serving Turbo, on a machine with no GPU of its own: a local
    # server here means CPU inference while a real GPU sits idle one hop away.
    # That is exactly what Turbo-over-HTTP exists for, and it is invisible to
    # someone who just typed `serve` -- so say it, and use the peer.
    #
    # Gated on having no usable GPU: on a machine WITH one, `serve` means "serve
    # from here" and hijacking that would be worse than the slow path. --local
    # forces a local server either way.
    if not _env_flag("GENESI_TURBO_LOCAL"):
        peer_url = remote_turbo()
        # A peer we were told to use that does not answer must be said out loud.
        # Silence here cost a full debugging round: the mesh had resolved to the
        # peer's Tailscale address, the Turbo port was open only on the LAN zone,
        # /health timed out, this returned None, and the ONLY thing printed was
        # the pooling path's unrelated "no worker peers online".
        chosen = _turbo_url()
        if not peer_url and not chosen.startswith(("http://127.0.0.1",
                                                   "http://localhost")):
            print(f"[!] {chosen} was chosen for Turbo but is not answering — "
                  "starting a local server instead.", file=sys.stderr, flush=True)
            print("    That address is reachable from the mesh's point of view "
                  "but the port is not.", file=sys.stderr, flush=True)
            print("    On that machine: sudo genesi-mesh serve on   (it opens "
                  "11435 on every", file=sys.stderr, flush=True)
            print("    interface peers arrive on — a LAN-only rule misses the "
                  "VPN path).", file=sys.stderr, flush=True)
        if peer_url:
            has_gpu, why = _mesh_gpu()
            source = _turbo_source()
            pinned = source not in ("auto", "local")
            if pinned or not has_gpu:
                print(f":: Genesi Mesh: {peer_url} is already serving Turbo.")
                print("   %s, so a local server would run on CPU while that one"
                      % ("You pinned this machine to it (genesi-mesh use %s)"
                         % source if pinned
                         else "This machine has no GPU (%s)" % why))
                print("   sits idle. Genesi apps here already use it — nothing "
                      "to start.")
                print(f"   API: {peer_url}/v1")
                print("   Serve locally anyway with --local.")
                return
            # A peer IS serving and we are starting our own anyway. Never do
            # that silently: the user is about to wait through a local load
            # while a ready GPU sits one hop away, and the only clue would be
            # how long it takes.
            print(f":: Genesi Mesh: {peer_url} is serving Turbo, but this "
                  "machine has a GPU")
            print("   (%s), so `serve` serves from HERE. Use it instead with:"
                  % why)
            print("       sudo genesi-mesh use %s" % _turbo_host_of(peer_url))

    main_g = ensure(main)
    if not main_g:
        sys.exit(f"could not resolve/pull {main}")
    if not server_cmd(main_g, None):
        sys.exit("llama-server not found — install the Genesi Vulkan build:\n"
                 "  sudo pacman -S genesi-llama-cpp   (ships llama.cpp + Vulkan)")

    # Record WHICH model this Turbo serves, by the name a human typed. The
    # server's own /props and /v1/models report the GGUF blob path, which under
    # ollama is a sha256 filename — true, and useless to a peer deciding whether
    # to route its chat here. Written before the variant loop because the last
    # variant os.execvp()s and never returns. A stale file cannot mislead: Genesi
    # Mesh only advertises a model while the port is actually listening.
    try:
        os.makedirs("/run/genesi-ai-mode", mode=0o755, exist_ok=True)
        with open("/run/genesi-ai-mode/turbo-model", "w", encoding="utf-8") as fh:
            fh.write(str(main).strip() + "\n")
    except OSError:
        pass                    # advisory only; never block a serve on it
    # Genesi Fit (opt-in, GENESI_TURBO_FIT=1): if this model would SPILL VRAM,
    # requantize it down to the best quant that fits 100% on the GPU and serve
    # THAT — full-GPU speed beats a spilling higher quant, and spec still stacks
    # on top (same tokenizer/family, so pick_draft below still matches). No-op
    # when the model already fits or nothing smaller fits.
    fitted = fit_path(main_g, _vram_budget_gb())
    if fitted:
        print(f":: Genesi Fit: serving a VRAM-fitted quant → {os.path.basename(fitted)} "
              f"(instead of the spilling original)")
        main_g = fitted
    # Default Turbo = plain full GPU offload, the reliable proven win (GPU >> CPU
    # is where the big speedup comes from). Speculative decoding is a MAYBE-win:
    # it helps on a mature driver (CUDA) but can REGRESS on Vulkan/NVK, where the
    # draft + verification cost more than plain offload saves (measured: plain
    # offload 21 t/s vs spec ~baseline on an NVK 3050). So spec is opt-in — pass
    # a draft explicitly, or set GENESI_TURBO_SPEC=1. `bench` always compares
    # both so you can check whether spec actually helps on your hardware first.
    if draft is None and (spec or _env_flag("GENESI_TURBO_SPEC")):
        draft = pick_draft(main)
    draft_g = ensure(draft) if draft else None
    # No same-family draft, but the user opted into a self-draft (GENESI_TURBO_
    # SELF_DRAFT=1)? Build/cache a low-bit quant of the model itself as the draft.
    # server_cmd's VRAM-fit check still decides whether it's actually used.
    if (draft_g is None and (spec or _env_flag("GENESI_TURBO_SPEC"))
            and _env_flag("GENESI_TURBO_SELF_DRAFT")):
        draft_g = self_draft_path(main_g)
        if draft_g:
            draft = "self-draft (Q2)"
    print(f":: Genesi Turbo serving {main}" +
          (f" + draft {draft} (speculative)" if draft_g
           else " (full GPU offload)"))
    print(f"   API: {_turbo_url()}/v1   (OpenAI-compatible)  Ctrl-C to stop")
    # Launch with graceful degradation: if MoE/draft trips the loader, fall back
    # to plain offload (what ollama does) instead of dying on a model ollama runs.
    _serve_with_fallback(main_g, draft_g)


TURBO_ENV_PATH = "/etc/genesi-ai-mode/turbo.env"
ADVANCED_CONF_PATH = "/etc/genesi-ai-mode/advanced.conf"


def _conf_set(path, key, value):
    """Set `key = value` in a genesi advanced.conf, keeping comments and order.

    Same job as _env_file_set for the other file format. Appends when the key is
    absent so this still works on a config predating the key."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []
    out, done = [], False
    for line in lines:
        st = line.strip()
        if st and not st.startswith("#") and "=" in st \
                and st.split("=", 1)[0].strip() == key:
            if not done:
                out.append("%s = %s" % (key, value))
                done = True
            continue
        out.append(line)
    if not done:
        out.append("%s = %s" % (key, value))
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip() + "\n")
    os.replace(tmp, path)


def _env_file_set(path, key, value):
    """Set one KEY=value in an env file, keeping comments and other keys.

    value=None removes the key. Written whole so a half-written file can never
    be read by systemd: EnvironmentFile has no notion of a partial line."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []
    out, done = [], False
    for line in lines:
        st = line.strip()
        if st and not st.startswith("#") and "=" in st \
                and st.split("=", 1)[0].strip() == key:
            if value is not None and not done:
                out.append("%s=%s" % (key, value))
                done = True
            continue                      # drop duplicates / the removed key
        out.append(line)
    if value is not None and not done:
        out.append("%s=%s" % (key, value))
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip() + "\n")
    os.replace(tmp, path)


def _firewall_port(port, opening):
    """Open or close `port`/tcp under whichever firewall is RUNNING.

    Returns a line describing what happened, honestly. Applying a rule to a
    firewall that is not running is the classic time sink -- `ufw allow` prints
    "Rules updated", exits 0, and filters nothing while firewalld owns the
    ruleset -- so we act only on an active manager and say when we found none."""
    def active(unit):
        try:
            return subprocess.run(["systemctl", "is-active", unit],
                                  capture_output=True, text=True,
                                  timeout=5).stdout.strip() == "active"
        except (OSError, subprocess.SubprocessError):
            return False

    did = "opened" if opening else "closed"
    if active("firewalld"):
        # EVERY zone peers can arrive on, not just the default. A mesh normally
        # has a LAN NIC and a VPN up at once, in different zones; opening only
        # the default left the other path shut, and the symptom was a peer whose
        # advertised Turbo simply did not answer -- which looks like a dead
        # service, not like a firewall. Measured: the LAN answered /health and
        # the Tailscale address timed out, and the client had been handed the
        # Tailscale one.
        zones = []
        try:
            sys.path.insert(0, "/usr/lib/genesi-mesh")
            import genesi_mesh_common as _mesh
            zones = _mesh.peer_facing_zones()
        except Exception:
            pass
        if not zones:
            zones = [subprocess.run(["firewall-cmd", "--get-default-zone"],
                                    capture_output=True, text=True
                                    ).stdout.strip() or "public"]
        flag = "--add-port" if opening else "--remove-port"
        failed = [z for z in zones
                  if subprocess.run(["firewall-cmd", "--permanent",
                                     "--zone=" + z, "%s=%d/tcp" % (flag, port)],
                                    capture_output=True).returncode != 0]
        subprocess.run(["firewall-cmd", "--reload"], capture_output=True)
        if failed:
            return ("firewalld: could NOT change %d/tcp in %s — do it by hand"
                    % (port, ", ".join(failed)))
        return "firewalld: %s %d/tcp in %s" % (did, port, ", ".join(zones))
    if active("ufw"):
        args = (["ufw", "allow", "%d/tcp" % port] if opening
                else ["ufw", "delete", "allow", "%d/tcp" % port])
        if subprocess.run(args, capture_output=True).returncode != 0:
            return "ufw: could NOT change %d/tcp — do it by hand" % port
        return "ufw: %s %d/tcp" % (did, port)
    return "no firewall running — nothing to open"


def cmd_share(arg):
    """Bind Turbo to the LAN (or back to loopback) and open/close its port.

    The MECHANISM only. Deciding to share compute with other machines is Genesi
    Mesh's job, and `genesi-mesh serve on|off` is the command users should
    reach for -- it sits next to `worker on|off`, which shares this machine's
    VRAM, so both ways of lending a GPU are in one place. This lives here
    because turbo.env, genesi-turbo.service and the port are ai-mode's to own;
    Mesh delegates rather than reaching into another package's files.

    Deliberately a command and not a default: Turbo has NO authentication, so
    binding it beyond loopback is the user's decision to make, once, knowingly."""
    if arg not in ("on", "off"):
        sys.exit("usage: genesi-ai-turbo share on|off")
    if os.geteuid() != 0:
        sys.exit("This needs root: sudo genesi-ai-turbo share %s" % arg)

    on = arg == "on"
    _env_file_set(TURBO_ENV_PATH, "GENESI_TURBO_HOST",
                  "0.0.0.0" if on else None)
    print(":: %s -> GENESI_TURBO_HOST=%s"
          % (TURBO_ENV_PATH, "0.0.0.0" if on else "(removed, back to loopback)"))
    print(":: " + _firewall_port(TURBO_PORT, on))

    # genesi-aid owns whether the warm unit runs: every poll it reads
    # always_warm_turbo and STOPS the unit when the knob is off. Enabling the
    # unit without flipping the knob starts a server that aid kills a second
    # later -- observed exactly that, and the journal reads "Deactivated
    # successfully", which looks like a clean shutdown rather than a fight.
    _conf_set(ADVANCED_CONF_PATH, "always_warm_turbo", "on" if on else "off")
    print(":: %s -> always_warm_turbo = %s"
          % (ADVANCED_CONF_PATH, "on" if on else "off"))

    # enable/disable + restart so the new bind takes effect now, not next boot.
    subprocess.run(["systemctl", "enable" if on else "disable",
                    "genesi-turbo.service"], capture_output=True)
    subprocess.run(["systemctl", "restart" if on else "stop",
                    "genesi-turbo.service"], capture_output=True)
    print(":: genesi-turbo %s" % ("enabled and restarted" if on else "stopped"))

    if on:
        addr = "this machine"
        try:
            sys.path.insert(0, "/usr/lib/genesi-mesh")
            import genesi_mesh_common as _mesh
            addr = _mesh.primary_address()
        except Exception:
            pass
        print()
        print("   Serving http://%s:%d/v1 to your network." % (addr, TURBO_PORT))
        print("   Other Genesi machines find it through the mesh on their next")
        print("   beacon — nothing to configure on them.")
        print()
        print("   Turbo has NO authentication. Anyone who can reach this port can")
        print("   use this GPU. Only do this on a network you control.")
    return


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return
    # Pull the speculative-decoding flag out of the args (it may appear anywhere).
    # Default: spec OFF (plain full GPU offload, the reliable win). Opt in with
    # --spec/--speculative, or globally with GENESI_TURBO_SPEC=1.
    spec = _env_flag("GENESI_TURBO_SPEC")
    # Did the user (or env) pin spec explicitly? If not, `serve` decides AUTO from
    # the backend: ON for the CUDA build (the proven win), OFF for Vulkan/NVK.
    spec_pinned = (_env_flag("GENESI_TURBO_SPEC")
                   or _env_flag("GENESI_TURBO_NO_SPEC"))
    pos = []
    for a in argv:
        al = a.lower()
        if al in ("--spec", "--speculative"):
            spec, spec_pinned = True, True
        elif al in ("--no-spec", "--no-speculative"):
            spec, spec_pinned = False, True
        elif al == "--local":
            os.environ["GENESI_TURBO_LOCAL"] = "1"   # serve HERE, not via a peer
        else:
            pos.append(a)
    if not pos:
        print(__doc__)
        return
    action, rest = pos[0], pos[1:]
    if action == "recommend":
        cmd_recommend(any(a.lower() == "--installed" for a in rest))
        return
    if action == "share":
        cmd_share(rest[0] if rest else "")
        return
    # Resolve an ollama tag to its GGUF blob path (used by genesi-ai-tune so the
    # autotuner benches the exact file Turbo would serve). Prints the path on
    # stdout, exits non-zero if it can't be resolved.
    if action == "gguf-path":
        if not rest:
            sys.exit("usage: genesi-ai-turbo gguf-path <model>")
        p = gguf_path(rest[0])
        if not p:
            sys.exit(1)
        print(p)
        return
    # The hardware signature server_cmd keys tuned profiles by. genesi-ai-tune
    # calls this so it writes under the EXACT key server_cmd will look up — no
    # risk of the two computing a different VRAM bucket and silently missing.
    if action == "hw-sig":
        print(_hw_sig())
        return
    # ── GGUF library (any .gguf on the machine is a usable Turbo model) ──
    # JSON on stdout so the Monitor can consume these directly.
    if action == "gguf-list":
        entries = scan_gguf_library()
        for e in entries:
            e["fit"], e["fit_detail"] = gguf_fit_report(e)
        print(json.dumps(entries))
        return
    if action == "gguf-info":
        if not rest:
            sys.exit("usage: genesi-ai-turbo gguf-info <path|gguf:name>")
        p = resolve_gguf_ref(rest[0])
        if not p:
            sys.exit(f"GGUF not found: {rest[0]}")
        e = gguf_describe(p)
        e["fit"], e["fit_detail"] = gguf_fit_report(e)
        print(json.dumps(e))
        return
    if action == "gguf-import":
        if not rest:
            sys.exit("usage: genesi-ai-turbo gguf-import <path|url> [--move]")
        move = any(a.lower() == "--move" for a in rest)
        src = next((a for a in rest if not a.startswith("--")), None)
        if not src:
            sys.exit("usage: genesi-ai-turbo gguf-import <path|url> [--move]")

        def _pct(done, total):
            print(f"\r:: downloading… {done * 100 // total}% "
                  f"({done / 1024**3:.1f}/{total / 1024**3:.1f} GB)",
                  end="", file=sys.stderr, flush=True)
        try:
            dest = import_gguf(src, move=move, progress=_pct)
        except (ValueError, OSError) as e:
            sys.exit(f"[!] {e}")
        print("", file=sys.stderr)
        e = gguf_describe(dest)
        verdict, detail = gguf_fit_report(e)
        print(f":: added {e['name']} ({e['size_gb']:.1f} GB"
              + (f", {e['quant']}" if e["quant"] else "")
              + (f", MoE/{e['experts']} experts" if e["moe"] else "")
              + f") → {detail}", file=sys.stderr)
        print(f":: serve it with:  genesi-ai-turbo serve {dest}", file=sys.stderr)
        print(dest)
        return
    # AUTO spec: with nothing pinned, default to speculative decoding on a CUDA
    # build (it pays off there) and plain offload on Vulkan/NVK (where it can
    # regress). The draft is still dropped automatically if the target spills
    # VRAM, so this only ever engages when it can actually help.
    if not spec_pinned and backend_is_cuda():
        spec = True
    if action in ("bench", "serve"):
        if not rest:
            sys.exit(f"usage: genesi-ai-turbo {action} <model> [draft-model] [--spec]")
        if action == "bench":
            cmd_bench(rest[0], rest[1] if len(rest) > 1 else None)
        else:
            cmd_serve(rest[0], rest[1] if len(rest) > 1 else None, spec=spec)
    else:
        cmd_serve(action, rest[0] if rest else None, spec=spec)


if __name__ == "__main__":
    main()
