def _parse_json_fields(reply, names):
    """Pull the declared fields out of a model's reply, or None.

    Tolerant on the way in, strict on the way out. Small local models wrap JSON
    in a ```json fence, or bracket it with a sentence, no matter how firmly the
    prompt says not to — refusing those would make the feature feel broken for
    a mistake that costs nothing to forgive. What is NOT forgiven is a missing
    field: the declared outputs are a contract with every block downstream, and
    half of them silently empty is the failure mode this design exists to stop.
    """
    text = (reply or "").strip()
    if not text:
        return None
    # Drop a surrounding code fence, with or without a language tag.
    fence = re.match(r"^```[a-zA-Z]*\s*(.*?)\s*```$", text, re.S)
    if fence:
        text = fence.group(1).strip()
    # Otherwise take the first balanced object in the text.
    if not text.startswith("{"):
        start = text.find("{")
        if start < 0:
            return None
        depth = 0
        for i in range(start, len(text)):
            if text[i] == "{":
                depth += 1
            elif text[i] == "}":
                depth -= 1
                if depth == 0:
                    text = text[start:i + 1]
                    break
        else:
            return None
    try:
        obj = json.loads(text)
    except ValueError:
        return None
    if not isinstance(obj, dict):
        return None

    out = {}
    for name in names:
        if name not in obj:
            return None
        value = obj[name]
        if isinstance(value, bool):
            value = "true" if value else "false"
        elif isinstance(value, (list, dict)):
            value = json.dumps(value, ensure_ascii=False)
        out[name] = str(value)
    return out


# Comparisons a Condition node understands. There is no eval() here on purpose:
# this string arrives from a JSON file on disk, and eval would quietly turn
# "an automation" into "a way to run arbitrary Python at login".
_COND_OPS = ("<=", ">=", "!=", "==", "<", ">",
             " contains ", " startswith ", " endswith ", " matches ")
_TRUTHY = {"true", "1", "yes", "on", "ok", "sim"}


def _cond_eval(expr):
    """Evaluate a rendered condition string. Returns True/False."""
    text = (expr or "").strip()
    if not text:
        return False

    op = None
    for candidate in _COND_OPS:
        idx = text.find(candidate)
        if idx > 0:
            op, left, right = candidate.strip(), text[:idx], text[idx + len(candidate):]
            break
    if op is None:
        # No operator: treat the whole thing as a flag. This is what makes
        # "{{answer}}" work as a condition straight out of an AI block.
        return text.strip().strip('"').strip("'").lower() in _TRUTHY

    left = left.strip().strip('"').strip("'")
    right = right.strip().strip('"').strip("'")

    if op == "contains":
        return right.lower() in left.lower()
    if op == "startswith":
        return left.lower().startswith(right.lower())
    if op == "endswith":
        return left.lower().endswith(right.lower())
    if op == "matches":
        try:
            return re.search(right, left) is not None
        except re.error:
            return False

    # Numbers when both sides are numbers, text otherwise, so "cpu > 80" and
    # "status == running" both behave the way they read. A percent sign is
    # tolerated because a model asked for a CPU figure often answers "83%".
    def _num(value):
        try:
            return float(value.rstrip("% "))
        except (ValueError, AttributeError):
            return None

    lnum, rnum = _num(left), _num(right)
    if op == "==":
        return (lnum == rnum) if (lnum is not None and rnum is not None) \
            else left.lower() == right.lower()
    if op == "!=":
        return (lnum != rnum) if (lnum is not None and rnum is not None) \
            else left.lower() != right.lower()

    # Ordering needs NUMBERS on both sides. Falling back to comparing text
    # alphabetically looks tolerant and is a trap: "{{cpu}} > 80" where the AI
    # answered "quite high" would compare "quite high" > "80", which is true in
    # ASCII, and the automation would fire on an answer nobody could measure.
    # A comparison we cannot make is false — the automation stays quiet.
    if lnum is None or rnum is None:
        return False
    if op == ">":
        return lnum > rnum
    if op == ">=":
        return lnum >= rnum
    if op == "<":
        return lnum < rnum
    if op == "<=":
        return lnum <= rnum
    return False


# ── inotify (filesystem events), via ctypes — no third-party dep ──────────────
IN_MODIFY = 0x00000002
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_ISDIR = 0x40000000
_DIR_MASK = (IN_CREATE | IN_DELETE | IN_MODIFY | IN_MOVED_FROM
             | IN_MOVED_TO | IN_CLOSE_WRITE)
_EVENT_HDR = struct.Struct("iIII")        # wd, mask, cookie, len


class Inotify:
    """Minimal recursive inotify wrapper. Calls on_event(full_path, change,
    is_dir) where change is 'created' | 'modified' | 'deleted'. Falls back to a
    mtime poll if the kernel inotify syscalls aren't available."""

    def __init__(self, on_event):
        self.on_event = on_event
        self._wd_path = {}
        self._roots = {}                  # root -> recursive(bool)
        self._stop = threading.Event()
        self._libc = None
        self._fd = -1
        self._wake_r, self._wake_w = os.pipe()
        try:
            self._libc = ctypes.CDLL("libc.so.6", use_errno=True)
            self._fd = self._libc.inotify_init()
        except Exception:
            self._fd = -1

    @property
    def ok(self):
        return self._fd >= 0

    def add_root(self, path, recursive):
        path = os.path.abspath(os.path.expanduser(path))
        self._roots[path] = recursive
        if self._fd < 0 or not os.path.isdir(path):
            return
        self._watch_dir(path)
        if recursive:
            for cur, dirs, _files in os.walk(path):
                for d in dirs:
                    self._watch_dir(os.path.join(cur, d))

    def _watch_dir(self, path):
        try:
            wd = self._libc.inotify_add_watch(self._fd, path.encode(), _DIR_MASK)
            if wd >= 0:
                self._wd_path[wd] = path
        except Exception:
            pass

    def _recursive_root_for(self, path):
        for root, rec in self._roots.items():
            if rec and (path == root or path.startswith(root + os.sep)):
                return True
        return False

    def run(self):
        if self._fd < 0:
            self._poll_fallback()
            return
        while not self._stop.is_set():
            try:
                r, _w, _e = select.select([self._fd, self._wake_r], [], [], 1.0)
            except Exception:
                break
            if self._wake_r in r:
                try:
                    os.read(self._wake_r, 4096)
                except OSError:
                    pass
            if self._fd not in r:
                continue
            try:
                data = os.read(self._fd, 65536)
            except OSError:
                continue
            self._dispatch(data)

    def _dispatch(self, data):
        off = 0
        while off + _EVENT_HDR.size <= len(data):
            wd, mask, _cookie, nlen = _EVENT_HDR.unpack_from(data, off)
            off += _EVENT_HDR.size
            raw = data[off:off + nlen]
            off += nlen
            name = raw.split(b"\0", 1)[0].decode("utf-8", "replace")
            base = self._wd_path.get(wd)
            if base is None:
                continue
            full = os.path.join(base, name) if name else base
            is_dir = bool(mask & IN_ISDIR)
            # A brand-new subdirectory under a recursive root → start watching it.
            if is_dir and (mask & (IN_CREATE | IN_MOVED_TO)) and \
                    self._recursive_root_for(full):
                self._watch_dir(full)
            if mask & (IN_CREATE | IN_MOVED_TO):
                self.on_event(full, "created", is_dir)
            if mask & (IN_MODIFY | IN_CLOSE_WRITE):
                self.on_event(full, "modified", is_dir)
            if mask & (IN_DELETE | IN_MOVED_FROM):
                self.on_event(full, "deleted", is_dir)

    def _poll_fallback(self):
        """No kernel inotify: coarse mtime-diff poll of the watched roots."""
        seen = {}
        first = True
        while not self._stop.is_set():
            for root, rec in list(self._roots.items()):
                walk = os.walk(root) if rec else [(root, *_shallow(root))]
                try:
                    for cur, dirs, files in walk:
                        for nm in dirs + files:
                            p = os.path.join(cur, nm)
                            try:
                                m = os.stat(p).st_mtime
                            except OSError:
                                continue
                            prev = seen.get(p)
                            seen[p] = m
                            if first:
                                continue         # baseline pass: don't fire
                            if prev is None:
                                self.on_event(p, "created", os.path.isdir(p))
                            elif m != prev:
                                self.on_event(p, "modified", os.path.isdir(p))
                except OSError:
                    pass
            first = False
            self._stop.wait(2.0)

    def stop(self):
        self._stop.set()
        try:
            os.write(self._wake_w, b"x")
        except OSError:
            pass


def _shallow(root):
    try:
        entries = os.listdir(root)
    except OSError:
        return [], []
    dirs, files = [], []
    for e in entries:
        (dirs if os.path.isdir(os.path.join(root, e)) else files).append(e)
    return dirs, files


