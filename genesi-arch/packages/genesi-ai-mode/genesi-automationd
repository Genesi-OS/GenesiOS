# ── inotify (filesystem events), via ctypes — no third-party dep ──────────────
IN_MODIFY = 0x00000002
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_ISDIR = 0x40000000
_DIR_MASK = (IN_CREATE | IN_DELETE | IN_MODIFY | IN_MOVED_FROM
             | IN_MOVED_TO | IN_CLOSE_WRITE)
_EVENT_HDR = struct.Struct("iIII")        # wd, mask, cookie, len


class Inotify:
    """Minimal recursive inotify wrapper. Calls on_event(full_path, change,
    is_dir) where change is 'created' | 'modified' | 'deleted'. Falls back to a
    mtime poll if the kernel inotify syscalls aren't available."""

    def __init__(self, on_event):
        self.on_event = on_event
        self._wd_path = {}
        self._roots = {}                  # root -> recursive(bool)
        self._stop = threading.Event()
        self._libc = None
        self._fd = -1
        self._wake_r, self._wake_w = os.pipe()
        try:
            self._libc = ctypes.CDLL("libc.so.6", use_errno=True)
            self._fd = self._libc.inotify_init()
        except Exception:
            self._fd = -1

    @property
    def ok(self):
        return self._fd >= 0

    def add_root(self, path, recursive):
        path = os.path.abspath(os.path.expanduser(path))
        self._roots[path] = recursive
        if self._fd < 0 or not os.path.isdir(path):
            return
        self._watch_dir(path)
        if recursive:
            for cur, dirs, _files in os.walk(path):
                for d in dirs:
                    self._watch_dir(os.path.join(cur, d))

    def _watch_dir(self, path):
        try:
            wd = self._libc.inotify_add_watch(self._fd, path.encode(), _DIR_MASK)
            if wd >= 0:
                self._wd_path[wd] = path
        except Exception:
            pass

    def _recursive_root_for(self, path):
        for root, rec in self._roots.items():
            if rec and (path == root or path.startswith(root + os.sep)):
                return True
        return False

    def run(self):
        if self._fd < 0:
            self._poll_fallback()
            return
        while not self._stop.is_set():
            try:
                r, _w, _e = select.select([self._fd, self._wake_r], [], [], 1.0)
            except Exception:
                break
            if self._wake_r in r:
                try:
                    os.read(self._wake_r, 4096)
                except OSError:
                    pass
            if self._fd not in r:
                continue
            try:
                data = os.read(self._fd, 65536)
            except OSError:
                continue
            self._dispatch(data)

    def _dispatch(self, data):
        off = 0
        while off + _EVENT_HDR.size <= len(data):
            wd, mask, _cookie, nlen = _EVENT_HDR.unpack_from(data, off)
            off += _EVENT_HDR.size
            raw = data[off:off + nlen]
            off += nlen
            name = raw.split(b"\0", 1)[0].decode("utf-8", "replace")
            base = self._wd_path.get(wd)
            if base is None:
                continue
            full = os.path.join(base, name) if name else base
            is_dir = bool(mask & IN_ISDIR)
            # A brand-new subdirectory under a recursive root → start watching it.
            if is_dir and (mask & (IN_CREATE | IN_MOVED_TO)) and \
                    self._recursive_root_for(full):
                self._watch_dir(full)
            if mask & (IN_CREATE | IN_MOVED_TO):
                self.on_event(full, "created", is_dir)
            if mask & (IN_MODIFY | IN_CLOSE_WRITE):
                self.on_event(full, "modified", is_dir)
            if mask & (IN_DELETE | IN_MOVED_FROM):
                self.on_event(full, "deleted", is_dir)

    def _poll_fallback(self):
        """No kernel inotify: coarse mtime-diff poll of the watched roots."""
        seen = {}
        first = True
        while not self._stop.is_set():
            for root, rec in list(self._roots.items()):
                walk = os.walk(root) if rec else [(root, *_shallow(root))]
                try:
                    for cur, dirs, files in walk:
                        for nm in dirs + files:
                            p = os.path.join(cur, nm)
                            try:
                                m = os.stat(p).st_mtime
                            except OSError:
                                continue
                            prev = seen.get(p)
                            seen[p] = m
                            if first:
                                continue         # baseline pass: don't fire
                            if prev is None:
                                self.on_event(p, "created", os.path.isdir(p))
                            elif m != prev:
                                self.on_event(p, "modified", os.path.isdir(p))
                except OSError:
                    pass
            first = False
            self._stop.wait(2.0)

    def stop(self):
        self._stop.set()
        try:
            os.write(self._wake_w, b"x")
        except OSError:
            pass


def _shallow(root):
    try:
        entries = os.listdir(root)
    except OSError:
        return [], []
    dirs, files = [], []
    for e in entries:
        (dirs if os.path.isdir(os.path.join(root, e)) else files).append(e)
    return dirs, files


# ── evdev (global hotkeys), via struct — no third-party dep ───────────────────
# input_event: struct timeval (2×long), __u16 type, __u16 code, __s32 value.
_EV = struct.Struct("llHHi")
EV_KEY = 0x01

# Enough of linux/input-event-codes.h to name modifiers, letters, digits and the
# common non-printing keys people bind. Modifiers collapse to a side-agnostic name.
_KEYMAP = {
    1: "esc", 14: "backspace", 15: "tab", 28: "enter", 57: "space",
    58: "capslock", 111: "delete", 110: "insert",
    102: "home", 107: "end", 104: "pageup", 109: "pagedown",
    103: "up", 108: "down", 105: "left", 106: "right",
    12: "minus", 13: "equal", 26: "[", 27: "]", 39: ";", 40: "'",
    41: "`", 43: "\\", 51: ",", 52: ".", 53: "/",
    29: "ctrl", 97: "ctrl", 56: "alt", 100: "alt",
    42: "shift", 54: "shift", 125: "super", 126: "super",
}
for _c, _ch in zip(range(2, 12), "1234567890"):
    _KEYMAP[_c] = _ch
for _c, _ch in zip(range(16, 26), "qwertyuiop"):
    _KEYMAP[_c] = _ch
for _c, _ch in zip(range(30, 40), "asdfghjkl"):
    _KEYMAP[_c] = _ch
for _c, _ch in zip(range(44, 51), "zxcvbnm"):
    _KEYMAP[_c] = _ch
for _i in range(1, 11):                    # F1..F10 = 59..68
    _KEYMAP[58 + _i] = "f%d" % _i
_KEYMAP[87] = "f11"
_KEYMAP[88] = "f12"

_MOD_ORDER = ["ctrl", "alt", "shift", "super"]


def _canon_combo(names):
    """A set of key names → a stable 'ctrl+alt+a' string (mods first)."""
    names = set(names)
    mods = [m for m in _MOD_ORDER if m in names]
    rest = sorted(n for n in names if n not in _MOD_ORDER)
    return "+".join(mods + rest)


def _combo_keyset(combo):
    return frozenset(p.strip().lower() for p in str(combo).split("+") if p.strip())


class Hotkeys:
    """Reads every readable /dev/input/event* keyboard, tracks the pressed key
    set, and fires when a bound combo becomes fully pressed. Also serves a
    one-shot 'capture the next chord' request for the config UI. Degrades to a
    no-op (available=False) when /dev/input isn't readable (user not in the
    'input' group)."""

    def __init__(self, on_combo):
        self.on_combo = on_combo
        self.available = False
        self._stop = threading.Event()
        self._fds = []
        self._pressed = set()
        self._active = set()               # combos currently satisfied (debounce)
        self._combos = set()               # bound frozensets to match
        self._cap_lock = threading.Lock()
        self._cap_active = False
        self._cap_peak = set()
        self._cap_result = None
        self._cap_event = threading.Event()
        self.last_input = time.monotonic()   # for idle detection (any input resets)
        self._open()

    def idle_seconds(self):
        return time.monotonic() - self.last_input

    def _open(self):
        for path in sorted(globmod.glob("/dev/input/event*")):
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                self._fds.append(fd)
            except OSError:
                continue
        self.available = bool(self._fds)

    def reopen(self):
        """Re-scan /dev/input — lets the daemon pick up input access gained after
        it started (e.g. the user was just added to the 'input' group). Returns
        the new `available`."""
        for fd in self._fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self._fds = []
        self._pressed = set()
        self._open()
        return self.available

    def set_combos(self, combos):
        self._combos = {_combo_keyset(c) for c in combos if c}

    def capture(self, timeout=12.0):
        """Block up to `timeout`s for the user to press a chord, then return its
        canonical string once they RELEASE it (so 'ctrl', 'shift', 'ctrl+shift'
        and 'ctrl+shift+n' all work). "" on timeout / unavailable."""
        if not self.available:
            return ""
        with self._cap_lock:
            self._cap_active = True
            self._cap_peak = set()
            self._cap_result = None
            self._cap_event.clear()
        got = self._cap_event.wait(timeout)
        with self._cap_lock:
            self._cap_active = False
            return (self._cap_result or "") if got else ""

    def run(self):
        if not self._fds:
            return
        while not self._stop.is_set():
            try:
                r, _w, _e = select.select(self._fds, [], [], 1.0)
            except Exception:
                break
            for fd in r:
                self._drain(fd)

    def _drain(self, fd):
        try:
            data = os.read(fd, _EV.size * 64)
        except OSError:
            return
        if data:
            self.last_input = time.monotonic()   # any input (key/mouse) → not idle
        for off in range(0, len(data) - _EV.size + 1, _EV.size):
            _s, _us, etype, code, value = _EV.unpack_from(data, off)
            if etype != EV_KEY:
                continue
            name = _KEYMAP.get(code)
            if not name:
                continue
            if value == 1:                 # key down
                self._pressed.add(name)
                self._on_change(down=name)
            elif value == 0:               # key up
                self._pressed.discard(name)
                self._on_change(up=name)

    def _on_change(self, down=None, up=None):
        # Capture mode: accumulate the peak chord as keys go down, and only
        # finalize once EVERYTHING is released — so we never save a half-pressed
        # chord (e.g. just "ctrl" while the user is still reaching for "shift").
        # Modifier-only chords ("ctrl", "shift", "ctrl+shift") are allowed.
        with self._cap_lock:
            if self._cap_active:
                if down:
                    self._cap_peak.add(down)
                elif up and self._cap_peak and not self._pressed:
                    self._cap_result = _canon_combo(self._cap_peak)
                    self._cap_active = False
                    self._cap_event.set()
                return
        pressed = frozenset(self._pressed)
        for combo in self._combos:
            if combo <= pressed:
                if combo not in self._active:
                    self._active.add(combo)
                    self.on_combo(_canon_combo(combo))
            else:
                self._active.discard(combo)

    def stop(self):
        self._stop.set()
        for fd in self._fds:
            try:
                os.close(fd)
            except OSError:
                pass


# ── status / logs the GUI reads ───────────────────────────────────────────────
class Status:
    def __init__(self):
        self._lock = threading.Lock()
        self._autos = {}                   # id -> {name,enabled,state,running,lastRun,log[]}
        self._hotkey_ok = False
        os.makedirs(STATE_DIR, exist_ok=True)

    def set_hotkey(self, ok):
        with self._lock:
            self._hotkey_ok = ok
        self._flush()

    def sync(self, autos):
        """Reconcile the tracked set with the loaded automations."""
        with self._lock:
            for aid, a in autos.items():
                cur = self._autos.setdefault(aid, {"log": []})
                cur["name"] = a.get("name", aid)
                cur["enabled"] = bool(a.get("enabled"))
                cur.setdefault("running", False)
                cur.setdefault("lastRun", 0)
                cur.setdefault("pending", [])
                cur["state"] = "listening" if a.get("enabled") else "disabled"
            for aid in list(self._autos):
                if aid not in autos:
                    self._autos.pop(aid, None)
        self._flush()

    def log(self, aid, line, level="out"):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["log"].append({"ts": _now(), "line": line, "level": level})
            if len(cur["log"]) > LOG_KEEP:
                cur["log"] = cur["log"][-LOG_KEEP:]
        self._flush()

    def state(self, aid, state, running=None):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["state"] = state
            if running is not None:
                cur["running"] = running
            if state == "running":
                cur["lastRun"] = _now()
        self._flush()

    def set_pending(self, aid, items):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["pending"] = items
        self._flush()

    def _flush(self):
        try:
            payload = {"updated": _now(), "hotkeyAvailable": self._hotkey_ok,
                       "automations": self._autos}
            tmp = STATUS_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(payload, fh, ensure_ascii=False)
            os.replace(tmp, STATUS_FILE)
        except OSError:
            pass


# ── the engine: run an action chain reachable from a fired event node ─────────
class Engine:
    def __init__(self, status):
        self.status = status
        self._tools = LocalToolExecutor() if _AGENT_OK else None
        self.approve = None                # set by Daemon: approve(aid, action)->bool

    def run_chain(self, auto, start_id, detail):
        aid = auto["id"]
        nodes = {n.get("id"): n for n in auto.get("nodes", [])}
        outgoing = {}
        for link in auto.get("links", []):
            outgoing.setdefault(link.get("from"), []).append(link.get("to"))

        # Reachable action nodes from the trigger (BFS), then topological order.
        reachable, pending = set(), list(outgoing.get(start_id, []))
        while pending:
            nid = pending.pop(0)
            if nid in reachable:
                continue
            reachable.add(nid)
            pending.extend(outgoing.get(nid, []))
        sequence = self._topo(auto, reachable)
        if not sequence:
            return

        self.status.state(aid, "running", running=True)
        self.status.log(aid, "▶ triggered — " + (detail or "event"), "step")
        try:
            for node in sequence:
                if node.get("kind") not in ACTION_KINDS:
                    continue
                self._run_action(auto, node)
        finally:
            self.status.state(aid, "listening" if auto.get("enabled") else "idle",
                              running=False)
            self.status.log(aid, "✓ finished", "ok")

    def _topo(self, auto, keep):
        nodes = {n.get("id"): n for n in auto.get("nodes", []) if n.get("id") in keep}
        indeg = {nid: 0 for nid in nodes}
        out = {nid: [] for nid in nodes}
        for link in auto.get("links", []):
            a, b = link.get("from"), link.get("to")
            if a in nodes and b in nodes:
                out[a].append(b)
                indeg[b] += 1
        queue = [nid for nid in nodes if indeg[nid] == 0]
        order = []
        while queue:
            nid = queue.pop(0)
            order.append(nodes[nid])
            for t in out[nid]:
                indeg[t] -= 1
                if indeg[t] == 0:
                    queue.append(t)
        return order if len(order) == len(nodes) else list(nodes.values())

    # -- action executors --------------------------------------------------
    def _run_action(self, auto, node):
        aid = auto["id"]
        kind = node.get("kind")
        cfg = node.get("config", {}) or {}
        title = node.get("title", kind)
        try:
            if kind == "act_script":
                self._act_script(aid, cfg, title)
            elif kind == "act_notify":
                self._act_notify(aid, cfg)
            elif kind == "act_ai":
                self._act_ai(aid, cfg, title)
            elif kind == "act_http":
                self._act_http(aid, cfg)
            elif kind == "act_file":
                self._act_file(aid, cfg)
            elif kind == "act_app":
                self._act_app(aid, cfg)
            elif kind == "act_sound":
                self._act_sound(aid, cfg)
            elif kind == "act_power":
                self._act_power(aid, cfg)
        except Exception as exc:
            self.status.log(aid, "%s: %s" % (title, exc), "err")

    def _act_script(self, aid, cfg, title):
        command = (cfg.get("command") or "").strip()
        if not command:
            self.status.log(aid, "script: empty command — skipped", "out")
            return
        self.status.log(aid, "$ " + command.splitlines()[0], "cmd")
        try:
            proc = subprocess.run(["/bin/sh", "-lc", command], capture_output=True,
                                  text=True, timeout=float(cfg.get("timeout", 300)))
        except subprocess.TimeoutExpired:
            self.status.log(aid, "script timed out", "err")
            return
        for line in (proc.stdout or "").splitlines()[-20:]:
            self.status.log(aid, line, "out")
        for line in (proc.stderr or "").splitlines()[-10:]:
            self.status.log(aid, line, "err")
        self.status.log(aid, "script exit %d" % proc.returncode,
                        "ok" if proc.returncode == 0 else "err")

    def _act_notify(self, aid, cfg):
        title = cfg.get("title") or "Genesi Automation"
        body = cfg.get("body") or ""
        if not shutil.which("notify-send"):
            self.status.log(aid, "notify: notify-send missing", "err")
            return
        try:
            subprocess.Popen(["notify-send", "--app-name=Genesi Automation",
                              title, body],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.status.log(aid, "🔔 " + title, "ok")
        except OSError as exc:
            self.status.log(aid, "notify failed: %s" % exc, "err")

    def _act_http(self, aid, cfg):
        url = (cfg.get("url") or "").strip()
        if not url:
            self.status.log(aid, "http: no URL — skipped", "out")
            return
        method = (cfg.get("method") or "GET").upper()
        body = cfg.get("body") or ""
        data = body.encode() if (body and method != "GET") else None
        headers = {"Content-Type": "application/json"} if data else {}
        try:
            req = urllib.request.Request(url, data=data, headers=headers, method=method)
            with urllib.request.urlopen(req, timeout=30) as r:
                self.status.log(aid, "%s %s → %s" % (method, url[:60], r.status), "ok")
        except Exception as exc:
            self.status.log(aid, "http failed: %s" % exc, "err")

    def _act_file(self, aid, cfg):
        import shutil as _sh
        op = cfg.get("op", "copy")
        src = os.path.expanduser(cfg.get("src", "") or "")
        dest = os.path.expanduser(cfg.get("dest", "") or "")
        try:
            if op == "copy" and src and dest:
                _sh.copy2(src, dest); self.status.log(aid, "copied → " + dest, "ok")
            elif op == "move" and src and dest:
                _sh.move(src, dest); self.status.log(aid, "moved → " + dest, "ok")
            elif op == "delete" and src:
                if os.path.isdir(src):
                    _sh.rmtree(src)
                else:
                    os.remove(src)
                self.status.log(aid, "deleted " + src, "ok")
            elif op == "mkdir" and (dest or src):
                os.makedirs(dest or src, exist_ok=True)
                self.status.log(aid, "created dir " + (dest or src), "ok")
            else:
                self.status.log(aid, "file: nothing to do", "out")
        except Exception as exc:
            self.status.log(aid, "file %s failed: %s" % (op, exc), "err")

    def _act_app(self, aid, cfg):
        op = cfg.get("op", "launch")
        app = (cfg.get("app") or "").strip()
        if not app:
            self.status.log(aid, "app: none set — skipped", "out")
            return
        try:
            if op == "launch":
                subprocess.Popen(["/bin/sh", "-lc", app],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                self.status.log(aid, "launched " + app, "ok")
            else:
                subprocess.run(["pkill", "-f", app], check=False)
                self.status.log(aid, "closed " + app, "ok")
        except OSError as exc:
            self.status.log(aid, "app %s failed: %s" % (op, exc), "err")

    def _act_sound(self, aid, cfg):
        sound = os.path.expanduser(cfg.get("sound", "") or "")
        players = []
        if sound:
            for tool in ("paplay", "aplay", "ffplay", "mpv"):
                if shutil.which(tool):
                    players.append([tool, sound] if tool != "ffplay"
                                   else [tool, "-autoexit", "-nodisp", sound])
                    break
        elif shutil.which("canberra-gtk-play"):
            players.append(["canberra-gtk-play", "-i", "message"])
        if not players:
            self.status.log(aid, "sound: no player (install pulseaudio/libcanberra)", "err")
            return
        try:
            subprocess.Popen(players[0], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            self.status.log(aid, "🔊 played sound", "ok")
        except OSError as exc:
            self.status.log(aid, "sound failed: %s" % exc, "err")

    def _act_power(self, aid, cfg):
        op = cfg.get("op", "lock")
        cmds = {
            "lock": ["loginctl", "lock-session"],
            "suspend": ["systemctl", "suspend"],
            "hibernate": ["systemctl", "hibernate"],
            "shutdown": ["systemctl", "poweroff"],
            "reboot": ["systemctl", "reboot"],
            "logout": ["loginctl", "terminate-user", os.environ.get("USER", "")],
        }
        cmd = cmds.get(op)
        if not cmd:
            self.status.log(aid, "power: unknown op " + op, "err")
            return
        # Prefer loginctl lock via a few fallbacks (compositor-agnostic).
        if op == "lock" and not shutil.which("loginctl"):
            for alt in (["xdg-screensaver", "lock"], ["swaylock"], ["hyprlock"]):
                if shutil.which(alt[0]):
                    cmd = alt
                    break
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.status.log(aid, "power: " + op, "ok")
        except OSError as exc:
            self.status.log(aid, "power %s failed: %s" % (op, exc), "err")

    def _act_ai(self, aid, cfg, title):
        if not _AGENT_OK:
            self.status.log(aid, "AI action unavailable (agent lib missing)", "err")
            return
        prompt = (cfg.get("prompt") or "").strip()
        if not prompt:
            self.status.log(aid, "AI: empty prompt — skipped", "out")
            return
        model = cfg.get("model") or ""
        want_turbo = bool(cfg.get("turbo"))
        spec = bool(cfg.get("spec"))
        # 3-way execution mode; back-compat with the old `autonomous` bool.
        exec_mode = cfg.get("exec") or ("auto" if cfg.get("autonomous") else "advisory")
        if exec_mode not in ("advisory", "ask", "auto"):
            exec_mode = "advisory"

        if cfg.get("aiMode"):
            _run(["genesi-ai-mode", "on"])
            self.status.log(aid, "AI Mode → on", "out")

        use_turbo = False
        if want_turbo:
            self.status.log(aid, "ensuring Turbo on %s…" % (model or "?"), "out")
            ok, msg = turbo_ctl.ensure(
                model, spec, on_status=lambda m: self.status.log(aid, m, "out"))
            self.status.log(aid, msg, "ok" if ok else "err")
            use_turbo = ok
        else:
            _ensure_ollama()

        label = {"auto": "autonomous", "ask": "with approval"}.get(exec_mode, "advisory")
        self.status.log(aid, "🤖 %s (%s)" % (title, label), "step")
        try:
            reply = self._ai_run(model, prompt, exec_mode, use_turbo, aid)
        except Exception as exc:
            self.status.log(aid, "AI error: %s" % exc, "err")
            return
        # Surface the assistant's final words in the log; an advisory block also
        # notifies (it takes no action, so the answer is the whole point).
        if reply:
            for line in reply.splitlines()[-8:]:
                self.status.log(aid, line, "out")
            if exec_mode == "advisory" and shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "--app-name=Genesi AI",
                                  title or "Genesi AI", reply[:400]],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)

    def _ai_chat(self, model, messages, use_turbo, system=None):
        msgs = ([{"role": "system", "content": system}] if system else []) + messages
        if use_turbo:
            body = json.dumps({"messages": msgs, "stream": False,
                               "max_tokens": 768, "cache_prompt": True}).encode()
            req = _request(TURBO + "/v1/chat/completions", body)
            obj = json.loads(_urlread(req, timeout=900))
            choices = obj.get("choices") or []
            return (choices[0].get("message") or {}).get("content", "") if choices else ""
        body = json.dumps({"model": model, "messages": msgs, "stream": False,
                           "keep_alive": "15m"}).encode()
        req = _request(OLLAMA + "/api/chat", body)
        obj = json.loads(_urlread(req, timeout=900))
        return (obj.get("message") or {}).get("content", "")

    def _ai_run(self, model, prompt, mode, use_turbo, aid):
        # Advisory: a single plain answer (no tools, no side effects).
        if mode == "advisory":
            return self._ai_chat(model, [{"role": "user", "content": prompt}],
                                 use_turbo).strip()
        # auto / ask: the bounded tool loop, mirroring the Monitor's agent but
        # headless. In "auto" every action runs; in "ask" each action waits for the
        # user's Approve/Deny (via self.approve, a 5-min gate). Bounded to 6 steps.
        messages = [{"role": "user", "content": prompt}]
        system = agent_system_prompt()
        seen = {}
        for _step in range(6):
            response = self._ai_chat(model, messages, use_turbo, system=system).strip()
            action = parse_agent_action(response)
            if not action:
                if looks_like_agent_action(response):
                    messages.append({"role": "assistant", "content": response})
                    messages.append({"role": "user", "content":
                                     "Your tool call was malformed. Return one valid JSON action."})
                    continue
                return response
            fp = json.dumps({"tool": action["tool"], "arguments": action["arguments"]},
                            sort_keys=True, ensure_ascii=True)
            if fp in seen:
                return summarize_tool_result(action["tool"], seen[fp])
            if mode == "ask" and self.approve is not None:
                if not self.approve(aid, action):
                    self.status.log(aid, "✗ denied: %s" % action["tool"], "err")
                    messages.append({"role": "assistant", "content": response})
                    messages.append({"role": "user", "content": "GENESI_TOOL_RESULT\n" +
                                     json.dumps({"ok": False, "error": "The user denied this action."})})
                    continue
            self.status.log(aid, "→ %s" % action["tool"], "cmd")
            result = self._tools.execute(action["tool"], action["arguments"])
            seen[fp] = result
            self.status.log(aid, summarize_tool_result(action["tool"], result),
                            "ok" if result.get("ok") else "err")
            messages.append({"role": "assistant", "content": response})
            messages.append({"role": "user", "content":
                             "GENESI_TOOL_RESULT\n" + json.dumps(result, ensure_ascii=False)})
        return "Stopped after 6 actions."


# ── small HTTP + process helpers ──────────────────────────────────────────────
def _request(url, body):
    return urllib.request.Request(url, data=body,
                                  headers={"Content-Type": "application/json"})


def _urlread(req, timeout=60):
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode()


def _run(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def _ensure_ollama():
    try:
        urllib.request.urlopen(OLLAMA + "/api/tags", timeout=2).read()
        return True
    except Exception:
        pass
    if not shutil.which("ollama"):
        return False
    _run(["systemctl", "start", "ollama"])
    try:
        subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError:
        pass
    for _ in range(10):
        try:
            urllib.request.urlopen(OLLAMA + "/api/tags", timeout=2).read()
            return True
        except Exception:
            time.sleep(1)
    return False


# ── the daemon supervisor ─────────────────────────────────────────────────────
class Daemon:
    def __init__(self):
        self.status = Status()
        self.engine = Engine(self.status)
        self.engine.approve = self._approval_gate
        self.autos = {}                    # id -> automation dict
        self.lock = threading.Lock()
        self._pending = {}                 # req_id -> {event, approved} (AI "ask")
        self._pending_lock = threading.Lock()
        self._fired_once = set()           # (aid, nid) once-nodes already fired
        # poll-loop memory
        self._res_prev = {}                # (aid,nid) -> bool satisfied
        self._app_prev = set()             # process names seen last tick
        self._app_primed = False           # skip firing on the first app snapshot
        self._sched_prev = {}              # (aid,nid) -> monotonic/date marker
        self._edge = {}                    # (aid,nid) -> bool, generic edge memory
        self._snap = {}                    # (aid,nid) -> set/str, diff snapshots
        self._offset = {}                  # (aid,nid) -> int, evt_log file offset
        self._cmd_next = {}                # (aid,nid) -> monotonic throttle marker
        self._proc_cache = {}              # pid -> psutil.Process (cpu% continuity)
        self._startup_done = set()         # (aid,nid) evt_startup already fired
        self._usb_primed = False
        self._mount_primed = False
        self._bt_primed = False
        # watchers
        self._inotify = None
        self._hotkeys = None
        self._hk_started = False           # evdev reader thread running?
        self._fs_nodes = []                # [(auto, node)]
        self._hotkey_nodes = []            # [(auto, node, combo)]
        self._stop = threading.Event()

    # -- store -------------------------------------------------------------
    def load(self):
        autos = {}
        os.makedirs(CONFIG_DIR, exist_ok=True)
        for path in globmod.glob(os.path.join(CONFIG_DIR, "*.json")):
            try:
                with open(path, encoding="utf-8") as fh:
                    a = json.load(fh)
            except (OSError, ValueError):
                continue
            aid = a.get("id") or os.path.splitext(os.path.basename(path))[0]
            a["id"] = aid
            autos[aid] = a
        with self.lock:
            self.autos = autos
            # Re-arm "once" nodes for automations that are currently disabled or
            # gone, so toggling one off then on lets it fire again.
            enabled_ids = {aid for aid, a in autos.items() if a.get("enabled")}
            self._fired_once = {k for k in self._fired_once if k[0] in enabled_ids}
        self.status.sync(autos)
        self._rearm()
        self._fire_startup()

    def _fire_startup(self):
        """Fire evt_startup nodes once per daemon session (on first load / login)."""
        with self.lock:
            enabled = [a for a in self.autos.values() if a.get("enabled")]
        for a in enabled:
            for n in a.get("nodes", []):
                if n.get("kind") != "evt_startup":
                    continue
                key = (a["id"], n.get("id"))
                if key in self._startup_done:
                    continue
                self._startup_done.add(key)
                self._fire(a, n, "startup")

    def _rearm(self):
        """(Re)build the watcher registries from the enabled automations."""
        with self.lock:
            enabled = [a for a in self.autos.values() if a.get("enabled")]
        # filesystem
        if self._inotify:
            self._inotify.stop()
        self._fs_nodes = []
        self._inotify = Inotify(self._on_fs_event)
        for a in enabled:
            for n in a.get("nodes", []):
                if n.get("kind") == "evt_fs":
                    cfg = n.get("config", {}) or {}
                    p = cfg.get("path") or ""
                    if p:
                        self._fs_nodes.append((a, n))
                        self._inotify.add_root(p, bool(cfg.get("recursive")))
        threading.Thread(target=self._inotify.run, daemon=True).start()
        # hotkeys
        self._hotkey_nodes = []
        combos = []
        for a in enabled:
            for n in a.get("nodes", []):
                if n.get("kind") == "evt_hotkey":
                    combo = (n.get("config", {}) or {}).get("combo") or ""
                    if combo:
                        self._hotkey_nodes.append((a, n, _combo_keyset(combo)))
                        combos.append(combo)
        if self._hotkeys:
            self._hotkeys.set_combos(combos)

    # -- firing ------------------------------------------------------------
    def _fire(self, auto, node, detail):
        aid, nid = auto["id"], node.get("id")
        mode = (node.get("config", {}) or {}).get("mode", "always")
        key = (aid, nid)
        if mode == "once":
            with self.lock:
                if key in self._fired_once:
                    return
                self._fired_once.add(key)
        threading.Thread(target=self.engine.run_chain,
                         args=(auto, nid, detail), daemon=True).start()

    def _approval_gate(self, aid, action):
        """Block the AI-block worker until the user approves/denies a proposed
        action in the Monitor (or 5 min elapses → deny). Publishes the request in
        status.json (the GUI renders Approve/Deny) and pings a notification."""
        req_id = uuid.uuid4().hex[:12]
        entry = {"event": threading.Event(), "approved": False}
        with self._pending_lock:
            self._pending[req_id] = entry
        tool = action.get("tool", "action")
        self.status.set_pending(aid, [{"id": req_id, "tool": tool,
                                       "reason": action.get("reason", ""),
                                       "title": tool}])
        if shutil.which("notify-send"):
            try:
                subprocess.Popen(
                    ["notify-send", "--app-name=Genesi AI", "--urgency=critical",
                     "Automation needs approval",
                     "The AI wants to run: %s — open the Monitor to approve." % tool],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    start_new_session=True)
            except OSError:
                pass
        ok = entry["event"].wait(300)
        with self._pending_lock:
            self._pending.pop(req_id, None)
        self.status.set_pending(aid, [])
        return bool(ok and entry["approved"])

    # -- filesystem --------------------------------------------------------
    def _on_fs_event(self, full, change, is_dir):
        for auto, node in list(self._fs_nodes):
            cfg = node.get("config", {}) or {}
            root = os.path.abspath(os.path.expanduser(cfg.get("path", "")))
            if not (full == root or full.startswith(root + os.sep)):
                continue
            if not cfg.get("recursive") and os.path.dirname(full) != root:
                continue
            want = cfg.get("change", "any")
            if want not in ("any", change):
                continue
            pattern = cfg.get("pattern") or "*"
            if pattern != "*" and not fnmatch.fnmatch(os.path.basename(full), pattern):
                continue
            self._fire(auto, node, "%s %s: %s" %
                       ("folder" if is_dir else "file", change, os.path.basename(full)))

    # -- hotkeys -----------------------------------------------------------
    def _on_combo(self, combo_str):
        keyset = _combo_keyset(combo_str)
        for auto, node, ks in list(self._hotkey_nodes):
            if ks == keyset:
                self._fire(auto, node, "hotkey " + combo_str)

    # -- resource / app / schedule poll -----------------------------------
    def _poll_loop(self):
        if psutil:
            psutil.cpu_percent(interval=None)   # prime
        tick = 0
        while not self._stop.is_set():
            try:
                self._poll_once()
            except Exception:
                pass
            tick += 1
            # Every ~10s, if hotkeys still have no input access, try again — the
            # user may have just been added to the 'input' group.
            if tick % 5 == 0 and self._hotkeys and not self._hotkeys.available:
                if self._hotkeys.reopen():
                    self.status.set_hotkey(True)
                    self._start_hotkey_reader()
            self._stop.wait(POLL_SECONDS)

    def _start_hotkey_reader(self):
        if self._hk_started or not (self._hotkeys and self._hotkeys.available):
            return
        self._hk_started = True
        threading.Thread(target=self._hotkeys.run, daemon=True).start()

    def _edge_fire(self, auto, node, satisfied, detail):
        """Fire when a boolean condition crosses from false → true (edge)."""
        key = (auto["id"], node.get("id"))
        prev = self._edge.get(key, False)
        self._edge[key] = satisfied
        if satisfied and not prev:
            self._fire(auto, node, detail)

    def _poll_once(self):
        with self.lock:
            enabled = [a for a in self.autos.values() if a.get("enabled")]
        kinds = set()
        for a in enabled:
            for n in a.get("nodes", []):
                kinds.add(n.get("kind"))

        # Cheap globals (always safe/fast).
        cpu = psutil.cpu_percent(interval=None) if psutil else None
        ram = psutil.virtual_memory().percent if psutil else None
        appset = set()
        if psutil and ("evt_app" in kinds):
            for pr in psutil.process_iter(["name"]):
                nm = (pr.info.get("name") or "").lower()
                if nm:
                    appset.add(nm)

        # Heavier globals — only when a node needs them.
        batt = (psutil.sensors_battery() if (psutil and "evt_power" in kinds
                and hasattr(psutil, "sensors_battery")) else None)
        online = self._net_online() if "evt_network" in kinds else None
        usbset = self._usb_set() if "evt_usb" in kinds else None
        mountset = self._mount_set() if "evt_disk" in kinds else None
        btset = self._bt_set() if "evt_bluetooth" in kinds else None

        for a in enabled:
            for n in a.get("nodes", []):
                k = n.get("kind")
                try:
                    if k == "evt_resource":
                        self._poll_resource(a, n, cpu, ram)
                    elif k == "evt_app" and self._app_primed:
                        self._poll_app(a, n, appset)
                    elif k == "evt_schedule":
                        self._poll_schedule(a, n)
                    elif k == "evt_power":
                        self._poll_power(a, n, batt)
                    elif k == "evt_temperature":
                        self._poll_temp(a, n)
                    elif k == "evt_disk":
                        self._poll_disk(a, n, mountset)
                    elif k == "evt_usb" and self._usb_primed:
                        self._poll_usb(a, n, usbset)
                    elif k == "evt_network":
                        self._poll_network(a, n, online)
                    elif k == "evt_process":
                        self._poll_process(a, n)
                    elif k == "evt_idle":
                        self._poll_idle(a, n)
                    elif k == "evt_log":
                        self._poll_log(a, n)
                    elif k == "evt_command":
                        self._poll_command(a, n)
                    elif k == "evt_bluetooth" and self._bt_primed:
                        self._poll_bluetooth(a, n, btset)
                except Exception:
                    pass

        self._app_prev = appset
        self._app_primed = True
        if usbset is not None:
            self._usb_primed = True
        if mountset is not None:
            self._mount_primed = True
        if btset is not None:
            self._bt_primed = True
        if len(self._proc_cache) > 500:
            self._proc_cache = {}

    def _poll_resource(self, auto, node, cpu, ram):
        cfg = node.get("config", {}) or {}
        metric = cfg.get("metric", "cpu")
        value = cpu if metric == "cpu" else ram
        if value is None:
            return
        try:
            thr = float(cfg.get("threshold", 80))
        except (TypeError, ValueError):
            thr = 80.0
        op = cfg.get("op", ">")
        satisfied = value > thr if op == ">" else value < thr
        key = (auto["id"], node.get("id"))
        prev = self._res_prev.get(key, False)
        self._res_prev[key] = satisfied
        if satisfied and not prev:          # edge trigger
            self._fire(auto, node, "%s %s %.0f%% (now %.0f%%)" %
                       (metric.upper(), op, thr, value))

    def _poll_app(self, auto, node, appset):
        if not self._app_prev and not appset:
            return
        cfg = node.get("config", {}) or {}
        name = (cfg.get("app") or "").lower().strip()
        if not name:
            return
        trans = cfg.get("transition", "opened")
        was = any(name in n for n in self._app_prev)
        now = any(name in n for n in appset)
        if trans == "opened" and now and not was:
            self._fire(auto, node, "app opened: " + name)
        elif trans == "closed" and was and not now:
            self._fire(auto, node, "app closed: " + name)

    def _poll_schedule(self, auto, node):
        cfg = node.get("config", {}) or {}
        key = (auto["id"], node.get("id"))
        at = (cfg.get("time") or "").strip()
        if at and ":" in at:                # HH:MM daily
            today = time.strftime("%Y-%m-%d")
            if time.strftime("%H:%M") == at and self._sched_prev.get(key) != today:
                self._sched_prev[key] = today
                self._fire(auto, node, "scheduled " + at)
            return
        try:
            minutes = max(0.1, float(cfg.get("interval", 60)))
        except (TypeError, ValueError):
            minutes = 60.0
        last = self._sched_prev.get(key)
        now = time.monotonic()
        if last is None:
            self._sched_prev[key] = now
        elif now - last >= minutes * 60:
            self._sched_prev[key] = now
            self._fire(auto, node, "every %g min" % minutes)

    # -- power / battery ---------------------------------------------------
    def _poll_power(self, auto, node, batt):
        cfg = node.get("config", {}) or {}
        ev = cfg.get("event", "on_battery")
        plugged = True if batt is None else bool(batt.power_plugged)
        pct = None if batt is None else batt.percent
        if ev == "on_ac":
            self._edge_fire(auto, node, plugged, "AC plugged in")
        elif ev == "on_battery":
            self._edge_fire(auto, node, not plugged, "on battery")
        elif ev in ("battery_below", "battery_above") and pct is not None:
            try:
                level = float(cfg.get("level", 20))
            except (TypeError, ValueError):
                level = 20.0
            sat = pct < level if ev == "battery_below" else pct > level
            self._edge_fire(auto, node, sat, "battery %.0f%% %s %.0f%%" %
                            (pct, "<" if ev == "battery_below" else ">", level))

    # -- temperature -------------------------------------------------------
    def _poll_temp(self, auto, node):
        if not (psutil and hasattr(psutil, "sensors_temperatures")):
            return
        cfg = node.get("config", {}) or {}
        want = (cfg.get("sensor") or "").lower().strip()
        try:
            thr = float(cfg.get("threshold", 80))
        except (TypeError, ValueError):
            thr = 80.0
        hottest = None
        try:
            temps = psutil.sensors_temperatures()
        except Exception:
            return
        for chip, entries in (temps or {}).items():
            for e in entries:
                label = ((e.label or "") + " " + chip).lower()
                if want and want not in label:
                    continue
                if e.current is not None:
                    hottest = e.current if hottest is None else max(hottest, e.current)
        if hottest is None:
            return
        self._edge_fire(auto, node, hottest > thr,
                        "temp %.0f°C > %.0f°C" % (hottest, thr))

    # -- disk (usage threshold / mount / unmount) --------------------------
    def _mount_set(self):
        if not psutil:
            return set()
        try:
            return {p.mountpoint for p in psutil.disk_partitions(all=False)}
        except Exception:
            return set()

    def _poll_disk(self, auto, node, mountset):
        cfg = node.get("config", {}) or {}
        ev = cfg.get("event", "usage_above")
        if ev == "usage_above":
            if not psutil:
                return
            path = cfg.get("path") or "/"
            try:
                thr = float(cfg.get("threshold", 90))
                pct = psutil.disk_usage(os.path.expanduser(path)).percent
            except Exception:
                return
            self._edge_fire(auto, node, pct > thr,
                            "disk %s %.0f%% > %.0f%%" % (path, pct, thr))
            return
        if mountset is None:
            return
        key = (auto["id"], node.get("id"))
        prev = self._snap.get(key, set())
        self._snap[key] = mountset
        if not self._mount_primed:
            return
        if ev == "mounted":
            for m in sorted(mountset - prev):
                self._fire(auto, node, "mounted: " + m)
        elif ev == "unmounted":
            for m in sorted(prev - mountset):
                self._fire(auto, node, "unmounted: " + m)

    # -- USB device add / remove ------------------------------------------
    def _usb_set(self):
        if shutil.which("lsusb"):
            try:
                out = subprocess.run(["lsusb"], capture_output=True, text=True,
                                     timeout=5).stdout
                return {ln.strip() for ln in out.splitlines() if ln.strip()}
            except Exception:
                pass
        # Fallback: /sys entries that are real devices (N-N, not hubs/ifaces).
        found = set()
        for p in globmod.glob("/sys/bus/usb/devices/*"):
            b = os.path.basename(p)
            if re.match(r"^\d+-\d+(\.\d+)*$", b):
                found.add(b)
        return found

    def _poll_usb(self, auto, node, usbset):
        if usbset is None:
            return
        cfg = node.get("config", {}) or {}
        action = cfg.get("action", "added")
        key = (auto["id"], node.get("id"))
        prev = self._snap.get(key, set())
        self._snap[key] = usbset
        added = usbset - prev
        removed = prev - usbset
        if action == "added":
            for d in sorted(added):
                self._fire(auto, node, "USB added: " + d[-40:])
        elif action == "removed":
            for d in sorted(removed):
                self._fire(auto, node, "USB removed: " + d[-40:])

    # -- network online/offline, interface up/down ------------------------
    def _net_online(self):
        try:
            s = socket.create_connection(("1.1.1.1", 53), timeout=1.5)
            s.close()
            return True
        except OSError:
            return False

    def _poll_network(self, auto, node, online):
        cfg = node.get("config", {}) or {}
        ev = cfg.get("event", "online")
        if ev in ("online", "offline"):
            if online is None:
                return
            self._edge_fire(auto, node, online if ev == "online" else not online,
                            "internet " + ("online" if ev == "online" else "offline"))
        elif ev in ("iface_up", "iface_down") and psutil:
            iface = (cfg.get("iface") or "").strip()
            try:
                stats = psutil.net_if_stats()
            except Exception:
                return
            up = bool(stats.get(iface).isup) if iface in stats else False
            self._edge_fire(auto, node, up if ev == "iface_up" else not up,
                            "%s %s" % (iface, "up" if ev == "iface_up" else "down"))

    # -- a named process over a CPU% / RAM threshold ----------------------
    def _poll_process(self, auto, node):
        if not psutil:
            return
        cfg = node.get("config", {}) or {}
        name = (cfg.get("app") or "").lower().strip()
        if not name:
            return
        metric = cfg.get("metric", "mem")
        try:
            thr = float(cfg.get("threshold", 1000))
        except (TypeError, ValueError):
            thr = 1000.0
        total = 0.0
        for pr in psutil.process_iter(["pid", "name"]):
            nm = (pr.info.get("name") or "").lower()
            if name not in nm:
                continue
            try:
                if metric == "cpu":
                    pid = pr.info["pid"]
                    p = self._proc_cache.get(pid)
                    if p is None:
                        p = pr
                        self._proc_cache[pid] = p
                    total += p.cpu_percent(None)
                else:
                    total += pr.memory_info().rss / (1024.0 * 1024.0)
            except Exception:
                continue
        unit = "%" if metric == "cpu" else "MB"
        self._edge_fire(auto, node, total > thr,
                        "%s %s %.0f%s > %.0f%s" % (name, metric, total, unit, thr, unit))

    # -- user idle / active (from the evdev last-input clock) --------------
    def _poll_idle(self, auto, node):
        if not (self._hotkeys and self._hotkeys.available):
            return
        cfg = node.get("config", {}) or {}
        try:
            mins = float(cfg.get("minutes", 5))
        except (TypeError, ValueError):
            mins = 5.0
        idle = self._hotkeys.idle_seconds()
        is_idle = idle >= mins * 60
        ev = cfg.get("event", "idle")
        key = (auto["id"], node.get("id"))
        prev = self._edge.get(key, False)
        self._edge[key] = is_idle
        if ev == "idle" and is_idle and not prev:
            self._fire(auto, node, "idle for %g min" % mins)
        elif ev == "active" and (not is_idle) and prev:
            self._fire(auto, node, "back from idle")

    # -- a log/text file gets a new line matching a regex -----------------
    def _poll_log(self, auto, node):
        cfg = node.get("config", {}) or {}
        path = os.path.expanduser(cfg.get("path", ""))
        if not path or not os.path.isfile(path):
            return
        key = (auto["id"], node.get("id"))
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        off = self._offset.get(key)
        if off is None:                    # prime: start at EOF, don't backfill
            self._offset[key] = size
            return
        if size < off:                     # rotated/truncated
            off = 0
        if size == off:
            return
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                fh.seek(off)
                data = fh.read()
                self._offset[key] = fh.tell()
        except OSError:
            return
        pattern = cfg.get("pattern") or ""
        rx = None
        if pattern:
            try:
                rx = re.compile(pattern)
            except re.error:
                rx = None
        for line in data.splitlines():
            if not line.strip():
                continue
            if rx is None or rx.search(line):
                self._fire(auto, node, "log: " + line.strip()[:80])
                if rx is None:
                    break              # no filter → one fire per batch is enough

    # -- a custom command "sensor" (poll a command, fire on its result) ---
    def _poll_command(self, auto, node):
        cfg = node.get("config", {}) or {}
        command = (cfg.get("command") or "").strip()
        if not command:
            return
        key = (auto["id"], node.get("id"))
        now = time.monotonic()
        try:
            every = max(2.0, float(cfg.get("interval", 30)))
        except (TypeError, ValueError):
            every = 30.0
        if now < self._cmd_next.get(key, 0):
            return
        self._cmd_next[key] = now + every
        try:
            proc = subprocess.run(["/bin/sh", "-lc", command], capture_output=True,
                                  text=True, timeout=30)
        except Exception:
            return
        out = (proc.stdout or "").strip()
        ev = cfg.get("on", "exit0")
        if ev == "exit0":
            self._edge_fire(auto, node, proc.returncode == 0, "command exit 0")
        elif ev == "match":
            pattern = cfg.get("match") or ""
            try:
                hit = bool(re.search(pattern, out)) if pattern else bool(out)
            except re.error:
                hit = False
            self._edge_fire(auto, node, hit, "command output matched")
        elif ev == "changed":
            prev = self._snap.get(key)
            self._snap[key] = out
            if prev is not None and out != prev:
                self._fire(auto, node, "command output changed")

    # -- bluetooth device connected / disconnected ------------------------
    def _bt_set(self):
        if not shutil.which("bluetoothctl"):
            return set()
        try:
            out = subprocess.run(["bluetoothctl", "devices", "Connected"],
                                 capture_output=True, text=True, timeout=5).stdout
            return {ln.split(" ", 2)[2] if len(ln.split(" ", 2)) > 2 else ln
                    for ln in out.splitlines() if ln.startswith("Device")}
        except Exception:
            return set()

    def _poll_bluetooth(self, auto, node, btset):
        if btset is None:
            return
        cfg = node.get("config", {}) or {}
        action = cfg.get("action", "connected")
        want = (cfg.get("name") or "").lower().strip()
        key = (auto["id"], node.get("id"))
        prev = self._snap.get(key, set())
        self._snap[key] = btset
        changed = (btset - prev) if action == "connected" else (prev - btset)
        for d in sorted(changed):
            if want and want not in d.lower():
                continue
            self._fire(auto, node, "BT %s: %s" % (action, d))

    # -- manual run (from the GUI) ----------------------------------------
    def run_now(self, aid):
        with self.lock:
            auto = self.autos.get(aid)
        if not auto:
            return "unknown automation"
        manual = [n for n in auto.get("nodes", []) if n.get("kind") == "evt_manual"]
        if manual:
            for n in manual:
                threading.Thread(target=self.engine.run_chain,
                                 args=(auto, n.get("id"), "manual run"),
                                 daemon=True).start()
        else:
            # No manual node: run every action node in order.
            keep = {n.get("id") for n in auto.get("nodes", [])
                    if n.get("kind") in ACTION_KINDS}
            seq = self.engine._topo(auto, keep)
            self.status.state(aid, "running", running=True)
            threading.Thread(target=self._run_all,
                             args=(auto, seq), daemon=True).start()
        return "ok"

    def _run_all(self, auto, seq):
        aid = auto["id"]
        try:
            for node in seq:
                self.engine._run_action(auto, node)
        finally:
            self.status.state(aid, "listening" if auto.get("enabled") else "idle",
                              running=False)

    # -- control socket ----------------------------------------------------
    def _serve_socket(self):
        try:
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            srv.bind(SOCK_PATH)
            os.chmod(SOCK_PATH, 0o600)
            srv.listen(8)
        except OSError as exc:
            sys.stderr.write("genesi-automationd: socket bind failed: %s\n" % exc)
            return
        srv.settimeout(1.0)
        while not self._stop.is_set():
            try:
                conn, _addr = srv.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            threading.Thread(target=self._handle_conn, args=(conn,),
                             daemon=True).start()

    def _handle_conn(self, conn):
        try:
            conn.settimeout(30)     # capture-hotkey can block ~12s before replying
            data = conn.recv(65536).decode("utf-8", "replace").strip()
            try:
                msg = json.loads(data) if data else {}
            except ValueError:
                msg = {}
            reply = self._dispatch_cmd(msg)
            conn.sendall((json.dumps(reply) + "\n").encode())
        except OSError:
            pass
        finally:
            try:
                conn.close()
            except OSError:
                pass

    def _dispatch_cmd(self, msg):
        cmd = msg.get("cmd")
        if cmd == "ping":
            return {"ok": True, "hotkeyAvailable": bool(
                self._hotkeys and self._hotkeys.available)}
        if cmd == "reload":
            self.load()
            return {"ok": True}
        if cmd == "run-now":
            return {"ok": True, "result": self.run_now(msg.get("id", ""))}
        if cmd in ("approve", "deny"):
            rid = msg.get("id", "")
            with self._pending_lock:
                entry = self._pending.get(rid)
                if entry:
                    entry["approved"] = (cmd == "approve")
                    entry["event"].set()
                    return {"ok": True}
            return {"ok": False, "error": "no such approval request"}
        if cmd == "capture-hotkey":
            hk = self._hotkeys
            # Last-ditch: try to gain input access right now (group just added).
            if hk and not hk.available and hk.reopen():
                self.status.set_hotkey(True)
                self._start_hotkey_reader()
            if not (hk and hk.available):
                return {"ok": False, "combo": "", "error": "no-input-access"}
            combo = hk.capture(float(msg.get("timeout", 12)))
            return {"ok": bool(combo), "combo": combo,
                    "error": "" if combo else "no-keys"}
        return {"ok": False, "error": "unknown command"}

    # -- config-dir watch (reload when the GUI saves) ---------------------
    def _watch_config(self):
        watcher = Inotify(lambda *_: self._debounced_reload())
        watcher.add_root(CONFIG_DIR, recursive=False)
        if watcher.ok:
            threading.Thread(target=watcher.run, daemon=True).start()
        else:                               # fallback: poll dir mtime
            last = 0
            while not self._stop.is_set():
                try:
                    m = os.stat(CONFIG_DIR).st_mtime
                except OSError:
                    m = 0
                if m != last:
                    last = m
                    self._debounced_reload()
                self._stop.wait(3.0)

    _reload_timer = None

    def _debounced_reload(self):
        if self._reload_timer and self._reload_timer.is_alive():
            return
        self._reload_timer = threading.Timer(0.6, self.load)
        self._reload_timer.daemon = True
        self._reload_timer.start()

    # -- lifecycle ---------------------------------------------------------
    def run(self):
        self._hotkeys = Hotkeys(self._on_combo)
        self.status.set_hotkey(self._hotkeys.available)
        self._start_hotkey_reader()
        self.load()
        threading.Thread(target=self._poll_loop, daemon=True).start()
        threading.Thread(target=self._serve_socket, daemon=True).start()
        threading.Thread(target=self._watch_config, daemon=True).start()
        try:
            while not self._stop.is_set():
                self._stop.wait(3600)
        except KeyboardInterrupt:
            pass

    def stop(self):
        self._stop.set()
        if self._inotify:
            self._inotify.stop()
        if self._hotkeys:
            self._hotkeys.stop()


def main():
    daemon = Daemon()
    import signal as _signal
    _signal.signal(_signal.SIGTERM, lambda *_a: daemon.stop())
    _signal.signal(_signal.SIGINT, lambda *_a: daemon.stop())
    daemon.run()


if __name__ == "__main__":
    main()
