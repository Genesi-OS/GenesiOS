            else:
                subprocess.run(["pkill", "-f", app], check=False)
                self.status.log(aid, "closed " + app, "ok")
            return "ok", ""
        except OSError as exc:
            self.status.log(aid, "app %s failed: %s" % (op, exc), "err")
            return "err", ""

    def _act_sound(self, aid, cfg):
        sound = os.path.expanduser(cfg.get("sound", "") or "")
        players = []
        if sound:
            for tool in ("paplay", "aplay", "ffplay", "mpv"):
                if shutil.which(tool):
                    players.append([tool, sound] if tool != "ffplay"
                                   else [tool, "-autoexit", "-nodisp", sound])
