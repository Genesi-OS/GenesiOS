def _cron_match(field, value):
    """One cron field against one number: *, a list, a range, or */step."""
    field = field.strip()
    if field in ("*", "?"):
        return True
    for part in field.split(","):
        part = part.strip()
        step = 1
        if "/" in part:
            part, _, raw_step = part.partition("/")
            try:
                step = max(1, int(raw_step))
            except ValueError:
                return False
            part = part or "*"
        if part == "*":
            if value % step == 0:
                return True
            continue
        if "-" in part:
            lo, _, hi = part.partition("-")
            try:
                lo, hi = int(lo), int(hi)
            except ValueError:
                return False
            if lo <= value <= hi and (value - lo) % step == 0:
                return True
            continue
        try:
            if int(part) == value:
                return True
        except ValueError:
            return False
    return False


def _keyring_get(service, account):
    """Read a secret from the session keyring, or None.

    Shelling out to secret-tool rather than binding libsecret: the daemon is
    stdlib-only by design, and this keeps the credential out of our address
    space for everything but the moment it is used.
    """
    if not shutil.which("secret-tool"):
        return None
    try:
        done = subprocess.run(
            ["secret-tool", "lookup", "service", service, "account", account],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout.strip() or None


