def _slug(name):
    """The nearest usable name, for the error message."""
    out = re.sub(r"[^A-Za-z0-9_]+", "_", (name or "").strip()).strip("_")
    return (out or "value").lower()


def _publish(vars, pairs):
    """Publish a block's named values for the blocks after it.

    Each value lands twice: namespaced ("clipboard.text") and bare ("text").
    The bare form is what a person writes when there is one obvious source,
    which is nearly every graph; the namespaced form is how you say WHICH script
    you meant when there are two. When two blocks publish the same bare name the
    most recent one along the path wins, because "the one that just ran" is the
    only reading of {{stdout}} that surprises nobody.
    """
    if vars is None:
        return
    for name, value in pairs:
        if value is None:
            continue
        text = value if isinstance(value, str) else str(value)
        vars[name] = text
        bare = name.split(".", 1)[1] if "." in name else name
        if bare:
            vars[bare] = text


