_MOD_ORDER = ["ctrl", "alt", "shift", "super"]


def _canon_combo(names):
    """A set of key names → a stable 'ctrl+alt+a' string (mods first)."""
    names = set(names)
    mods = [m for m in _MOD_ORDER if m in names]
    rest = sorted(n for n in names if n not in _MOD_ORDER)
    return "+".join(mods + rest)


def _combo_keyset(combo):
    return frozenset(p.strip().lower() for p in str(combo).split("+") if p.strip())


class Hotkeys:
    """Reads every readable /dev/input/event* keyboard, tracks the pressed key
    set, and fires when a bound combo becomes fully pressed. Also serves a
    one-shot 'capture the next chord' request for the config UI. Degrades to a
    no-op (available=False) when /dev/input isn't readable (user not in the
    'input' group)."""

    def __init__(self, on_combo):
        self.on_combo = on_combo
        self.available = False
        self._stop = threading.Event()
        self._fds = []
        self._pressed = set()
        self._active = set()               # combos currently satisfied (debounce)
        self._combos = set()               # bound frozensets to match
        self._cap_lock = threading.Lock()
        self._cap_active = False
        self._cap_peak = set()
        self._cap_result = None
        self._cap_event = threading.Event()
        self.last_input = time.monotonic()   # for idle detection (any input resets)
        self._open()

    def idle_seconds(self):
        return time.monotonic() - self.last_input

    def _open(self):
        for path in sorted(globmod.glob("/dev/input/event*")):
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                self._fds.append(fd)
            except OSError:
                continue
        self.available = bool(self._fds)

    def reopen(self):
        """Re-scan /dev/input — lets the daemon pick up input access gained after
        it started (e.g. the user was just added to the 'input' group). Returns
        the new `available`."""
        for fd in self._fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self._fds = []
        self._pressed = set()
        self._open()
        return self.available

    def set_combos(self, combos):
        self._combos = {_combo_keyset(c) for c in combos if c}

    def capture(self, timeout=12.0):
        """Block up to `timeout`s for the user to press a chord, then return its
        canonical string once they RELEASE it (so 'ctrl', 'shift', 'ctrl+shift'
        and 'ctrl+shift+n' all work). "" on timeout / unavailable."""
        if not self.available:
            return ""
        with self._cap_lock:
            self._cap_active = True
            self._cap_peak = set()
            self._cap_result = None
            self._cap_event.clear()
        got = self._cap_event.wait(timeout)
        with self._cap_lock:
            self._cap_active = False
            return (self._cap_result or "") if got else ""

    def run(self):
        if not self._fds:
            return
        while not self._stop.is_set():
            try:
                r, _w, _e = select.select(self._fds, [], [], 1.0)
            except Exception:
                break
            for fd in r:
                self._drain(fd)

    def _drain(self, fd):
        try:
            data = os.read(fd, _EV.size * 64)
        except OSError:
            return
        if data:
            self.last_input = time.monotonic()   # any input (key/mouse) → not idle
        for off in range(0, len(data) - _EV.size + 1, _EV.size):
            _s, _us, etype, code, value = _EV.unpack_from(data, off)
            if etype != EV_KEY:
                continue
            name = _KEYMAP.get(code)
            if not name:
                continue
            if value == 1:                 # key down
                self._pressed.add(name)
                self._on_change(down=name)
            elif value == 0:               # key up
                self._pressed.discard(name)
                self._on_change(up=name)

    def _on_change(self, down=None, up=None):
        # Capture mode: accumulate the peak chord as keys go down, and only
        # finalize once EVERYTHING is released — so we never save a half-pressed
        # chord (e.g. just "ctrl" while the user is still reaching for "shift").
        # Modifier-only chords ("ctrl", "shift", "ctrl+shift") are allowed.
        with self._cap_lock:
            if self._cap_active:
                if down:
                    self._cap_peak.add(down)
                elif up and self._cap_peak and not self._pressed:
                    self._cap_result = _canon_combo(self._cap_peak)
                    self._cap_active = False
                    self._cap_event.set()
                return
        pressed = frozenset(self._pressed)
        for combo in self._combos:
            if combo <= pressed:
                if combo not in self._active:
                    self._active.add(combo)
                    self.on_combo(_canon_combo(combo))
            else:
                self._active.discard(combo)

    def stop(self):
        self._stop.set()
        for fd in self._fds:
            try:
                os.close(fd)
            except OSError:
                pass


# ── status / logs the GUI reads ───────────────────────────────────────────────
class Status:
    def __init__(self):
        self._lock = threading.Lock()
        self._autos = {}                   # id -> {name,enabled,state,running,lastRun,log[]}
        self._hotkey_ok = False
        os.makedirs(STATE_DIR, exist_ok=True)

    def set_hotkey(self, ok):
        with self._lock:
            self._hotkey_ok = ok
        self._flush()

    def sync(self, autos):
        """Reconcile the tracked set with the loaded automations."""
        with self._lock:
            for aid, a in autos.items():
                cur = self._autos.setdefault(aid, {"log": []})
                cur["name"] = a.get("name", aid)
                cur["enabled"] = bool(a.get("enabled"))
                cur.setdefault("running", False)
                cur.setdefault("lastRun", 0)
                cur.setdefault("pending", [])
                cur.setdefault("nodes", {})
                cur["state"] = "listening" if a.get("enabled") else "disabled"
            for aid in list(self._autos):
                if aid not in autos:
                    self._autos.pop(aid, None)
        self._flush()

    def log(self, aid, line, level="out"):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["log"].append({"ts": _now(), "line": line, "level": level})
            if len(cur["log"]) > LOG_KEEP:
                cur["log"] = cur["log"][-LOG_KEEP:]
        self._flush()

    def is_running(self, aid):
        """Is this automation mid-run right now?"""
        with self._lock:
            cur = self._autos.get(aid)
            return bool(cur and cur.get("running"))

    def state(self, aid, state, running=None):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["state"] = state
            if running is not None:
                cur["running"] = running
            if state == "running":
                cur["lastRun"] = _now()
        self._flush()

    # -- per-node run state (drives the canvas flow visuals) ---------------
    # Without this the GUI only knew a single per-automation `running` bool and
    # lit EVERY card blue, so the actual path through the graph was invisible
    # (reported 2026-07-19). States: running | ok | failed | skipped.
    def nodes_reset(self, aid, states=None):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["nodes"] = dict(states or {})
        self._flush()

    def node_state(self, aid, node_id, state):
        if not node_id:
            return
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur.setdefault("nodes", {})[node_id] = state
        self._flush()

    def set_pending(self, aid, items):
        with self._lock:
            cur = self._autos.get(aid)
            if cur is None:
                return
            cur["pending"] = items
        self._flush()

    def _flush(self):
        try:
            payload = {"updated": _now(), "hotkeyAvailable": self._hotkey_ok,
                       "automations": self._autos}
            tmp = STATUS_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(payload, fh, ensure_ascii=False)
            os.replace(tmp, STATUS_FILE)
        except OSError:
            pass


# ── the engine: run an action chain reachable from a fired event node ─────────
class Engine:
    def __init__(self, status):
        self.status = status
        self._tools = LocalToolExecutor() if _AGENT_OK else None
        self.approve = None                # set by Daemon: approve(aid, action)->bool
        self.quiet_after_run = None        # set by Daemon: quiet_after_run(aid)
        self._cond_snap = {}               # (aid,node) -> last output, for "changed"

    def run_chain(self, auto, start_id, detail, values=None):
        """Walk the graph from the fired trigger, following links by RESULT.

        Each executed node yields (outcome, output): outcome is "ok"/"err",
        output is its text product (stdout / AI reply / HTTP body). A link
        fires when its port is empty (always), equals the outcome, or is
        "output" and the node produced non-empty output. The winning output is
        forwarded as the next node's payload ({input} / $GENESI_INPUT), so a
        chain like  Run Script → Command sensor → Notify  pipes real data.
        Old graphs (portless links) behave as before: everything reachable
        runs, in link order."""
        aid = auto["id"]
        nodes = {n.get("id"): n for n in auto.get("nodes", [])}
        outgoing = {}
        for link in auto.get("links", []):
            outgoing.setdefault(link.get("from"), []).append(
                ((link.get("fromPort") or ""), link.get("to")))
        first = outgoing.get(start_id, [])
        if not first:
            return

        self.status.state(aid, "running", running=True)
        # Start a fresh per-node picture: the trigger is already satisfied,
        # everything else is blank until the walk reaches it.
        self.status.nodes_reset(aid, {start_id: "ok"})
        self.status.log(aid, "▶ triggered — " + (detail or "event"), "step")
        # Named values published during THIS run, readable by later nodes as
        # {{name}}. Scoped to the run and carried on the walk rather than kept
        # on the engine: two automations can be walking at the same time, and
        # one must never read the other's values.
        walk = _Walk(auto, nodes, outgoing, detail)
        _publish(walk.vars, (values or {}).items())
        try:
            # A trigger has no run result: every outgoing link fires, whatever
            # dot it was drawn from, carrying the event detail as payload.
            self._walk(walk, [(to, detail or "") for _port, to in first])
            for nid in walk.skipped:
                if nid not in walk.ran:
                    self.status.node_state(aid, nid, "skipped")
        finally:
            self.status.state(aid, "listening" if auto.get("enabled") else "idle",
                              running=False)
            # The run's own children are exiting right about now; hold triggers
            # off until they have. See _fire for why this exists.
            if self.quiet_after_run is not None:
                self.quiet_after_run(aid)
            self.status.log(aid, "✓ finished", "ok")

    def _walk(self, walk, queue):
        """Drain a queue of (node_id, payload), executing each node in order.

        Split out of run_chain so a Loop can replay a branch, and a Sub-workflow
        can run another graph, through the SAME routing rules. A second copy of
        this logic is exactly how the branch inside a loop would quietly start
        behaving differently from the branch outside one.
        """
        aid = walk.auto["id"]
        nodes, outgoing, vars = walk.nodes, walk.outgoing, walk.vars
        while queue and walk.steps < walk.budget:
            nid, payload = queue.pop(0)
            node = nodes.get(nid)
            if node is None:
                continue
            walk.steps += 1
            # One node at a time, in order: mark it running, execute it to
            # completion, then record its outcome before moving on.
            self.status.node_state(aid, nid, "running")
            outcome, output = self._run_node(walk.auto, node, payload, vars, walk)
            walk.ran.add(nid)
            walk.skipped.discard(nid)
            # "true"/"false" are ANSWERS, not failures. A condition that
            # correctly says false is a node that worked, and painting it red
            # would teach people that a working graph looks broken.
            self.status.node_state(aid, nid,
                                   "failed" if outcome == "err" else "ok")
            kind = node.get("kind")
            # A condition node (evt_* mid-chain, e.g. the Command sensor)
            # GATES the flow: when its configured condition did not hold,
            # NOTHING downstream runs — whatever port the link was drawn
            # from. This is absolute: the legacy "output" port used to mean
            # "fire if the node printed anything", which bypassed the gate
            # entirely and let the next block run after a "did NOT match"
            # (reported 2026-07-19).
            blocked = kind in EVENT_KINDS and outcome != "ok"
            is_cond = kind in COND_KINDS
            is_loop = kind in LOOP_KINDS
            for port, to in outgoing.get(nid, []):
                if is_loop:
                    # The `each` branch belongs to the loop, which already ran
                    # it once per item. Letting the outer walk follow it too
                    # would run the body one extra time with no item bound —
                    # the classic off-by-one that only shows up in production.
                    # A link from the plain dot means "after the loop", which
                    # is what `done` means.
                    fires = outcome != "err" and port in ("", "done")
                elif is_cond:
                    # A condition routes by its ANSWER. A link drawn from the
                    # plain dot (no port) follows the true branch — "carry on
                    # if it holds" is what someone who did not bother picking a
                    # port meant, and silently running the rest of the graph on
                    # false would be the worst reading of it.
                    if outcome == "err":
                        fires = False
                    elif port in ("true", "false"):
                        fires = (port == outcome)
                    else:
                        fires = (outcome == "true")
                elif blocked:
                    fires = False
                elif port == "" or port == "output":
                    # "output" is a legacy port (its dot was removed in
                    # pkgrel 130); treat it as the plain default link.
                    fires = True
                else:
                    fires = (port == outcome)
                if fires:
                    queue.append((to, output if (output or "").strip()
                                  else payload))
                elif to not in walk.ran:
                    # The branch was not taken — show it as skipped so the
                    # path that DID run is unambiguous on the canvas.
                    walk.skipped.add(to)


    def _run_node(self, auto, node, payload, vars=None, walk=None):
        """Execute one node mid-chain. Actions dispatch to their executor; an
        evt_command with an incoming link acts as a CONDITION over the payload;
        any other event node just passes the payload through."""
        kind = node.get("kind")
        if kind in ACTION_KINDS:
            return self._run_action(auto, node, payload, vars, walk)
        if kind == "evt_command":
            return self._cond_command(auto, node, payload, vars)
        if kind == "evt_app":
            return self._wait_app(auto, node, payload, vars)
        return "ok", payload

    @staticmethod
    def _sub(text, payload, vars=None):
        """Render a node field: {input} plus {{named}} variables.

        {input} is the whole output of the previous block and predates this —
        it keeps working exactly as before.

        {{name}} pulls a NAMED value out of the run, which is what makes an AI
        block useful to the blocks after it. An AI node that declares outputs
        (say `cpu` and `gpu`) publishes them here, so a notification can say
        "CPU {{cpu}}%, GPU {{gpu}}%" instead of pasting a paragraph of prose.

        An unknown {{name}} is left ON THE SCREEN rather than replaced with
        nothing. A notification reading "CPU {{cpu}}%" tells the user their
        wiring is wrong; one reading "CPU %" looks like the computer is broken.
        """
        text = text or ""

        def _resolve(match):
            key = match.group(1).strip()
            if key == "input":
                return payload or ""
            if vars and key in vars:
                return str(vars[key])
            return match.group(0)

        # {{...}} FIRST, then the bare {input}. The other order looks harmless
        # and is not: "{{input}}" contains "{input}" as a substring, so
        # replacing the short form first turns it into "{payload}" — braces and
        # all — and the {{ }} pass never sees it.
        if "{{" in text:
            text = _VAR_RE.sub(_resolve, text)
        return text.replace("{input}", payload or "")

    def _wait_app(self, auto, node, payload="", vars=None):
        """An App block placed MID-CHAIN waits for the transition to happen.

        As a trigger, this kind starts a workflow. Reached through a link it
        used to pass straight through, so the obvious graph —

            App opens (firefox) -> AI -> App closes (firefox) -> Notify

        — ran the whole thing the instant Firefox opened, and the "after it
        closed" half measured nothing. The block looked configured and did
        nothing, which is the failure mode this codebase keeps having to fix.

        So it blocks the chain until the app is in the state it names, or until
        it gives up. Giving up is an ERROR, not a silent continue: the run log
        says it timed out, and the err port is there to handle it. The wait
        happens on the run's own thread, which is already one per run, so a
        workflow waiting on a browser does not hold up anything else.
        """
        aid = auto["id"]
        cfg = node.get("config", {}) or {}
        name = (cfg.get("app") or "").lower().strip()
        trans = cfg.get("transition", "opened")
        if not name:
            # "Any app" cannot be waited for: every tick something starts
            # somewhere, so it would return immediately and mean nothing.
            self.status.log(aid, "app: name the app to wait for it here", "err")
            return "err", payload
        if psutil is None:
            self.status.log(aid, "app: psutil missing — cannot watch", "err")
            return "err", payload

        try:
            limit = float(cfg.get("waitSeconds", 300))
        except (TypeError, ValueError):
            limit = 300.0
        limit = max(1.0, min(3600.0, limit))

        want_running = (trans != "closed")
        self.status.log(aid, "⏳ waiting for %s to be %s (up to %gs)"
                        % (name, "open" if want_running else "closed", limit), "step")
        deadline = time.monotonic() + limit
        while True:
            try:
                running = any(name in (pr.info.get("name") or "").lower()
                              for pr in psutil.process_iter(["name"]))
            except Exception:
                running = False
            if running == want_running:
                _publish(vars, (("app.name", name), ("app.transition", trans)))
                self.status.log(aid, "%s is %s" % (name, "open" if running else "closed"),
                                "ok")
                return "ok", payload
            if time.monotonic() >= deadline:
                self.status.log(aid, "gave up waiting for %s to be %s"
                                % (name, "open" if want_running else "closed"), "err")
                return "err", payload
            time.sleep(1.0)

    def _cond_command(self, auto, node, payload, vars=None):
        """evt_command chained after another node: run its command ONCE with
        the upstream output in $GENESI_INPUT / {input} (empty command = test
        the payload itself), then report ok/err + the produced output."""
        aid = auto["id"]
        cfg = node.get("config", {}) or {}
        command = self._sub((cfg.get("command") or "").strip(), payload, vars)
        out, base_ok = (payload or "").strip(), bool((payload or "").strip())
        if command:
            self.status.log(aid, "? " + command.splitlines()[0], "cmd")
            env = _graphical_env()
            env["GENESI_INPUT"] = payload or ""
            try:
                proc = subprocess.run(["/bin/sh", "-lc", command],
                                      capture_output=True, text=True,
                                      timeout=60, env=env)
                # stdout + stderr: error text ("comando não encontrado", …)
                # lives on stderr and must be matchable too.
                out = ((proc.stdout or "").strip() + "\n"
                       + (proc.stderr or "").strip()).strip()
                base_ok = proc.returncode == 0
            except Exception as exc:
                self.status.log(aid, "checker failed: %s" % exc, "err")
                return "err", ""
        # Always show WHAT was tested — a checker that silently "doesn't work"
        # is almost always matching against text it never saw (2026-07-19).
        preview = " ".join((out or "").split())[:110] or "(no output)"
        self.status.log(aid, "checker input: " + preview, "out")
        on = cfg.get("on", "exit0")
        if on == "match":
            pattern = cfg.get("match") or ""
            if not pattern:
                hit = bool(out)
                self.status.log(aid, "checker: no regex set — treating any "
                                "output as a match", "out")
            else:
                try:
                    hit = bool(re.search(pattern, out))
                except re.error as exc:
                    hit = False
                    self.status.log(aid, "checker: invalid regex (%s)" % exc,
                                    "err")
                self.status.log(
                    aid, "checker: /%s/ %s" % (pattern,
                                               "matched" if hit else "did NOT match"),
                    "ok" if hit else "err")
            outcome = "ok" if hit else "err"
        elif on == "error":
            # Condition = "the command FAILED" (outcome ok when it did fail).
            outcome = "ok" if not base_ok else "err"
            self.status.log(aid, "checker: command %s"
                            % ("failed → condition met" if not base_ok else
                               "succeeded → condition NOT met"),
                            "ok" if not base_ok else "err")
        elif on == "changed":
            # Condition = "the output differs from the previous run of this
            # checker". The first run has nothing to compare against, so it
            # does NOT fire (same edge semantics as the polling trigger).
            key = (aid, node.get("id"))
            prev = self._cond_snap.get(key)
            self._cond_snap[key] = out
            changed = prev is not None and out != prev
            outcome = "ok" if changed else "err"
            self.status.log(
                aid, "checker: output %s" % (
                    "changed → condition met" if changed else
                    ("first run, nothing to compare → condition NOT met"
                     if prev is None else "unchanged → condition NOT met")),
                "ok" if changed else "err")
        else:  # exit0
            outcome = "ok" if base_ok else "err"
            self.status.log(aid, "checker: command %s"
                            % ("succeeded → condition met" if base_ok else
                               "failed → condition NOT met"),
                            "ok" if base_ok else "err")
        return outcome, out

    def _topo(self, auto, keep):
        nodes = {n.get("id"): n for n in auto.get("nodes", []) if n.get("id") in keep}
        indeg = {nid: 0 for nid in nodes}
        out = {nid: [] for nid in nodes}
        for link in auto.get("links", []):
            a, b = link.get("from"), link.get("to")
            if a in nodes and b in nodes:
                out[a].append(b)
                indeg[b] += 1
        queue = [nid for nid in nodes if indeg[nid] == 0]
        order = []
        while queue:
            nid = queue.pop(0)
            order.append(nodes[nid])
            for t in out[nid]:
                indeg[t] -= 1
                if indeg[t] == 0:
                    queue.append(t)
        return order if len(order) == len(nodes) else list(nodes.values())

    # -- action executors --------------------------------------------------
    # Every executor returns (outcome, output): outcome "ok"/"err" drives the
    # result ports, output feeds the next node's payload.
    def _run_action(self, auto, node, payload="", vars=None, walk=None):
        aid = auto["id"]
        kind = node.get("kind")
        cfg = node.get("config", {}) or {}
        title = node.get("title", kind)
        _ensure_display_env()               # so launched GUI apps actually appear
        try:
            if kind == "act_script":
                return self._act_script(aid, cfg, title, payload, vars)
            elif kind == "act_notify":
                return self._act_notify(aid, cfg, payload, vars)
            elif kind == "act_ai":
                return self._act_ai(aid, cfg, title, payload, vars)
            elif kind == "act_cond":
                return self._act_cond(aid, cfg, title, payload, vars)
            elif kind == "act_http":
                return self._act_http(aid, cfg, payload, vars)
            elif kind == "act_file":
                return self._act_file(aid, cfg)
            elif kind == "act_app":
                return self._act_app(aid, cfg)
            elif kind == "act_sound":
                return self._act_sound(aid, cfg)
            elif kind == "act_power":
                return self._act_power(aid, cfg)
            elif kind == "act_email":
                return self._act_email(aid, cfg, payload, vars)
            elif kind == "act_loop":
                return self._act_loop(auto, node, payload, vars, walk)
            elif kind == "act_subflow":
                return self._act_subflow(auto, node, payload, vars, walk)
            elif kind == "act_wait":
                return self._act_wait(aid, cfg)
        except Exception as exc:
            self.status.log(aid, "%s: %s" % (title, exc), "err")
            return "err", ""
        return "ok", ""

    def _act_cond(self, aid, cfg, title, payload="", vars=None):
        """A branch: answers "true" or "false", and its two ports carry those
        names. Returns "err" only when it could not decide at all — a condition
        that is simply false is a node that worked.

        Two modes:
          expr  a comparison over the run's values — "{{cpu}} > 80".
          ai    the local model answers the question about the input.

        The AI mode delegates to the AI block rather than reimplementing it, so
        it inherits the whole shipped path: model choice, Turbo, local GGUF
        loading, logging. It forces advisory execution on the way through,
        because a question must never be able to take an action while answering
        itself.
        """
        mode = (cfg.get("mode") or "expr").strip().lower()

        if mode == "ai":
            question = (cfg.get("prompt") or "").strip()
            if not question:
                self.status.log(aid, "condition: no question — skipped", "err")
                return "err", ""
            sub = dict(cfg)
            sub["exec"] = "advisory"
            sub["autonomous"] = False
            sub["prompt"] = (question +
                             "\n\nAnswer the question above about the input. "
                             "true if it holds, false if it does not.")
            sub["outputs"] = [{"name": "answer",
                               "desc": "true or false, nothing else"}]
            local = dict(vars or {})
            outcome, _out = self._act_ai(aid, sub, title, payload, local)
            if outcome != "ok":
                return "err", ""
            answer = str(local.get("answer", "")).strip().lower()
            result = answer in _TRUTHY
            # The answer is published so the blocks after the branch can quote
            # the model's own words, and so a second condition can chain off it.
            if vars is not None:
                vars["answer"] = answer
                for key, value in local.items():
                    vars.setdefault(key, value)
            self.status.log(aid, "condition → %s" % ("true" if result else "false"),
                            "ok")
            _publish(vars, [("cond.answer", "true" if result else "false")])
            return ("true" if result else "false"), payload

        expr = (cfg.get("expr") or "").strip()
        if not expr:
            self.status.log(aid, "condition: empty expression — skipped", "err")
            return "err", ""
        rendered = self._sub(expr, payload, vars)
        result = _cond_eval(rendered)
        self.status.log(aid, "condition: %s → %s"
                        % (rendered, "true" if result else "false"), "ok")
        _publish(vars, [("cond.answer", "true" if result else "false")])
        return ("true" if result else "false"), payload

    # ── Loop ────────────────────────────────────────────────────────────────

    def _loop_items(self, cfg, payload, vars):
        """The list a Loop walks. Four sources, because the useful ones differ:
        a script prints lines, an HTTP call returns a JSON array, a person types
        a short list by hand, and a counter is just a range."""
        source = (cfg.get("source") or "lines").strip().lower()
        if source == "list":
            raw = self._sub(cfg.get("list") or "", payload, vars)
            return [p.strip() for p in raw.split(",") if p.strip()]
        if source == "range":
            try:
                start = int(float(self._sub(str(cfg.get("from", 1)), payload, vars)))
                stop = int(float(self._sub(str(cfg.get("to", 0)), payload, vars)))
            except (TypeError, ValueError):
                return []
            step = 1 if stop >= start else -1
            return [str(n) for n in range(start, stop + step, step)]
        if source == "json":
            try:
                obj = json.loads((payload or "").strip())
            except ValueError:
                return []
            if isinstance(obj, dict):
                obj = obj.get("items") if isinstance(obj.get("items"), list) else [obj]
            if not isinstance(obj, list):
                return []
            return [v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
                    for v in obj]
        return [ln for ln in (payload or "").splitlines() if ln.strip()]

    def _act_loop(self, auto, node, payload="", vars=None, walk=None):
        """Run the `each` branch once per item; `done` continues afterwards.

        The branch is executed HERE, synchronously, rather than by queueing its
        nodes once per item on the outer walk. That is not a style choice: the
        walk is breadth-first and {{item}} lives in one shared dict, so queueing
        five iterations would run them all after the loop finished and every one
        of them would read the fifth item. Running each iteration to completion
        before binding the next is the only way {{item}} means what it says.
        """
        aid = auto["id"]
        cfg = node.get("config") or {}
        if walk is None:
            # A lone node fired from the GUI's "test this block" has no graph
            # around it, so there is no branch to repeat.
            self.status.log(aid, "loop: nothing to repeat outside a workflow", "err")
            return "err", ""
        if walk.depth >= 3:
            self.status.log(aid, "loop: nested too deep (3 levels) — stopping", "err")
            return "err", ""

        targets = [to for port, to in walk.outgoing.get(node.get("id"), [])
                   if port == "each"]
        if not targets:
            self.status.log(aid, "loop: nothing connected to the 'each' output",
                            "err")
            return "err", ""

        try:
            cap = int(float(cfg.get("max", 100)))
        except (TypeError, ValueError):
            cap = 100
        cap = max(1, min(1000, cap))

        items = self._loop_items(cfg, payload, vars)
        if not items:
            self.status.log(aid, "loop: nothing to iterate", "out")
            return "ok", ""
        if len(items) > cap:
            self.status.log(aid, "loop: %d items, capped at %d" % (len(items), cap),
                            "out")
            items = items[:cap]

        self.status.log(aid, "🔁 %d item(s)" % len(items), "step")
        outer = dict(vars) if vars else {}
        done = 0
        for index, item in enumerate(items):
            if walk.steps >= walk.budget:
                self.status.log(aid, "loop: step budget reached — stopping", "err")
                break
            _publish(vars, (("item", item), ("index", index),
                            ("count", len(items))))
            walk.depth += 1
            try:
                self._walk(walk, [(t, item) for t in targets])
            finally:
                walk.depth -= 1
            done += 1

        # The loop's own bookkeeping is not something the blocks after it should
        # inherit: {{item}} after a loop has finished means nothing, and leaving
        # the last one bound is how a notification ends up quoting item five
        # forever. Values the BODY published are kept, because publishing them
        # is usually the point of the loop.
        if vars is not None:
            for key in ("item", "index", "count"):
                if key in outer:
                    vars[key] = outer[key]
                else:
                    vars.pop(key, None)
        return "ok", "%d item(s)" % done

    # ── Sub-workflow ────────────────────────────────────────────────────────

    def _find_auto(self, ref):
        """Another automation by id or by name. In-memory first (the daemon
        keeps them fresh), the config directory as the fallback so this also
        works from a test-run and from the GUI's preview."""
        ref = (ref or "").strip()
        if not ref:
            return None
        provider = getattr(self, "autos_provider", None)
        pool = {}
        if callable(provider):
            try:
                pool = dict(provider() or {})
            except Exception:
                pool = {}
        if not pool:
            base = os.path.expanduser("~/.config/genesi-ai-monitor/automations")
            for path in sorted(globmod.glob(os.path.join(base, "*.json"))):
                try:
                    with open(path, "r", encoding="utf-8") as fh:
                        obj = json.load(fh)
                    if isinstance(obj, dict) and obj.get("id"):
                        pool[obj["id"]] = obj
                except (OSError, ValueError):
                    continue
        if ref in pool:
            return pool[ref]
        for auto in pool.values():
            if (auto.get("name") or "").strip().lower() == ref.lower():
                return auto
        return None

    def _act_subflow(self, auto, node, payload="", vars=None, walk=None):
        """Run another automation as one step of this one.

        The sub-workflow shares this run's step budget and its own values are
        merged back on the way out, so a workflow can be factored into pieces
        the same way a program is factored into functions — without either half
        having to know it is being reused.
        """
        aid = auto["id"]
        cfg = node.get("config") or {}
        target = self._find_auto(self._sub(cfg.get("workflow") or "", payload, vars))
        if target is None:
            self.status.log(aid, "sub-workflow: '%s' not found"
                            % (cfg.get("workflow") or ""), "err")
            return "err", ""
        if target.get("id") == aid:
            # Cheap and worth it: the graph cannot see itself, so the only
            # protection against "call myself" is here.
            self.status.log(aid, "sub-workflow: a workflow cannot call itself",
                            "err")
            return "err", ""
        if walk is not None and walk.depth >= 3:
            self.status.log(aid, "sub-workflow: nested too deep (3 levels)", "err")
            return "err", ""

        sub_nodes = {n.get("id"): n for n in target.get("nodes", [])}
        sub_out = {}
        for link in target.get("links", []):
            sub_out.setdefault(link.get("from"), []).append(
                ((link.get("fromPort") or ""), link.get("to")))
        # Start where a manual "Run now" would: every trigger that nothing
        # feeds into. A sub-workflow's own triggers are not armed — it runs
        # because THIS graph reached it.
        fed = {to for links in sub_out.values() for _p, to in links}
        starts = [nid for nid, n in sub_nodes.items()
                  if n.get("kind") in EVENT_KINDS and nid not in fed]
        queue = []
        for nid in starts:
            queue.extend([(to, payload) for _p, to in sub_out.get(nid, [])])
        if not queue:
            self.status.log(aid, "sub-workflow '%s' has nothing to run"
                            % target.get("name", "?"), "err")
            return "err", ""

        self.status.log(aid, "↪ %s" % target.get("name", target.get("id")), "step")
        sub_walk = _Walk(target, sub_nodes, sub_out, payload)
        sub_walk.vars.update(vars or {})
        if walk is not None:
            sub_walk.depth = walk.depth + 1
            sub_walk.budget = max(1, walk.budget - walk.steps)
        # The sub-workflow reports against ITS OWN id, so its nodes light up on
        # its own canvas rather than painting node states onto a graph that does
        # not contain them.
        self._walk(sub_walk, queue)
        if walk is not None:
            walk.steps += sub_walk.steps
        if vars is not None:
            for key, value in sub_walk.vars.items():
                if key != "trigger":
                    vars[key] = value
        return "ok", ""

    # ── Email ───────────────────────────────────────────────────────────────

    def _act_email(self, aid, cfg, payload="", vars=None):
        """Send mail over SMTP, or read the newest unread messages over IMAP.

        THE PASSWORD IS NEVER IN THE WORKFLOW. The node stores an account name;
        the credential lives in the session keyring (libsecret) where the user
        put it, and is read here at send time. A workflow file is a document
        people copy, paste into a forum when asking for help, and sync between
        machines — an app password sitting in one would leak the first time
        somebody shared their automation.
        """
        import smtplib
        import imaplib
        import email as _email
        from email.message import EmailMessage

        account = (cfg.get("account") or "").strip()
        if not account:
            self.status.log(aid, "email: no account configured", "err")
            return "err", ""
        secret = _keyring_get("genesi-automation-email", account)
        if not secret:
            self.status.log(
                aid, "email: no password stored for '%s' — add it in the node's "
                     "Account panel" % account, "err")
            return "err", ""

        host = (cfg.get("host") or "").strip()
        user = (cfg.get("user") or account).strip()
        mode = (cfg.get("mode") or "send").strip().lower()

        if mode == "read":
            port = int(cfg.get("port") or 993)
            folder = (cfg.get("folder") or "INBOX").strip() or "INBOX"
            limit = max(1, min(20, int(cfg.get("limit") or 5)))
            box = imaplib.IMAP4_SSL(host, port, timeout=30)
            try:
                box.login(user, secret)
                box.select(folder, readonly=not cfg.get("markRead"))
                typ, data = box.search(None, cfg.get("search") or "UNSEEN")
                ids = (data[0].split() if data and data[0] else [])[-limit:]
                out = []
                for num in ids:
                    typ, raw = box.fetch(num, "(RFC822)")
                    if typ != "OK" or not raw or not raw[0]:
                        continue
                    msg = _email.message_from_bytes(raw[0][1])
                    body = ""
                    if msg.is_multipart():
                        for part in msg.walk():
                            if part.get_content_type() == "text/plain":
                                body = part.get_payload(decode=True) \
                                    .decode(part.get_content_charset() or "utf-8",
                                            "replace")
                                break
                    else:
                        body = (msg.get_payload(decode=True) or b"").decode(
                            msg.get_content_charset() or "utf-8", "replace")
                    out.append({"from": str(msg.get("From", "")),
                                "subject": str(msg.get("Subject", "")),
                                "date": str(msg.get("Date", "")),
                                "body": body.strip()[:4000]})
                if out:
                    _publish(vars, (("mail.from", out[-1]["from"]),
                                    ("mail.subject", out[-1]["subject"]),
                                    ("mail.body", out[-1]["body"]),
                                    ("mail.count", len(out))))
                self.status.log(aid, "📥 %d message(s)" % len(out), "ok")
                return "ok", json.dumps(out, ensure_ascii=False)
            finally:
                try:
                    box.logout()
                except Exception:
                    pass

        to = self._sub(cfg.get("to") or "", payload, vars).strip()
        if not to:
            self.status.log(aid, "email: no recipient", "err")
            return "err", ""
        msg = EmailMessage()
        msg["From"] = cfg.get("from") or user
        msg["To"] = to
        msg["Subject"] = self._sub(cfg.get("subject") or "Genesi Automation",
                                   payload, vars)
        msg.set_content(self._sub(cfg.get("body") or "", payload, vars))
        port = int(cfg.get("port") or 587)
        if port == 465:
            server = smtplib.SMTP_SSL(host, port, timeout=30)
        else:
            server = smtplib.SMTP(host, port, timeout=30)
            server.starttls()
        try:
            server.login(user, secret)
            server.send_message(msg)
        finally:
            try:
                server.quit()
            except Exception:
                pass
        self.status.log(aid, "📤 sent to %s" % to, "ok")
        return "ok", ""

    def _act_wait(self, aid, cfg):
        try:
            seconds = min(3600.0, max(0.0, float(cfg.get("seconds", 5))))
        except (TypeError, ValueError):
            seconds = 5.0
        self.status.log(aid, "waiting %gs…" % seconds, "out")
        time.sleep(seconds)
        return "ok", ""

    # Terminal emulators for "Run in a terminal window" (TUI apps like cmatrix/
    # htop need a real TTY — headless they die with `$TERM="unknown"`,
    # reported 2026-07-19). Same picker order as the Monitor's Turbo installer.
    _TERMS = (("konsole", ["konsole", "-e"]),
              ("foot", ["foot"]),
              ("alacritty", ["alacritty", "-e"]),
              ("kitty", ["kitty"]),
              ("xterm", ["xterm", "-e"]))

    def _find_terminal(self):
        return next((argv for name, argv in self._TERMS
                     if shutil.which(name)), None)

    def _act_script(self, aid, cfg, title, payload="", vars=None):
        command = self._sub((cfg.get("command") or "").strip(), payload, vars)
        if not command:
            self.status.log(aid, "script: empty command — skipped", "out")
            return "err", ""
        env = _graphical_env()
        env["GENESI_INPUT"] = payload or ""
        if cfg.get("terminal"):
            # Interactive/TUI mode: open the command in a terminal window.
            # Its output cannot be captured, so the ok port means "launched"
            # and the payload stays empty.
            term = self._find_terminal()
            if term is None:
                self.status.log(aid, "no terminal emulator found "
                                "(install konsole/foot/kitty)", "err")
                return "err", ""
            self.status.log(aid, "↗ " + command.splitlines()[0]
                            + "  (terminal window)", "cmd")
            try:
                subprocess.Popen(term + ["bash", "-lc", command],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL,
                                 start_new_session=True, env=env)
                return "ok", ""
            except OSError as exc:
                self.status.log(aid, "terminal launch failed: %s" % exc, "err")
                return "err", ""
        # Headless: give CLI tools a sane $TERM (ncurses aborts on "unknown";
        # "dumb" makes tput/less-style calls degrade instead of dying).
        env.setdefault("TERM", "dumb")
        self.status.log(aid, "$ " + command.splitlines()[0], "cmd")
        try:
            proc = subprocess.run(["/bin/sh", "-lc", command], capture_output=True,
                                  text=True, timeout=float(cfg.get("timeout", 300)),
                                  env=env)
        except subprocess.TimeoutExpired:
            self.status.log(aid, "script timed out", "err")
            return "err", ""
        for line in (proc.stdout or "").splitlines()[-20:]:
            self.status.log(aid, line, "out")
        for line in (proc.stderr or "").splitlines()[-10:]:
            self.status.log(aid, line, "err")
        self.status.log(aid, "script exit %d" % proc.returncode,
                        "ok" if proc.returncode == 0 else "err")
        # Payload: stdout; on failure fall back to stderr so an error branch
        # carries the actual error message ("comando não encontrado" etc.).
        out = (proc.stdout or "").strip()
        if not out and proc.returncode != 0:
            out = (proc.stderr or "").strip()
        _publish(vars, (("script.stdout", (proc.stdout or "").strip()),
                        ("script.stderr", (proc.stderr or "").strip()),
                        ("script.exit", proc.returncode)))
        return ("ok" if proc.returncode == 0 else "err", out)

    def _act_notify(self, aid, cfg, payload="", vars=None):
        title = self._sub(cfg.get("title") or "Genesi Automation", payload, vars)
        body = self._sub(cfg.get("body") or "", payload, vars)
        if not shutil.which("notify-send"):
            self.status.log(aid, "notify: notify-send missing", "err")
            return "err", ""
        try:
            subprocess.Popen(["notify-send", "--app-name=Genesi Automation",
                              title, body],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True, env=_graphical_env())
            self.status.log(aid, "🔔 " + title, "ok")
            return "ok", ""
        except OSError as exc:
            self.status.log(aid, "notify failed: %s" % exc, "err")
            return "err", ""

    def _act_http(self, aid, cfg, payload="", vars=None):
        url = self._sub((cfg.get("url") or "").strip(), payload, vars)
        if not url:
            self.status.log(aid, "http: no URL — skipped", "out")
            return "err", ""
        method = (cfg.get("method") or "GET").upper()
        body = self._sub(cfg.get("body") or "", payload, vars)
        data = body.encode() if (body and method != "GET") else None
        headers = {"Content-Type": "application/json"} if data else {}
        try:
            req = urllib.request.Request(url, data=data, headers=headers, method=method)
            with urllib.request.urlopen(req, timeout=30) as r:
                text = ""
                try:
                    text = r.read(8192).decode("utf-8", "replace")
                except Exception:
                    pass
                self.status.log(aid, "%s %s → %s" % (method, url[:60], r.status), "ok")
                _publish(vars, (("http.status", r.status),
                                ("http.body", text.strip())))
                return "ok", text.strip()
        except Exception as exc:
            self.status.log(aid, "http failed: %s" % exc, "err")
            # A failed call still has a status worth branching on when the
            # server answered at all — an err port that cannot tell 404 from
            # "the host does not exist" is only half a branch.
            _publish(vars, (("http.status", getattr(exc, "code", "")),
                            ("http.body", "")))
            return "err", ""

    def _act_file(self, aid, cfg):
        import shutil as _sh
        op = cfg.get("op", "copy")
        src = os.path.expanduser(cfg.get("src", "") or "")
        dest = os.path.expanduser(cfg.get("dest", "") or "")
        try:
            if op == "copy" and src and dest:
                _sh.copy2(src, dest); self.status.log(aid, "copied → " + dest, "ok")
            elif op == "move" and src and dest:
                _sh.move(src, dest); self.status.log(aid, "moved → " + dest, "ok")
            elif op == "delete" and src:
                if os.path.isdir(src):
                    _sh.rmtree(src)
                else:
                    os.remove(src)
                self.status.log(aid, "deleted " + src, "ok")
            elif op == "mkdir" and (dest or src):
                os.makedirs(dest or src, exist_ok=True)
                self.status.log(aid, "created dir " + (dest or src), "ok")
            else:
                self.status.log(aid, "file: nothing to do", "out")
                return "err", ""
            return "ok", ""
        except Exception as exc:
            self.status.log(aid, "file %s failed: %s" % (op, exc), "err")
            return "err", ""

    def _act_app(self, aid, cfg):
        op = cfg.get("op", "launch")
        app = (cfg.get("app") or "").strip()
        if not app:
            self.status.log(aid, "app: none set — skipped", "out")
            return "err", ""
        try:
            if op == "launch":
                subprocess.Popen(["/bin/sh", "-lc", app],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True, env=_graphical_env())
