        if not players:
            self.status.log(aid, "sound: no player (install pulseaudio/libcanberra)", "err")
            return "err", ""
        try:
            subprocess.Popen(players[0], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True,
                             env=_graphical_env())
            self.status.log(aid, "🔊 played sound", "ok")
            return "ok", ""
        except OSError as exc:
            self.status.log(aid, "sound failed: %s" % exc, "err")
            return "err", ""

    def _act_power(self, aid, cfg):
        op = cfg.get("op", "lock")
        cmds = {
            "lock": ["loginctl", "lock-session"],
            "suspend": ["systemctl", "suspend"],
            "hibernate": ["systemctl", "hibernate"],
            "shutdown": ["systemctl", "poweroff"],
            "reboot": ["systemctl", "reboot"],
            "logout": ["loginctl", "terminate-user", os.environ.get("USER", "")],
        }
        cmd = cmds.get(op)
        if not cmd:
            self.status.log(aid, "power: unknown op " + op, "err")
            return "err", ""
        # Prefer loginctl lock via a few fallbacks (compositor-agnostic).
        if op == "lock" and not shutil.which("loginctl"):
            for alt in (["xdg-screensaver", "lock"], ["swaylock"], ["hyprlock"]):
                if shutil.which(alt[0]):
                    cmd = alt
                    break
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.status.log(aid, "power: " + op, "ok")
            return "ok", ""
        except OSError as exc:
            self.status.log(aid, "power %s failed: %s" % (op, exc), "err")
            return "err", ""

    def _act_ai(self, aid, cfg, title, payload="", vars=None):
        if not _AGENT_OK:
            self.status.log(aid, "AI action unavailable (agent lib missing)", "err")
            return "err", ""
        prompt = self._sub((cfg.get("prompt") or "").strip(), payload, vars)
        if not prompt:
            self.status.log(aid, "AI: empty prompt — skipped", "out")
            return "err", ""
        # A chained AI block gets the upstream output appended when the prompt
        # doesn't already place it via {input} — so "summarize this" works.
        if payload and "{input}" not in (cfg.get("prompt") or ""):
            prompt = prompt + "\n\nInput from the previous block:\n" + payload

        # Declared outputs turn the free-text answer into named values. The
        # schema goes in the prompt so the model knows the shape before it
        # writes, which is the only reliable way to get JSON out of a small
        # local model; the reply is validated on the way back regardless.
        outs = [o for o in (cfg.get("outputs") or [])
                if isinstance(o, dict) and (o.get("name") or "").strip()]
        for o in outs:
            o["name"] = o["name"].strip()
        # A name that {{ }} cannot reference is a field nobody can ever use.
        # The editor used to accept anything, so "RAM {{app.name}} usage" could
        # be declared, sent to the model, and then never matched — the block
        # failed with "expected JSON with ..." and the reason was three steps
        # away from the message. Say it here instead.
        bad = [o["name"] for o in outs if not _VAR_NAME_RE.match(o["name"])]
        if bad:
            self.status.log(
                aid, "AI: output name %s cannot be used as {{...}} — letters, "
                     "digits and _ only (try %s)"
                % (", ".join(repr(b) for b in bad), _slug(bad[0])), "err")
            return "err", ""
        if outs:
            schema = ", ".join('"%s": "<%s>"' % (o["name"],
                                                 (o.get("desc") or "value").strip())
                               for o in outs)
            prompt += ("\n\nReply with ONE JSON object and NOTHING else — no "
                       "prose, no explanation, no markdown fence:\n{%s}" % schema)
        model = cfg.get("model") or ""
        want_turbo = bool(cfg.get("turbo"))
        spec = bool(cfg.get("spec"))
        # 3-way execution mode; back-compat with the old `autonomous` bool.
        exec_mode = cfg.get("exec") or ("auto" if cfg.get("autonomous") else "advisory")
        if exec_mode not in ("advisory", "ask", "auto"):
            exec_mode = "advisory"

        if cfg.get("aiMode"):
            _run(["genesi-ai-mode", "on"])
            self.status.log(aid, "AI Mode → on", "out")

        use_turbo = False
        # A local GGUF can only be loaded by llama-server, so it needs Turbo
        # whether or not the node asked for it — otherwise picking a local model
        # in an automation would silently post to Ollama, which has never heard
        # of that file. The node's Turbo checkbox still controls the extras.
        needs_turbo = want_turbo or turbo_ctl.is_gguf_ref(model)
        if needs_turbo:
            if want_turbo:
                self.status.log(aid, "ensuring Turbo on %s…" % (model or "?"), "out")
            else:
                self.status.log(
                    aid, "loading local GGUF %s…" % turbo_ctl.model_label(model), "out")
            ok, msg = turbo_ctl.ensure(
                model, spec, on_status=lambda m: self.status.log(aid, m, "out"))
            self.status.log(aid, msg, "ok" if ok else "err")
            use_turbo = ok
            # A GGUF has no Ollama fallback: if the server didn't come up the
            # block must fail loudly instead of quietly asking the wrong engine.
            if not ok and turbo_ctl.is_gguf_ref(model):
                return "err", ""
        else:
            _ensure_ollama()

        label = {"auto": "autonomous", "ask": "with approval"}.get(exec_mode, "advisory")
        self.status.log(aid, "🤖 %s (%s)" % (title, label), "step")
        try:
            reply = self._ai_run(model, prompt, exec_mode, use_turbo, aid)
        except Exception as exc:
            self.status.log(aid, "AI error: %s" % exc, "err")
            return "err", ""
        # Declared outputs: publish them as {{name}} for the blocks downstream.
        #
        # This is what turns the AI block from "prints a paragraph" into a
        # source of values. "Check whether the PC is under heavy load" with
        # outputs cpu and gpu lets the notification after it say
        # "CPU {{cpu}}%, GPU {{gpu}}%" instead of pasting prose at the user.
        if outs:
            fields = _parse_json_fields(reply, [o["name"] for o in outs])
            if fields is None:
                # Deliberately a failure, not a shrug. If we carried on, every
                # {{name}} downstream would render as itself and the automation
                # would "work" while producing a notification full of braces.
                # Failing routes the graph down the err port instead, which is
                # a branch the user can actually handle.
                self.status.log(
                    aid, "AI: expected JSON with %s — got something else"
                    % ", ".join(o["name"] for o in outs), "err")
                for line in (reply or "").splitlines()[:4]:
                    self.status.log(aid, line, "out")
                return "err", (reply or "").strip()
            if vars is not None:
                vars.update(fields)
            _publish(vars, [("ai.reply", (reply or "").strip())])
            summary = ", ".join("%s=%s" % (k, fields[k]) for k in fields)
            self.status.log(aid, "→ " + summary, "ok")
            return "ok", summary

        # Surface the assistant's final words in the log; an advisory block also
        # notifies (it takes no action, so the answer is the whole point).
        if reply:
            for line in reply.splitlines()[-8:]:
                self.status.log(aid, line, "out")
            if exec_mode == "advisory" and shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "--app-name=Genesi AI",
                                  title or "Genesi AI", reply[:400]],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
        _publish(vars, [("ai.reply", (reply or "").strip())])
        return "ok", (reply or "").strip()

    def _ai_chat(self, model, messages, use_turbo, system=None):
        msgs = ([{"role": "system", "content": system}] if system else []) + messages
        if use_turbo:
            body = json.dumps({"messages": msgs, "stream": False,
                               "max_tokens": 768, "cache_prompt": True}).encode()
            req = _request(TURBO + "/v1/chat/completions", body)
            obj = json.loads(_urlread(req, timeout=900))
            choices = obj.get("choices") or []
            return (choices[0].get("message") or {}).get("content", "") if choices else ""
        body = json.dumps({"model": model, "messages": msgs, "stream": False,
                           "keep_alive": "15m"}).encode()
        req = _request(OLLAMA + "/api/chat", body)
        obj = json.loads(_urlread(req, timeout=900))
        return (obj.get("message") or {}).get("content", "")

    def _ai_run(self, model, prompt, mode, use_turbo, aid):
        # Advisory: a single plain answer (no tools, no side effects).
        if mode == "advisory":
            return self._ai_chat(model, [{"role": "user", "content": prompt}],
                                 use_turbo).strip()
        # auto / ask: the bounded tool loop, mirroring the Monitor's agent but
        # headless. In "auto" every action runs; in "ask" each action waits for the
        # user's Approve/Deny (via self.approve, a 5-min gate). Bounded to 6 steps.
        messages = [{"role": "user", "content": prompt}]
        system = agent_system_prompt()
        # Deterministic fast-paths FIRST — exactly like the Monitor's chat. These
        # resolve obvious "open X / run Y in a terminal / install Z" prompts
        # without depending on a small local model emitting perfect JSON, which is
        # the #1 reason the AI block produced no action (and so, in ask mode, never
        # asked for approval and looked like it "did nothing").
        direct_action = (direct_package_action(messages) or direct_terminal_action(messages)
                         or direct_app_action(messages))
        seen = {}
        for _step in range(6):
            if direct_action:
                action = direct_action
                response = json.dumps({"type": "action", **action}, ensure_ascii=False)
                direct_action = None
            else:
                response = self._ai_chat(model, messages, use_turbo, system=system).strip()
                action = parse_agent_action(response)
            if not action:
                if looks_like_agent_action(response):
                    messages.append({"role": "assistant", "content": response})
                    messages.append({"role": "user", "content":
                                     "Your tool call was malformed. Return one valid JSON action."})
                    continue
                return response
            fp = json.dumps({"tool": action["tool"], "arguments": action["arguments"]},
                            sort_keys=True, ensure_ascii=True)
            if fp in seen:
                return summarize_tool_result(action["tool"], seen[fp])
            if mode == "ask" and self.approve is not None:
                if not self.approve(aid, action):
                    self.status.log(aid, "✗ denied: %s" % action["tool"], "err")
                    if action.get("completion"):    # a one-shot direct request
                        return "Action denied."
                    messages.append({"role": "assistant", "content": response})
                    messages.append({"role": "user", "content": "GENESI_TOOL_RESULT\n" +
                                     json.dumps({"ok": False, "error": "The user denied this action."})})
                    continue
            self.status.log(aid, "→ %s" % action["tool"], "cmd")
            result = self._tools.execute(action["tool"], action["arguments"])
            seen[fp] = result
            self.status.log(aid, summarize_tool_result(action["tool"], result),
                            "ok" if result.get("ok") else "err")
            # A deterministic direct action is a complete, single-shot request
            # ("open firefox") — return its friendly completion instead of looping
            # the model over the tool result.
            if action.get("completion"):
                return (action["completion"] if result.get("ok")
                        else summarize_tool_result(action["tool"], result))
            messages.append({"role": "assistant", "content": response})
            messages.append({"role": "user", "content":
                             "GENESI_TOOL_RESULT\n" + json.dumps(result, ensure_ascii=False)})
        return "Stopped after 6 actions."


# ── small HTTP + process helpers ──────────────────────────────────────────────
def _request(url, body):
    return urllib.request.Request(url, data=body,
                                  headers={"Content-Type": "application/json"})


def _urlread(req, timeout=60):
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode()


def _run(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


_GENV_CACHE = {"ts": 0.0, "env": None}     # cache the systemctl lookup a few s


def _graphical_env():
    """An environment for launching GUI apps from this headless --user daemon.

    genesi-automationd is a `systemd --user` service that is deliberately NOT
    tied to graphical-session.target (so it also runs on "No Desktop"), so it
    does not inherit DISPLAY / WAYLAND_DISPLAY. Without them, an action like
    `firefox` or `xdg-open …` dies with "no DISPLAY environment variable
    specified" even though the event fired correctly. We resolve the session's
    display vars from the systemd user manager (the session imports them there
    at login) and fall back to sane defaults, so GUI actions actually open."""
    env = dict(os.environ)
    if env.get("DISPLAY") or env.get("WAYLAND_DISPLAY"):
        return env                          # already in a graphical env
    now = time.monotonic()
    base = _GENV_CACHE["env"]
    if base is None or now - _GENV_CACHE["ts"] > 10:
        base = {}
        try:
            out = subprocess.run(["systemctl", "--user", "show-environment"],
                                 capture_output=True, text=True, timeout=5).stdout
            for line in out.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    base[k] = v
        except Exception:
            pass
        _GENV_CACHE["env"] = base
        _GENV_CACHE["ts"] = now
    for k in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY",
              "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE"):
        if base.get(k) and not env.get(k):
            env[k] = base[k]
    if not env.get("DISPLAY") and not env.get("WAYLAND_DISPLAY"):
        rt = env.get("XDG_RUNTIME_DIR")
        if rt:
            for cand in ("wayland-1", "wayland-0"):
                if os.path.exists(os.path.join(rt, cand)):
                    env["WAYLAND_DISPLAY"] = cand
                    break
        env.setdefault("DISPLAY", ":0")     # last-ditch: the usual X socket
    return env


def _ensure_display_env():
    """Merge the resolved graphical env into this process's os.environ, so every
    subprocess the daemon spawns inherits DISPLAY/WAYLAND_DISPLAY — including the
    AI tool executor (genesi_agent.LocalToolExecutor), whose launch_app/open_path/
    run_in_terminal Popen calls inherit os.environ and would otherwise open apps
    into the void. Idempotent and cheap (the lookup is cached in _graphical_env)."""
    genv = _graphical_env()
    for k in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY",
              "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE"):
        v = genv.get(k)
        if v and not os.environ.get(k):
            os.environ[k] = v


def _ensure_ollama():
    try:
        urllib.request.urlopen(OLLAMA + "/api/tags", timeout=2).read()
        return True
    except Exception:
        pass
    if not shutil.which("ollama"):
        return False
    _run(["systemctl", "start", "ollama"])
    try:
        subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError:
        pass
    for _ in range(10):
        try:
            urllib.request.urlopen(OLLAMA + "/api/tags", timeout=2).read()
            return True
        except Exception:
            time.sleep(1)
    return False


# ── the daemon supervisor ─────────────────────────────────────────────────────
class Daemon:
    def __init__(self):
        self.status = Status()
        self.engine = Engine(self.status)
        self.engine.approve = self._approval_gate
        self.autos = {}                    # id -> automation dict
        self.lock = threading.Lock()
        self._pending = {}                 # req_id -> {event, approved} (AI "ask")
        self._pending_lock = threading.Lock()
        self._fired_once = set()           # (aid, nid) once-nodes already fired
        # aid -> monotonic time until which its triggers stay quiet. Set when
        # a run ends, because that is exactly when the run's own children are
        # exiting and a process-watching trigger would see them.
        self._fire_quiet = {}
        self.engine.quiet_after_run = self._quiet_after_run
        # poll-loop memory
        self._res_prev = {}                # (aid,nid) -> bool satisfied
        self._app_prev = set()             # process names seen last tick
        self._app_primed = False           # skip firing on the first app snapshot
        self._sched_prev = {}              # (aid,nid) -> monotonic/date marker
        self._clip_prev = {}               # (aid,nid) -> last clipboard digest
        self._webhook_srv = None           # the HTTP listener, when one is needed
        self._webhook_addr = None          # (host, port) it is bound to
        self._webhook_target = {}          # path -> (auto, node, cfg)
        self._webhook_err = None           # last bind error, logged once
        self._shot_prev = {}               # (aid,nid) -> {screenshot: mtime}
        self._edge = {}                    # (aid,nid) -> bool, generic edge memory
        self._snap = {}                    # (aid,nid) -> set/str, diff snapshots
        self._offset = {}                  # (aid,nid) -> int, evt_log file offset
        self._cmd_next = {}                # (aid,nid) -> monotonic throttle marker
        self._proc_cache = {}              # pid -> psutil.Process (cpu% continuity)
        self._startup_done = set()         # (aid,nid) evt_startup already fired
        self._usb_primed = False
        self._mount_primed = False
        self._bt_primed = False
        # watchers
        self._inotify = None
        self._hotkeys = None
        self._hk_started = False           # evdev reader thread running?
        self._fs_nodes = []                # [(auto, node)]
        self._hotkey_nodes = []            # [(auto, node, combo)]
        self._stop = threading.Event()

    # -- store -------------------------------------------------------------
    def load(self):
        autos = {}
        os.makedirs(CONFIG_DIR, exist_ok=True)
        for path in globmod.glob(os.path.join(CONFIG_DIR, "*.json")):
            try:
                with open(path, encoding="utf-8") as fh:
                    a = json.load(fh)
            except (OSError, ValueError):
                continue
            aid = a.get("id") or os.path.splitext(os.path.basename(path))[0]
            a["id"] = aid
            autos[aid] = a
        with self.lock:
            self.autos = autos
            # Re-arm "once" nodes for automations that are currently disabled or
            # gone, so toggling one off then on lets it fire again.
            enabled_ids = {aid for aid, a in autos.items() if a.get("enabled")}
            self._fired_once = {k for k in self._fired_once if k[0] in enabled_ids}
        # Outside the lock: _webhook_sync takes it again to read the automations,
        # and binding a socket is not something to do while holding it.
        self._webhook_sync()
        self.status.sync(autos)
        self._rearm()
        self._fire_startup()

    def _fire_startup(self):
        """Fire evt_startup nodes once per daemon session (on first load / login)."""
        with self.lock:
            enabled = [a for a in self.autos.values() if a.get("enabled")]
        for a in enabled:
            for n in a.get("nodes", []):
                if n.get("kind") != "evt_startup":
                    continue
                key = (a["id"], n.get("id"))
                if key in self._startup_done:
                    continue
                self._startup_done.add(key)
                self._fire(a, n, "startup")

    def _rearm(self):
        """(Re)build the watcher registries from the enabled automations."""
        with self.lock:
            enabled = [a for a in self.autos.values() if a.get("enabled")]
        # filesystem
        if self._inotify:
            self._inotify.stop()
        self._fs_nodes = []
        self._inotify = Inotify(self._on_fs_event)
        for a in enabled:
            for n in a.get("nodes", []):
                if n.get("kind") == "evt_fs":
                    cfg = n.get("config", {}) or {}
                    p = cfg.get("path") or ""
                    if p:
                        self._fs_nodes.append((a, n))
                        self._inotify.add_root(p, bool(cfg.get("recursive")))
        threading.Thread(target=self._inotify.run, daemon=True).start()
        # hotkeys
        self._hotkey_nodes = []
        combos = []
        for a in enabled:
            for n in a.get("nodes", []):
                if n.get("kind") == "evt_hotkey":
                    combo = (n.get("config", {}) or {}).get("combo") or ""
                    if combo:
                        self._hotkey_nodes.append((a, n, _combo_keyset(combo)))
                        combos.append(combo)
        if self._hotkeys:
            self._hotkeys.set_combos(combos)

    # -- firing ------------------------------------------------------------
    # How long a workflow's triggers stay deaf after it finishes. Long enough
    # for the shells, notify-send and model servers it started to be reaped;
    # short enough that a real event a moment later is not lost, since the
    # pollers re-check every couple of seconds anyway.
    QUIET_AFTER_RUN = 5.0

    def _quiet_after_run(self, aid):
        self._fire_quiet[aid] = time.monotonic() + self.QUIET_AFTER_RUN

    def _fire(self, auto, node, detail, values=None):
        aid, nid = auto["id"], node.get("id")
        mode = (node.get("config", {}) or {}).get("mode", "always")
        key = (aid, nid)

        # An automation must not be re-triggered by its own side effects.
        #
        # Running a workflow starts processes: a shell for a Run Script,
        # notify-send, a model server, python. Those exit, and a trigger
        # watching for "any app closed" saw them and fired the workflow again,
        # which started more of them. Reported as "it just runs forever", and it
        # is: the loop is real, it is fast, and nothing in the graph is wrong.
        #
        # So a trigger stands down while its own automation is still running,
        # and for a short breath afterwards, which is when the children of the
        # last run are exiting. Nothing legitimate is lost: an event that
        # matters while a run is in flight will still be there on the next tick.
        if self.status.is_running(aid):
            return
        quiet_until = self._fire_quiet.get(aid, 0.0)
        if time.monotonic() < quiet_until:
            return
        if mode == "once":
            with self.lock:
                if key in self._fired_once:
                    return
                self._fired_once.add(key)
        threading.Thread(target=self.engine.run_chain,
                         args=(auto, nid, detail, values), daemon=True).start()

    def _approval_gate(self, aid, action):
        """Block the AI-block worker until the user approves/denies a proposed
        action in the Monitor (or 5 min elapses → deny). Publishes the request in
        status.json (the GUI renders Approve/Deny) and pings a notification."""
        req_id = uuid.uuid4().hex[:12]
        entry = {"event": threading.Event(), "approved": False}
        with self._pending_lock:
            self._pending[req_id] = entry
        tool = action.get("tool", "action")
        self.status.set_pending(aid, [{"id": req_id, "tool": tool,
                                       "reason": action.get("reason", ""),
                                       "title": tool}])
        if shutil.which("notify-send"):
            try:
                subprocess.Popen(
                    ["notify-send", "--app-name=Genesi AI", "--urgency=critical",
                     "Automation needs approval",
                     "The AI wants to run: %s — open the Monitor to approve." % tool],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    start_new_session=True)
            except OSError:
                pass
        ok = entry["event"].wait(300)
        with self._pending_lock:
            self._pending.pop(req_id, None)
        self.status.set_pending(aid, [])
        return bool(ok and entry["approved"])

    # -- filesystem --------------------------------------------------------
    def _on_fs_event(self, full, change, is_dir):
        for auto, node in list(self._fs_nodes):
            cfg = node.get("config", {}) or {}
            root = os.path.abspath(os.path.expanduser(cfg.get("path", "")))
            if not (full == root or full.startswith(root + os.sep)):
                continue
            if not cfg.get("recursive") and os.path.dirname(full) != root:
                continue
            want = cfg.get("change", "any")
            if want not in ("any", change):
                continue
            pattern = cfg.get("pattern") or "*"
            if pattern != "*" and not fnmatch.fnmatch(os.path.basename(full), pattern):
                continue
            self._fire(auto, node, full,
                       {"file.path": full,
                        "file.name": os.path.basename(full),
                        "file.change": change})

    # -- hotkeys -----------------------------------------------------------
    def _on_combo(self, combo_str):
        keyset = _combo_keyset(combo_str)
        for auto, node, ks in list(self._hotkey_nodes):
            if ks == keyset:
                self._fire(auto, node, "hotkey " + combo_str,
                           {"hotkey.combo": combo_str})

    # -- resource / app / schedule poll -----------------------------------
    def _poll_loop(self):
        if psutil:
            psutil.cpu_percent(interval=None)   # prime
        self_path = os.path.abspath(__file__)
        try:
            self_mtime = os.path.getmtime(self_path)
        except OSError:
            self_mtime = 0
        tick = 0
        while not self._stop.is_set():
            try:
                self._poll_once()
            except Exception:
                pass
            tick += 1
            # Every ~10s, if hotkeys still have no input access, try again — the
            # user may have just been added to the 'input' group.
            if tick % 5 == 0 and self._hotkeys and not self._hotkeys.available:
                if self._hotkeys.reopen():
                    self.status.set_hotkey(True)
                    self._start_hotkey_reader()
            # Every ~10s: self-restart when the on-disk daemon changed. This is
            # a per-USER service, so a `pacman -Syu` cannot restart it the way
            # post_upgrade restarts system units — after the pkgrel-129 update
            # the resident OLD daemon kept ignoring link ports ("runs every
            # card at once", 2026-07-19). Re-exec picks the new code up within
            # seconds of the package landing; graphs reload at startup.
            if tick % 5 == 0 and self_mtime:
                try:
                    if os.path.getmtime(self_path) != self_mtime:
                        os.execv(sys.executable,
                                 [sys.executable, self_path] + sys.argv[1:])
                except OSError:
                    pass
            self._stop.wait(POLL_SECONDS)

    def _start_hotkey_reader(self):
        if self._hk_started or not (self._hotkeys and self._hotkeys.available):
            return
        self._hk_started = True
        threading.Thread(target=self._hotkeys.run, daemon=True).start()

    def _edge_fire(self, auto, node, satisfied, detail, values=None):
        """Fire when a boolean condition crosses from false → true (edge)."""
        key = (auto["id"], node.get("id"))
        prev = self._edge.get(key, False)
        self._edge[key] = satisfied
        if satisfied and not prev:
            self._fire(auto, node, detail, values)

    def _poll_once(self):
        with self.lock:
            enabled = [a for a in self.autos.values() if a.get("enabled")]
        kinds = set()
        for a in enabled:
            for n in a.get("nodes", []):
                kinds.add(n.get("kind"))

        # Cheap globals (always safe/fast).
        cpu = psutil.cpu_percent(interval=None) if psutil else None
        ram = psutil.virtual_memory().percent if psutil else None
        appset = set()
        if psutil and ("evt_app" in kinds):
            for pr in psutil.process_iter(["name"]):
                nm = (pr.info.get("name") or "").lower()
                if nm:
                    appset.add(nm)

        # Heavier globals — only when a node needs them.
        batt = (psutil.sensors_battery() if (psutil and "evt_power" in kinds
                and hasattr(psutil, "sensors_battery")) else None)
        online = self._net_online() if "evt_network" in kinds else None
        usbset = self._usb_set() if "evt_usb" in kinds else None
        mountset = self._mount_set() if "evt_disk" in kinds else None
        btset = self._bt_set() if "evt_bluetooth" in kinds else None

        for a in enabled:
            # An event node that is the TARGET of a link is a mid-chain
            # CONDITION (e.g. a Command sensor checking a Run Script's
            # output): it must never poll/fire on its own.
            fed = {l.get("to") for l in a.get("links", [])}
            for n in a.get("nodes", []):
                if n.get("id") in fed:
                    continue
                k = n.get("kind")
                try:
                    if k == "evt_resource":
                        self._poll_resource(a, n, cpu, ram)
                    elif k == "evt_app" and self._app_primed:
                        self._poll_app(a, n, appset)
                    elif k == "evt_schedule":
                        self._poll_schedule(a, n)
                    elif k == "evt_power":
                        self._poll_power(a, n, batt)
                    elif k == "evt_temperature":
                        self._poll_temp(a, n)
                    elif k == "evt_disk":
                        self._poll_disk(a, n, mountset)
                    elif k == "evt_usb" and self._usb_primed:
                        self._poll_usb(a, n, usbset)
                    elif k == "evt_network":
                        self._poll_network(a, n, online)
                    elif k == "evt_process":
                        self._poll_process(a, n)
                    elif k == "evt_idle":
                        self._poll_idle(a, n)
                    elif k == "evt_log":
                        self._poll_log(a, n)
                    elif k == "evt_command":
                        self._poll_command(a, n)
                    elif k == "evt_bluetooth" and self._bt_primed:
                        self._poll_bluetooth(a, n, btset)
                    elif k == "evt_clipboard":
                        self._poll_clipboard(a, n)
                    elif k == "evt_screenshot":
                        self._poll_screenshot(a, n)
                except Exception:
                    pass

        self._app_prev = appset
        self._app_primed = True
        if usbset is not None:
            self._usb_primed = True
        if mountset is not None:
            self._mount_primed = True
        if btset is not None:
            self._bt_primed = True
        if len(self._proc_cache) > 500:
            self._proc_cache = {}

    def _poll_resource(self, auto, node, cpu, ram):
        cfg = node.get("config", {}) or {}
        metric = cfg.get("metric", "cpu")
        value = cpu if metric == "cpu" else ram
        if value is None:
            return
        try:
            thr = float(cfg.get("threshold", 80))
        except (TypeError, ValueError):
            thr = 80.0
        op = cfg.get("op", ">")
        satisfied = value > thr if op == ">" else value < thr
        key = (auto["id"], node.get("id"))
        prev = self._res_prev.get(key, False)
        self._res_prev[key] = satisfied
        if satisfied and not prev:          # edge trigger
            self._fire(auto, node, "%s %s %.0f%% (now %.0f%%)" %
                       (metric.upper(), op, thr, value),
                       {"resource.metric": metric,
                        "resource.value": "%.0f" % value})

    def _poll_app(self, auto, node, appset):
        if not self._app_prev and not appset:
            return
        cfg = node.get("config", {}) or {}
        name = (cfg.get("app") or "").lower().strip()
        trans = cfg.get("transition", "opened")

        # No name means ANY app. It used to mean "never fire", which is the
        # worst of the three possible readings: the node sat on the canvas
        # looking configured and silently did nothing.
        #
        # It reports the process that actually changed, so {{app.name}} is
        # useful downstream and a Condition can filter it. Be aware this sees
        # every process, not only windowed ones — a shell script counts.
        if not name:
            changed = (appset - self._app_prev) if trans == "opened"                 else (self._app_prev - appset)
            if not changed:
                return
            # One event per tick: a login or a build can start dozens at once,
            # and firing the whole workflow for each is never what was meant.
            which = sorted(changed)[0]
            self._fire(auto, node, "app %s: %s" % (trans, which),
                       {"app.name": which, "app.transition": trans})
            return

        was = any(name in n for n in self._app_prev)
        now = any(name in n for n in appset)
        if trans == "opened" and now and not was:
            self._fire(auto, node, "app opened: " + name,
                       {"app.name": name, "app.transition": "opened"})
        elif trans == "closed" and was and not now:
            self._fire(auto, node, "app closed: " + name,
                       {"app.name": name, "app.transition": "closed"})

    def _poll_schedule(self, auto, node):
        cfg = node.get("config", {}) or {}
        key = (auto["id"], node.get("id"))
        cron = (cfg.get("cron") or "").strip()
        if cron:
            self._poll_cron(auto, node, cron)
            return
        at = (cfg.get("time") or "").strip()
        if at and ":" in at:                # HH:MM daily
            today = time.strftime("%Y-%m-%d")
            if time.strftime("%H:%M") == at and self._sched_prev.get(key) != today:
                self._sched_prev[key] = today
                self._fire(auto, node, "scheduled " + at, {"schedule.at": at})
            return
        try:
            minutes = max(0.1, float(cfg.get("interval", 60)))
        except (TypeError, ValueError):
            minutes = 60.0
        last = self._sched_prev.get(key)
        now = time.monotonic()
        if last is None:
            self._sched_prev[key] = now
        elif now - last >= minutes * 60:
            self._sched_prev[key] = now
            self._fire(auto, node, "every %g min" % minutes,
                       {"schedule.at": time.strftime("%H:%M")})

    # -- webhook -----------------------------------------------------------
    #
    # An HTTP endpoint that fires a workflow. This is the one trigger that
    # opens a socket, so the defaults are the careful ones:
    #
    #   * it binds 127.0.0.1 unless the node explicitly asks otherwise, and
    #     asking otherwise REQUIRES a token. A webhook runs shell commands; a
    #     port on 0.0.0.0 with no secret is a remote shell for the whole LAN,
    #     and that must not be something a user can switch on by accident.
    #   * the token is compared with compare_digest, so the reply time does not
    #     tell an attacker how much of it they guessed right.
    #   * it only ever exists while an enabled automation has a webhook node.
    #
    # Loopback-only is not a limitation in practice: a tunnel or a reverse proxy
    # is how a public webhook should reach a laptop anyway, and both terminate
    # somewhere that already does TLS.
    def _webhook_routes(self):
        routes = {}
        with self.lock:
            autos = [a for a in self.autos.values() if a.get("enabled")]
        for auto in autos:
            fed = {l.get("to") for l in auto.get("links", [])}
            for node in auto.get("nodes", []):
                if node.get("kind") != "evt_webhook" or node.get("id") in fed:
                    continue
                cfg = node.get("config", {}) or {}
                path = "/" + (cfg.get("path") or node.get("id") or "hook").strip("/")
                routes[path] = (auto, node, cfg)
        return routes

    def _webhook_sync(self):
        """Bring the listener in line with the current automations."""
        routes = self._webhook_routes()
        if not routes:
            self._webhook_stop()
            return
        port, bind_all = 8737, False
        for _path, (_a, _n, cfg) in routes.items():
            try:
                port = int(cfg.get("port") or 8737)
            except (TypeError, ValueError):
                port = 8737
            if cfg.get("bindAll") and (cfg.get("token") or "").strip():
                bind_all = True
            break
        host = "0.0.0.0" if bind_all else "127.0.0.1"
        self._webhook_target = routes
        if self._webhook_srv is not None:
            if (self._webhook_addr == (host, port)):
                return                       # same socket, new routes: done
            self._webhook_stop()

        import http.server
        daemon = self

        class _Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, *_a):      # never spam the journal
                pass

            def _reply(self, code, text):
                body = text.encode()
                self.send_response(code)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def _handle(self, payload):
                path = self.path.split("?", 1)[0].rstrip("/") or "/"
                entry = (daemon._webhook_target or {}).get(path)
                if entry is None:
                    self._reply(404, "no such hook\n")
                    return
                auto, node, cfg = entry
                token = (cfg.get("token") or "").strip()
                if token:
                    got = (self.headers.get("X-Genesi-Token") or "").strip()
                    if not got:
                        query = self.path.split("?", 1)
                        if len(query) == 2:
                            for pair in query[1].split("&"):
                                key, _, value = pair.partition("=")
                                if key == "token":
                                    got = value
                    if not hmac.compare_digest(got, token):
                        self._reply(403, "bad token\n")
                        return
                daemon._fire(auto, node, payload[:8000],
                             {"webhook.body": payload[:8000],
                              "webhook.path": path})
                self._reply(200, "fired\n")

            def do_POST(self):
                try:
                    length = int(self.headers.get("Content-Length") or 0)
                except ValueError:
                    length = 0
                raw = self.rfile.read(min(length, 1 << 20)) if length else b""
                self._handle(raw.decode("utf-8", "replace"))

            def do_GET(self):
                query = self.path.split("?", 1)
                self._handle(query[1] if len(query) == 2 else "")

        try:
            srv = http.server.ThreadingHTTPServer((host, port), _Handler)
        except OSError as exc:
            # A port already in use must not take the daemon down with it: every
            # other trigger in every other automation still has to work.
            if self._webhook_err != str(exc):
                self._webhook_err = str(exc)
                sys.stderr.write("genesi-automationd: webhook %s:%d — %s\n"
                                 % (host, port, exc))
            return
        self._webhook_err = None
        srv.daemon_threads = True
        self._webhook_srv = srv
        self._webhook_addr = (host, port)
        threading.Thread(target=srv.serve_forever, kwargs={"poll_interval": 0.5},
                         daemon=True).start()
        sys.stderr.write("genesi-automationd: webhook listening on http://%s:%d %s\n"
                         % (host, port, " ".join(sorted(routes))))

    def _webhook_stop(self):
        srv, self._webhook_srv = self._webhook_srv, None
        self._webhook_addr = None
        self._webhook_target = {}
        if srv is not None:
            try:
                srv.shutdown()
                srv.server_close()
            except Exception:
                pass

    # -- clipboard ---------------------------------------------------------
    #
    # Polled, not subscribed. Both Wayland and X11 can push clipboard changes,
    # but only through a toolkit connection to the compositor — and this daemon
    # deliberately has no display-server dependency so it can run on Plasma,
    # Hyprland, a bare tty and a "No Desktop" install alike. A read every couple
    # of seconds costs one short-lived process and cannot get stuck.
    def _clipboard_text(self):
        for argv in (["wl-paste", "--no-newline", "--type", "text/plain"],
                     ["xclip", "-selection", "clipboard", "-o"],
                     ["xsel", "--clipboard", "--output"]):
            if not shutil.which(argv[0]):
                continue
            try:
                done = subprocess.run(argv, capture_output=True, text=True,
                                      timeout=3, env=_graphical_env())
            except (OSError, subprocess.SubprocessError):
                continue
            if done.returncode == 0:
                return done.stdout
        return None

    def _poll_clipboard(self, auto, node):
        cfg = node.get("config", {}) or {}
        key = (auto["id"], node.get("id"))
        text = self._clipboard_text()
        if text is None:
            return
        digest = hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()
        prev = self._clip_prev.get(key)
        self._clip_prev[key] = digest
        # The first read only establishes what is already there. Firing on it
        # would mean every login triggers on whatever was copied yesterday.
        if prev is None or digest == prev:
            return
        stripped = text.strip()
        if not stripped:
            return
        contains = (cfg.get("contains") or "").strip()
        if contains and contains.lower() not in stripped.lower():
            return
        if cfg.get("onlyUrl") and not re.match(r"^[a-z][a-z0-9+.-]*://\S+$",
                                               stripped, re.I):
            return
        self._fire(auto, node, stripped[:2000],
                   {"clipboard.text": stripped})

    # -- screenshot --------------------------------------------------------
    #
    # A new image landing in the screenshots folder. Every desktop Genesi ships
    # writes one there (Spectacle, grim, gnome-screenshot, flameshot), and
    # watching the folder is the one method that works for all of them without
    # hooking a single one.
    def _shot_dir(self, cfg):
        explicit = (cfg.get("path") or "").strip()
        if explicit:
            return os.path.expanduser(explicit)
        home = os.path.expanduser("~")
        pics = home + "/Pictures"
        try:
            with open(home + "/.config/user-dirs.dirs", encoding="utf-8") as fh:
                for line in fh:
                    m = re.match(r'\s*XDG_PICTURES_DIR="(.*)"', line)
                    if m:
                        pics = m.group(1).replace("$HOME", home)
                        break
        except OSError:
            pass
        for name in ("Screenshots", "Capturas de tela", "Screenshot"):
            candidate = os.path.join(pics, name)
            if os.path.isdir(candidate):
                return candidate
        return pics

    def _poll_screenshot(self, auto, node):
        cfg = node.get("config", {}) or {}
        key = (auto["id"], node.get("id"))
        folder = self._shot_dir(cfg)
        try:
            entries = {}
            with os.scandir(folder) as it:
                for entry in it:
                    if not entry.is_file(follow_symlinks=False):
                        continue
                    if os.path.splitext(entry.name)[1].lower() not in _SHOT_EXTS:
                        continue
                    entries[entry.name] = entry.stat().st_mtime
        except OSError:
            return
        prev = self._shot_prev.get(key)
        self._shot_prev[key] = entries
        if prev is None:                    # first pass: learn, do not fire
            return
        fresh = [n for n in entries if n not in prev]
        if not fresh:
            return
        newest = max(fresh, key=lambda n: entries[n])
        path = os.path.join(folder, newest)
        self._fire(auto, node, path,
                   {"screenshot.path": path, "screenshot.name": newest})

    # -- cron --------------------------------------------------------------

    def _poll_cron(self, auto, node, expr):
        """A 5-field cron expression, checked once a minute.

        Written out rather than pulled from a library because the daemon is
        stdlib-only, and because the subset people actually type — *, lists,
        ranges and */step — is a dozen lines. Anything it cannot parse does not
        fire, which is the safe direction for something that runs commands.
        """
        key = (auto["id"], node.get("id"))
        stamp = time.strftime("%Y-%m-%d %H:%M")
        if self._sched_prev.get(key) == stamp:
            return                          # already handled this minute
        now = time.localtime()
        fields = (now.tm_min, now.tm_hour, now.tm_mday, now.tm_mon,
                  0 if now.tm_wday == 6 else now.tm_wday + 1)
        parts = expr.split()
        if len(parts) != 5:
            return
        for part, value in zip(parts, fields):
            if not _cron_match(part, value):
                return
        self._sched_prev[key] = stamp
        self._fire(auto, node, "cron " + expr, {"schedule.at": stamp})

    # -- power / battery ---------------------------------------------------
    def _poll_power(self, auto, node, batt):
        cfg = node.get("config", {}) or {}
        ev = cfg.get("event", "on_battery")
        plugged = True if batt is None else bool(batt.power_plugged)
        pct = None if batt is None else batt.percent
        if ev == "on_ac":
            self._edge_fire(auto, node, plugged, "AC plugged in",
                            {"power.event": "on_ac",
                             "power.level": "" if pct is None else "%.0f" % pct})
        elif ev == "on_battery":
            self._edge_fire(auto, node, not plugged, "on battery",
                            {"power.event": "on_battery",
                             "power.level": "" if pct is None else "%.0f" % pct})
        elif ev in ("battery_below", "battery_above") and pct is not None:
            try:
                level = float(cfg.get("level", 20))
            except (TypeError, ValueError):
                level = 20.0
            sat = pct < level if ev == "battery_below" else pct > level
            self._edge_fire(auto, node, sat, "battery %.0f%% %s %.0f%%" %
                            (pct, "<" if ev == "battery_below" else ">", level),
                            {"power.event": ev, "power.level": "%.0f" % pct})

    # -- temperature -------------------------------------------------------
    def _poll_temp(self, auto, node):
        if not (psutil and hasattr(psutil, "sensors_temperatures")):
            return
        cfg = node.get("config", {}) or {}
        want = (cfg.get("sensor") or "").lower().strip()
        try:
            thr = float(cfg.get("threshold", 80))
        except (TypeError, ValueError):
            thr = 80.0
        hottest = None
        try:
            temps = psutil.sensors_temperatures()
        except Exception:
            return
        for chip, entries in (temps or {}).items():
            for e in entries:
                label = ((e.label or "") + " " + chip).lower()
                if want and want not in label:
                    continue
                if e.current is not None:
                    hottest = e.current if hottest is None else max(hottest, e.current)
        if hottest is None:
            return
        self._edge_fire(auto, node, hottest > thr,
                        "temp %.0f°C > %.0f°C" % (hottest, thr),
                        {"temp.value": "%.0f" % hottest,
                         "temp.sensor": (cfg.get("sensor") or "").strip()})

    # -- disk (usage threshold / mount / unmount) --------------------------
    def _mount_set(self):
        if not psutil:
            return set()
        try:
            return {p.mountpoint for p in psutil.disk_partitions(all=False)}
        except Exception:
            return set()

    def _poll_disk(self, auto, node, mountset):
        cfg = node.get("config", {}) or {}
        ev = cfg.get("event", "usage_above")
        if ev == "usage_above":
            if not psutil:
                return
            path = cfg.get("path") or "/"
            try:
                thr = float(cfg.get("threshold", 90))
                pct = psutil.disk_usage(os.path.expanduser(path)).percent
            except Exception:
                return
            self._edge_fire(auto, node, pct > thr,
                            "disk %s %.0f%% > %.0f%%" % (path, pct, thr),
                            {"disk.path": path, "disk.value": "%.0f" % pct})
            return
        if mountset is None:
            return
        key = (auto["id"], node.get("id"))
        prev = self._snap.get(key, set())
        self._snap[key] = mountset
        if not self._mount_primed:
            return
        if ev == "mounted":
            for m in sorted(mountset - prev):
                self._fire(auto, node, "mounted: " + m,
                           {"disk.path": m, "disk.event": "mounted"})
        elif ev == "unmounted":
            for m in sorted(prev - mountset):
                self._fire(auto, node, "unmounted: " + m,
                           {"disk.path": m, "disk.event": "unmounted"})

    # -- USB device add / remove ------------------------------------------
    def _usb_set(self):
        if shutil.which("lsusb"):
            try:
                out = subprocess.run(["lsusb"], capture_output=True, text=True,
                                     timeout=5).stdout
                return {ln.strip() for ln in out.splitlines() if ln.strip()}
            except Exception:
                pass
        # Fallback: /sys entries that are real devices (N-N, not hubs/ifaces).
        found = set()
        for p in globmod.glob("/sys/bus/usb/devices/*"):
            b = os.path.basename(p)
            if re.match(r"^\d+-\d+(\.\d+)*$", b):
                found.add(b)
        return found

    def _poll_usb(self, auto, node, usbset):
        if usbset is None:
            return
        cfg = node.get("config", {}) or {}
        action = cfg.get("action", "added")
        key = (auto["id"], node.get("id"))
        prev = self._snap.get(key, set())
        self._snap[key] = usbset
        added = usbset - prev
        removed = prev - usbset
        if action == "added":
            for d in sorted(added):
                self._fire(auto, node, "USB added: " + d[-40:],
                           {"usb.action": "added", "usb.device": d})
        elif action == "removed":
            for d in sorted(removed):
                self._fire(auto, node, "USB removed: " + d[-40:],
                           {"usb.action": "removed", "usb.device": d})

    # -- network online/offline, interface up/down ------------------------
    def _net_online(self):
        try:
            s = socket.create_connection(("1.1.1.1", 53), timeout=1.5)
            s.close()
            return True
        except OSError:
            return False

    def _poll_network(self, auto, node, online):
        cfg = node.get("config", {}) or {}
        ev = cfg.get("event", "online")
        if ev in ("online", "offline"):
            if online is None:
                return
            self._edge_fire(auto, node, online if ev == "online" else not online,
                            "internet " + ("online" if ev == "online" else "offline"),
                            {"network.event": ev, "network.iface": ""})
        elif ev in ("iface_up", "iface_down") and psutil:
            iface = (cfg.get("iface") or "").strip()
            try:
                stats = psutil.net_if_stats()
            except Exception:
                return
            up = bool(stats.get(iface).isup) if iface in stats else False
            self._edge_fire(auto, node, up if ev == "iface_up" else not up,
                            "%s %s" % (iface, "up" if ev == "iface_up" else "down"),
                            {"network.event": ev, "network.iface": iface})

    # -- a named process over a CPU% / RAM threshold ----------------------
    def _poll_process(self, auto, node):
        if not psutil:
            return
        cfg = node.get("config", {}) or {}
        name = (cfg.get("app") or "").lower().strip()
        if not name:
            return
        metric = cfg.get("metric", "mem")
        try:
            thr = float(cfg.get("threshold", 1000))
        except (TypeError, ValueError):
            thr = 1000.0
        total = 0.0
        for pr in psutil.process_iter(["pid", "name"]):
            nm = (pr.info.get("name") or "").lower()
            if name not in nm:
                continue
            try:
                if metric == "cpu":
                    pid = pr.info["pid"]
                    p = self._proc_cache.get(pid)
                    if p is None:
                        p = pr
                        self._proc_cache[pid] = p
                    total += p.cpu_percent(None)
                else:
                    total += pr.memory_info().rss / (1024.0 * 1024.0)
            except Exception:
                continue
        unit = "%" if metric == "cpu" else "MB"
        self._edge_fire(auto, node, total > thr,
                        "%s %s %.0f%s > %.0f%s" % (name, metric, total, unit, thr, unit))

    # -- user idle / active (from the evdev last-input clock) --------------
    def _poll_idle(self, auto, node):
        if not (self._hotkeys and self._hotkeys.available):
            return
        cfg = node.get("config", {}) or {}
        try:
            mins = float(cfg.get("minutes", 5))
        except (TypeError, ValueError):
            mins = 5.0
        idle = self._hotkeys.idle_seconds()
        is_idle = idle >= mins * 60
        ev = cfg.get("event", "idle")
        key = (auto["id"], node.get("id"))
        prev = self._edge.get(key, False)
        self._edge[key] = is_idle
        if ev == "idle" and is_idle and not prev:
            self._fire(auto, node, "idle for %g min" % mins,
                       {"idle.minutes": "%g" % mins})
        elif ev == "active" and (not is_idle) and prev:
            self._fire(auto, node, "back from idle", {"idle.minutes": "0"})

    # -- a log/text file gets a new line matching a regex -----------------
    def _poll_log(self, auto, node):
        cfg = node.get("config", {}) or {}
        path = os.path.expanduser(cfg.get("path", ""))
        if not path or not os.path.isfile(path):
            return
        key = (auto["id"], node.get("id"))
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        off = self._offset.get(key)
        if off is None:                    # prime: start at EOF, don't backfill
            self._offset[key] = size
            return
        if size < off:                     # rotated/truncated
            off = 0
        if size == off:
            return
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                fh.seek(off)
                data = fh.read()
                self._offset[key] = fh.tell()
        except OSError:
            return
        pattern = cfg.get("pattern") or ""
        rx = None
        if pattern:
            try:
                rx = re.compile(pattern)
            except re.error:
                rx = None
        for line in data.splitlines():
            if not line.strip():
                continue
            if rx is None or rx.search(line):
                self._fire(auto, node, line.strip(),
                           {"log.line": line.strip(),
                            "log.path": path})
                if rx is None:
                    break              # no filter → one fire per batch is enough

    # -- a custom command "sensor" (poll a command, fire on its result) ---
    def _poll_command(self, auto, node):
        cfg = node.get("config", {}) or {}
        command = (cfg.get("command") or "").strip()
        if not command:
            return
        key = (auto["id"], node.get("id"))
        now = time.monotonic()
        try:
            every = max(2.0, float(cfg.get("interval", 30)))
        except (TypeError, ValueError):
            every = 30.0
        if now < self._cmd_next.get(key, 0):
            return
        self._cmd_next[key] = now + every
        try:
            proc = subprocess.run(["/bin/sh", "-lc", command], capture_output=True,
                                  text=True, timeout=30, env=_graphical_env())
        except Exception:
            return
        # Match against stdout AND stderr — "command not found" and most error
        # text go to stderr, which a stdout-only match silently missed
        # (reported 2026-07-19).
        out = ((proc.stdout or "").strip() + "\n"
               + (proc.stderr or "").strip()).strip()
        ev = cfg.get("on", "exit0")
        if ev == "exit0":
            self._edge_fire(auto, node, proc.returncode == 0, "command exit 0")
        elif ev == "error":
            self._edge_fire(auto, node, proc.returncode != 0, "command failed")
        elif ev == "match":
            pattern = cfg.get("match") or ""
            try:
                hit = bool(re.search(pattern, out)) if pattern else bool(out)
            except re.error:
                hit = False
            self._edge_fire(auto, node, hit, "command output matched")
        elif ev == "changed":
            prev = self._snap.get(key)
            self._snap[key] = out
            if prev is not None and out != prev:
                self._fire(auto, node, "command output changed")

    # -- bluetooth device connected / disconnected ------------------------
    def _bt_set(self):
        if not shutil.which("bluetoothctl"):
            return set()
        try:
            out = subprocess.run(["bluetoothctl", "devices", "Connected"],
                                 capture_output=True, text=True, timeout=5).stdout
            return {ln.split(" ", 2)[2] if len(ln.split(" ", 2)) > 2 else ln
                    for ln in out.splitlines() if ln.startswith("Device")}
        except Exception:
            return set()

    def _poll_bluetooth(self, auto, node, btset):
        if btset is None:
            return
        cfg = node.get("config", {}) or {}
        action = cfg.get("action", "connected")
        want = (cfg.get("name") or "").lower().strip()
        key = (auto["id"], node.get("id"))
        prev = self._snap.get(key, set())
        self._snap[key] = btset
        changed = (btset - prev) if action == "connected" else (prev - btset)
        for d in sorted(changed):
            if want and want not in d.lower():
                continue
            self._fire(auto, node, "BT %s: %s" % (action, d),
                       {"bt.action": action, "bt.device": d})

    # -- manual run (from the GUI) ----------------------------------------
    def run_now(self, aid):
        with self.lock:
            auto = self.autos.get(aid)
        if not auto:
            return "unknown automation"
        # Event nodes fed by a link are mid-chain conditions, not triggers.
        fed = {l.get("to") for l in auto.get("links", [])}
        manual = [n for n in auto.get("nodes", [])
                  if n.get("kind") == "evt_manual" and n.get("id") not in fed]
        triggers = [n for n in auto.get("nodes", [])
                    if n.get("kind") in EVENT_KINDS and n.get("kind") != "evt_manual"
                    and n.get("id") not in fed]
        if manual:
            for n in manual:
                threading.Thread(target=self.engine.run_chain,
                                 args=(auto, n.get("id"), "manual run"),
                                 daemon=True).start()
        elif triggers:
            # Test run: fire each trigger's action chain exactly as the real
            # event would — so "Run now" exercises the actual wiring
            # (event → actions), instead of firing every stray action on the
            # sheet. For a "hotkey → run script" graph this runs the script,
            # just as pressing the hotkey does.
            for n in triggers:
                threading.Thread(target=self.engine.run_chain,
                                 args=(auto, n.get("id"), "test run"),
                                 daemon=True).start()
        else:
            # No trigger at all: run every action node in order.
            keep = {n.get("id") for n in auto.get("nodes", [])
                    if n.get("kind") in ACTION_KINDS}
            seq = self.engine._topo(auto, keep)
            self.status.state(aid, "running", running=True)
            threading.Thread(target=self._run_all,
                             args=(auto, seq), daemon=True).start()
        return "ok"

    def _run_all(self, auto, seq):
        aid = auto["id"]
        try:
            for node in seq:
                self.engine._run_action(auto, node, "")
        finally:
            self.status.state(aid, "listening" if auto.get("enabled") else "idle",
                              running=False)

    # -- control socket ----------------------------------------------------
    def _serve_socket(self):
        try:
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            srv.bind(SOCK_PATH)
            os.chmod(SOCK_PATH, 0o600)
            srv.listen(8)
        except OSError as exc:
            sys.stderr.write("genesi-automationd: socket bind failed: %s\n" % exc)
            return
        srv.settimeout(1.0)
        while not self._stop.is_set():
            try:
                conn, _addr = srv.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            threading.Thread(target=self._handle_conn, args=(conn,),
                             daemon=True).start()

    def _handle_conn(self, conn):
        try:
            conn.settimeout(30)     # capture-hotkey can block ~12s before replying
            data = conn.recv(65536).decode("utf-8", "replace").strip()
            try:
                msg = json.loads(data) if data else {}
            except ValueError:
                msg = {}
            reply = self._dispatch_cmd(msg)
            conn.sendall((json.dumps(reply) + "\n").encode())
        except OSError:
            pass
        finally:
            try:
                conn.close()
            except OSError:
                pass

    def _dispatch_cmd(self, msg):
        cmd = msg.get("cmd")
        if cmd == "ping":
            return {"ok": True, "hotkeyAvailable": bool(
                self._hotkeys and self._hotkeys.available)}
        if cmd == "reload":
            self.load()
            return {"ok": True}
        if cmd == "run-now":
            return {"ok": True, "result": self.run_now(msg.get("id", ""))}
        if cmd in ("approve", "deny"):
            rid = msg.get("id", "")
            with self._pending_lock:
                entry = self._pending.get(rid)
                if entry:
                    entry["approved"] = (cmd == "approve")
                    entry["event"].set()
                    return {"ok": True}
            return {"ok": False, "error": "no such approval request"}
        if cmd == "capture-hotkey":
            hk = self._hotkeys
            # Last-ditch: try to gain input access right now (group just added).
            if hk and not hk.available and hk.reopen():
                self.status.set_hotkey(True)
                self._start_hotkey_reader()
            if not (hk and hk.available):
                return {"ok": False, "combo": "", "error": "no-input-access"}
            combo = hk.capture(float(msg.get("timeout", 12)))
            return {"ok": bool(combo), "combo": combo,
                    "error": "" if combo else "no-keys"}
        return {"ok": False, "error": "unknown command"}

    # -- config-dir watch (reload when the GUI saves) ---------------------
    def _watch_config(self):
        watcher = Inotify(lambda *_: self._debounced_reload())
        watcher.add_root(CONFIG_DIR, recursive=False)
        if watcher.ok:
            threading.Thread(target=watcher.run, daemon=True).start()
        else:                               # fallback: poll dir mtime
            last = 0
            while not self._stop.is_set():
                try:
                    m = os.stat(CONFIG_DIR).st_mtime
                except OSError:
                    m = 0
                if m != last:
                    last = m
                    self._debounced_reload()
                self._stop.wait(3.0)

    _reload_timer = None

    def _debounced_reload(self):
        if self._reload_timer and self._reload_timer.is_alive():
            return
        self._reload_timer = threading.Timer(0.6, self.load)
        self._reload_timer.daemon = True
        self._reload_timer.start()

    # -- lifecycle ---------------------------------------------------------
    def run(self):
        self._hotkeys = Hotkeys(self._on_combo)
        self.status.set_hotkey(self._hotkeys.available)
        self._start_hotkey_reader()
        self.load()
        threading.Thread(target=self._poll_loop, daemon=True).start()
        threading.Thread(target=self._serve_socket, daemon=True).start()
        threading.Thread(target=self._watch_config, daemon=True).start()
        try:
            while not self._stop.is_set():
                self._stop.wait(3600)
        except KeyboardInterrupt:
            pass

    def stop(self):
        self._stop.set()
        if self._inotify:
            self._inotify.stop()
        if self._hotkeys:
            self._hotkeys.stop()


def main():
    daemon = Daemon()
    import signal as _signal
    _signal.signal(_signal.SIGTERM, lambda *_a: daemon.stop())
    _signal.signal(_signal.SIGINT, lambda *_a: daemon.stop())
    daemon.run()


if __name__ == "__main__":
    main()
