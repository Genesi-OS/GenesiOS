class _Walk:
    """Everything one automation run needs to carry, including nested walks.

    A single object instead of six parameters threaded through every executor.
    It is created per run and never touched by another: two automations can be
    walking at the same moment, and one reading the other's values would be a
    bug nobody could reproduce on purpose.
    """

    # A whole run, loop bodies included. The old guard was 128 steps for a flat
    # walk; a loop of 50 items over a 4-block branch is 200 legitimate steps, so
    # the ceiling has to be a budget for the RUN rather than for the graph.
    BUDGET = 2000

    def __init__(self, auto, nodes, outgoing, detail):
        self.auto = auto
        self.nodes = nodes
        self.outgoing = outgoing
        self.vars = {"trigger": detail or ""}
        self.ran = set()
        self.skipped = set()
        self.steps = 0
        self.budget = self.BUDGET
        self.depth = 0          # nesting: loops and sub-workflows raise it

