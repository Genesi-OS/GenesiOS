# Ensure the release-hosted [genesi-cuda] repo is configured, so AI Mode's
# "switch to CUDA" button can `pacman -S genesi-llama-cpp-cuda` (the prebuilt
# ~122 MB package that can't live in the git-hosted [genesi] repo). Idempotent;
# new installs already get it from the ISO's pacman.conf, this covers existing
# systems upgrading into a build that has the CUDA package. NVIDIA-only download,
# and only ever pulled on demand — merely having the repo configured costs
# nothing.
_seed_cuda_repo() {
    if ! grep -q '^\[genesi-cuda\]' /etc/pacman.conf 2>/dev/null; then
        printf '\n[genesi-cuda]\nSigLevel = Optional TrustAll\nServer = https://github.com/Genesi-OS/GenesiOS/releases/download/cuda-repo\n' >> /etc/pacman.conf 2>/dev/null \
            && echo "==> Added [genesi-cuda] repo to /etc/pacman.conf" || true
    fi
}

# Automations hotkey blocks read /dev/input via evdev, which is root:input 0640 —
# so add every human user to the 'input' group. Universal (works on X11 + every
# Wayland compositor Genesi ships); takes effect on next login. Everything else in
# Automations (files, CPU/RAM, apps, schedule) already works without this.
_grant_input_access() {
    getent group input >/dev/null 2>&1 || groupadd -r input 2>/dev/null || true
    local u
    for u in $(getent passwd | awk -F: '$3>=1000 && $3<60000 {print $1}'); do
        if ! id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx input; then
            gpasswd -a "$u" input >/dev/null 2>&1 || true
        fi
    done
}

post_install() {
    _seed_cuda_repo
    echo "==> Creating AI Mode runtime directory..."
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/genesi-ai-mode.conf 2>/dev/null || true
    echo "==> Applying AI Mode sysctl tuning..."
    sysctl --system >/dev/null 2>&1 || true
    # Pick up the Ollama drop-in (no-op until Ollama is installed).
    systemctl daemon-reload 2>/dev/null || true
    echo "==> Enabling genesi-aid service..."
    systemctl enable genesi-aid.service 2>/dev/null || true
    # Nightly self-calibration (autotuner). The timer only fires the bench when
    # the machine is idle + on AC, so enabling it by default is safe.
    echo "==> Enabling nightly AI autotuner timer..."
    systemctl enable genesi-ai-tune.timer 2>/dev/null || true
    # Per-user Automations engine is auto-enabled via its default.target.wants
    # symlink; grant input access so hotkey blocks work after next login.
    _grant_input_access
    echo "==> Automations engine will start on next login (genesi-automationd)."
    echo "==> AI Mode is ready. Start now with: sudo systemctl start genesi-aid"
}

post_upgrade() {
    _seed_cuda_repo
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/genesi-ai-mode.conf 2>/dev/null || true
    sysctl --system >/dev/null 2>&1 || true
    echo "==> Restarting genesi-aid service..."
    systemctl daemon-reload 2>/dev/null || true
    systemctl restart genesi-aid.service 2>/dev/null || true
    # Enable the autotuner timer for systems upgrading from a build without it.
    systemctl enable genesi-ai-tune.timer 2>/dev/null || true
    # Grant input access for Automations hotkeys on systems upgrading into this
    # build (the per-user genesi-automationd auto-enables via its wants symlink).
    _grant_input_access
    # Aplica as novas permissões de leitura no diretório de modelos do Ollama
    systemctl try-restart ollama.service 2>/dev/null || true
}

pre_remove() {
    echo "==> Stopping and disabling genesi-aid service..."
    systemctl stop genesi-aid.service 2>/dev/null || true
    systemctl disable genesi-aid.service 2>/dev/null || true
    # Also tear down the optional always-warm Turbo unit so it isn't orphaned.
    systemctl disable --now genesi-turbo.service 2>/dev/null || true
    # And the nightly autotuner timer.
    systemctl disable --now genesi-ai-tune.timer 2>/dev/null || true
}
