#!/usr/bin/env python3
"""genesi-find — find a file by describing it, not by naming it.

    genesi-find "the contract PDF I saved last month"
    genesi-find "aquela foto do churrasco que eu baixei ontem"
    genesi-find -p ~/Projetos "the config with the database password"

THE MODEL NEVER TOUCHES YOUR DISK. It does exactly one job: turn the sentence
into a filter — words, extensions, a date range, maybe a standard folder. That
filter is then validated (an extension has to look like an extension, a folder
has to be one of a fixed list) and executed locally by this script. A model that
hallucinated `/etc/shadow` would get a filter with a bad folder name, and the
filter would be dropped, because nothing it returns is ever treated as a path.

With no model warm it still works. The built-in parser understands the same
shapes in English and Portuguese — "last month", "mês passado", "photo", "foto",
"planilha", "spreadsheet" — and searching by those alone is already most of what
people want. That is the difference between a feature and a demo: it degrades
into a plain search instead of into an error.

The GUI (genesi-find-ui, and "Search with AI here" in Dolphin) is a front end
over `genesi-find --json`. This file is the single source of truth.
"""

import argparse
import json
import os
import re
import sys
import time
import unicodedata

sys.path.insert(0, "/usr/share/genesi-ai-mode")
try:
    import genesi_ai_assist as assist        # noqa: E402
except ImportError:                          # running from a source checkout
    assist = None

DIM = "\033[2m"
BOLD = "\033[1m"
CYAN = "\033[36m"
RESET = "\033[0m"

# Walking a home directory has to have a ceiling, or one forgotten 200k-file
# directory turns a search into a hang.
MAX_ENTRIES = 300000
MAX_SECONDS = 6.0

# Directories that are never what someone is looking for and are usually the
# biggest thing in a home directory. Pruning these is most of the speed.
# `build`, `dist` and `out` are deliberately NOT here: people do look for things
# in them, and they are rarely enormous. `target` is (Rust), so it is.
SKIP_DIRS = {
    ".git", ".svn", ".hg", ".cache", ".ccache", "__pycache__", "node_modules",
    ".venv", "venv", ".npm", ".yarn", ".pnpm-store", ".cargo", ".rustup",
    ".gradle", ".m2", ".nuget", ".gem", ".pub-cache", "site-packages",
    "target", ".next", ".nuxt", ".terraform", ".tox", ".mypy_cache",
    "Trash", ".Trash", ".local/share/Trash", ".steam", "Steam", ".wine",
    ".var", ".flatpak", ".mozilla", ".thunderbird", ".zoom", "Snap", "snap",
}

# What a word means, when someone says it instead of an extension.
#
# ONLY words about the FORM of the file belong here. "contract", "report" and
# "project" were in this list and it was a real bug: they are what the file is
# ABOUT, so consuming them here meant that "aquele pdf do contrato" searched for
# any PDF at all and threw away the one word that would have found it. Same
# reason "arquivo" is not a trigger for archives — in Portuguese it just means
# "file".
KINDS = {
    "image": ("jpg jpeg png gif webp heic bmp tiff svg avif",
              ("photo", "photos", "picture", "pictures", "image", "images",
               "screenshot", "foto", "fotos", "imagem", "imagens", "print",
               "captura")),
    "video": ("mp4 mkv mov avi webm m4v wmv flv",
              ("video", "videos", "movie", "movies", "film", "clip", "filme",
               "filmes")),
    "audio": ("mp3 flac wav ogg m4a opus aac",
              ("audio", "song", "songs", "music", "musica", "musicas",
               "podcast")),
    "doc": ("pdf docx doc odt rtf txt md tex epub",
            ("document", "documents", "doc", "docs", "text", "documento",
             "documentos", "texto")),
    "sheet": ("xlsx xls csv ods tsv",
              ("spreadsheet", "spreadsheets", "sheet", "planilha", "planilhas")),
    "slides": ("pptx ppt odp key",
               ("presentation", "slides", "deck", "apresentacao", "slide")),
    "archive": ("zip tar gz xz bz2 7z rar zst iso",
                ("zip", "compressed", "compactado", "zipado")),
    "code": ("py js ts tsx jsx rs go c h cpp hpp java kt rb php sh fish lua sql",
             ("code", "script", "scripts", "codigo", "fonte")),
    "config": ("conf cfg ini toml yaml yml json env",
               ("config", "configuration", "settings", "configuracao",
                "ajustes")),
}

# "when", in both languages. Longest phrases first so "last month" is not eaten
# by "month".
WHEN = [
    (r"\b(today|hoje)\b", 1),
    (r"\b(yesterday|ontem)\b", 2),
    (r"\b(this week|esta semana|essa semana)\b", 7),
    (r"\b(last week|semana passada|semana retrasada)\b", 14),
    (r"\b(this month|este mes|esse mes)\b", 31),
    (r"\b(last month|mes passado)\b", 62),
    (r"\b(this year|este ano|esse ano)\b", 365),
    (r"\b(last year|ano passado)\b", 730),
    (r"\b(recent|recently|recente|recentemente|ultimos dias)\b", 30),
    (r"\b(\d+)\s*(days?|dias?)\b", None),      # "3 days ago" → 3
    (r"\b(\d+)\s*(weeks?|semanas?)\b", None),
    (r"\b(\d+)\s*(months?|meses)\b", None),
]

# XDG folder names people say out loud. These are PHRASES, not word lists:
# splitting "area de trabalho" on spaces put a bare "de" in the table, and every
# Portuguese sentence contains "de", so every search was silently confined to
# the Desktop.
DIR_WORDS = {
    "download": ("download", "downloads", "downloaded", "baixados", "baixei",
                 "baixado", "baixada"),
    "document": ("document", "documents", "documento", "documentos"),
    "picture": ("picture", "pictures", "imagem", "imagens", "foto", "fotos"),
    "video": ("video", "videos", "filme", "filmes"),
    "music": ("music", "musica", "musicas", "song", "songs"),
    "desktop": ("desktop", "area de trabalho"),
}
XDG_KEYS = {
    "download": "XDG_DOWNLOAD_DIR", "document": "XDG_DOCUMENTS_DIR",
    "picture": "XDG_PICTURES_DIR", "video": "XDG_VIDEOS_DIR",
    "music": "XDG_MUSIC_DIR", "desktop": "XDG_DESKTOP_DIR",
}

# Words that describe the ASKING, not the file. Keeping them would make every
# search look for a file literally named "aquele arquivo que eu baixei".
STOPWORDS = set("""
