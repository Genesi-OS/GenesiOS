def engine_argv(engine):
    """How to start the engine. A .py engine is the stand-in ci/image-cli-test.py
    uses, run through this interpreter so the test also runs where a shebang
    does not (a Windows dev box)."""
    return [sys.executable, engine] if engine.endswith(".py") else [engine]


def build_generate_argv(engine, model, prompt, out_path, width, height,
                        steps=None, seed=-1, ref=None, extra_flags=()):
    d = model["defaults"]
    argv = engine_argv(engine)
    for role, cid in model["parts"].items():
        argv += [PART_FLAGS[role], component_path(cid)]
    argv += ["-p", prompt,
             "-W", str(int(width)), "-H", str(int(height)),
             "--steps", str(int(steps or d.get("steps", 20))),
             "--cfg-scale", str(d.get("cfg", 1.0)),
             "--seed", str(int(seed)),
             "-o", out_path]
    if d.get("sampler"):
        argv += ["--sampling-method", d["sampler"]]
    if ref:
        argv += ["-r", ref]
    # Flash attention in the diffusion model only: the big VRAM saving, and
    # the one path every backend of the pinned ggml implements.
    argv += ["--diffusion-fa"]
    argv += list(extra_flags)
    return argv


def build_upscale_argv(engine, model, src, out_path):
    return engine_argv(engine) + ["-M", "upscale",
            "--upscale-model", component_path(model["parts"]["upscale"]),
            "-i", src, "-o", out_path]


# A progress bar from sd-cli's pretty_progress: "|====>   | 3/4 - 1.23s/it".
# The SAME printer also draws the model-loading bar, in bytes per second.
_PROG = re.compile(r"(\d+)/(\d+) - ([\d.]+)\s*(s/it|it/s|[KMG]B/s)")


class ProgressParser:
    """Turns sd-cli's terminal output into phases the page can show.

    The output mixes \\r-redrawn bars with log lines, so it is fed raw chunks
    and splits on BOTH. Phases: load (weights going to the GPU, a bytes bar),
    encode (the prompt through the text model), sample (the steps),
    decode (latent to pixels), upscale.
    """

    def __init__(self):
        self.buf = ""
        self.phase = "load"
        self.last_error = ""

    def feed(self, text):
        self.buf += text
        events = []
        parts = re.split(r"[\r\n]", self.buf)
        self.buf = parts.pop()
        for line in parts:
            ev = self._line(line)
            if ev:
                events.append(ev)
        # A bar redrawn with \r and no newline yet still says where we are.
        if self.buf:
            ev = self._bar(self.buf)
            if ev:
                events.append(ev)
        return events

    def _bar(self, line):
        m = _PROG.search(line)
        if not m:
            return None
        step, steps, unit = int(m.group(1)), int(m.group(2)), m.group(4)
        if unit.endswith("B/s"):
            # Weights load lazily, one model at a time: the VAE's bytes bar
            # comes AFTER the steps. Once drawing has started, a load bar is
            # part of finishing -- reporting it as "load" sent the page's bar
            # back to 10% at the very end of a run.
            if self.phase in ("sample", "decode"):
                self.phase = "decode"
                return {"kind": "phase", "phase": "decode"}
            phase = "load"
        else:
            phase = "upscale" if self.phase == "upscale" else "sample"
        if phase == "sample":
            self.phase = "sample"
        rate = float(m.group(3))
        sec_per_it = rate if unit == "s/it" else (1.0 / rate if rate else 0.0)
        return {"kind": "progress", "phase": phase, "step": step, "steps": steps,
                "sec_per_step": round(sec_per_it, 3) if phase != "load" else None}

    def _line(self, line):
        line = line.strip()
        if not line:
            return None
        bar = self._bar(line)
        if bar:
            return bar
        low = line.lower()
        if "[error" in low or "error:" in low or "failed" in low:
            self.last_error = re.sub(r"^\[[A-Z]+\s*\]\s*", "", line)[:300]
        # The prompt has been through the text model: sampling is next.
        if "condition" in low and "completed" in low:
            return {"kind": "phase", "phase": "encode"}
        if "sampling completed" in low:
            self.phase = "decode"
            return {"kind": "phase", "phase": "decode"}
        if "upscaling from" in low or ("upscal" in low and "loading" in low):
            self.phase = "upscale"
            return {"kind": "phase", "phase": "upscale"}
        return None


def ollama_unload_all():
    """Give the GPU back from Ollama: unload every model it keeps warm.
    Same request genesi-ai-turbo uses; a model reloads on its next question."""
    try:
        with urllib.request.urlopen(OLLAMA + "/api/ps", timeout=2) as r:
            models = json.loads(r.read().decode()).get("models", [])
    except (OSError, ValueError, urllib.error.URLError):
        return 0
    n = 0
    for m in models:
        name = m.get("name") or m.get("model")
        if not name:
            continue
        try:
            body = json.dumps({"model": name, "keep_alive": 0}).encode()
            req = urllib.request.Request(OLLAMA + "/api/generate", data=body,
                                         headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=15).read()
            n += 1
        except (OSError, urllib.error.URLError):
            pass
    return n


_child = None


def _forward_signal(signum, _frame):
    if _child and _child.poll() is None:
        try:
            _child.terminate()
        except OSError:
            pass
    sys.exit(130)


def run_engine(argv, out):
    """Run sd-cli, translating its output into events. Returns (rc, error)."""
    global _child
    parser = ProgressParser()
    try:
        _child = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, bufsize=0)
    except OSError as e:
        return 127, str(e)
    last_emit = 0.0
    last_phase = ""
    pending = None
    while True:
        chunk = _child.stdout.read(4096)
        if not chunk:
            break
        for ev in parser.feed(chunk.decode("utf-8", "replace")):
            if ev["kind"] == "phase":
                # A redrawn bar re-parses as the same phase on every chunk.
                if ev["phase"] != last_phase:
                    last_phase = ev["phase"]
                    out.event("phase", phase=ev["phase"])
                continue
            # Bars redraw many times a second; the page needs a few.
            pending = ev
            now = time.monotonic()
            if now - last_emit > 0.25 or ev["step"] == ev["steps"]:
                last_emit = now
                out.event("progress", phase=ev["phase"], step=ev["step"],
                          steps=ev["steps"], sec_per_step=ev.get("sec_per_step"))
                pending = None
    if pending:
        out.event("progress", phase=pending["phase"], step=pending["step"],
                  steps=pending["steps"], sec_per_step=pending.get("sec_per_step"))
    rc = _child.wait()
    return rc, parser.last_error


def write_sidecar(png, meta):
    try:
        with open(os.path.splitext(png)[0] + ".json", "w", encoding="utf-8") as fh:
            json.dump(meta, fh, ensure_ascii=False, indent=1)
    except OSError:
        pass


# ── subcommands ──────────────────────────────────────────────────────────────

def cmd_status(args, out):
    engine = find_engine()
    out.data({
        "engine": engine or "",
        "engine_installed": bool(engine),
        "models_dir": models_dir(),
        "output_dir": output_dir(),
        "vram_mb": gpu_vram_mb(),
        "any_model": any(model_state(m)["installed"] for m in MODELS
                         if "generate" in m["caps"]),
    })
    return 0


def cmd_catalog(args, out):
    out.data([model_state(m) for m in MODELS])
    return 0


def cmd_pull(args, out):
    m = model_by_id(args.model)
    if not m:
        out.event("error", text="unknown model: %s" % args.model)
        return 2
    comps = model_components(m)
    for i, cid in enumerate(comps, 1):
        if component_ready(cid):
            continue
        out.event("status", text="%s (%d/%d)" % (COMPONENTS[cid]["file"], i, len(comps)))
        if not download_component(cid, out):
            return 1
    out.event("done", model=m["id"], text="%s ready" % m["name"])
    return 0


def cmd_remove(args, out):
    m = model_by_id(args.model)
    if not m:
        out.event("error", text="unknown model: %s" % args.model)
        return 2
    # Files another INSTALLED (or half-downloaded) model still needs stay.
    keep = set()
    for other in MODELS:
        if other["id"] == m["id"]:
            continue
        st = model_state(other)
        if st["installed"] or st["partial"]:
            keep.update(model_components(other))
    freed = 0
    for cid in model_components(m):
        if cid in keep:
            continue
        for p in (component_path(cid), component_path(cid) + ".part"):
            try:
                freed += os.path.getsize(p)
                os.unlink(p)
            except OSError:
                pass
    out.event("done", model=m["id"], freed=freed, text="removed %s" % m["name"])
    return 0


def _engine_or_fail(out):
    engine = find_engine()
    if not engine:
        out.event("error", code="no-engine",
                  text="the image engine is not installed (sudo pacman -S genesi-sd-cpp)")
    return engine


def cmd_generate(args, out):
    m = model_by_id(args.model)
    if not m:
        out.event("error", text="unknown model: %s" % args.model)
        return 2
    mode = "edit" if args.ref else "generate"
    if mode not in m["caps"]:
        out.event("error", text="%s cannot %s images" % (m["name"], mode))
        return 2
    if not model_state(m)["installed"]:
        out.event("error", code="no-model", text="%s is not downloaded yet" % m["name"])
        return 2
    prompt = (args.prompt or "").strip()
    if not prompt:
        out.event("error", text="empty prompt")
        return 2
    engine = _engine_or_fail(out)
    if not engine:
        return 3

    if args.ref:
        if not os.path.isfile(args.ref):
            out.event("error", text="no such image: %s" % args.ref)
            return 2
        dims = image_size(args.ref)
        if not dims:
            out.event("error", text="%s is not a PNG or JPEG" % args.ref)
            return 2
    if args.width and args.height:
        width, height = fit_size(args.width, args.height,
                                 target=min(args.width * args.height,
                                            MAX_SIDE * MAX_SIDE))
    elif args.ref:
        width, height = fit_size(*dims)
    else:
        width, height = 1024, 1024
    seed = args.seed if args.seed is not None and args.seed >= 0 \
        else random.randint(0, 2 ** 31 - 1)
    out_path = args.out or new_output_path("genesi-edit" if args.ref else "genesi")

    if not args.keep_llm:
        n = ollama_unload_all()
        if n:
            out.event("status", text="unloaded %d chat model(s) to free the GPU" % n)

    argv = build_generate_argv(engine, m, prompt, out_path, width, height,
                               steps=args.steps, seed=seed, ref=args.ref)
    out.event("start", mode=mode, model=m["id"], width=width, height=height,
              seed=seed, path=out_path)
    t0 = time.monotonic()
    rc, err = run_engine(argv, out)
    secs = round(time.monotonic() - t0, 1)
    if rc != 0 or not os.path.isfile(out_path):
        out.event("error", text=err or "the image engine stopped (exit %d)" % rc)
        return 1
    write_sidecar(out_path, {
        "mode": mode, "model": m["id"], "prompt": prompt, "seed": seed,
        "width": width, "height": height,
        "steps": args.steps or m["defaults"].get("steps"),
        "source": os.path.abspath(args.ref) if args.ref else "",
        "seconds": secs, "created": int(time.time()),
    })
    out.event("done", path=out_path, seconds=secs, seed=seed,
              width=width, height=height)
    return 0


def cmd_upscale(args, out):
    m = model_by_id("upscaler")
    if not model_state(m)["installed"]:
        out.event("error", code="no-model", text="%s is not downloaded yet" % m["name"])
        return 2
    if not os.path.isfile(args.input or ""):
        out.event("error", text="no such image: %s" % args.input)
        return 2
    engine = _engine_or_fail(out)
    if not engine:
        return 3
    base = os.path.splitext(os.path.basename(args.input))[0]
    out_path = args.out or os.path.join(output_dir(), base + "-4x.png")
    os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
    n = 2
    while not args.out and os.path.exists(out_path):
        out_path = os.path.join(output_dir(), "%s-4x-%d.png" % (base, n))
        n += 1
    out.event("start", mode="upscale", model=m["id"], path=out_path)
    out.event("phase", phase="upscale")
    t0 = time.monotonic()
    rc, err = run_engine(build_upscale_argv(engine, m, args.input, out_path), out)
    secs = round(time.monotonic() - t0, 1)
    if rc != 0 or not os.path.isfile(out_path):
        out.event("error", text=err or "the upscaler stopped (exit %d)" % rc)
        return 1
    dims = image_size(out_path) or (0, 0)
    write_sidecar(out_path, {"mode": "upscale", "model": m["id"], "prompt": "",
                             "source": os.path.abspath(args.input),
                             "width": dims[0], "height": dims[1],
                             "seconds": secs, "created": int(time.time())})
    out.event("done", path=out_path, seconds=secs, width=dims[0], height=dims[1])
    return 0


def cmd_gallery(args, out):
    d = output_dir()
    items = []
    try:
        names = [n for n in os.listdir(d) if n.lower().endswith(".png")]
    except OSError:
        names = []
    for n in names:
        p = os.path.join(d, n)
        try:
            mtime = os.path.getmtime(p)
        except OSError:
            continue
        meta = {}
        try:
            with open(os.path.splitext(p)[0] + ".json", encoding="utf-8") as fh:
                meta = json.load(fh)
        except (OSError, ValueError):
            pass
        meta.update({"path": p, "mtime": int(mtime)})
        items.append(meta)
    items.sort(key=lambda it: it["mtime"], reverse=True)
    out.data(items[:max(1, args.limit)])
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="genesi-ai-image",
                                 description="Local image generation for Genesi AI Mode")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")
    sub.add_parser("catalog")
    p = sub.add_parser("pull"); p.add_argument("model")
    p = sub.add_parser("remove"); p.add_argument("model")
    p = sub.add_parser("generate")
    p.add_argument("--model", default="flux2-klein")
    p.add_argument("--prompt", required=True)
    p.add_argument("--ref", help="image to edit (the instruction is the prompt)")
    p.add_argument("--width", type=int, default=0)
    p.add_argument("--height", type=int, default=0)
    p.add_argument("--steps", type=int, default=0)
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--out")
    p.add_argument("--keep-llm", action="store_true",
                   help="do not unload Ollama's warm chat models first")
    p = sub.add_parser("upscale")
    p.add_argument("--in", dest="input", required=True)
    p.add_argument("--out")
    p = sub.add_parser("gallery")
    p.add_argument("--limit", type=int, default=60)

    # --json is accepted after the subcommand too, which is where people type it.
    # The Monitor reads this as UTF-8 whatever the locale says, and a prompt in
    # Portuguese must not become a UnicodeEncodeError under LANG=C.
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    raw = list(sys.argv[1:] if argv is None else argv)
    as_json = "--json" in raw
    raw = [a for a in raw if a != "--json"]
    args = ap.parse_args(raw)
    out = Out(as_json)

    signal.signal(signal.SIGTERM, _forward_signal)
    signal.signal(signal.SIGINT, _forward_signal)

    handler = {"status": cmd_status, "catalog": cmd_catalog, "pull": cmd_pull,
               "remove": cmd_remove, "generate": cmd_generate,
               "upscale": cmd_upscale, "gallery": cmd_gallery}[args.cmd]
    return handler(args, out)


if __name__ == "__main__":
    sys.exit(main())
