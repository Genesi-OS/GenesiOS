def custom_path():
    return os.path.join(models_dir(), "custom.json")


def load_custom():
    try:
        with open(custom_path(), encoding="utf-8") as fh:
            items = json.load(fh)
        return items if isinstance(items, list) else []
    except (OSError, ValueError):
