        p = os.path.join(d, n)
        try:
            mtime = os.path.getmtime(p)
        except OSError:
            continue
        meta = {}
        try:
            with open(os.path.splitext(p)[0] + ".json", encoding="utf-8") as fh:
                meta = json.load(fh)
        except (OSError, ValueError):
            pass
        meta.update({"path": p, "mtime": int(mtime)})
        items.append(meta)
    items.sort(key=lambda it: it["mtime"], reverse=True)
    out.data(items[:max(1, args.limit)])
    return 0


def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)
    if raw[:1] == ["_keeper"]:
        keeper_main(raw[1:])
        return 0

    ap = argparse.ArgumentParser(prog="genesi-ai-image",
                                 description="Local image generation for Genesi AI Mode")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status")
    sub.add_parser("catalog")
    p = sub.add_parser("pull"); p.add_argument("model"); p.add_argument("--variant")
    p = sub.add_parser("remove"); p.add_argument("model"); p.add_argument("--variant")
    p = sub.add_parser("generate")
    p.add_argument("--model", default="flux2-klein")
    p.add_argument("--variant")
    p.add_argument("--prompt", required=True)
    p.add_argument("--mode", choices=["generate", "edit", "img2img"])
    p.add_argument("--ref", help="picture to edit, or to start from (img2img)")
    p.add_argument("--strength", type=float, default=None)
    p.add_argument("--negative", default=None)
    p.add_argument("--width", type=int, default=0)
    p.add_argument("--height", type=int, default=0)
    p.add_argument("--steps", type=int, default=0)
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--turbo", action="store_true")
    p.add_argument("--vary", action="store_true",
                   help="add a few details drawn from the seed (lighting, angle, style, pose) "
                        "so the same request does not draw the same scene every time")
    p.add_argument("--extra-ref", action="append", default=[], metavar="IMAGE",
                   help="another reference picture (picture 2, 3...) for editors that take several")
    p.add_argument("--mask", help="grayscale PNG: white = change, black = keep")
    p.add_argument("--protect-faces", action="store_true",
                   help="keep every detected face exactly as in the source")
    p.add_argument("--lora", action="append", default=[],
                   help="an imported LoRA, ID or ID:WEIGHT (repeatable)")
    p.add_argument("--out")
    p.add_argument("--keep-llm", action="store_true",
                   help="do not unload Ollama's warm chat models first")
    p = sub.add_parser("upscale")
    p.add_argument("--in", dest="input", required=True)
    p.add_argument("--model", default="upscaler")
    p.add_argument("--out")
    p = sub.add_parser("import"); p.add_argument("file"); p.add_argument("--name")
    p = sub.add_parser("optimize"); p.add_argument("model")
    p.add_argument("--type", default="q8_0", choices=["q8_0", "q5_0", "q4_0"])
    p = sub.add_parser("server"); p.add_argument("action", choices=["status", "stop"])
    p = sub.add_parser("gallery"); p.add_argument("--limit", type=int, default=60)
    p = sub.add_parser("lora")
    p.add_argument("action", choices=["list", "import", "remove"])
    p.add_argument("target", nargs="?")
    p.add_argument("--name")
    p.add_argument("--trigger")

    # The Monitor reads this as UTF-8 whatever the locale says, and a prompt in
    # Portuguese must not become a UnicodeEncodeError under LANG=C.
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    # --json is accepted after the subcommand too, which is where people type it.
    as_json = "--json" in raw
    raw = [a for a in raw if a != "--json"]
    args = ap.parse_args(raw)
    out = Out(as_json)

    signal.signal(signal.SIGTERM, _forward_signal)
    signal.signal(signal.SIGINT, _forward_signal)

    handler = {"status": cmd_status, "catalog": cmd_catalog, "pull": cmd_pull,
               "remove": cmd_remove, "generate": cmd_generate, "upscale": cmd_upscale,
               "import": cmd_import, "optimize": cmd_optimize, "server": cmd_server,
               "gallery": cmd_gallery, "lora": cmd_lora}[args.cmd]
    return handler(args, out)


if __name__ == "__main__":
    sys.exit(main())
