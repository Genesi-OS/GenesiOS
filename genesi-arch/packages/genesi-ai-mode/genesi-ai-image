def _sha256(path, out, label):
    h = hashlib.sha256()
    size = os.path.getsize(path)
    done, last = 0, 0.0
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(8 * 1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
            done += len(chunk)
            now = time.monotonic()
            if now - last > 0.5:
                last = now
                out.event("progress", phase="verify", file=label, step=done, steps=size)
    return h.hexdigest()


def download_component(cid, out, stop=lambda: False):
    """Fetch one file into the models dir, resuming a .part when there is one.
    Returns True when the file is in place and verified."""
    c = COMPONENTS[cid]
    dest = component_path(cid)
    if component_ready(cid):
        return True
    os.makedirs(models_dir(), exist_ok=True)
    part = dest + ".part"
    have = 0
    try:
        have = os.path.getsize(part)
    except OSError:
        pass
    if have > c["size"]:
        os.unlink(part)
        have = 0

    if have < c["size"]:
        req = urllib.request.Request(c["url"], headers={"User-Agent": "genesi-ai-image/2"})
        if have:
            req.add_header("Range", "bytes=%d-" % have)
        try:
            resp = urllib.request.urlopen(req, timeout=60)
        except urllib.error.HTTPError as e:
            if e.code == 416:          # already complete on the server's count
                resp = None
            else:
                out.event("error", text="%s: HTTP %s" % (c["file"], e.code))
                return False
        except (urllib.error.URLError, OSError) as e:
            out.event("error", text="%s: %s" % (c["file"], getattr(e, "reason", e)))
            return False
        if resp is not None:
            # A server that ignored the Range sends the whole file from byte 0;
            # appending that to the partial would build a corrupt file.
            if have and resp.status != 206:
                have = 0
            mode = "ab" if have else "wb"
            done, last, t0 = have, 0.0, time.monotonic()
            try:
                with resp, open(part, mode) as fh:
                    while True:
                        if stop():
                            out.event("error", text="cancelled")
                            return False
                        chunk = resp.read(1024 * 1024)
                        if not chunk:
                            break
                        fh.write(chunk)
                        done += len(chunk)
                        now = time.monotonic()
                        if now - last > 0.4:
                            last = now
                            rate = (done - have) / max(now - t0, 1e-6)
                            out.event("progress", phase="download", file=c["file"],
                                      step=done, steps=c["size"], rate=int(rate))
            except (OSError, urllib.error.URLError) as e:
                out.event("error", text="%s: %s (the download resumes where it "
                          "stopped next time)" % (c["file"], e))
                return False

    size = os.path.getsize(part)
    if size != c["size"]:
        out.event("error", text="%s: got %d bytes, expected %d (try again — it "
                  "resumes)" % (c["file"], size, c["size"]))
        return False
    if c["sha256"]:
        digest = _sha256(part, out, c["file"])
        if digest != c["sha256"]:
            os.unlink(part)
            out.event("error", text="%s failed its checksum and was deleted — "
                      "download it again" % c["file"])
            return False
    os.replace(part, dest)
    return True


def convert(engine, src, dst, qtype, out):
    """Quantize a checkpoint to GGUF with the engine itself (sd-cli -M
    convert). Written to a temporary name and moved into place only when the
    engine says it finished, with a .ok marker -- a half-written GGUF must
    never look like a model."""
    tmp = dst + ".converting"
    argv = engine_argv(engine) + ["-M", "convert", "-m", src, "-o", tmp, "--type", qtype]
    out.event("phase", phase="convert")
    out.event("status", text="optimizing %s → %s" % (os.path.basename(src), qtype.upper()))
    rc, err, _ = run_engine(argv, out)
    if rc != 0 or not os.path.isfile(tmp):
        try:
            os.unlink(tmp)
        except OSError:
            pass
        out.event("error", text=err or "conversion failed (exit %s)" % rc, log=log_path())
        return False
    os.replace(tmp, dst)
    with open(dst + ".ok", "w") as fh:
        json.dump({"from": os.path.basename(src), "type": qtype,
                   "size": os.path.getsize(dst), "at": int(time.time())}, fh)
    return True


# ── image helpers ────────────────────────────────────────────────────────────

def image_size(path):
    """(width, height) of a PNG or JPEG from its header, or None."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(32)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:2] != b"\xff\xd8":
                return None
            fh.seek(2)
            while True:
                b = fh.read(1)
                while b and b != b"\xff":
                    b = fh.read(1)
                while b == b"\xff":
                    b = fh.read(1)
                if not b:
                    return None
                marker = b[0]
                seglen = struct.unpack(">H", fh.read(2))[0]
                # SOF0..SOF15 except DHT(C4), JPG(C8), DAC(CC) carry the size.
                if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                    fh.read(1)
                    h, w = struct.unpack(">HH", fh.read(4))
                    return (w, h)
                fh.seek(seglen - 2, 1)
    except (OSError, struct.error):
        return None


def snap(n):
    return max(256, int(round(n / 16.0)) * 16)


def fit_size(w, h, target=TARGET_PIXELS):
    """Keep the aspect ratio, land near `target` pixels, multiples of 16."""
    if w <= 0 or h <= 0:
        side = snap(target ** 0.5)
        return side, side
    scale = (target / float(w * h)) ** 0.5
    nw, nh = snap(w * scale), snap(h * scale)
    big = max(nw, nh)
    if big > MAX_SIDE:
        f = MAX_SIDE / float(big)
        nw, nh = snap(nw * f), snap(nh * f)
    return nw, nh


def new_output_path(stem="genesi"):
    d = output_dir()
    os.makedirs(d, exist_ok=True)
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    path = os.path.join(d, "%s-%s.png" % (stem, ts))
    n = 2
    while os.path.exists(path):
        path = os.path.join(d, "%s-%s-%d.png" % (stem, ts, n))
        n += 1
    return path


# ── what the engine is asked to do ───────────────────────────────────────────

def _heavy(m, v, vram_mb):
    """Weights that will not fit the card next to their activations."""
    total = sum(_component_size(r) for r in variant_parts(m, v).values()
                if not (os.path.isabs(r) and not os.path.exists(r)))
    return (not vram_mb) or total > (vram_mb - 1536) * 1024 * 1024


def ctx_flags(m, v, backend, turbo, safe, vram_mb):
    """Flags that shape the engine itself -- the same for every picture, so a
    warm server started with them can take any request for this model."""
    flags = []
    for role, ref in variant_parts(m, v).items():
        flags += [PART_FLAGS[role], component_path(ref)]
    d = m.get("defaults", {})
    if d.get("model_args"):
        flags += ["--model-args", d["model_args"]]
    # Flash attention helps on CUDA and CPU and, per the upstream performance
    # notes, slows the other backends down -- Vulkan included.
    if backend in ("cuda", "cpu"):
        flags += ["--diffusion-fa"]
    if backend == "cuda" and turbo:
        flags += ["--sage-attn"]
    # Weights in RAM, staged onto the card as each segment runs, with ~1 GB
    # of the card held back: upstream's recommended shape for a model bigger
    # than the card. Also the safe retry after an out-of-memory failure.
    if safe or _heavy(m, v, vram_mb):
        flags += ["--offload-to-cpu", "--max-vram", "-1"]
    # Always: user LoRAs and Turbo LoRAs both live in the models directory,
    # and sd-server must be given one anyway (see ensure_server).
    flags += ["--lora-model-dir", models_dir()]
    return flags


def gen_settings(m, mode, turbo, steps=0, cfg=None, negative=None, strength=None):
    d = m.get("defaults", {})
    t = m.get("turbo") or {}
    s = {"steps": d.get("steps", 20), "cfg": d.get("cfg", 1.0),
         "sampler": d.get("sampler"), "scheduler": d.get("scheduler"),
         "flow_shift": d.get("flow_shift"), "clip_skip": d.get("clip_skip"),
         "prefix": d.get("prefix", ""),
         "negative": d.get("negative", "") if negative is None else negative,
         "strength": d.get("strength", 0.6) if strength is None else strength,
         "lora": None, "loras": [], "cache": None}
    if turbo and t.get("lora") and component_ready(t["lora"]):
        s["lora"] = component_path(t["lora"])
        s["loras"].append((s["lora"], 1.0))
        s["steps"] = t.get("steps", s["steps"])
        s["cfg"] = t.get("cfg", s["cfg"])
    elif turbo and t.get("cache"):
        s["cache"] = t["cache"]
    if steps:
        s["steps"] = steps
    if cfg is not None:
        s["cfg"] = cfg
    # Distilled models ignore a negative prompt at cfg 1 -- sending one only
    # makes the engine encode text it will not use.
    if s["cfg"] <= 1.0:
        s["negative"] = ""
    return s


def build_cli_argv(engine, m, v, s, prompt, out_path, width, height, seed,
                   mode, ref, backend, turbo, safe, vram_mb):
    argv = engine_argv(engine) + ctx_flags(m, v, backend, turbo, safe, vram_mb)
    text = s["prefix"] + prompt
    for path, weight in s["loras"]:
        text += " <lora:%s:%g>" % (os.path.splitext(os.path.basename(path))[0], weight)
    argv += ["-p", text]
    if s["negative"]:
        argv += ["-n", s["negative"]]
    argv += ["-W", str(int(width)), "-H", str(int(height)),
             "--steps", str(int(s["steps"])), "--cfg-scale", str(s["cfg"]),
             "--seed", str(int(seed)), "-o", out_path]
    if s["sampler"]:
        argv += ["--sampling-method", s["sampler"]]
    if s["scheduler"]:
        argv += ["--scheduler", s["scheduler"]]
    if s["flow_shift"]:
        argv += ["--flow-shift", str(s["flow_shift"])]
    if s["clip_skip"]:
        argv += ["--clip-skip", str(s["clip_skip"])]
    if s["cache"]:
        argv += ["--cache-mode", s["cache"]]
    if mode == "edit" or s.get("refs"):
        for r in s.get("refs") or [ref]:
            argv += ["-r", r]
    elif mode == "img2img":
        argv += ["-i", ref, "--strength", str(s["strength"])]
        # Inpainting proper: the sampler only changes the painted area.
        if s.get("mask"):
            argv += ["--mask", s["mask"]]
    # Encoding a picture has no out-of-memory retry upstream (decoding does),
    # which is exactly why edits failed on an 8 GB card while generating
    # worked: tile it.
    if mode in ("edit", "img2img") or s.get("refs") or safe:
        argv += ["--vae-tiling"]
    return argv


def build_upscale_argv(engine, m, v, src, out_path):
    return engine_argv(engine) + ["-M", "upscale",
                                  "--upscale-model", component_path(v["parts"]["upscale"]),
                                  "-i", src, "-o", out_path]


# A progress bar from sd-cli's pretty_progress: "|====>   | 3/4 - 1.23s/it".
# The SAME printer also draws the model-loading bar, in bytes per second.
_PROG = re.compile(r"(\d+)/(\d+) - ([\d.]+)\s*(s/it|it/s|[KMG]B/s)")
_OOM = re.compile(r"out of memory|outofdevicememory|cudamalloc failed|failed to allocate|"
                  r"cannot allocate|vk::.*memory|not enough memory|alloc.*failed", re.I)
_GENERIC = re.compile(r"generate failed|new_sd_ctx_t failed|generate_image failed", re.I)


class ProgressParser:
    """Turns sd-cli / sd-server output into phases the page can show.

    The output mixes \\r-redrawn bars with log lines, so it is fed raw chunks
    and splits on BOTH. Phases: load (weights onto the device, a bytes bar),
    encode (the prompt through the text model), sample (the steps),
    decode (latent to pixels), upscale.
    """

    def __init__(self, phase="load"):
        self.buf = ""
        self.phase = phase
        self.errors = []
        self.oom = False

    def feed(self, text):
        self.buf += text
        events = []
        parts = re.split(r"[\r\n]", self.buf)
        self.buf = parts.pop()
        for line in parts:
            ev = self._line(line)
            if ev:
                events.append(ev)
        # A bar redrawn with \r and no newline yet still says where we are.
        if self.buf:
            ev = self._bar(self.buf)
            if ev:
                events.append(ev)
        return events

    def last_error(self):
        """The line that says WHY. sd-cli ends every failure with a generic
        "generate failed", which is all the page used to show; the reason is
        the error before it."""
        specific = [e for e in self.errors if not _GENERIC.search(e)]
        return (specific or self.errors or [""])[-1]

    def _bar(self, line):
        m = _PROG.search(line)
        if not m:
            return None
        step, steps, unit = int(m.group(1)), int(m.group(2)), m.group(4)
        if unit.endswith("B/s"):
            # Weights load lazily, one model at a time: the VAE's bytes bar
            # comes AFTER the steps. Once drawing has started, a load bar is
            # part of finishing -- reporting it as "load" sent the page's bar
            # back to 10% at the very end of a run.
            if self.phase in ("sample", "decode"):
                self.phase = "decode"
                return {"kind": "phase", "phase": "decode"}
            if self.phase == "convert":
                return {"kind": "progress", "phase": "convert", "step": step,
                        "steps": steps, "sec_per_step": None}
            phase = "load"
        else:
            phase = "upscale" if self.phase == "upscale" else "sample"
        if phase == "sample":
            self.phase = "sample"
        rate = float(m.group(3))
        sec_per_it = rate if unit == "s/it" else (1.0 / rate if rate else 0.0)
        return {"kind": "progress", "phase": phase, "step": step, "steps": steps,
                "sec_per_step": round(sec_per_it, 3) if phase != "load" else None}

    def _line(self, line):
        line = line.strip()
        if not line:
            return None
        bar = self._bar(line)
        if bar:
            return bar
        low = line.lower()
        if "[error" in low or "error:" in low or " failed" in low:
            self.errors.append(re.sub(r"^\[[A-Z]+\s*\]\s*(\S+:\d+\s*-\s*)?", "", line)[:300])
        if _OOM.search(line):
            self.oom = True
        # The prompt has been through the text model: sampling is next.
        if "condition" in low and "completed" in low:
            return {"kind": "phase", "phase": "encode"}
        if "sampling completed" in low:
            self.phase = "decode"
            return {"kind": "phase", "phase": "decode"}
        if "upscaling from" in low or ("upscal" in low and "loading" in low):
            self.phase = "upscale"
            return {"kind": "phase", "phase": "upscale"}
        return None


def ollama_unload_all():
    """Give the GPU back from Ollama: unload every model it keeps warm.
    Same request genesi-ai-turbo uses; a model reloads on its next question."""
    try:
        with urllib.request.urlopen(OLLAMA + "/api/ps", timeout=2) as r:
            models = json.loads(r.read().decode()).get("models", [])
    except (OSError, ValueError, urllib.error.URLError):
        return 0
    n = 0
    for m in models:
        name = m.get("name") or m.get("model")
        if not name:
            continue
        try:
            body = json.dumps({"model": name, "keep_alive": 0}).encode()
            req = urllib.request.Request(OLLAMA + "/api/generate", data=body,
                                         headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=15).read()
            n += 1
        except (OSError, urllib.error.URLError):
            pass
    return n


class _Emitter:
    """Throttles bar redraws (many a second) to what the page needs."""

    def __init__(self, out):
        self.out = out
        self.last = 0.0
        self.pending = None
        self.phase = ""

    def __call__(self, ev):
        if ev["kind"] == "phase":
            if ev["phase"] != self.phase:
                self.phase = ev["phase"]
                self.out.event("phase", phase=ev["phase"])
            return
        self.pending = ev
        now = time.monotonic()
        if now - self.last > 0.25 or ev["step"] == ev["steps"]:
            self.last = now
            self.flush()

    def flush(self):
        ev, self.pending = self.pending, None
        if ev:
            self.out.event("progress", phase=ev["phase"], step=ev["step"],
                           steps=ev["steps"], sec_per_step=ev.get("sec_per_step"))


_child = None


def _forward_signal(signum, _frame):
    if _child and _child.poll() is None:
        try:
            _child.terminate()
        except OSError:
            pass
    if _warm_job:
        _warm_cancel()
    sys.exit(130)


def run_engine(argv, out, phase="load"):
    """Run sd-cli, translating its output into events and keeping all of it
    in last-run.log. Returns (rc, reason, parser)."""
    global _child
    parser = ProgressParser(phase)
    emit = _Emitter(out)
    try:
        log = open(log_path(), "w", encoding="utf-8", errors="replace")
        log.write("$ " + " ".join(argv) + "\n\n")
    except OSError:
        log = None
    try:
        _child = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, bufsize=0)
    except OSError as e:
        return 127, str(e), parser
    while True:
        chunk = _child.stdout.read(4096)
        if not chunk:
            break
        text = chunk.decode("utf-8", "replace")
        if log:
            log.write(text)
        for ev in parser.feed(text):
            emit(ev)
    emit.flush()
    rc = _child.wait()
    if log:
        log.write("\n[exit %s]\n" % rc)
        log.close()
    return rc, parser.last_error(), parser


def write_sidecar(png, meta):
    try:
        with open(os.path.splitext(png)[0] + ".json", "w", encoding="utf-8") as fh:
            json.dump(meta, fh, ensure_ascii=False, indent=1)
    except OSError:
        pass


# ── the warm engine (Turbo) ──────────────────────────────────────────────────
#
# A keeper process owns one genesi-sd-server: it records where it listens in
# server.json, and stops it once nothing has touched `activity` for WARM_IDLE
# seconds, so a picture made at lunch does not hold the GPU all afternoon.
# Requests carry everything per-picture (prompt, size, steps, LoRA, cache); the
# server is restarted only when what shapes the engine itself changes -- the
# model, its variant, the backend flags.

_warm_job = None


def _state_file():
    return os.path.join(runtime_dir(), "server.json")


def _activity_file():
    return os.path.join(runtime_dir(), "activity")


def _touch_activity():
    try:
        with open(_activity_file(), "a"):
            pass
        os.utime(_activity_file(), None)
    except OSError:
        pass


def _alive(pid):
    try:
        pid = int(pid)
    except (ValueError, TypeError):
        return False
    if os.name == "nt":
        # os.kill(pid, 0) on Windows TERMINATES the process (any signal other
        # than the console ones is TerminateProcess) -- only the test suite
        # runs this on Windows, and it must not kill what it is checking.
        try:
            r = subprocess.run(["tasklist", "/FI", "PID eq %d" % pid, "/NH"],
                               capture_output=True, text=True, timeout=10)
            return str(pid) in (r.stdout or "")
        except (OSError, subprocess.SubprocessError):
            return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def server_state():
    try:
        with open(_state_file()) as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        return None
    if not _alive(st.get("pid")):
        return None
    return st


def _http(port, path, body=None, timeout=30):
    req = urllib.request.Request(
        "http://127.0.0.1:%d%s" % (port, path),
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "replace"))


def stop_server():
    st = server_state()
    if not st:
        try:
            os.unlink(_state_file())
        except OSError:
            pass
        return False
    for pid in (st.get("keeper"), st.get("pid")):
        if pid and _alive(pid):
            try:
                os.kill(int(pid), signal.SIGTERM)
            except OSError:
                pass
    for _ in range(40):
        if not _alive(st.get("pid")):
            break
        time.sleep(0.25)
    if _alive(st.get("pid")):
        try:
            os.kill(int(st["pid"]), getattr(signal, "SIGKILL", signal.SIGTERM))
        except OSError:
            pass
    try:
        os.unlink(_state_file())
    except OSError:
        pass
    return True


def _free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def keeper_main(argv):
    """`genesi-ai-image _keeper STATE IDLE -- server argv...`: own the server.

    Everything the keeper reads and writes lives beside STATE, never
    re-derived from the environment. A keeper that recomputed its directory
    once watched a different `activity` file than its clients touched -- it
    never went idle, and held a second copy of a model in RAM for half an hour.
    """
    state_path, idle = argv[0], int(argv[1])
    home = os.path.dirname(state_path)
    activity = os.path.join(home, "activity")
    busy_flag = os.path.join(home, "busy")
    sargv = argv[3:]
    port = int(sargv[sargv.index("--listen-port") + 1])
    log = open(os.path.join(home, "server.log"), "w")
    # Run it from the keeper's own (near-empty) directory too: anything the
    # server resolves against "." must not mean the user's home.
    child = subprocess.Popen(sargv, stdout=log, stderr=subprocess.STDOUT, cwd=home)
    key = os.environ.get("GENESI_IMAGE_KEY", "")
    started = time.time()

    def bye(*_):
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(10)
            except subprocess.TimeoutExpired:
                child.kill()
        try:
            with open(state_path) as fh:
                if json.load(fh).get("pid") == child.pid:
                    os.unlink(state_path)
        except (OSError, ValueError):
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    with open(state_path + ".tmp", "w") as fh:
        json.dump({"pid": child.pid, "keeper": os.getpid(), "port": port, "key": key,
                   "model": os.environ.get("GENESI_IMAGE_MODEL", ""),
                   "variant": os.environ.get("GENESI_IMAGE_VARIANT", ""),
                   "started": int(started)}, fh)
    os.replace(state_path + ".tmp", state_path)
    while child.poll() is None:
        time.sleep(5)
        if os.path.exists(busy_flag):
            continue
        try:
            last = os.path.getmtime(activity)
        except OSError:
            # No activity file at all is not "active now": count from start,
            # or a deleted file would keep the server forever.
            last = started
        if time.time() - max(last, started) > idle:
            sys.stderr.write("keeper: idle for %ds, stopping the server\n" % idle)
            bye()
    # The server went away on its own: say how, or a crash is
    # indistinguishable from a clean stop.
    rc = child.returncode
    sys.stderr.write("keeper: the server exited with %s%s\n" % (
        rc, " (signal %d)" % -rc if rc is not None and rc < 0 else ""))
    sys.stderr.flush()
    bye()


def _kill_stray_keepers():
    """Every warm engine this user still runs, whatever state file it uses.

    One card holds one warm model: a keeper left from an earlier session (or
    from a different runtime directory) is a second copy of a model in memory,
    and on a 16 GB machine that is what turns a 10-second load into minutes.
    """
    if not os.path.isdir("/proc"):
        return 0
    me, uid, n = os.getpid(), os.getuid(), 0
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            if os.stat("/proc/" + pid).st_uid != uid:
                continue
            with open("/proc/%s/cmdline" % pid, "rb") as fh:
                cmd = fh.read().split(b"\0")
        except OSError:
            continue
        if b"_keeper" in cmd and any(c.endswith(b"genesi-ai-image") for c in cmd):
            try:
                os.kill(int(pid), signal.SIGTERM)
                n += 1
            except OSError:
                pass
    return n


def ensure_server(m, v, flags, out):
    """A warm server for exactly these engine flags, started if needed."""
    server = find_server()
    if not server:
        return None
    key = hashlib.sha256(json.dumps([server] + flags).encode()).hexdigest()[:16]
    st = server_state()
    if st and st.get("key") == key:
        try:
            _http(st["port"], "/sdcpp/v1/capabilities", timeout=5)
            return st
        except (OSError, ValueError, urllib.error.URLError):
            pass
    if st:
        out.event("status", text="switching the warm engine to %s" % m["name"])
    stop_server()
    if _kill_stray_keepers():
        time.sleep(2)
    port = _free_port()
    sargv = engine_argv(server) + ["--listen-ip", "127.0.0.1", "--listen-port", str(port)] + flags
    # sd-server scans its LoRA directory RECURSIVELY on /capabilities and on
    # every picture request. Without the flag it scans the working directory
    # -- the user's home -- and every request hangs for minutes (found in WSL:
    # /capabilities timed out for 10 minutes, and answered at once with the
    # flag). Always name the small models directory.
    if "--lora-model-dir" not in sargv:
        sargv += ["--lora-model-dir", models_dir()]
    env = dict(os.environ, GENESI_IMAGE_KEY=key, GENESI_IMAGE_MODEL=m["id"],
               GENESI_IMAGE_VARIANT=v["id"])
    me = os.path.abspath(__file__)
    # The keeper's own errors go to keeper.log: with them in /dev/null a
    # keeper that died at start looked exactly like a slow server.
    klog = open(os.path.join(runtime_dir(), "keeper.log"), "a")
    klog.write("--- %s: starting %s/%s\n" % (time.strftime("%H:%M:%S"), m["id"], v["id"]))
    klog.flush()
    subprocess.Popen([sys.executable, me, "_keeper", _state_file(), str(WARM_IDLE), "--"] + sargv,
                     stdin=subprocess.DEVNULL, stdout=klog, stderr=subprocess.STDOUT,
                     env=env, start_new_session=True)
    klog.close()
    # sd-server loads EVERY weight before it starts listening -- seconds from
    # the page cache, minutes for a 20B model on a cold disk. The first real
    # run gave up at a fixed 120 s while the server was still loading. So: wait
    # as long as the server is alive (with a generous ceiling), show its load
    # bar meanwhile, and give up at once only if it dies.
    parser = ProgressParser("load")
    emit = _Emitter(out)
    slog = os.path.join(runtime_dir(), "server.log")
    offset = 0
    t0 = time.monotonic()
    seen_state = False
    reason = "it did not answer within 15 minutes"
    while time.monotonic() - t0 < 900:
        # Someone is waiting for this server: that is activity. Without it
        # the keeper counted a long load as idle time and killed the server
        # at exactly WARM_IDLE -- seen in WSL, where reading 4 GB took 10 min.
        _touch_activity()
        st = server_state()
        if st and st.get("key") == key:
            seen_state = True
            try:
                _http(st["port"], "/sdcpp/v1/capabilities", timeout=5)
                emit.flush()
                return st
            except (OSError, ValueError, urllib.error.URLError):
                pass
        elif seen_state:
            # It came up and went away: the server process exited.
            reason = "the server exited while loading"
            break
        elif time.monotonic() - t0 > 60:
            reason = ("its keeper never started" if not st else
                      "another engine's state is in the way (key %s, wanted %s)"
                      % (st.get("key"), key))
            break
        try:
            with open(slog, "rb") as fh:
                fh.seek(offset)
                chunk = fh.read()
                offset += len(chunk)
            for ev in parser.feed(chunk.decode("utf-8", "replace")):
                emit(ev)
        except OSError:
            pass
        time.sleep(0.5)
    try:
        with open(log_path(), "wb") as dst:
            for name in ("keeper.log", "server.log"):
                try:
                    with open(os.path.join(runtime_dir(), name), "rb") as fh:
                        dst.write(("== %s ==\n" % name).encode() + fh.read()[-200000:] + b"\n")
                except OSError:
                    pass
    except OSError:
        pass
    out.event("status", code="warm-failed", text="warm engine: " + reason)
    stop_server()
    return None


def _warm_cancel():
    job, port = _warm_job
    try:
        _http(port, "/sdcpp/v1/jobs/%s/cancel" % job, body={}, timeout=5)
    except (OSError, ValueError, urllib.error.URLError):
        # A job already generating cannot be interrupted upstream: stopping
        # the server is the only way to give the GPU back now.
        stop_server()


def _b64(path):
    with open(path, "rb") as fh:
        return base64.b64encode(fh.read()).decode()


def run_warm(st, s, prompt, out_path, width, height, seed, mode, ref, out):
    """One picture through the warm server. Returns (ok, reason, parser)."""
    global _warm_job
    port = st["port"]
    text = s["prefix"] + prompt
    body = {"prompt": text, "width": int(width), "height": int(height), "seed": int(seed),
            "sample_params": {"sample_steps": int(s["steps"]),
                              "guidance": {"txt_cfg": float(s["cfg"])}}}
    if s["sampler"]:
        body["sample_params"]["sample_method"] = s["sampler"]
    if s["scheduler"]:
        body["sample_params"]["scheduler"] = s["scheduler"]
    if s["flow_shift"]:
        body["sample_params"]["flow_shift"] = float(s["flow_shift"])
    if s["negative"]:
        body["negative_prompt"] = s["negative"]
    if s["clip_skip"]:
        body["clip_skip"] = int(s["clip_skip"])
    if s["cache"]:
        body["cache_mode"] = s["cache"]
    if s["loras"]:
        body["lora"] = [{"path": os.path.basename(path), "multiplier": float(w)}
                        for path, w in s["loras"]]
    if mode == "edit" or s.get("refs"):
        body["ref_images"] = [_b64(r) for r in (s.get("refs") or [ref])]
    elif mode == "img2img":
        body["init_image"] = _b64(ref)
        body["strength"] = float(s["strength"])
        if s.get("mask"):
            body["mask_image"] = _b64(s["mask"])
    if mode in ("edit", "img2img") or s.get("refs"):
        body["vae_tiling_params"] = {"enabled": True}

    parser = ProgressParser("load")
    emit = _Emitter(out)
    slog = os.path.join(runtime_dir(), "server.log")
    try:
        offset = os.path.getsize(slog)
    except OSError:
        offset = 0
    busy = os.path.join(runtime_dir(), "busy")
    open(busy, "w").close()
    _touch_activity()
    try:
        try:
            job = _http(port, "/sdcpp/v1/img_gen", body=body, timeout=30)
        except urllib.error.HTTPError as e:
            return False, "the warm engine refused the request: %s" % e.read()[:200], parser
        except (OSError, urllib.error.URLError) as e:
            return False, "the warm engine is not answering: %s" % e, parser
        _warm_job = (job["id"], port)
        while True:
            # The server prints the same bars sd-cli does: tail them.
            try:
                with open(slog, "rb") as fh:
                    fh.seek(offset)
                    chunk = fh.read()
                    offset += len(chunk)
                for ev in parser.feed(chunk.decode("utf-8", "replace")):
                    emit(ev)
            except OSError:
                pass
            try:
                js = _http(port, "/sdcpp/v1/jobs/" + job["id"], timeout=10)
            except (OSError, ValueError, urllib.error.URLError):
                if not server_state():
                    return False, parser.last_error() or "the warm engine stopped", parser
                time.sleep(1)
                continue
            if js.get("status") == "completed":
                emit.flush()
                imgs = (js.get("result") or {}).get("images") or []
                if not imgs:
                    return False, "the warm engine returned no picture", parser
                with open(out_path, "wb") as fh:
                    fh.write(base64.b64decode(imgs[0]["b64_json"]))
                return True, "", parser
            if js.get("status") in ("failed", "cancelled"):
                err = (js.get("error") or {}).get("message") or ""
                return False, parser.last_error() or err or js["status"], parser
            time.sleep(0.4)
    finally:
        _warm_job = None
        try:
            os.unlink(busy)
        except OSError:
            pass
        _touch_activity()
        try:
            with open(slog, "rb") as fh:
                fh.seek(max(0, offset - 200000))
                with open(log_path(), "wb") as dst:
                    dst.write(fh.read())
        except OSError:
            pass


# ── masks, faces and compositing ─────────────────────────────────────────────
#
# A mask is a grayscale picture the size of the source: white = change, black
# = keep. Whatever the model does, the final picture is composited: outside
# the mask every pixel is the ORIGINAL, at the original resolution. That is
# the guarantee "edit only this part" needs -- even an instruction editor,
# which takes no mask, cannot touch what was not painted.
#
# Done with PySide6 (a hard dependency of genesi-ai-mode); faces come from
# OpenCV's frontal-face detector when python-opencv is installed.

def _qt():
    try:
        from PySide6 import QtGui, QtCore
        return QtGui, QtCore
    except ImportError:
        return None, None


# ── Reference pictures ─────────────────────────────────────────────────────
#
# An editor that takes several pictures (Qwen-Image-Edit, FLUX.2 klein) is
# given them in order: picture 1 is the one being edited, the rest are what
# the prompt points at -- "put the jacket from picture 2 on the person in
# picture 1". Each one costs memory and time in proportion to its pixels, so
# the extra ones are scaled down to REF_EXTRA_AREA before they go in; the
# model needs to SEE a reference, not reproduce it pixel for pixel.
REF_EXTRA_AREA = 1024 * 768

# How each family names the pictures, in the words it was trained on.
# Qwen-Image-Edit's own template labels them "Picture 1:", "Picture 2:"
# (sd.cpp conditioner, QwenImageEditPlusPipeline); FLUX.2's examples say
# "image 1". Whatever the person typed -- "imagem 2", "foto 2", "img 2",
# "@2" -- becomes that, so the prompt and the template agree.
REF_LABEL = {"qwen": "Picture %d", "flux2": "image %d"}
_REF_WORD = re.compile(r"(?i)(?:@\s*([1-9])\b|\b(?:imagem|imagen|image|img|foto|photo|picture|pic|figura|refer[eê]ncia|ref)\s*#?\s*([1-9])\b)")


# ── Variety ────────────────────────────────────────────────────────────────
#
# The fast editors (Qwen-Image-Edit with its Lightning LoRA, FLUX.2 klein)
# are distilled: a new seed barely moves them. Asked twice for "a bedroom"
# with the same photo they draw the same bedroom, because the seed is not
# where their variety lives -- the TEXT is. So --vary adds a few concrete
# details to the prompt, drawn from the run's seed: a different room each
# time, and the same one again when the seed is locked. What was added is
# reported and recorded, never hidden.
VARY_ROOM = [
    "a minimalist Scandinavian room with light wood and white walls",
    "a cozy room with exposed brick walls and warm textiles",
    "a modern loft with tall windows and polished concrete",
    "a vintage room with patterned wallpaper and old furniture",
    "a Japanese-style room with tatami mats and paper screens",
    "a bohemian room full of plants, rugs and hanging lights",
    "an industrial room with metal shelves and dark wood",
    "a luxurious hotel room with marble and brass details",
    "a small attic room with a slanted wooden ceiling",
    "a colorful retro 1970s room with round furniture",
    "a dark moody room with deep green walls and velvet",
    "a bright beach-house room with linen and rattan",
]
VARY_LIGHT = [
    "soft morning light", "golden hour sunlight through the window",
    "warm evening lamp light", "cool overcast daylight",
    "neon accent lighting at night", "candlelight", "bright natural daylight",
    "dramatic side light with deep shadows",
]
VARY_ANGLE = [
    "shot from a low angle", "a wide shot showing the whole space",
    "a medium shot", "seen from the side", "from a slightly high angle",
    "framed through a doorway",
]
VARY_POSE = [
    "sitting on the edge of the bed", "leaning against the wall",
    "standing by the window", "lying on the floor reading",
    "sitting cross-legged on the floor", "stretching with arms raised",
    "walking toward the camera", "looking back over the shoulder",
    "sitting in an armchair with legs crossed", "kneeling beside a low table",
]
VARY_PALETTE = [
    "muted earthy colors", "a pastel color palette", "deep blue and teal tones",
    "warm orange and brown tones", "neutral beige and cream tones",
    "black and white with one bold accent color",
]
_ROOMISH = re.compile(r"(?i)\b(quarto|sala|cozinha|banheiro|escrit[oó]rio|cômodo|comodo|casa|"
                      r"room|bedroom|living room|kitchen|bathroom|office|interior|apartamento|apartment|"
                      r"habitaci[oó]n|dormitorio)")
# The person already said how it is lit: do not draw over that.
_LIT = re.compile(r"(?i)\b(noite|night|dia|day|manh[aã]|morning|tarde|evening|p[oô]r do sol|sunset|"
                  r"amanhecer|sunrise|luz|light|lighting|ilumina\w*|escur\w*|dark|sol|sun|neon|vela|candle)\b")
_POSEY = re.compile(r"(?i)\b(pose|poses|posi[cç][aã]o|posando|aleat[oó]ri\w*|random|qualquer|any)\b")


def variation(prompt, seed):
    """A few details for this run, the same for the same seed."""
    rnd = random.Random(int(seed) * 7919 + 17)
    parts = []
    if _ROOMISH.search(prompt):
        parts.append(rnd.choice(VARY_ROOM))
    light = rnd.choice(VARY_LIGHT)
    if not _LIT.search(prompt):
        parts.append(light)
    if _POSEY.search(prompt):
        parts.append(rnd.choice(VARY_POSE))
    if rnd.random() < 0.6:
        parts.append(rnd.choice(VARY_ANGLE))
    if rnd.random() < 0.5:
        parts.append(rnd.choice(VARY_PALETTE))
    return ", ".join(parts)


def max_refs(m):
    """How many pictures the model takes at once: 1 for everything but the
    multi-reference editors."""
    if "edit" not in m.get("caps", []):
        return 1
    return int(m.get("max_refs", 1))


def ref_prompt(prompt, family, n):
    """The prompt with every mention of picture k (k <= n) said the way the
    model's family says it. Numbers past the last picture are left alone --
    "image 7" with three pictures is the person's words, not a reference."""
    label = REF_LABEL.get(family)
    if not label or n < 2:
        return prompt

    def swap(match):
        k = int(match.group(1) or match.group(2))
        return label % k if k <= n else match.group(0)
    return _REF_WORD.sub(swap, prompt)


def prepare_ref(path, index):
    """An extra reference scaled down to REF_EXTRA_AREA (never up). Returns
    the path to hand the engine -- the original when it is already small or
    Qt is missing."""
    dims = image_size(path)
    if not dims or dims[0] * dims[1] <= REF_EXTRA_AREA:
        return path
    QtGui, QtCore = _qt()
    if not QtGui:
        return path
    img = QtGui.QImage(path)
    if img.isNull():
        return path
    w, h = fit_size(dims[0], dims[1], target=REF_EXTRA_AREA)
    img = img.scaled(int(w), int(h), QtCore.Qt.IgnoreAspectRatio, QtCore.Qt.SmoothTransformation)
    if img.hasAlphaChannel():
        img = img.convertToFormat(QtGui.QImage.Format_RGB888)
    out = os.path.join(cache_dir(), "ref-%d-%dx%d.png" % (index, w, h))
    return out if img.save(out, "PNG") else path


def prepare_mask(mask, width, height):
    """The user's mask scaled to the engine's working size, for sd-cli's own
    inpainting (img2img). Returns a path, or None when Qt is missing."""
    QtGui, QtCore = _qt()
    if not QtGui:
        return None
    img = QtGui.QImage(mask)
    if img.isNull():
        return None
    img = img.convertToFormat(QtGui.QImage.Format_Grayscale8).scaled(
        int(width), int(height), QtCore.Qt.IgnoreAspectRatio, QtCore.Qt.SmoothTransformation)
    out = os.path.join(cache_dir(), "mask-%dx%d.png" % (width, height))
    return out if img.save(out, "PNG") else None


def _cascade_path():
    cands = []
    try:
        import cv2
        cands.append(os.path.join(getattr(cv2, "data", None).haarcascades, ""))
    except (ImportError, AttributeError, TypeError):
        pass
    cands += ["/usr/share/opencv4/haarcascades/", "/usr/share/opencv/haarcascades/"]
    for d in cands:
        f = os.path.join(d, "haarcascade_frontalface_default.xml")
        if os.path.isfile(f):
            return f
    return None


def faces_available():
    try:
        import cv2  # noqa: F401
    except ImportError:
        return False
    return _cascade_path() is not None


def detect_faces(path):
    """Face boxes (x, y, w, h) in source pixels; [] when none or no OpenCV."""
    try:
        import cv2
    except ImportError:
        return []
    cascade = _cascade_path()
    if not cascade:
        return []
    img = cv2.imread(path)
    if img is None:
        return []
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    side = min(gray.shape[:2])
    found = cv2.CascadeClassifier(cascade).detectMultiScale(
        gray, scaleFactor=1.1, minNeighbors=5, minSize=(max(24, side // 25),) * 2)
    return [tuple(int(v) for v in f) for f in found]


def composite(src, result, out_path, mask=None, faces=()):
    """Write `result` over `src` through `mask` (white = take the result),
    with every face box kept from `src`, at src's full resolution."""
    QtGui, QtCore = _qt()
    if not QtGui:
        return False
    Q = QtGui.QImage
    base = Q(src).convertToFormat(Q.Format_RGB32)
    res = Q(result)
    if base.isNull() or res.isNull():
        return False
    W, H = base.width(), base.height()
    layer = res.scaled(W, H, QtCore.Qt.IgnoreAspectRatio,
                       QtCore.Qt.SmoothTransformation).convertToFormat(Q.Format_ARGB32_Premultiplied)
    if mask:
        m = Q(mask).convertToFormat(Q.Format_Grayscale8).scaled(
            W, H, QtCore.Qt.IgnoreAspectRatio, QtCore.Qt.SmoothTransformation)
    else:
        m = Q(W, H, Q.Format_Grayscale8)
        m.fill(255)
    m = m.convertToFormat(Q.Format_Grayscale8)
    if faces:
        p = QtGui.QPainter(m)
        p.setRenderHint(QtGui.QPainter.Antialiasing)
        p.setPen(QtCore.Qt.NoPen)
        p.setBrush(QtGui.QColor(0, 0, 0))
        for (x, y, w, h) in faces:
            # A margin around the box: hairline and chin belong to the face.
            mx, my = w * 0.25, h * 0.35
            p.drawEllipse(QtCore.QRectF(x - mx, y - my, w + 2 * mx, h + 2 * my))
        p.end()
    # Feather the edge (down- then up-scaling is a cheap, decent blur) so the
    # seam between kept and changed pixels does not show.
    k = max(1, min(W, H) // 96)
    m = m.scaled(max(1, W // k), max(1, H // k), QtCore.Qt.IgnoreAspectRatio,
                 QtCore.Qt.SmoothTransformation).scaled(
                     W, H, QtCore.Qt.IgnoreAspectRatio, QtCore.Qt.SmoothTransformation)
    m = m.convertToFormat(Q.Format_Grayscale8)
    raw = bytes(m.constBits())[: m.bytesPerLine() * m.height()]
    alpha = Q(raw, m.width(), m.height(), m.bytesPerLine(), Q.Format_Alpha8).copy()
    p = QtGui.QPainter(layer)
    p.setCompositionMode(QtGui.QPainter.CompositionMode_DestinationIn)
    p.drawImage(0, 0, alpha)
    p.end()
    p = QtGui.QPainter(base)
    p.drawImage(0, 0, layer)
    p.end()
    return base.save(out_path, "PNG")


# ── user LoRAs ───────────────────────────────────────────────────────────────
#
# Downloaded by the user (Civitai, Hugging Face), imported here: copied into
# the models directory as userlora-<slug>.safetensors so sd-cli and sd-server
# both resolve them by name. ONLY .safetensors: a .ckpt/.pt is a Python pickle,
# and loading one can run arbitrary code -- that is a door, not a format.
#
# They apply to Generate (text to image), not to edits of an existing photo:
# a community LoRA on top of an editor that keeps faces is how fake intimate
# pictures of real people get made, and nothing here can know who is in a
# photo or whether they agreed.

def loras_path():
    return os.path.join(models_dir(), "loras.json")


def load_loras():
    try:
        with open(loras_path(), encoding="utf-8") as fh:
            items = json.load(fh)
        return [x for x in items if isinstance(x, dict)] if isinstance(items, list) else []
    except (OSError, ValueError):
        return []


def save_loras(items):
    os.makedirs(models_dir(), exist_ok=True)
    tmp = loras_path() + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(items, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, loras_path())


def detect_lora_family(path):
    """sdxl | sd15 | flux | qwen | zimage | '' from a LoRA's tensor names."""
    keys = _safetensors_keys(path)
    joined = "\n".join(keys)
    if "lora_te2_" in joined or "lora_te1_" in joined or "lora_unet_input_blocks_" in joined \
            or "lora_unet_label_emb" in joined:
        return "sdxl"
    if "double_blocks" in joined or "single_blocks" in joined \
            or "single_transformer_blocks" in joined:
        return "flux"
    if "img_mod" in joined or "txt_mlp" in joined or "img_mlp" in joined:
        return "qwen"
    if "context_refiner" in joined or "noise_refiner" in joined:
        return "zimage"
    if "lora_unet_down_blocks_" in joined or "lora_te_text_model" in joined:
        # SDXL's unet has up to 10 transformer blocks per attention; SD 1.5 has one.
        if re.search(r"transformer_blocks_[2-9]", joined):
            return "sdxl"
        return "sd15"
    return ""


def lora_by_id(lid):
    for x in load_loras():
        if x.get("id") == lid:
            return x
    return None


def resolve_loras(m, mode, specs, out):
    """[(path, weight)] for `--lora ID[:W]` specs, or None after an error."""
    chosen = []
    for spec in specs or []:
        lid, _, w = spec.partition(":")
        lo = lora_by_id(lid)
        if not lo:
            out.event("error", code="no-lora", text="no imported LoRA %s" % lid)
            return None
        fams = LORA_FAMILIES.get(m.get("family", ""), [])
        if lo.get("family") and lo["family"] not in fams:
            out.event("error", code="lora-mismatch",
                      text="%s is a %s LoRA; %s takes %s" % (lo["name"], lo["family"].upper(),
                                                             m["name"], ", ".join(f.upper() for f in fams) or "none"))
            return None
        path = os.path.join(models_dir(), lo["file"])
        if not os.path.isfile(path):
            out.event("error", code="no-lora", text="%s's file is gone" % lo["name"])
            return None
        try:
            weight = float(w) if w else float(lo.get("weight", 0.8))
        except ValueError:
            weight = float(lo.get("weight", 0.8))
        chosen.append((path, max(-2.0, min(2.0, weight)), lo.get("trigger", "")))
    return chosen


def cmd_lora(args, out):
    if args.action == "list":
        items = load_loras()
        for x in items:
            x["present"] = os.path.isfile(os.path.join(models_dir(), x.get("file", "")))
        out.data(items)
        return 0
    if args.action == "remove":
        lo = lora_by_id(args.target or "")
        if not lo:
            out.event("error", text="no imported LoRA %s" % args.target)
            return 2
        try:
            os.unlink(os.path.join(models_dir(), lo["file"]))
        except OSError:
            pass
        save_loras([x for x in load_loras() if x.get("id") != lo["id"]])
        out.event("done", lora=lo["id"], text="removed %s" % lo["name"])
        return 0
    # import
    path = os.path.abspath(os.path.expanduser(args.target or ""))
    if not os.path.isfile(path):
        out.event("error", text="no such file: %s" % args.target)
        return 2
    if not path.lower().endswith(".safetensors"):
        out.event("error", code="unsafe-format",
                  text="only .safetensors LoRAs are accepted — .ckpt/.pt files can run "
                       "code when loaded; look for the .safetensors version")
        return 2
    try:
        family = detect_lora_family(path)
    except (OSError, ValueError, struct.error) as e:
        out.event("error", text="not a readable .safetensors file: %s" % e)
        return 2
    size = os.path.getsize(path)
    if size > 3 * 1024 ** 3:
        out.event("error", code="not-a-lora",
                  text="this is %.1f GB — that is a full model, not a LoRA; use Add my model"
                       % (size / 1024 ** 3))
        return 2
    name = (args.name or os.path.splitext(os.path.basename(path))[0])[:60]
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or "lora"
    lid = slug
    n = 2
    existing = {x.get("id") for x in load_loras()}
    while lid in existing:
        lid = "%s-%d" % (slug, n)
        n += 1
    fname = LORA_PREFIX + lid + ".safetensors"
    os.makedirs(models_dir(), exist_ok=True)
    dest = os.path.join(models_dir(), fname)
    out.event("status", text="copying %s" % os.path.basename(path))
    shutil.copyfile(path, dest + ".part")
    os.replace(dest + ".part", dest)
    items = load_loras()
    items.append({"id": lid, "name": name, "file": fname, "family": family,
                  "trigger": (args.trigger or "").strip()[:200], "weight": 0.8,
                  "size": size, "added": int(time.time())})
    save_loras(items)
    out.event("done", lora=lid, family=family,
              text="%s added%s" % (name, "" if family else " (base not recognized)"))
    return 0


