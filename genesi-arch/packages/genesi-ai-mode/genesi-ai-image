# ── importing a checkpoint ───────────────────────────────────────────────────

def _safetensors_keys(path):
    with open(path, "rb") as fh:
        n = struct.unpack("<Q", fh.read(8))[0]
        if n > 200 * 1024 * 1024:
            raise ValueError("header too large")
        return list(json.loads(fh.read(n).decode("utf-8")).keys())


def _gguf_tensor_names(path, limit=4000):
    """Tensor names from a GGUF header (v2/v3), without loading weights."""
    with open(path, "rb") as fh:
        if fh.read(4) != b"GGUF":
            raise ValueError("not a GGUF file")
        version = struct.unpack("<I", fh.read(4))[0]
        if version < 2:
            raise ValueError("GGUF v%d is too old" % version)
        n_tensors, n_kv = struct.unpack("<QQ", fh.read(16))
        sizes = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}

        def rstr():
            ln = struct.unpack("<Q", fh.read(8))[0]
            return fh.read(ln).decode("utf-8", "replace")

        def skip(t):
            if t == 8:
                rstr()
            elif t == 9:
                et, cnt = struct.unpack("<IQ", fh.read(12))
                for _ in range(cnt):
                    skip(et)
            else:
                fh.read(sizes[t])

        for _ in range(n_kv):
            rstr()
            skip(struct.unpack("<I", fh.read(4))[0])
        names = []
        for _ in range(min(n_tensors, limit)):
            names.append(rstr())
            nd = struct.unpack("<I", fh.read(4))[0]
            fh.read(8 * nd + 4 + 8)
        return names


def detect_family(path):
    """sdxl | sd15 | '' from the tensor names of a single-file checkpoint."""
    keys = (_gguf_tensor_names(path) if path.lower().endswith(".gguf")
            else _safetensors_keys(path))
    joined = "\n".join(keys)
    if "conditioner.embedders.1" in joined:
        return "sdxl"
    if "model.diffusion_model.input_blocks" in joined and "cond_stage_model" in joined:
        return "sd15"
    return ""


def cmd_import(args, out):
    path = os.path.abspath(os.path.expanduser(args.file))
    if not os.path.isfile(path) or not path.lower().endswith((".safetensors", ".gguf")):
        out.event("error", text="pick a .safetensors or .gguf checkpoint")
        return 2
    try:
        family = detect_family(path)
    except (OSError, ValueError, struct.error, KeyError) as e:
        out.event("error", text="could not read %s: %s" % (os.path.basename(path), e))
        return 2
    if not family:
        out.event("error", code="unsupported",
                  text="this file is not a complete SD 1.5 or SDXL checkpoint (Pony, "
                       "Illustrious and most Civitai models are). Diffusion-only files "
                       "need their text encoders and cannot be imported alone.")
        return 2
    name = (args.name or os.path.splitext(os.path.basename(path))[0])[:60]
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or "model"
    mid = "custom-" + slug
    items = [c for c in load_custom() if c["id"] != mid]
    items.append({"id": mid, "name": name, "path": path, "family": family,
                  "optimized": [], "added": int(time.time())})
    save_custom(items)
    # An SDXL checkpoint needs the fp16-safe VAE: fetch it now so the model is
    # usable the moment the import says it is done.
    if family == "sdxl" and not component_ready("sdxl-vae"):
        out.event("status", text="fetching the SDXL VAE (335 MB)")
        if not download_component("sdxl-vae", out):
            return 1
    out.event("done", model=mid, family=family, text="%s added" % name)
    return 0


def cmd_optimize(args, out):
    m = model_by_id(args.model)
    if not m or not m.get("custom"):
        out.event("error", text="only imported models are optimized here — catalog "
                                 "models come with their variants")
        return 2
    engine = _engine_or_fail(out)
    if not engine:
        return 3
    qtype = args.type
    items = load_custom()
    c = next(x for x in items if x["id"] == m["id"])
    dst = os.path.join(models_dir(), "%s-%s.gguf" % (c["id"], qtype.split("_")[0]))
    if not convert(engine, c["path"], dst, qtype, out):
        return 1
    tag = qtype.split("_")[0]
    if tag not in c["optimized"]:
        c["optimized"].append(tag)
    save_custom(items)
    out.event("done", model=m["id"], variant=tag, text="optimized to %s" % qtype.upper())
    return 0


def cmd_server(args, out):
