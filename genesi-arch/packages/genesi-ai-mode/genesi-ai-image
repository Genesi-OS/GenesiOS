def cmd_pull(args, out):
    m = model_by_id(args.model)
    if not m:
        out.event("error", text="unknown model: %s" % args.model)
        return 2
    v = _variant_or_fail(m, args.variant, out)
    if not v:
        return 2
    if "convert" in v and not converted_ready(v) and not find_engine():
        out.event("error", code="no-engine",
                  text="install the image engine first — it optimizes this model after the download")
        return 3
    # Was the fp16 source already here -- i.e. does the user keep the fp16
    # variant? Then the conversion must not delete it afterwards.
    had_source = "convert" in v and component_ready(v["convert"]["from"])
    need = [r for r in variant_downloads(m, v) if not component_ready(r)]
    for i, cid in enumerate(need, 1):
        out.event("status", text="%s (%d/%d)" % (COMPONENTS[cid]["file"], i, len(need)))
        if not download_component(cid, out):
            return 1
    if "convert" in v and not converted_ready(v):
        src = component_path(v["convert"]["from"])
        if not convert(find_engine(), src, converted_path(v), v["convert"]["type"], out):
            return 1
        # The fp16 source stays only if it was here before this pull (the
        # user has the fp16 variant); otherwise it is 7 GB nothing will ever
        # read again.
        if not had_source:
            try:
                os.unlink(src)
            except OSError:
                pass
    out.event("done", model=m["id"], variant=v["id"], text="%s ready" % m["name"])
    return 0


def _in_use_by_others(skip_model, skip_variant):
    keep = set()
    for other in all_models():
        for v in other["variants"]:
            if other["id"] == skip_model and (skip_variant is None or v["id"] == skip_variant):
                continue
            st_ready = variant_ready(other, v)
            st_partial = any(os.path.exists(component_path(r) + ".part")
                             for r in variant_downloads(other, v) if not os.path.isabs(r))
            if st_ready or st_partial:
                keep.update(r for r in variant_parts(other, v).values() if not os.path.isabs(r))
                lora = (other.get("turbo") or {}).get("lora")
                if lora:
                    keep.add(lora)
    return keep


def cmd_remove(args, out):
    m = model_by_id(args.model)
    if not m:
        out.event("error", text="unknown model: %s" % args.model)
        return 2
    variants = [v for v in m["variants"] if not args.variant or v["id"] == args.variant]
    keep = _in_use_by_others(m["id"], args.variant)
    st = server_state()
    if st and st.get("model") == m["id"]:
        stop_server()
    freed = 0
    for v in variants:
        targets = []
        if "convert" in v:
            targets += [converted_path(v), converted_path(v) + ".ok", converted_path(v) + ".converting"]
            # The fp16 source may still be the user's fp16 variant.
            if v["convert"]["from"] not in keep:
                targets.append(component_path(v["convert"]["from"]))
        for ref in list(m.get("parts", {}).values()) + list(v.get("parts", {}).values()):
            if os.path.isabs(ref):
                # An imported file is the user's: only what WE made goes.
                if os.path.dirname(ref) == models_dir():
                    targets.append(ref)
                continue
            if ref not in keep:
                targets.append(component_path(ref))
        lora = (m.get("turbo") or {}).get("lora")
        if lora and lora not in keep and not args.variant:
            targets.append(component_path(lora))
        for p in set(targets):
            for q in (p, p + ".part"):
                try:
                    freed += os.path.getsize(q)
                    os.unlink(q)
                except OSError:
                    pass
    if m.get("custom") and not args.variant:
        save_custom([c for c in load_custom() if c["id"] != m["id"]])
    out.event("done", model=m["id"], freed=freed, text="removed %s" % m["name"])
    return 0


def _engine_or_fail(out):
    engine = find_engine()
    if not engine:
        out.event("error", code="no-engine",
                  text="the image engine is not installed (sudo pacman -S genesi-sd-cpp)")
    return engine


def _friendly(reason, parser, safe):
    if parser is not None and parser.oom:
        return ("out of video memory%s — try a smaller size, a smaller variant, or "
                "close what else uses the GPU" % (" even in low-memory mode" if safe else ""))
    return reason


def cmd_generate(args, out):
    m = model_by_id(args.model)
    if not m:
        out.event("error", text="unknown model: %s" % args.model)
        return 2
    mode = args.mode or ("edit" if args.ref and "edit" in m["caps"] else
                         "img2img" if args.ref else "generate")
    if mode not in m["caps"]:
        out.event("error", text="%s cannot %s" % (m["name"], mode))
        return 2
    v = pick_variant(m, args.variant)
    if not v or not variant_ready(m, v):
        out.event("error", code="no-model", text="%s is not downloaded yet" % m["name"])
        return 2
    prompt = (args.prompt or "").strip()
    # What the person typed, kept apart from what the engine is finally told
    # (references renamed, trigger words, a variation): the gallery's "use
    # this prompt again" must give back their words, not ours.
    asked = prompt
    if not prompt:
        out.event("error", text="empty prompt")
        return 2
    engine = _engine_or_fail(out)
    if not engine:
        return 3

    base = m.get("defaults", {}).get("base", 1024)
    target = base * base
    dims = None
    if args.ref:
        if not os.path.isfile(args.ref):
            out.event("error", text="no such image: %s" % args.ref)
            return 2
        dims = image_size(args.ref)
        if not dims:
            out.event("error", text="%s is not a PNG or JPEG" % args.ref)
            return 2
    extras = [r for r in (args.extra_ref or []) if r]
    if extras:
        if mode == "img2img" or "edit" not in m["caps"]:
            out.event("error", code="refs-unsupported",
                      text="%s works from one picture only; for several, use an editor "
                           "(Qwen-Image-Edit or FLUX.2 klein)" % m["name"])
            return 2
        limit = max_refs(m) - (1 if args.ref else 0)
        if len(extras) > limit:
            out.event("error", code="too-many-refs",
                      text="%s takes at most %d pictures at once" % (m["name"], max_refs(m)))
            return 2
        for r in extras:
            if not os.path.isfile(r) or not image_size(r):
                out.event("error", text="%s is not a PNG or JPEG" % r)
                return 2
    if args.width and args.height:
        # Never past what the model was trained at: a 1024 preset on an SD 1.5
        # model lands at 512x512, and a small request stays small.
        width, height = fit_size(args.width, args.height,
                                 target=min(args.width * args.height, target))
    elif dims:
        width, height = fit_size(*dims, target=target)
    else:
        width, height = fit_size(base, base, target=target)
    seed = args.seed if args.seed is not None and args.seed >= 0 \
        else random.randint(0, 2 ** 31 - 1)
    out_path = args.out or new_output_path("genesi-edit" if args.ref else "genesi")

    if not args.keep_llm:
        n = ollama_unload_all()
        if n:
            out.event("status", text="unloaded %d chat model(s) to free the GPU" % n)

    info = engine_info()
    backend = info["backend"] or "cpu"
    vram = gpu_vram_mb()
    turbo = bool(args.turbo)
    s = gen_settings(m, mode, turbo, steps=args.steps, negative=args.negative,
                     strength=args.strength)
    if extras:
        refs = ([args.ref] if args.ref else []) + [prepare_ref(r, i + 2) for i, r in enumerate(extras)]
        s["refs"] = refs
        prompt = ref_prompt(prompt, m.get("family", ""), len(refs))
        out.event("status", text="%d reference picture(s)" % len(refs))
    varied = ""
    if args.vary:
        varied = variation(prompt, seed)
        prompt = prompt.rstrip(" .,") + ", " + varied
        out.event("status", code="variation", text="variation: " + varied, variation=varied)
    user_loras = resolve_loras(m, mode, args.lora, out)
    if user_loras is None:
        return 2
    for path, weight, trigger in user_loras:
        s["loras"].append((path, weight))
        if trigger and trigger.lower() not in prompt.lower():
            prompt = prompt + ", " + trigger

    # Masks and protected faces only make sense on a picture being edited.
    mask = args.mask if (args.mask and args.ref) else None
    if args.mask and not args.ref:
        out.event("status", text="a mask needs a picture to edit; ignoring it")
    if mask and not os.path.isfile(mask):
        out.event("error", text="no such mask: %s" % mask)
        return 2
    faces = []
    if args.protect_faces and args.ref:
        if not faces_available():
            out.event("status", code="no-faces",
                      text="face protection needs python-opencv (sudo pacman -S python-opencv)")
        else:
            faces = detect_faces(args.ref)
            out.event("status", text="protecting %d face(s)" % len(faces))
    if mask and mode == "img2img":
        s["mask"] = prepare_mask(mask, width, height)
    # The composite writes the final picture; the engine writes beside it.
    final_path = out_path
    if args.ref and (mask or faces):
        out_path = os.path.splitext(final_path)[0] + ".raw.png"
    out.event("start", mode=mode, model=m["id"], variant=v["id"], width=width,
              height=height, seed=seed, path=out_path, steps=s["steps"],
              backend=backend, turbo=turbo,
              turbo_extra="lora" if s["lora"] else (s["cache"] or ""))
    t0 = time.monotonic()
    ok, reason, parser, safe = False, "", None, False

    # Turbo: the warm engine first. Any failure there falls through to a
    # one-shot run, which is slower but has never needed the server.
    if turbo and find_server():
        flags = ctx_flags(m, v, backend, turbo, False, vram)
        st = ensure_server(m, v, flags, out)
        if st:
            out.event("status", text="warm engine ready")
            ok, reason, parser = run_warm(st, s, prompt, out_path, width, height,
                                          seed, mode, args.ref, out)
            if not ok and parser.oom:
                stop_server()
        else:
            out.event("status", text="the warm engine did not start — drawing without it")

    if not ok:
        for attempt in (1, 2):
            safe = attempt == 2
            if safe:
                # Out of memory, or any failure after the engine started: the
                # low-memory shape -- weights in RAM, tiled VAE, ~0.6 MP.
                width, height = fit_size(width, height, target=min(target, 768 * 768))
                out.event("status", code="retry",
                          text="retrying in low-memory mode (%dx%d)" % (width, height))
            argv = build_cli_argv(engine, m, v, s, prompt, out_path, width, height, seed,
                                  mode, args.ref, backend, turbo, safe, vram)
            rc, reason, parser = run_engine(argv, out)
            ok = rc == 0 and os.path.isfile(out_path)
            if ok or rc in (-15, 130, 143) or attempt == 2:
                break

    secs = round(time.monotonic() - t0, 1)
    if not ok:
        out.event("error", code="oom" if parser and parser.oom else "engine",
                  text=_friendly(reason or "the image engine stopped", parser, safe),
                  log=log_path())
        return 1
    if out_path != final_path:
        if composite(args.ref, out_path, final_path, mask=mask, faces=faces):
            try:
                os.unlink(out_path)
            except OSError:
                pass
            width, height = image_size(final_path) or (width, height)
        else:
            out.event("status", text="could not keep the unpainted area (PySide6 missing); "
                                     "showing the model's picture as is")
            os.replace(out_path, final_path)
        out_path = final_path
    write_sidecar(out_path, {
        "mode": mode, "model": m["id"], "variant": v["id"], "prompt": asked, "seed": seed,
        "width": width, "height": height, "steps": s["steps"], "turbo": turbo,
        "backend": backend, "source": os.path.abspath(args.ref) if args.ref else "",
        "masked": bool(mask), "faces_kept": len(faces),
        "refs": [os.path.basename(r) for r in (args.extra_ref or [])],
        "variation": varied,
        "loras": [os.path.basename(p_) for p_, _w in s["loras"]],
        "seconds": secs, "created": int(time.time()),
    })
    out.event("done", path=out_path, seconds=secs, seed=seed,
              width=width, height=height, low_memory=safe, variation=varied)
    return 0


