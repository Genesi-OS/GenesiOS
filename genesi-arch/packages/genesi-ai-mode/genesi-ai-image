# SDXL checkpoints share almost everything but their weights and prompt habits.
def _sdxl(mid, name, src, summary, license_, tags, defaults, turbo=None,
          recommended=False):
    return {
        "id": mid, "name": name, "family": "sdxl", "summary": summary,
        "license": license_, "caps": ["generate", "img2img"],
        "tags": ["unfiltered", "sdxl"] + tags,
        "parts": {"vae": "sdxl-vae"},
        "variants": [
            {"id": "q8", "label": "Q8_0 (optimized)",
             "convert": {"from": src, "type": "q8_0",
                         "file": "%s-q8_0.gguf" % mid, "role": "model"}},
            {"id": "fp16", "label": "FP16 (original)", "parts": {"model": src}},
        ],
        "defaults": dict({"steps": 28, "cfg": 5.5, "sampler": "euler_a",
                          "strength": 0.6, "base": 1024}, **defaults),
        # {} is a real answer (a 5-step Lightning model has nothing to cache),
        # so only None takes the default.
        "turbo": {"cache": "ucache"} if turbo is None else turbo,
        "recommended": recommended,
    }


