def component_path(cid):
    return os.path.join(models_dir(), COMPONENTS[cid]["file"])


def component_ready(cid):
    """Present at its full size. Size, not hash: hashing 4 GB on every catalog
    refresh would freeze the page, and the hash was checked when it landed."""
    try:
        return os.path.getsize(component_path(cid)) == COMPONENTS[cid]["size"]
    except OSError:
        return False


def model_components(m):
    seen, out = set(), []
    for cid in m["parts"].values():
        if cid not in seen:
            seen.add(cid)
            out.append(cid)
    return out


def model_state(m):
    comps = model_components(m)
    total = sum(COMPONENTS[c]["size"] for c in comps)
    have = 0
    for c in comps:
        p = component_path(c)
        if component_ready(c):
            have += COMPONENTS[c]["size"]
        else:
            try:
                have += min(os.path.getsize(p + ".part"), COMPONENTS[c]["size"])
            except OSError:
                pass
    installed = all(component_ready(c) for c in comps)
    return {
        "id": m["id"], "name": m["name"], "summary": m["summary"],
        "license": m["license"], "caps": m["caps"],
        "recommended": m["recommended"], "defaults": m["defaults"],
        "size": total, "downloaded": have if not installed else total,
        "installed": installed,
        "partial": (not installed) and have > 0,
    }


def gpu_vram_mb():
    """Total VRAM of the biggest GPU, or 0 when nothing can be read."""
    best = 0
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=memory.total",
                            "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=5)
        for line in (r.stdout or "").splitlines():
            try:
                best = max(best, int(float(line.strip())))
            except ValueError:
                pass
    except (OSError, subprocess.SubprocessError):
        pass
    if best:
        return best
    # amdgpu / i915 with local memory publish it in sysfs.
    drm = "/sys/class/drm"
    try:
        for card in os.listdir(drm):
            f = os.path.join(drm, card, "device", "mem_info_vram_total")
            try:
                with open(f) as fh:
                    best = max(best, int(fh.read().strip()) // (1024 * 1024))
            except (OSError, ValueError):
                pass
    except OSError:
        pass
    return best


# ── downloads ────────────────────────────────────────────────────────────────

def _sha256(path, out, label):
    h = hashlib.sha256()
    size = os.path.getsize(path)
    done, last = 0, 0.0
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(8 * 1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
            done += len(chunk)
            now = time.monotonic()
            if now - last > 0.5:
                last = now
                out.event("progress", phase="verify", file=label,
                          step=done, steps=size)
    return h.hexdigest()


def download_component(cid, out, stop=lambda: False):
    """Fetch one file into the models dir, resuming a .part when there is one.
    Returns True when the file is in place and verified."""
    c = COMPONENTS[cid]
    dest = component_path(cid)
    if component_ready(cid):
        return True
    os.makedirs(models_dir(), exist_ok=True)
    part = dest + ".part"
    have = 0
    try:
        have = os.path.getsize(part)
    except OSError:
        pass
    if have > c["size"]:
        os.unlink(part)
        have = 0

    if have < c["size"]:
        req = urllib.request.Request(c["url"], headers={
            "User-Agent": "genesi-ai-image/1"})
        if have:
            req.add_header("Range", "bytes=%d-" % have)
        try:
            resp = urllib.request.urlopen(req, timeout=60)
        except urllib.error.HTTPError as e:
            if e.code == 416:          # already complete on the server's count
                resp = None
            else:
                out.event("error", text="%s: HTTP %s" % (c["file"], e.code))
                return False
        except (urllib.error.URLError, OSError) as e:
            out.event("error", text="%s: %s" % (c["file"], getattr(e, "reason", e)))
            return False
        if resp is not None:
            # A server that ignored the Range sends the whole file from byte 0;
            # appending that to the partial would build a corrupt file.
            if have and resp.status != 206:
                have = 0
            mode = "ab" if have else "wb"
            done, last, t0 = have, 0.0, time.monotonic()
            try:
                with resp, open(part, mode) as fh:
                    while True:
                        if stop():
                            out.event("error", text="cancelled")
                            return False
                        chunk = resp.read(1024 * 1024)
                        if not chunk:
                            break
                        fh.write(chunk)
                        done += len(chunk)
                        now = time.monotonic()
                        if now - last > 0.4:
                            last = now
                            rate = (done - have) / max(now - t0, 1e-6)
                            out.event("progress", phase="download", file=c["file"],
                                      step=done, steps=c["size"],
                                      rate=int(rate))
            except (OSError, urllib.error.URLError) as e:
                out.event("error", text="%s: %s (the download resumes where it "
                          "stopped next time)" % (c["file"], e))
                return False

    size = os.path.getsize(part)
    if size != c["size"]:
        out.event("error", text="%s: got %d bytes, expected %d (try again — it "
                  "resumes)" % (c["file"], size, c["size"]))
        return False
    if c["sha256"]:
        digest = _sha256(part, out, c["file"])
        if digest != c["sha256"]:
            os.unlink(part)
            out.event("error", text="%s failed its checksum and was deleted — "
                      "download it again" % c["file"])
            return False
    os.replace(part, dest)
    return True


# ── image helpers ────────────────────────────────────────────────────────────

def image_size(path):
    """(width, height) of a PNG or JPEG from its header, or None."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(32)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:2] != b"\xff\xd8":
                return None
            fh.seek(2)
            while True:
                b = fh.read(1)
                while b and b != b"\xff":
                    b = fh.read(1)
                while b == b"\xff":
                    b = fh.read(1)
                if not b:
                    return None
                marker = b[0]
                seglen = struct.unpack(">H", fh.read(2))[0]
                # SOF0..SOF15 except DHT(C4), JPG(C8), DAC(CC) carry the size.
                if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                    fh.read(1)
                    h, w = struct.unpack(">HH", fh.read(4))
                    return (w, h)
                fh.seek(seglen - 2, 1)
    except (OSError, struct.error):
        return None


def snap(n):
    return max(256, int(round(n / 16.0)) * 16)


def fit_size(w, h, target=TARGET_PIXELS):
    """Keep the aspect ratio, land near `target` pixels, multiples of 16."""
    if w <= 0 or h <= 0:
        return 1024, 1024
    scale = (target / float(w * h)) ** 0.5
    nw, nh = snap(w * scale), snap(h * scale)
    big = max(nw, nh)
    if big > MAX_SIDE:
        f = MAX_SIDE / float(big)
        nw, nh = snap(nw * f), snap(nh * f)
    return nw, nh


def new_output_path(stem="genesi"):
    d = output_dir()
    os.makedirs(d, exist_ok=True)
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    path = os.path.join(d, "%s-%s.png" % (stem, ts))
    n = 2
    while os.path.exists(path):
        path = os.path.join(d, "%s-%s-%d.png" % (stem, ts, n))
        n += 1
    return path


