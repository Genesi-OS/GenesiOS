# ── paths ────────────────────────────────────────────────────────────────────

def _data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")


def models_dir():
    env = os.environ.get("GENESI_IMAGE_MODELS_DIR", "").strip()
    # NOT genesi/models: that is the GGUF chat library genesi-ai-turbo scans,
    # and a diffusion GGUF listed as a chat model would be offered in every
    # model picker and fail to load in all of them.
    return env or os.path.join(_data_home(), "genesi", "image-models")


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    d = os.environ.get("GENESI_IMAGE_CACHE_DIR", "").strip() or os.path.join(base, "genesi-ai-image")
    os.makedirs(d, exist_ok=True)
    return d


def runtime_dir():
    env = os.environ.get("GENESI_IMAGE_RUNTIME_DIR", "").strip()
    if env:
        os.makedirs(env, exist_ok=True)
        return env
    # NOT $XDG_RUNTIME_DIR, though it is the textbook place. It is a tmpfs
    # logind can mount AFTER a process started -- under WSL, ~20 s after boot
    # -- and every file in it (the warm engine's state, its activity clock,
    # its logs) vanishes under a running keeper: the server looked like it
    # "exited while loading" every first run, and keepers lost track of their
    # own activity file and never went idle. A stale file in the cache dir is
    # harmless: every pid in it is checked for life before it is believed.
    d = os.path.join(cache_dir(), "run")
    os.makedirs(d, exist_ok=True)
    return d


def log_path():
    return os.path.join(cache_dir(), "last-run.log")


def _xdg_pictures():
    try:
        r = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True,
                           text=True, timeout=3)
        p = (r.stdout or "").strip()
        # xdg-user-dir answers $HOME when the directory is not configured,
        # which would scatter pictures across the home folder.
        if p and os.path.realpath(p) != os.path.realpath(os.path.expanduser("~")):
            return p
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.expanduser("~/Pictures")


def output_dir():
    env = os.environ.get("GENESI_IMAGE_OUTPUT_DIR", "").strip()
    return env or os.path.join(_xdg_pictures(), "Genesi AI")


def _find(env_name, names):
    env = os.environ.get(env_name, "").strip()
    if env:
        return env if os.path.exists(env) else None
    for name in names:
        p = shutil.which(name)
        if p:
            return p
    return None


def find_engine():
    return _find("GENESI_SD_CLI", ENGINE_NAMES)


def find_server():
    return _find("GENESI_SD_SERVER", SERVER_NAMES)


def engine_argv(engine):
    """How to start an engine binary. A .py one is the stand-in
    ci/image-cli-test.py uses, run through this interpreter so the test also
    runs where a shebang does not (a Windows dev box)."""
    return [sys.executable, engine] if engine.endswith(".py") else [engine]


# ── output ───────────────────────────────────────────────────────────────────

class Out:
    """One JSON object per line in --json mode, readable text otherwise."""

    def __init__(self, as_json):
        self.json = as_json

    def event(self, kind, **fields):
        if self.json:
            fields["event"] = kind
            sys.stdout.write(json.dumps(fields, ensure_ascii=False) + "\n")
            sys.stdout.flush()
        else:
            text = fields.get("text")
            if kind == "progress":
                text = "%s %s/%s" % (fields.get("phase", ""), fields.get("step"),
                                     fields.get("steps") or 0)
            elif kind == "done":
                text = fields.get("path") or fields.get("text") or "done"
            elif kind == "phase":
                text = fields.get("phase")
            if text:
                sys.stderr.write(("[!] " if kind == "error" else ":: ") + str(text) + "\n")

    def data(self, obj):
        sys.stdout.write(json.dumps(obj, ensure_ascii=False,
                                    indent=None if self.json else 2) + "\n")
        sys.stdout.flush()


# ── hardware ─────────────────────────────────────────────────────────────────

def gpu_vram_mb():
    """Total VRAM of the biggest GPU, or 0 when nothing can be read."""
    env = os.environ.get("GENESI_IMAGE_VRAM_MB", "").strip()
    if env.isdigit():
        return int(env)
    best = 0
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=memory.total",
                            "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=5)
        for line in (r.stdout or "").splitlines():
            try:
                best = max(best, int(float(line.strip())))
            except ValueError:
                pass
    except (OSError, subprocess.SubprocessError):
        pass
    if best:
        return best
    drm = "/sys/class/drm"
    try:
        for card in os.listdir(drm):
            f = os.path.join(drm, card, "device", "mem_info_vram_total")
            try:
                with open(f) as fh:
                    best = max(best, int(fh.read().strip()) // (1024 * 1024))
            except (OSError, ValueError):
                pass
    except OSError:
        pass
    return best


def ram_mb():
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) // 1024
    except (OSError, ValueError):
        pass
    return 0


def has_nvidia():
    if shutil.which("nvidia-smi"):
        try:
            return subprocess.run(["nvidia-smi", "-L"], capture_output=True,
                                  timeout=5).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
    return False


def engine_info():
    """Which backend the installed engine will run on: cuda | vulkan | cpu.

    Asked of the engine itself (`--list-devices`), not guessed from the
    package name, and cached by the engine's mtime -- the probe loads every
    backend and is not free."""
    engine = find_engine()
    if not engine:
        return {"installed": False, "backend": "", "devices": [], "package": ""}
    try:
        stamp = "%s:%s" % (os.path.realpath(engine), os.path.getmtime(os.path.realpath(engine)))
    except OSError:
        stamp = engine
    cache = os.path.join(cache_dir(), "engine.json")
    try:
        with open(cache) as fh:
            c = json.load(fh)
        if c.get("stamp") == stamp:
            return c["info"]
    except (OSError, ValueError, KeyError):
        pass
    devices, backend = [], "cpu"
    try:
        r = subprocess.run(engine_argv(engine) + ["--list-devices"], capture_output=True,
                           text=True, timeout=60)
        for line in (r.stdout or "").splitlines():
            m = re.match(r"^(CUDA\d+|Vulkan\d+|ROCm\d+|CPU)\s+(.*)$", line.strip())
            if m:
                devices.append({"id": m.group(1), "name": m.group(2).strip()})
        ids = [d["id"] for d in devices]
        if any(i.startswith("CUDA") for i in ids):
            backend = "cuda"
        elif any(i.startswith("Vulkan") for i in ids):
            backend = "vulkan"
    except (OSError, subprocess.SubprocessError):
        pass
    pkg = ""
    for p in ("genesi-sd-cpp-cuda", "genesi-sd-cpp"):
        try:
            if subprocess.run(["pacman", "-Qq", p], capture_output=True,
                              timeout=10).returncode == 0:
                pkg = p
                break
        except (OSError, subprocess.SubprocessError):
            break
    info = {"installed": True, "backend": backend, "devices": devices, "package": pkg}
    try:
        with open(cache, "w") as fh:
            json.dump({"stamp": stamp, "info": info}, fh)
    except OSError:
        pass
    return info


