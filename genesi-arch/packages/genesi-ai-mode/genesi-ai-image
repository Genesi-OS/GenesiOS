def _custom_model(c):
    """A user's own checkpoint, shaped like a catalog model."""
    d = dict(IMPORT_DEFAULTS.get(c.get("family"), IMPORT_DEFAULTS["sdxl"]))
    parts = {"vae": "sdxl-vae"} if c.get("family") == "sdxl" else {}
    variants = [{"id": "file", "label": T("Original file", "Arquivo original"),
                 "parts": {"model": c["path"]}}]
    for q in c.get("optimized", []):
        variants.append({"id": q, "label": q.upper(),
                         "parts": {"model": os.path.join(models_dir(), "%s-%s.gguf" % (c["id"], q))}})
    return {"id": c["id"], "name": c["name"], "family": c.get("family", "sdxl"),
            "summary": T("Your model (%s)." % os.path.basename(c["path"]),
                         "Seu modelo (%s)." % os.path.basename(c["path"])),
            "license": "—", "caps": ["generate", "img2img"],
            "tags": ["custom", c.get("family", "sdxl")],
            "parts": parts, "variants": variants, "defaults": d,
            "turbo": {"cache": "ucache"}, "recommended": False, "custom": True}


def all_models():
    return MODELS + [_custom_model(c) for c in load_custom()]


def model_by_id(mid):
    for m in all_models():
        if m["id"] == mid:
            return m
    return None


def component_path(ref):
    """A part is either a component id or, for imported models, a path."""
    if os.path.isabs(ref):
        return ref
    return os.path.join(models_dir(), COMPONENTS[ref]["file"])


def component_ready(ref):
    """Present at its full size. Size, not hash: hashing GBs on every catalog
    refresh would freeze the page, and the hash was checked when it landed."""
    p = component_path(ref)
    if os.path.isabs(ref):
        return os.path.isfile(p)
    try:
        return os.path.getsize(p) == COMPONENTS[ref]["size"]
    except OSError:
        return False


def _component_size(ref):
    if os.path.isabs(ref):
        try:
            return os.path.getsize(ref)
        except OSError:
            return 0
    return COMPONENTS[ref]["size"]


def converted_path(v):
    return os.path.join(models_dir(), v["convert"]["file"])


def converted_ready(v):
    p = converted_path(v)
    return os.path.isfile(p) and os.path.isfile(p + ".ok")


def variant_parts(m, v):
    """role -> part (component id or path) for this variant, shared ones too."""
    parts = dict(m.get("parts", {}))
    if "convert" in v:
        parts[v["convert"]["role"]] = converted_path(v)
    else:
        parts.update(v.get("parts", {}))
    return parts


def variant_downloads(m, v):
    """Component ids this variant has to download (the source of a
    conversion included, since the conversion needs it)."""
    ids = []
    for ref in m.get("parts", {}).values():
        if not os.path.isabs(ref) and ref not in ids:
            ids.append(ref)
    if "convert" in v:
        if not converted_ready(v):
            ids.append(v["convert"]["from"])
    else:
        for ref in v.get("parts", {}).values():
            if not os.path.isabs(ref) and ref not in ids:
                ids.append(ref)
    lora = (m.get("turbo") or {}).get("lora")
    if lora and lora not in ids:
        ids.append(lora)
    return ids


def variant_ready(m, v):
    for ref in variant_parts(m, v).values():
        if os.path.isabs(ref):
            if not os.path.isfile(ref) or ("convert" in v and not converted_ready(v)):
                return False
        elif not component_ready(ref):
            return False
    return True


def turbo_ready(m):
    lora = (m.get("turbo") or {}).get("lora")
    return (not lora) or component_ready(lora)


def _variant_size(m, v):
    total = 0
    for ref in m.get("parts", {}).values():
        total += _component_size(ref)
    if "convert" in v:
        # What stays on disk: about 60% of the fp16 source for Q8_0 (measured: 6.94 -> 4.18 GB).
        total += int(COMPONENTS[v["convert"]["from"]]["size"] * 0.61)
    else:
        for ref in v.get("parts", {}).values():
            total += _component_size(ref)
    return total


def _gpu_part_size(m, v):
    """The weights the GPU actually computes with each step."""
    parts = v.get("parts", {})
    ref = parts.get("diffusion") or parts.get("model") or parts.get("upscale")
    if "convert" in v:
        return int(COMPONENTS[v["convert"]["from"]]["size"] * 0.61)
    return _component_size(ref) if ref else 0


def recommended_variant(m, vram_mb=None):
    """The largest variant whose compute weights fit the card with ~1.5 GB to
    spare for activations; the smallest one when none does (auto-fit and
    offload carry the rest, slower)."""
    vram_mb = gpu_vram_mb() if vram_mb is None else vram_mb
    vs = sorted(m["variants"], key=lambda v: _gpu_part_size(m, v))
    if not vram_mb:
        return vs[0]
    fit = [v for v in vs if _gpu_part_size(m, v) <= (vram_mb - 1536) * 1024 * 1024]
    # An fp16 checkpoint is never the recommendation when a converted one
    # exists: same picture, twice the memory.
    fit = [v for v in fit if not (v["id"] == "fp16" and any("convert" in x for x in vs))] or fit
    return fit[-1] if fit else vs[0]


def pick_variant(m, wanted=None):
    """The variant to run: the one asked for, else the best installed one."""
    by_id = {v["id"]: v for v in m["variants"]}
    if wanted:
        return by_id.get(wanted)
    rec = recommended_variant(m)
    if variant_ready(m, rec):
        return rec
    ready = [v for v in m["variants"] if variant_ready(m, v)]
    return ready[-1] if ready else rec


def model_state(m, vram_mb=None):
    vram_mb = gpu_vram_mb() if vram_mb is None else vram_mb
    rec = recommended_variant(m, vram_mb)
    variants = []
    for v in m["variants"]:
        need = variant_downloads(m, v)
        have = 0
        for ref in need:
            if component_ready(ref):
                have += _component_size(ref)
            else:
                try:
                    have += min(os.path.getsize(component_path(ref) + ".part"), _component_size(ref))
                except OSError:
                    pass
        ready = variant_ready(m, v)
        variants.append({
            "id": v["id"],
            "label": v["label"] if isinstance(v["label"], dict) else T(v["label"], v["label"]),
            "size": _variant_size(m, v), "gpu_size": _gpu_part_size(m, v),
            # What is still to fetch -- not what the variant weighs: a file
            # another model already brought is not downloaded again.
            "download": sum(_component_size(r) for r in need
                            if not component_ready(r)) if not ready else 0,
            "downloaded": have, "installed": ready,
            "partial": (not ready) and have > 0,
            "converts": "convert" in v,
            "recommended": v["id"] == rec["id"],
        })
    installed = [v for v in variants if v["installed"]]
    return {
        "id": m["id"], "name": m["name"], "family": m.get("family", ""),
        "summary": m["summary"], "license": m["license"], "caps": m["caps"],
        "tags": m.get("tags", []), "defaults": m.get("defaults", {}),
        "recommended": m.get("recommended", False), "custom": m.get("custom", False),
        "min_ram_gb": m.get("min_ram_gb", 0),
        "identity": m.get("identity", 0),
        "max_refs": max_refs(m),
        "lora_families": LORA_FAMILIES.get(m.get("family", ""), []),
        "turbo": {"kind": ("lora" if (m.get("turbo") or {}).get("lora")
                           else (m.get("turbo") or {}).get("cache") and "cache" or "warm"),
                  "steps": (m.get("turbo") or {}).get("steps")},
        "variants": variants,
        "installed": bool(installed),
        "partial": any(v["partial"] for v in variants),
        "active_variant": pick_variant(m)["id"] if installed else rec["id"],
    }


