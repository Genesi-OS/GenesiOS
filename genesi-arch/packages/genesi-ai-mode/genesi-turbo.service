[Unit]
Description=Genesi Turbo - always-warm shared local-AI inference server
Documentation=https://github.com/Genesi-OS/GenesiOS
# Roadmap 2.8.11 Tier 1: one persistent llama-server (the Turbo :11435, OpenAI-
# compatible) that EVERY Genesi app (Code, Hermes, the Monitor) reuses — no
# per-app reload, one warm model + one KV cache shared across apps. OFF by
# default: shipped but NOT enabled at install. Turn it on with the advanced.conf
# `always_warm_turbo` knob (genesi-aid then starts/stops this unit) or directly:
#   sudo systemctl enable --now genesi-turbo.service
# Order after ollama so its model blobs are already group-readable (the ollama
# drop-in opens the perms on start); harmless if ollama isn't installed.
After=ollama.service genesi-aid.service
Wants=genesi-aid.service
# Don't restart-storm if the model can't load (bad model, no VRAM, OOM): give up
# after 5 failures in 5 min so a misconfig doesn't peg the box.
# StartLimit* belong to [Unit], not [Service] — in [Service] systemd ignores
# them with "Unknown key 'StartLimitIntervalSec' in section [Service]" and the
# rate limit never applies, so a Turbo that cannot load its model retried every
# RestartSec forever instead of giving up.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Resolve the model to keep warm: an explicit GENESI_WARM_MODEL (optional env
# file) wins, else the advisor's biggest-fits-VRAM pick, else a safe small model.
# `exec` so llama-server becomes the main process (clean stop/restart).
#
# The same env file takes GENESI_TURBO_HOST=0.0.0.0 to serve the LAN instead of
# loopback, which is how one GPU box serves machines that have no GPU. Clients
# set GENESI_TURBO_URL=http://<that-box>:11435. Prefer this over Genesi Mesh
# whenever the model FITS on the GPU box: Turbo-over-HTTP moves text, Mesh moves
# layer activations for every token. Turbo has no authentication, so only bind
# beyond loopback on a network you control.
EnvironmentFile=-/etc/genesi-ai-mode/turbo.env
# HOME must exist. Without it `ollama` does not fail, it PANICS --
# "panic: $HOME is not defined" out of envconfig.Models() before the CLI is even
# built -- so a warm model that is not downloaded yet could never be pulled, and
# the unit just exited 1 in a loop with the panic buried in the journal. A
# service that runs another program's CLI has to give it an environment that
# program can start in. StateDirectory gives us a real one (and somewhere for
# the optional slot cache to live, which ProtectHome otherwise denies).
StateDirectory=genesi-turbo
Environment=HOME=/var/lib/genesi-turbo
# --installed: recommend WITHOUT it answers "the biggest model this GPU could
# run", which is advice, not a boot decision. A machine with a 3B downloaded got
# told 8B and started its day pulling 5 GB nobody asked for -- then failed,
# because the pull needs an environment ollama can start in. Serve what is here;
# fall back to a small pull only when nothing is.
ExecStart=/bin/sh -c 'm="${GENESI_WARM_MODEL:-$(genesi-ai-turbo recommend --installed 2>/dev/null | head -n1)}"; [ -n "$m" ] || m=llama3.2:3b; echo "genesi-turbo: warming $m"; exec genesi-ai-turbo serve "$m"'
Restart=on-failure
RestartSec=15

# Inference server: needs the GPU + to read the model blobs, so we keep the
# sandbox light. NoNewPrivileges is safe; ProtectHome only costs the optional
# on-disk slot cache (Turbo skips it gracefully when ~/.cache isn't writable).
NoNewPrivileges=true
ProtectSystem=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
