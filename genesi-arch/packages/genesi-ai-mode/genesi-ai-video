def _load_image_tool():
    """genesi-ai-image, as a module. Beside this file when installed (both go
    to /usr/local/bin), beside it in the source tree too; GENESI_AI_IMAGE_TOOL
    overrides for tests."""
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.environ.get("GENESI_AI_IMAGE_TOOL", "").strip(),
              os.path.join(here, "genesi-ai-image"),
              shutil.which("genesi-ai-image") or ""):
        if p and os.path.isfile(p):
            loader = importlib.machinery.SourceFileLoader("genesi_ai_image", p)
            spec = importlib.util.spec_from_loader("genesi_ai_image", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    sys.stderr.write("genesi-ai-video: genesi-ai-image is missing (reinstall genesi-ai-mode)\n")
    sys.exit(127)


