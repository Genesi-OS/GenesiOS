def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    d = os.environ.get("GENESI_VIDEO_CACHE_DIR", "").strip() or os.path.join(base, "genesi-ai-video")
    os.makedirs(d, exist_ok=True)
    return d


def log_path():
    return os.path.join(cache_dir(), "last-run.log")


def _xdg_videos():
    try:
        r = subprocess.run(["xdg-user-dir", "VIDEOS"], capture_output=True, text=True, timeout=3)
        p = (r.stdout or "").strip()
        if p and os.path.realpath(p) != os.path.realpath(os.path.expanduser("~")):
            return p
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.expanduser("~/Videos")


def output_dir():
    env = os.environ.get("GENESI_VIDEO_OUTPUT_DIR", "").strip()
    return env or os.path.join(_xdg_videos(), "Genesi AI")


def find_ffmpeg():
    env = os.environ.get("GENESI_FFMPEG", "").strip()
    if env:
        return env if os.path.exists(env) else None
    return shutil.which("ffmpeg")


def find_ffprobe():
    env = os.environ.get("GENESI_FFPROBE", "").strip()
    if env:
        return env if os.path.exists(env) else None
    return shutil.which("ffprobe")


def tool_argv(path):
    """A stand-in ffmpeg in the tests is a .py, run by this interpreter."""
    return [sys.executable, path] if path.endswith(".py") else [path]


def new_output_stem(kind="genesi-video"):
    d = output_dir()
    os.makedirs(d, exist_ok=True)
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    stem = os.path.join(d, "%s-%s" % (kind, ts))
    n = 2
    while any(os.path.exists(stem + ext) for ext in (".mp4", ".avi", ".json")):
        stem = os.path.join(d, "%s-%s-%d" % (kind, ts, n))
        n += 1
    return stem


