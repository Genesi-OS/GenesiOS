# Which user LoRAs each family takes (genesi-ai-image reads the base of an
# imported LoRA; Wan's three widths do not take each other's). Wan2.2 A14B is
# built on Wan2.1 14B and takes its LoRAs. LTX-2 LoRAs are not recognized yet.
VIDEO_LORA_FAMILIES = {
    "wan-5b": ["wan-5b"], "wan-1.3b": ["wan-1.3b"], "wan-14b": ["wan-14b"],
    "wan22-a14b": ["wan-14b"], "ltx2": [],
}


def _install_catalog():
    """Hand the video catalog to the image module, so its download, removal,
    state and LoRA code works on video models unchanged. Only in THIS process:
    genesi-ai-image run on its own never sees a video model.

    Idempotent, and it never overwrites an entry that is already there: main()
    runs it on every call, and a second pass that put the real URLs back over
    a test's stand-ins once sent the suite downloading 12 GB from the Hub."""
    for cid, c in VIDEO_COMPONENTS.items():
        img.COMPONENTS.setdefault(cid, c)
    for role, flag in VIDEO_PART_FLAGS.items():
        img.PART_FLAGS.setdefault(role, flag)
    for fam, fams in VIDEO_LORA_FAMILIES.items():
        img.LORA_FAMILIES.setdefault(fam, fams)
    have = {m["id"] for m in img.MODELS}
    img.MODELS.extend(m for m in VIDEO_MODELS if m["id"] not in have)
    # The video run's log is its own: "Show details" on the Video page must
    # not open the last PICTURE's engine output.
    img.log_path = log_path


