# ── frames, sizes ────────────────────────────────────────────────────────────

def frame_count(m, seconds=None, frames=None):
    """Frames for a clip: N*step + 1, which is what the video VAEs take (Wan
    packs 4 frames per latent, LTX 8), never past the model's longest clip."""
    vid = m.get("video", {})
    fps = vid.get("fps", 16)
    step = vid.get("frame_step", 4)
    longest = (int(vid.get("max_seconds", 5) * fps) // step) * step + 1
    if frames:
        n = int(frames)
    else:
        n = int(round(float(seconds if seconds else vid.get("default_seconds", 3)) * fps))
    n = max(step + 1, ((max(1, n - 1) + step // 2) // step) * step + 1)
    return min(n, longest)


def _snap(n, align):
    return max(align * 8, int(round(n / float(align))) * align)


def video_size(m, size="480p", aspect=None, src=None):
    """(width, height): the preset's pixel area, in the shape of the aspect
    ratio -- or of the picture/video being animated -- in multiples of the
    model's alignment (16 for Wan 14B/1.3B, 32 for the 5B and LTX)."""
    vid = m.get("video", {})
    align = vid.get("align", 16)
    if size not in vid.get("sizes", ["480p"]):
        size = vid.get("sizes", ["480p"])[0]
    pw, ph = SIZES.get(size, SIZES["480p"])
    area = pw * ph
    if src and src[0] > 0 and src[1] > 0:
        rw, rh = src
    else:
        # The presets ARE the shapes the models were trained at (832x480,
        # 1280x720): landscape and portrait use them as they are.
        if (aspect or "16:9") == "16:9":
            return _snap(pw, align), _snap(ph, align)
        if aspect == "9:16":
            return _snap(ph, align), _snap(pw, align)
        rw, rh = ASPECTS.get(aspect, (16, 9))
    scale = (area / float(rw * rh)) ** 0.5
    return _snap(rw * scale, align), _snap(rh * scale, align)


# ── turning the engine's output into a video ────────────────────────────────

def avi_frames(path, limit=None):
    """The JPEG frames of an MJPG .avi (what sd-cli writes), in order. Pure
    Python on purpose: the gallery's poster and a clip's first frame must
    not need ffmpeg."""
    out = []
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        return out
    i = data.find(b"movi")
    while i >= 0:
        i = data.find(b"00dc", i + 4)
        if i < 0 or i + 8 > len(data):
            break
        size = struct.unpack("<I", data[i + 4:i + 8])[0]
        chunk = data[i + 8:i + 8 + size]
        if chunk[:2] == b"\xff\xd8":
            out.append(chunk)
            if limit and len(out) >= limit:
                break
        i += 8 + size - 4
    return out


def write_poster(avi, dest):
    frames = avi_frames(avi, limit=1)
    if not frames:
        return False
    try:
        with open(dest, "wb") as fh:
            fh.write(frames[0])
        return True
    except OSError:
        return False


def to_mp4(src, dest, out):
    """H.264 + AAC .mp4 from the engine's .avi, small and playable anywhere.
    The .avi stays when this fails -- a clip that cannot be shared is still a
    clip."""
    ff = find_ffmpeg()
    if not ff:
        return False
    out.event("phase", phase="finish")
    argv = tool_argv(ff) + ["-y", "-loglevel", "error", "-i", src,
                            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "18",
                            "-preset", "medium", "-movflags", "+faststart",
                            "-c:a", "aac", "-b:a", "160k", dest]
    try:
        r = subprocess.run(argv, capture_output=True, timeout=1800)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0 and os.path.isfile(dest) and os.path.getsize(dest) > 0


def probe(path):
    """(width, height, fps, seconds) of a video, or None. ffprobe when it is
    there; our own .avi header otherwise."""
    fp = find_ffprobe()
    if fp:
        try:
            r = subprocess.run(tool_argv(fp) + ["-v", "error", "-select_streams", "v:0",
                                                "-show_entries", "stream=width,height,r_frame_rate,nb_frames:format=duration",
                                                "-of", "json", path],
                               capture_output=True, text=True, timeout=30)
            js = json.loads(r.stdout or "{}")
            s = (js.get("streams") or [{}])[0]
            num, _, den = str(s.get("r_frame_rate", "0/1")).partition("/")
            fps = float(num) / float(den or 1) if float(den or 1) else 0.0
            dur = float((js.get("format") or {}).get("duration") or 0)
            if s.get("width") and s.get("height"):
                return int(s["width"]), int(s["height"]), fps, dur
        except (OSError, subprocess.SubprocessError, ValueError, ZeroDivisionError):
            pass
    try:
        with open(path, "rb") as fh:
            head = fh.read(256)
        if head[:4] == b"RIFF" and head[8:12] == b"AVI ":
            i = head.find(b"avih")
            usec, _, _, _, nframes = struct.unpack("<IIIII", head[i + 8:i + 28])
            w, h = struct.unpack("<II", head[i + 40:i + 48])
            fps = 1e6 / usec if usec else 0.0
            return w, h, fps, nframes / fps if fps else 0.0
    except (OSError, struct.error, ValueError):
        pass
    return None


def run_ffmpeg(args, timeout=1800):
    ff = find_ffmpeg()
    if not ff:
        return 127, "ffmpeg is not installed"
    try:
        r = subprocess.run(tool_argv(ff) + ["-y", "-loglevel", "error"] + args,
                           capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)
    return r.returncode, (r.stderr or "").strip()[-400:]


def control_frames(src, width, height, fps, frames, out):
    """A source video as the numbered PNG frames VACE reads (--control-video
    takes a directory), at the model's frame rate and the run's size."""
    d = os.path.join(cache_dir(), "control")
    shutil.rmtree(d, ignore_errors=True)
    os.makedirs(d, exist_ok=True)
    out.event("status", text="reading the source video")
    vf = ("fps=%d,scale=%d:%d:force_original_aspect_ratio=increase,crop=%d:%d,setsar=1"
          % (fps, width, height, width, height))
    rc, err = run_ffmpeg(["-i", src, "-vf", vf, "-frames:v", str(frames),
                          os.path.join(d, "%05d.png")])
    got = sorted(n for n in os.listdir(d) if n.endswith(".png")) if os.path.isdir(d) else []
    if rc != 0 or not got:
        return None, err or "no frames could be read from the video"
    return d, ""


def last_frame(src, out):
    """The final frame of a video, where a continuation starts."""
    dest = os.path.join(cache_dir(), "last-frame.png")
    try:
        os.unlink(dest)
    except OSError:
        pass
    out.event("status", text="taking the last frame")
    rc, err = run_ffmpeg(["-sseof", "-1", "-i", src, "-update", "1", "-q:v", "1", dest])
    if rc != 0 or not os.path.isfile(dest):
        return None, err or "could not read the video's last frame"
    return dest, ""


def join_clips(first, second, dest, width, height, fps, out):
    """first + second as one clip. The second starts ON the first's last
    frame, so that frame is dropped from it rather than shown twice."""
    out.event("status", text="joining the clips")
    fc = ("[0:v]fps=%d,scale=%d:%d,setsar=1[a];"
          "[1:v]trim=start_frame=1,setpts=PTS-STARTPTS,fps=%d,scale=%d:%d,setsar=1[b];"
          "[a][b]concat=n=2:v=1:a=0[v]" % (fps, width, height, fps, width, height))
    rc, err = run_ffmpeg(["-i", first, "-i", second, "-filter_complex", fc, "-map", "[v]",
                          "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "18",
                          "-movflags", "+faststart", dest])
    return rc == 0 and os.path.isfile(dest), err


# ── what the engine is asked to do ───────────────────────────────────────────

def video_settings(m, turbo, steps=0, cfg=None, negative=None):
    d = m.get("defaults", {})
    t = m.get("turbo") or {}
    s = {"steps": d.get("steps", 20), "cfg": d.get("cfg", 5.0),
         "sampler": d.get("sampler"), "scheduler": d.get("scheduler"),
         "flow_shift": d.get("flow_shift"), "sigmas": d.get("sigmas"),
         "vace_strength": d.get("vace_strength"),
         "negative": d.get("negative", "") if negative is None else negative,
         "loras": [], "turbo": False}
    if turbo and img.turbo_loras(m) and img.turbo_ready(m):
        s["loras"].append((img.component_path(t["lora"]), 1.0, False))
        if t.get("lora_high"):
            s["loras"].append((img.component_path(t["lora_high"]), 1.0, True))
        s["steps"] = t.get("steps", s["steps"])
        s["cfg"] = t.get("cfg", s["cfg"])
        s["sigmas"] = None
        s["turbo"] = True
    if steps:
        s["steps"] = int(steps)
        # A fixed schedule IS a step count; another count means the
        # scheduler's own schedule.
        s["sigmas"] = None
    if cfg is not None:
        s["cfg"] = float(cfg)
    if s["cfg"] <= 1.0:
        s["negative"] = ""
    return s


def lora_tag(path, weight, high=False):
    name = os.path.splitext(os.path.basename(path))[0]
    return "<lora:%s%s:%g>" % ("|high_noise|" if high else "", name, weight)


def build_video_argv(engine, m, v, s, prompt, out_path, width, height, frames, seed,
                     mode, image, end_image, control_dir, backend, safe, vram_mb,
                     low_memory=False, light_vae=False):
    vid = m.get("video", {})
    argv = img.engine_argv(engine) + ["-M", "vid_gen"]
    parts = img.variant_parts(m, v)
    tae = parts.get("tae")
    use_tae = bool(light_vae and tae and img.component_ready(tae))
    for role, ref in parts.items():
        if role == "tae":
            continue
        if role == "vae" and use_tae:
            argv += ["--tae", img.component_path(tae)]
            continue
        argv += [img.PART_FLAGS[role], img.component_path(ref)]
    # Same rule as pictures: flash attention helps CUDA and CPU, slows Vulkan.
    if backend in ("cuda", "cpu"):
        argv += ["--diffusion-fa"]
    if safe or low_memory or img._heavy(m, v, vram_mb):
        argv += ["--offload-to-cpu", "--max-vram", "-1"]
    argv += ["--lora-model-dir", img.models_dir()]
    text = prompt
    for path, weight, high in s["loras"]:
        text += lora_tag(path, weight, high)
    argv += ["-p", text]
    if s["negative"]:
        argv += ["-n", s["negative"]]
    argv += ["-W", str(int(width)), "-H", str(int(height)),
             "--video-frames", str(int(frames)), "--fps", str(int(vid.get("fps", 16))),
             "--steps", str(int(s["steps"])), "--cfg-scale", str(s["cfg"]),
             "--seed", str(int(seed)), "-o", out_path]
    if s["sampler"]:
        argv += ["--sampling-method", s["sampler"]]
    if s["scheduler"]:
        argv += ["--scheduler", s["scheduler"]]
    if s["flow_shift"]:
        argv += ["--flow-shift", str(s["flow_shift"])]
    if s["sigmas"]:
        argv += ["--sigmas", s["sigmas"]]
    if vid.get("moe"):
        # The high-noise expert is a second model with its own sampler
        # settings; left unset it would run at its defaults, not ours. The
        # split between the two is upstream's automatic boundary: --steps is
        # the TOTAL.
        argv += ["--high-noise-sampling-method", s["sampler"] or "euler",
                 "--high-noise-cfg-scale", str(s["cfg"])]
    if mode in ("i2v", "flf2v", "extend", "r2v") and image:
        argv += ["-i", image]
    if mode == "flf2v" and end_image:
        argv += ["--end-img", end_image]
    if mode == "v2v":
        if image:
            argv += ["-i", image]
        argv += ["--control-video", control_dir]
    if mode in ("r2v", "v2v") and s.get("vace_strength") is not None:
        argv += ["--vace-strength", str(s["vace_strength"])]
    # Encoding a picture or a control video has no out-of-memory retry
    # upstream (decoding does), so every mode that encodes one is tiled --
    # the same 8 GB failure the Image page's edits had.
    if mode != "t2v" or safe or low_memory:
        argv += ["--vae-tiling"]
    return argv


