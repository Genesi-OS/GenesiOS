def cmd_status(args, out):
    info = img.engine_info()
    st = img.server_state()
    out.data({
        "engine": img.find_engine() or "",
        "engine_installed": bool(info["installed"]),
        "backend": info["backend"],
        "devices": info["devices"],
        "package": info["package"],
        "nvidia": img.has_nvidia(),
        "ffmpeg": bool(find_ffmpeg()),
        "image_warm": bool(st),
        "models_dir": img.models_dir(),
        "output_dir": output_dir(),
        "log": log_path(),
        "loras": len(img.load_loras()),
        "vram_mb": img.gpu_vram_mb(),
        "ram_mb": img.ram_mb(),
        "any_model": any(img.model_state(m)["installed"] for m in VIDEO_MODELS),
    })
    return 0


def cmd_catalog(args, out):
    vram = img.gpu_vram_mb()
    out.data([video_state(m, vram) for m in VIDEO_MODELS])
    return 0


def _video_or_fail(mid, out):
    m = video_model(mid)
    if not m:
        out.event("error", text="unknown video model: %s" % mid)
    return m


def cmd_pull(args, out):
    if not _video_or_fail(args.model, out):
        return 2
    return img.cmd_pull(args, out)


def cmd_remove(args, out):
    if not _video_or_fail(args.model, out):
        return 2
    return img.cmd_remove(args, out)


def _need_image(path, what, out):
    if not path or not os.path.isfile(path):
        out.event("error", code="no-input", text="%s: no such picture %s" % (what, path or ""))
        return None
    dims = img.image_size(path)
    if not dims:
        out.event("error", code="no-input", text="%s is not a PNG or JPEG" % path)
        return None
    return dims


def cmd_generate(args, out):
    m = _video_or_fail(args.model, out)
    if not m:
        return 2
    vid = m.get("video", {})
    mode = args.mode or ("i2v" if args.image and "i2v" in m["caps"] else "t2v")
    can = list(m["caps"]) + (["extend"] if "i2v" in m["caps"] else [])
    if mode not in can:
        out.event("error", code="mode-unsupported", text="%s cannot do %s" % (m["name"], mode))
        return 2
    v = img.pick_variant(m, args.variant)
    if not v or not img.variant_ready(m, v):
        out.event("error", code="no-model", text="%s is not downloaded yet" % m["name"])
        return 2
    prompt = (args.prompt or "").strip()
    asked = prompt
    if not prompt:
        out.event("error", text="empty prompt")
        return 2

    # The inputs each mode needs, checked before anything is loaded.
    src_dims = None
    if mode in ("i2v", "flf2v", "r2v"):
        src_dims = _need_image(args.image, "the picture", out)
        if not src_dims:
            return 2
    if mode == "flf2v" and not _need_image(args.end_image, "the last frame", out):
        return 2
    if mode == "v2v" and args.image and not _need_image(args.image, "the reference", out):
        return 2
    if mode in ("v2v", "extend"):
        if not args.video or not os.path.isfile(args.video):
            out.event("error", code="no-input", text="no such video: %s" % (args.video or ""))
            return 2
        if not find_ffmpeg():
            out.event("error", code="no-ffmpeg",
                      text="reading a video needs ffmpeg (sudo pacman -S ffmpeg)")
            return 3
        pr = probe(args.video)
        if not pr:
            out.event("error", code="no-input", text="%s is not a video Genesi can read" % args.video)
            return 2
        src_dims = (pr[0], pr[1])
    engine = img._engine_or_fail(out)
    if not engine:
        return 3

    fps = int(vid.get("fps", 16))
    frames = frame_count(m, seconds=args.seconds, frames=args.frames)
    # r2v places the reference in a NEW scene: the picture's shape is not the
    # video's, so it follows the aspect chosen like text-to-video does.
    shape_src = None if mode == "r2v" else src_dims
    width, height = video_size(m, args.size or vid.get("sizes", ["480p"])[0], args.aspect, shape_src)
    seed = args.seed if args.seed is not None and args.seed >= 0 else random.randint(0, 2 ** 31 - 1)

    if not args.keep_llm:
        n = img.ollama_unload_all()
        if n:
            out.event("status", text="unloaded %d chat model(s) to free the GPU" % n)
    # The Image page's warm engine holds a model on the same card.
    if img.server_state():
        img.stop_server()
        out.event("status", code="image-warm-stopped",
                  text="stopped the Image page's warm engine to free the GPU")

    info = img.engine_info()
    backend = info["backend"] or "cpu"
    vram = img.gpu_vram_mb()
    s = video_settings(m, bool(args.turbo), steps=args.steps, cfg=args.cfg, negative=args.negative)
    user_loras = img.resolve_loras(m, mode, args.lora, out)
    if user_loras is None:
        return 2
    for path, weight, trigger in user_loras:
        s["loras"].append((path, weight, False))
        # A Wan2.2 A14B clip runs through BOTH experts: a style that only
        # touched the second would arrive too late to shape the motion.
        if vid.get("moe"):
            s["loras"].append((path, weight, True))
        if trigger and trigger.lower() not in prompt.lower():
            prompt = prompt + ", " + trigger

    stem = os.path.splitext(args.out)[0] if args.out else new_output_stem(
        "genesi-video" if mode == "t2v" else "genesi-" + mode)
    avi = stem + (".part.avi" if mode == "extend" else ".avi")
    image, control_dir = args.image, None
    if mode == "extend":
        image, err = last_frame(args.video, out)
        if not image:
            out.event("error", code="no-input", text=err)
            return 1
    if mode == "v2v":
        control_dir, err = control_frames(args.video, width, height, fps, frames, out)
        if not control_dir:
            out.event("error", code="no-input", text=err)
            return 1
        # A short source gives fewer frames than asked: never generate past it.
        got = len([n for n in os.listdir(control_dir) if n.endswith(".png")])
        if got < frames:
            frames = max(vid.get("frame_step", 4) + 1,
                         ((got - 1) // vid.get("frame_step", 4)) * vid.get("frame_step", 4) + 1)

    out.event("start", mode=mode, model=m["id"], variant=v["id"], width=width, height=height,
              frames=frames, fps=fps, seconds=round(frames / float(fps), 2), seed=seed,
              steps=s["steps"], backend=backend, turbo=s["turbo"], path=stem)
    t0 = time.monotonic()
    ok, reason, parser, safe = False, "", None, False
    for attempt in (1, 2):
        safe = attempt == 2
        light = bool(args.light_vae)
        if safe:
            # The low-memory shape: weights in RAM, tiled VAE, the 22 MB
            # decoder when it is here, and no bigger than 480p.
            light = True
            w480, h480 = video_size(m, "480p", args.aspect, None if mode == "r2v" else src_dims)
            if width * height > w480 * h480:
                width, height = w480, h480
            out.event("status", code="retry",
                      text="retrying in low-memory mode (%dx%d)" % (width, height))
        argv = build_video_argv(engine, m, v, s, prompt, avi, width, height, frames, seed,
                                mode, image, args.end_image, control_dir, backend, safe, vram,
                                low_memory=bool(args.low_memory), light_vae=light)
        rc, reason, parser = img.run_engine(argv, out)
        ok = rc == 0 and os.path.isfile(avi)
        if not ok and rc == 0 and os.path.isfile(os.path.splitext(avi)[0] + ".png"):
            reason = "the engine made a single picture, not a video"
        if ok or rc in (-15, 130, 143) or attempt == 2:
            break

    if not ok:
        out.event("error", code="oom" if parser and parser.oom else "engine",
                  text=img._friendly(reason or "the video engine stopped", parser, safe),
                  log=log_path())
        return 1

    final, audio = avi, bool(vid.get("audio"))
    poster = stem + ".jpg"
    if mode == "extend":
        joined = stem + ".mp4"
        good, err = join_clips(args.video, avi, joined, width, height, fps, out)
        if not good:
            out.event("error", code="join", text="the new part was made but could not be joined: "
                                                 + (err or "ffmpeg failed"), log=log_path(), path=avi)
            return 1
        write_poster(avi, poster)
        try:
            os.unlink(avi)
        except OSError:
            pass
        final = joined
        # The poster of a continuation is the source's own first frame.
        if find_ffmpeg():
            run_ffmpeg(["-i", joined, "-frames:v", "1", "-q:v", "2", poster])
    else:
        write_poster(avi, poster)
        mp4 = stem + ".mp4"
        if to_mp4(avi, mp4, out):
            try:
                os.unlink(avi)
            except OSError:
                pass
            final = mp4
        elif find_ffmpeg():
            out.event("status", text="kept the .avi (the .mp4 conversion failed)")

    secs = round(time.monotonic() - t0, 1)
    meta = {"mode": mode, "model": m["id"], "variant": v["id"], "prompt": asked, "seed": seed,
            "width": width, "height": height, "frames": frames, "fps": fps,
            "seconds_long": round(frames / float(fps), 2), "steps": s["steps"],
            "turbo": s["turbo"], "backend": backend, "audio": audio,
            "source": os.path.abspath(args.video or args.image) if (args.video or args.image) else "",
            "loras": [os.path.basename(p_) for p_, _w, _h in s["loras"]],
            "poster": poster if os.path.isfile(poster) else "",
            "seconds": secs, "created": int(time.time())}
    img.write_sidecar(stem + ".json", meta)
    out.event("done", path=final, poster=meta["poster"], seconds=secs, seed=seed,
              width=width, height=height, frames=frames, fps=fps, low_memory=safe)
    return 0


def cmd_gallery(args, out):
    d = output_dir()
    items = []
    try:
        names = [n for n in os.listdir(d) if n.lower().endswith((".mp4", ".avi", ".webm"))
                 and ".part." not in n]
    except OSError:
        names = []
    for n in names:
        p = os.path.join(d, n)
        stem = os.path.splitext(p)[0]
        try:
            mtime = os.path.getmtime(p)
        except OSError:
            continue
        meta = {}
        try:
            with open(stem + ".json", encoding="utf-8") as fh:
                meta = json.load(fh)
        except (OSError, ValueError):
            pass
        meta.update({"path": p, "mtime": int(mtime),
                     "poster": stem + ".jpg" if os.path.isfile(stem + ".jpg") else ""})
        items.append(meta)
    items.sort(key=lambda it: it["mtime"], reverse=True)
    out.data(items[:max(1, args.limit)])
    return 0


def cmd_lora(args, out):
    # The SAME store as the Image page: a LoRA imported on either page is
    # one file, and each page shows the ones its models take.
    return img.cmd_lora(args, out)


def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)
    _install_catalog()

    ap = argparse.ArgumentParser(prog="genesi-ai-video",
                                 description="Local video generation for Genesi AI Mode")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    sub.add_parser("catalog")
    p = sub.add_parser("pull"); p.add_argument("model"); p.add_argument("--variant")
    p = sub.add_parser("remove"); p.add_argument("model"); p.add_argument("--variant")
    p = sub.add_parser("generate")
    p.add_argument("--model", default="wan22-ti2v-5b")
    p.add_argument("--variant")
    p.add_argument("--prompt", required=True)
    p.add_argument("--mode", choices=list(MODES))
    p.add_argument("--image", help="first frame (i2v, flf2v, extend) or reference (r2v, v2v)")
    p.add_argument("--end-image", help="last frame (flf2v)")
    p.add_argument("--video", help="the video to restyle (v2v) or continue (extend)")
    p.add_argument("--seconds", type=float, default=None)
    p.add_argument("--frames", type=int, default=None)
    p.add_argument("--size", choices=list(SIZES))
    p.add_argument("--aspect", choices=list(ASPECTS))
    p.add_argument("--steps", type=int, default=0)
    p.add_argument("--cfg", type=float, default=None)
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--negative", default=None)
    p.add_argument("--lora", action="append", default=[],
                   help="an imported LoRA, ID or ID:WEIGHT (repeatable)")
    p.add_argument("--turbo", action="store_true", help="the model's distillation LoRA: 4-6 steps")
    p.add_argument("--low-memory", action="store_true",
                   help="weights in RAM, tiled VAE: slower, fits small cards")
    p.add_argument("--light-vae", action="store_true",
                   help="decode with the 22 MB TAE instead of the VAE (much less memory, softer)")
    p.add_argument("--out")
    p.add_argument("--keep-llm", action="store_true")
    p = sub.add_parser("gallery"); p.add_argument("--limit", type=int, default=60)
    p = sub.add_parser("lora")
    p.add_argument("action", choices=["list", "import", "remove"])
    p.add_argument("target", nargs="?")
    p.add_argument("--name")
    p.add_argument("--trigger")

    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    as_json = "--json" in raw
    raw = [a for a in raw if a != "--json"]
    args = ap.parse_args(raw)
    out = img.Out(as_json)
    signal.signal(signal.SIGTERM, img._forward_signal)
    signal.signal(signal.SIGINT, img._forward_signal)
    handler = {"status": cmd_status, "catalog": cmd_catalog, "pull": cmd_pull,
               "remove": cmd_remove, "generate": cmd_generate, "gallery": cmd_gallery,
               "lora": cmd_lora}[args.cmd]
    return handler(args, out)


if __name__ == "__main__":
    sys.exit(main())
