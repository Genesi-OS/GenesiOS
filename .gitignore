# Build artifacts
genesi-arch/work/
genesi-arch/out/
*.iso

# Temporary files
*.tmp
*.log
*~

# genesi-code build cache (Cargo target dir, multi-GB)
.tmp-genesi-code-target/

# System files
.DS_Store
Thumbs.db

# Local
.verdent/
build/
example/
# Anchored to repo root so it doesn't also ignore the genesi-desktop
# meta-package under genesi-arch/packages/.
/genesi-desktop/
kernel_legacy/

# Temporary documentation (don't commit)
*_plan.md
*_summary.md
implementation_*.md
debug_*.md

# Working directory for ISO build (generated by setup script)
genesi-iso/

# Tooling state (Claude Code, oh-my-claudecode, etc.)
.claude/
.omc/

# Python bytecode (e.g. from py_compile checks)
__pycache__/
*.pyc

# Built package repository (generated by CI)
genesi-arch/repo/

# Local makepkg output. Packages are published to genesi-arch/repo/x86_64 by
# CI; anything built in place under packages/ is a local test artifact and must
# not be committed alongside the source it was built from.
genesi-arch/packages/*/*.pkg.tar.zst
genesi-arch/packages/*/pkg/
genesi-arch/packages/*/src/
# The bare git clone a VCS PKGBUILD caches next to itself (llama.cpp is
# gigabytes of upstream history).
genesi-arch/packages/*/llama.cpp/
